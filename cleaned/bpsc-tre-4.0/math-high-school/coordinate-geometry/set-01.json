  "questions": [
    {
      "id": "coordinate-geometry-01-001",
      "number": 1,
      "question": "If the distance between the points (x, 0) and (0, 3) is 5 units, then x is:",
      "options": {
        "A": "4 only",
        "B": "-4 only",
        "C": "plus minus 4",
        "D": "16",
        "E": "None of the above"
      },
      "answer": "C",
      "explanation": "Using distance formula: sqrt(x^2 + 3^2) = 5, so x^2 + 9 = 25, x^2 = 16, x = plus minus 4.",
      "hash": "f22a7d1e4031a898",
      "translations": {
        "hi": {
          "question": "यदि बिंदुओं (x, 0) और (0, 3) के बीच की दूरी 5 इकाई है, तो x का मान है:",
          "options": {
            "A": "केवल 4",
            "B": "केवल -4",
            "C": "प्लस माइनस 4",
            "D": "16",
            "E": "उपर्युक्त में से कोई नहीं"
          },
          "explanation": "दूरी सूत्र का उपयोग करते हुए: sqrt(x^2 + 3^2) = 5, इसलिए x^2 + 9 = 25, x^2 = 16, x = प्लस माइनस 4।"
        }
      }
    },
    {
      "id": "coordinate-geometry-01-002",
      "number": 2,
      "question": "The distance of the point (4, 3) from the x-axis is:",
      "options": {
        "A": "4 units",
        "B": "3 units",
        "C": "5 units",
        "D": "7 units",
        "E": "None of the above"
      },
      "answer": "B",
      "explanation": "The distance of a point (x, y) from the x-axis is the absolute value of its y-coordinate.",
      "hash": "e1d732e5817c71e6",
      "translations": {
        "hi": {
          "question": "बिंदु (4, 3) की x-अक्ष से दूरी है:",
          "options": {
            "A": "4 इकाई",
            "B": "3 इकाई",
            "C": "5 इकाई",
            "D": "7 इकाई",
            "E": "उपर्युक्त में से कोई नहीं"
          },
          "explanation": "किसी बिंदु (x, y) की x-अक्ष से दूरी उसके y-निर्देशांक का परिमाण होती है।"
        }
      }
    },
    {
      "id": "coordinate-geometry-01-003",
      "number": 3,
      "question": "The coordinates of the midpoint of the line segment joining (2, 4) and (6, 8) are:",
      "options": {
        "A": "(4, 4)",
        "B": "(8, 12)",
        "C": "(4, 6)",
        "D": "(2, 2)",
        "E": "More than one of the above"
      },
      "answer": "C",
      "explanation": "Midpoint formula is ((x1+x2)/2, (y1+y2)/2). Here, ((2+6)/2, (4+8)/2) = (4, 6).",
      "hash": "0ce15277b575aaaa",
      "translations": {
        "hi": {
          "question": "(2, 4) और (6, 8) को जोड़ने वाले रेखाखंड के मध्य बिंदु के निर्देशांक हैं:",
          "options": {
            "A": "(4, 4)",
            "B": "(8, 12)",
            "C": "(4, 6)",
            "D": "(2, 2)",
            "E": "उपर्युक्त में से एक से अधिक"
          },
          "explanation": "मध्य बिंदु का सूत्र ((x1+x2)/2, (y1+y2)/2) है। यहाँ, ((2+6)/2, (4+8)/2) = (4, 6) है।"
        }
      }
    },
    {
      "id": "coordinate-geometry-01-004",
      "number": 4,
      "question": "The area of a triangle with vertices (0,0), (3,0) and (0,4) is:",
      "options": {
        "A": "12 sq units",
        "B": "6 sq units",
        "C": "7 sq units",
        "D": "5 sq units",
        "E": "More than one of the above"
      },
      "answer": "B",
      "explanation": "Area = 1/2 * base * height = 1/2 * 3 * 4 = 6.",
      "hash": "654fd76b9e77348c",
      "translations": {
        "hi": {
          "question": "शीर्षों (0,0), (3,0) और (0,4) वाले त्रिभुज का क्षेत्रफल है:",
          "options": {
            "A": "12 वर्ग इकाई",
            "B": "6 वर्ग इकाई",
            "C": "7 वर्ग इकाई",
            "D": "5 वर्ग इकाई",
            "E": "उपर्युक्त में से एक से अधिक"
          },
          "explanation": "क्षेत्रफल = 1/2 * आधार * ऊँचाई = 1/2 * 3 * 4 = 6।"
        }
      }
    },
    {
      "id": "coordinate-geometry-01-005",
      "number": 5,
      "question": "The point which divides the line segment joining (1, 2) and (3, 4) in the ratio 1:1 is:",
      "options": {
        "A": "(2, 3)",
        "B": "(4, 6)",
        "C": "(1, 1)",
        "D": "(3, 2)",
        "E": "None of the above"
      },
      "answer": "A",
      "explanation": "A 1:1 ratio means the midpoint: ((1+3)/2, (2+4)/2) = (2, 3).",
      "hash": "d637c17001903441",
      "translations": {
        "hi": {
          "question": "वह बिंदु जो (1, 2) और (3, 4) को जोड़ने वाले रेखाखंड को 1:1 के अनुपात में विभाजित करता है, वह है:",
          "options": {
            "A": "(2, 3)",
            "B": "(4, 6)",
            "C": "(1, 1)",
            "D": "(3, 2)",
            "E": "उपर्युक्त में से कोई नहीं"
          },
          "explanation": "1:1 अनुपात का अर्थ मध्य बिंदु है: ((1+3)/2, (2+4)/2) = (2, 3)।"
        }
      }
    },
    {
      "id": "coordinate-geometry-01-006",
      "number": 6,
      "question": "Points (1, 1), (2, 2) and (3, 3) are:",
      "options": {
        "A": "Vertices of an isosceles triangle",
        "B": "Vertices of an equilateral triangle",
        "C": "Collinear",
        "D": "Vertices of a right triangle",
        "E": "None of the above"
      },
      "answer": "C",
      "explanation": "The slope between any two points is 1, so they lie on the same line.",
      "hash": "c046e0ab0dcc07cd",
      "translations": {
        "hi": {
          "question": "बिंदु (1, 1), (2, 2) और (3, 3) हैं:",
          "options": {
            "A": "एक समद्विबाहु त्रिभुज के शीर्ष",
            "B": "एक समबाहु त्रिभुज के शीर्ष",
            "C": "संरेख",
            "D": "एक समकोण त्रिभुज के शीर्ष",
            "E": "उपर्युक्त में से कोई नहीं"
          },
          "explanation": "किन्हीं दो बिंदुओं के बीच का ढाल 1 है, इसलिए वे एक ही रेखा पर स्थित हैं।"
        }
      }
    },
    {
      "id": "coordinate-geometry-01-007",
      "number": 7,
      "question": "The centroid of a triangle whose vertices are (1, 2), (3, 4), and (5, 6) is:",
      "options": {
        "A": "(9, 12)",
        "B": "(3, 3)",
        "C": "(3, 4)",
        "D": "(4, 5)",
        "E": "None of the above"
      },
      "answer": "C",
      "explanation": "Centroid = ((x1+x2+x3)/3, (y1+y2+y3)/3) = ((1+3+5)/3, (2+4+6)/3) = (3, 4).",
      "hash": "96bcd35b01a6a4be",
      "translations": {
        "hi": {
          "question": "एक त्रिभुज का केंद्रक जिसके शीर्ष (1, 2), (3, 4) और (5, 6) हैं, वह है:",
          "options": {
            "A": "(9, 12)",
            "B": "(3, 3)",
            "C": "(3, 4)",
            "D": "(4, 5)",
            "E": "उपर्युक्त में से कोई नहीं"
          },
          "explanation": "केंद्रक = ((x1+x2+x3)/3, (y1+y2+y3)/3) = ((1+3+5)/3, (2+4+6)/3) = (3, 4)।"
        }
      }
    },
    {
      "id": "coordinate-geometry-01-008",
      "number": 8,
      "question": "The distance of point (-6, 8) from the origin is:",
      "options": {
        "A": "8 units",
        "B": "2 units",
        "C": "10 units",
        "D": "6 units",
        "E": "None of the above"
      },
      "answer": "C",
      "explanation": "Distance from origin = sqrt((-6)^2 + 8^2) = sqrt(36 + 64) = 10.",
      "hash": "44b211b9b3d711bf",
      "translations": {
        "hi": {
          "question": "मूल बिंदु से बिंदु (-6, 8) की दूरी है:",
          "options": {
            "A": "8 इकाई",
            "B": "2 इकाई",
            "C": "10 इकाई",
            "D": "6 इकाई",
            "E": "उपर्युक्त में से कोई नहीं"
          },
          "explanation": "मूल बिंदु से दूरी = sqrt((-6)^2 + 8^2) = sqrt(36 + 64) = 10।"
        }
      }
    },
    {
      "id": "coordinate-geometry-01-009",
      "number": 9,
      "question": "If the slope of the line joining (2, 5) and (x, 3) is 2, then x is:",
      "options": {
        "A": "1",
        "B": "2",
        "C": "3",
        "D": "4",
        "E": "None of the above"
      },
      "answer": "A",
      "explanation": "Slope (m) = (y2-y1)/(x2-x1). 2 = (3-5)/(x-2) => 2(x-2) = -2 => x-2 = -1 => x = 1.",
      "hash": "ec1ddecf29148225",
      "translations": {
        "hi": {
          "question": "यदि (2, 5) और (x, 3) को जोड़ने वाली रेखा का ढाल 2 है, तो x का मान है:",
          "options": {
            "A": "1",
            "B": "2",
            "C": "3",
            "D": "4",
            "E": "उपर्युक्त में से कोई नहीं"
          },
          "explanation": "ढाल (m) = (y2-y1)/(x2-x1)। 2 = (3-5)/(x-2) => 2(x-2) = -2 => x-2 = -1 => x = 1।"
        }
      }
    },
    {
