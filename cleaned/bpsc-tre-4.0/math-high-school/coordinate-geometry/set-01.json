        "hi": {
          "question": "x-अक्ष पर वह बिंदु जो (-1, 0) और (5, 0) से समान दूरी पर है, वह है:",
          "options": {
            "A": "(0, 2)",
            "B": "(2, 0)",
            "C": "(3, 0)",
