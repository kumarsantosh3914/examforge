      "id": "coordinate-geometry-03-020",
      "number": 20,
      "question": "If P(x, y) is equidistant from A(5, 1) and B(-1, 5), then:",
      "options": {
        "A": "3x = 2y",
        "B": "2x = 3y",
        "C": "x = y",
        "D": "x + y = 0",
        "E": "None of the above"
      },
      "answer": "A",
      "explanation": "(x-5)^2 + (y-1)^2 = (x+1)^2 + (y-5)^2 => -10x + 25 - 2y + 1 = 2x + 1 - 10y + 25 => -12x = -8y => 3x = 2y.",
      "hash": "e63ef8ee6a68a76f",
      "translations": {
        "hi": {
          "question": "यदि P(x, y) A(5, 1) और B(-1, 5) से समान दूरी पर है, तो:",
          "options": {
            "A": "3x = 2y",
            "B": "2x = 3y",
            "C": "x = y",
            "D": "x + y = 0",
            "E": "उपर्युक्त में से कोई नहीं"
          },
          "explanation": "(x-5)^2 + (y-1)^2 = (x+1)^2 + (y-5)^2 => -12x = -8y => 3x = 2y।"
        }
      }
    }
