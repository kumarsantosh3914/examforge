    {
      "id": "mathematics-05-002",
      "number": 2,
      "question": "Solve: 100 ÷ 10 × (2 + 3) = ?",
      "options": {
        "A": "20",
        "B": "50",
        "C": "10",
        "D": "5"
      },
      "answer": "B",
      "explanation": "Brackets first: 2 + 3 = 5. Then left to right: 100 ÷ 10 = 10, 10 × 5 = 50.",
      "hash": "f00ad3184ca985c6",
      "translations": {
        "hi": {
          "question": "हल करें: 100 ÷ 10 × (2 + 3) = ?",
          "options": {
            "A": "20",
            "B": "50",
            "C": "10",
            "D": "5"
          },
          "explanation": "पहले कोष्ठक: 2 + 3 = 5। फिर बाएँ से दाएँ: 100 ÷ 10 = 10, 10 × 5 = 50।"
        }
      }
    },
    {
      "id": "mathematics-05-003",
      "number": 3,
      "question": "If 4 is subtracted from the square of a number, the result is 12. What is the number?",
      "options": {
        "A": "2",
        "B": "4",
        "C": "3",
        "D": "5"
      },
      "answer": "B",
      "explanation": "x² − 4 = 12 ⇒ x² = 16 ⇒ x = 4.",
      "hash": "2d806ec02f5e209d",
      "translations": {
        "hi": {
          "question": "यदि एक संख्या के वर्ग में से 4 घटाने पर 12 आता है, तो वह संख्या क्या है?",
          "options": {
            "A": "2",
            "B": "4",
            "C": "3",
            "D": "5"
          },
          "explanation": "x² − 4 = 12 ⇒ x² = 16 ⇒ x = 4।"
        }
      }
    },
    {
      "id": "mathematics-05-004",
      "number": 4,
      "question": "The ratio of two numbers is 5:3 and their difference is 10. Find the numbers.",
      "options": {
        "A": "25, 15",
        "B": "20, 10",
        "C": "30, 20",
        "D": "15, 5"
      },
      "answer": "A",
      "explanation": "Let the numbers be 5k and 3k. 5k − 3k = 2k = 10 ⇒ k = 5, so the numbers are 25 and 15.",
      "hash": "d14476a0269d5299",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का अनुपात 5:3 है और उनका अंतर 10 है। संख्याएँ ज्ञात करें।",
          "options": {
            "A": "25, 15",
            "B": "20, 10",
            "C": "30, 20",
            "D": "15, 5"
          },
          "explanation": "माना संख्याएँ 5k और 3k हैं। 5k − 3k = 2k = 10 ⇒ k = 5, अतः संख्याएँ 25 और 15 हैं।"
        }
      }
    },
