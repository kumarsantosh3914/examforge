      "translations": {
        "hi": {
          "question": "एक ट्रेन 72 किमी/घंटा की गति से चल रही है। 10 सेकंड में वह कितनी दूरी तय करेगी?",
          "options": {
            "A": "100 मीटर",
            "B": "200 मीटर",
            "C": "300 मीटर",
            "D": "400 मीटर"
          },
          "explanation": "72 किमी/घंटा = 72 × 5/18 = 20 मी/से। 10 सेकंड में: 20 × 10 = 200 मीटर।"
        }
      }
    },
