    {
      "id": "mathematics-04-005",
      "number": 5,
      "question": "Product of two numbers is 120 and their HCF is 6. What will be their LCM?",
      "options": {
        "A": "20",
        "B": "24",
        "C": "30",
        "D": "15"
      },
      "answer": "A",
      "explanation": "Product of two numbers = HCF × LCM ⇒ LCM = 120/6 = 20.",
      "hash": "470ac637e2f1e4cd",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का गुणनफल 120 है और उनका महत्तम समापवर्तक (HCF) 6 है। उनका लघुत्तम समापवर्त्य (LCM) क्या होगा?",
          "options": {
            "A": "20",
            "B": "24",
            "C": "30",
            "D": "15"
          },
          "explanation": "दो संख्याओं का गुणनफल = HCF × LCM ⇒ LCM = 120/6 = 20।"
        }
      }
    },
