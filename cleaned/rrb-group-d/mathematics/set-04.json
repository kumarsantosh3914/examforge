        "hi": {
          "question": "यदि क्रय मूल्य (CP) ₹500 और विक्रय मूल्य (SP) ₹450 है, तो हानि प्रतिशत क्या है?",
          "options": {
            "A": "5%",
            "B": "10%",
            "C": "15%",
            "D": "20%"
          },
          "explanation": "हानि = 500 − 450 = ₹50। हानि % = 50/500 × 100 = 10%।"
        }
      }
