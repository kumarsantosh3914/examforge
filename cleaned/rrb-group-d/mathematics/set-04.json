      "translations": {
        "hi": {
          "question": "समय और कार्य: यदि राम किसी काम को 6 दिन में और श्याम 12 दिन में करता है, तो दोनों मिलकर कितने दिन में करेंगे?",
          "options": {
            "A": "3 दिन",
            "B": "4 दिन",
            "C": "5 दिन",
            "D": "6 दिन"
          },
          "explanation": "दोनों मिलकर = (6 × 12)/(6 + 12) = 72/18 = 4 दिन।"
        }
      }
    },
