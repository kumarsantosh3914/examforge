    {
      "id": "mathematics-04-003",
      "number": 3,
      "question": "Simplify: (256)⁰.²⁵ = ?",
      "options": {
        "A": "2",
        "B": "4",
        "C": "8",
        "D": "16"
      },
      "answer": "B",
      "explanation": "0.25 = 1/4, so (256)^(1/4) is the fourth root of 256. 4⁴ = 256, so the answer is 4.",
      "hash": "7bb21d5d3f522bb1",
      "translations": {
        "hi": {
          "question": "सरल करें: (256)⁰.²⁵ = ?",
          "options": {
            "A": "2",
            "B": "4",
            "C": "8",
            "D": "16"
          },
          "explanation": "0.25 = 1/4, अतः (256)^(1/4) यानी 256 का चतुर्थ मूल। 4⁴ = 256, इसलिए उत्तर 4 है।"
        }
      }
    },
