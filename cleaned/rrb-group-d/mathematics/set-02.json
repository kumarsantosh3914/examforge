        "hi": {
          "question": "साधारण ब्याज की किस दर से कोई राशि 10 वर्षों में दोगुनी हो जाएगी?",
          "options": {
            "A": "5%",
            "B": "8%",
            "C": "10%",
            "D": "12%"
          },
          "explanation": "दोगुना होने के लिए ब्याज मूलधन के बराबर होना चाहिए: P = P × R × 10/100 ⇒ R = 10%।"
        }
      }
    },
