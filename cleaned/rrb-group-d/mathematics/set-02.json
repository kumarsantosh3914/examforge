            "A": "₹80",
            "B": "₹90",
            "C": "₹95",
            "D": "₹85"
          },
          "explanation": "छूट = 100 का 10% = ₹10, इसलिए मूल्य = 100 − 10 = ₹90।"
        }
      }
    },
