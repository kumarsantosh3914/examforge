      "id": "mathematics-02-001",
      "number": 1,
      "question": "Solve: 12 ÷ 4 + 3 × 2 - 5 = ?",
      "options": {
        "A": "2",
        "B": "4",
        "C": "5",
        "D": "6"
      },
      "answer": "B",
      "explanation": "BODMAS: 12 ÷ 4 = 3 and 3 × 2 = 6, so 3 + 6 − 5 = 4.",
      "hash": "da35e1240b7e0459",
      "translations": {
        "hi": {
          "question": "हल करें (Solve): 12 ÷ 4 + 3 × 2 - 5 = ?",
          "options": {
            "A": "2",
            "B": "4",
            "C": "5",
            "D": "6"
          },
          "explanation": "BODMAS: 12 ÷ 4 = 3 और 3 × 2 = 6, अतः 3 + 6 − 5 = 4।"
        }
      }
    },
