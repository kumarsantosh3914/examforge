      "question": "Ratio of two numbers is 3:4 and their sum is 28. Find the larger number.",
      "options": {
        "A": "12",
        "B": "16",
        "C": "20",
        "D": "14"
      },
      "answer": "B",
      "explanation": "Total parts = 3 + 4 = 7. Larger number = 4/7 × 28 = 16.",
      "hash": "8b48b4d3b61f747b",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का अनुपात 3:4 है और उनका योग 28 है। बड़ी संख्या ज्ञात करें।",
          "options": {
            "A": "12",
            "B": "16",
            "C": "20",
            "D": "14"
          },
          "explanation": "कुल भाग = 3 + 4 = 7। बड़ी संख्या = 4/7 × 28 = 16।"
        }
      }
    },
