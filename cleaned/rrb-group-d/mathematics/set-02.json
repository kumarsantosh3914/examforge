          "options": {
            "A": "25 दिन",
            "B": "30 दिन",
            "C": "40 दिन",
            "D": "20 दिन"
          },
          "explanation": "कुल कार्य = 15 × 20 = 300 मानव-दिवस। 10 आदमी 300/10 = 30 दिन लेंगे।"
        }
      }
