      "id": "mathematics-02-003",
      "number": 3,
      "question": "How much distance will a car cover in 2.5 hours at a speed of 60 km/h?",
      "options": {
        "A": "120 km",
        "B": "150 km",
        "C": "180 km",
        "D": "100 km"
      },
      "answer": "B",
      "explanation": "Distance = speed × time = 60 × 2.5 = 150 km.",
      "hash": "3aa47bd802076a2b",
      "translations": {
        "hi": {
          "question": "एक कार 60 किमी/घंटा की चाल से 2.5 घंटे में कितनी दूरी तय करेगी?",
          "options": {
            "A": "120 किमी",
            "B": "150 किमी",
            "C": "180 किमी",
            "D": "100 किमी"
          },
          "explanation": "दूरी = चाल × समय = 60 × 2.5 = 150 किमी।"
        }
      }
    },
    {
      "id": "mathematics-02-004",
      "number": 4,
      "question": "What is the HCF of 36 and 48?",
      "options": {
        "A": "6",
        "B": "12",
        "C": "18",
        "D": "24"
      },
      "answer": "B",
      "explanation": "36 = 2² × 3² and 48 = 2⁴ × 3. HCF = 2² × 3 = 12.",
      "hash": "dce34b42b3db00d0",
      "translations": {
        "hi": {
          "question": "36 और 48 का महत्तम समापवर्तक (HCF) क्या है?",
          "options": {
            "A": "6",
            "B": "12",
            "C": "18",
            "D": "24"
          },
          "explanation": "36 = 2² × 3² और 48 = 2⁴ × 3। HCF = 2² × 3 = 12।"
        }
      }
    },
