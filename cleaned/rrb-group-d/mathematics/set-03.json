      "id": "mathematics-03-001",
      "number": 1,
      "question": "Which is the smallest Composite Number?",
      "options": {
        "A": "1",
        "B": "2",
        "C": "3",
        "D": "4"
      },
      "answer": "D",
      "explanation": "A composite number has more than two factors. 4 (1, 2, 4) is the smallest; 1 is neither prime nor composite.",
      "hash": "ab05d9b9087ec607",
      "translations": {
        "hi": {
          "question": "सबसे छोटी भाज्य संख्या (Composite Number) कौन सी है?",
          "options": {
            "A": "1",
            "B": "2",
            "C": "3",
            "D": "4"
          },
          "explanation": "भाज्य संख्या के दो से अधिक गुणनखंड होते हैं। 4 (1, 2, 4) सबसे छोटी है; 1 न अभाज्य है न भाज्य।"
        }
      }
    },
