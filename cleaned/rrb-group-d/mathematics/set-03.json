      "translations": {
        "hi": {
          "question": "प्रथम 5 प्राकृतिक संख्याओं का योग (Sum) क्या है?",
          "options": {
            "A": "10",
            "B": "15",
            "C": "20",
            "D": "25"
          },
          "explanation": "1 + 2 + 3 + 4 + 5 = 15, या n(n + 1)/2 = 5 × 6/2 = 15।"
        }
      }
