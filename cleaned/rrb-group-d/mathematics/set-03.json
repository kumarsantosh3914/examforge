    {
      "id": "mathematics-03-004",
      "number": 4,
      "question": "Base of a triangle is 10 cm and height is 5 cm, what will be its Area?",
      "options": {
        "A": "25 cm²",
        "B": "50 cm²",
        "C": "15 cm²",
        "D": "100 cm²"
      },
      "answer": "A",
      "explanation": "Area = 1/2 × base × height = 1/2 × 10 × 5 = 25 cm².",
      "hash": "7f8666c6c17c65eb",
      "translations": {
        "hi": {
          "question": "एक त्रिभुज का आधार 10 सेमी और ऊंचाई 5 सेमी है, उसका क्षेत्रफल (Area) क्या होगा?",
          "options": {
            "A": "25 cm²",
            "B": "50 cm²",
            "C": "15 cm²",
            "D": "100 cm²"
          },
          "explanation": "क्षेत्रफल = 1/2 × आधार × ऊँचाई = 1/2 × 10 × 5 = 25 cm²।"
        }
      }
    },
    {
      "id": "mathematics-03-005",
      "number": 5,
      "question": "A 300m long train crosses a pole in 15 seconds. What is the speed of the train?",
      "options": {
        "A": "10 m/s",
        "B": "20 m/s",
        "C": "15 m/s",
        "D": "25 m/s"
      },
      "answer": "B",
      "explanation": "To cross a pole the train covers its own length: speed = 300/15 = 20 m/s.",
      "hash": "dd58be5270731ee6",
      "translations": {
        "hi": {
          "question": "300 मीटर लंबी ट्रेन एक खंभे को 15 सेकंड में पार करती है। ट्रेन की चाल (Speed) क्या है?",
          "options": {
            "A": "10 m/s",
            "B": "20 m/s",
            "C": "15 m/s",
            "D": "25 m/s"
          },
          "explanation": "खंभा पार करने में ट्रेन अपनी लंबाई जितनी दूरी तय करती है: चाल = 300/15 = 20 मी/से।"
        }
      }
    },
    {
      "id": "mathematics-03-006",
      "number": 6,
      "question": "If 4:x :: 2:3, then find the value of x.",
      "options": {
        "A": "5",
        "B": "6",
        "C": "8",
        "D": "4"
      },
      "answer": "B",
      "explanation": "4/x = 2/3 ⇒ 2x = 12 ⇒ x = 6.",
      "hash": "3396f1f1d83f8dc4",
      "translations": {
        "hi": {
          "question": "यदि 4:x :: 2:3 है, तो x का मान ज्ञात करें।",
          "options": {
            "A": "5",
            "B": "6",
            "C": "8",
            "D": "4"
          },
          "explanation": "4/x = 2/3 ⇒ 2x = 12 ⇒ x = 6।"
        }
      }
    },
    {
      "id": "mathematics-03-007",
      "number": 7,
      "question": "A shopkeeper sells a ₹100 item for ₹80. What is the loss percentage?",
      "options": {
        "A": "10%",
        "B": "20%",
        "C": "25%",
        "D": "15%"
      },
      "answer": "B",
      "explanation": "Loss = 100 − 80 = ₹20. Loss % = 20/100 × 100 = 20%.",
      "hash": "ce13eede27ae8db8",
      "translations": {
        "hi": {
          "question": "एक दुकानदार ₹100 की वस्तु को ₹80 में बेचता है। हानि प्रतिशत क्या है?",
          "options": {
            "A": "10%",
            "B": "20%",
            "C": "25%",
            "D": "15%"
          },
          "explanation": "हानि = 100 − 80 = ₹20। हानि % = 20/100 × 100 = 20%।"
        }
      }
    },
