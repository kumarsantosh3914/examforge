      "hash": "688d394652a9b443",
      "translations": {
        "hi": {
          "question": "समकोण त्रिभुज (Right Angled Triangle) में पाइथागोरस प्रमेय क्या है?",
          "options": {
            "A": "H² = P² + B²",
            "B": "H = P + B",
            "C": "H² = P² - B²",
            "D": "H = P² + B²"
          },
          "explanation": "समकोण त्रिभुज में, कर्ण² = लम्ब² + आधार², अर्थात H² = P² + B²।"
        }
      }
