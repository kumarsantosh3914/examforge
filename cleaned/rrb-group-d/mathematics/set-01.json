      "id": "mathematics-01-001",
      "number": 1,
      "question": "Which is the smallest Prime Number?",
      "options": {
        "A": "0",
        "B": "1",
        "C": "2",
        "D": "3"
      },
      "answer": "C",
      "explanation": "A prime number has exactly two factors, 1 and itself. 0 and 1 are not prime, so the smallest prime is 2.",
      "hash": "f011cec17010c44b",
      "translations": {
        "hi": {
          "question": "सबसे छोटी अभाज्य संख्या (Prime Number) कौन सी है?",
          "options": {
            "A": "0",
            "B": "1",
            "C": "2",
            "D": "3"
          },
          "explanation": "अभाज्य संख्या के ठीक दो गुणनखंड होते हैं, 1 और वह स्वयं। 0 और 1 अभाज्य नहीं हैं, इसलिए सबसे छोटी अभाज्य संख्या 2 है।"
        }
      }
    },
    {
      "id": "mathematics-01-002",
      "number": 2,
      "question": "If 20% of a number is 40, then what is that number?",
      "options": {
        "A": "200",
        "B": "150",
        "C": "300",
        "D": "250"
      },
      "answer": "A",
      "explanation": "20% of x = 40 ⇒ x = 40 × 100/20 = 200.",
      "hash": "76734641ab80b24b",
      "translations": {
        "hi": {
          "question": "यदि एक संख्या का 20% 40 है, तो वह संख्या क्या है?",
          "options": {
            "A": "200",
            "B": "150",
            "C": "300",
            "D": "250"
          },
          "explanation": "x का 20% = 40 ⇒ x = 40 × 100/20 = 200।"
        }
      }
    },
