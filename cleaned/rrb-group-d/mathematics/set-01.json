    {
      "id": "mathematics-01-010",
      "number": 10,
      "question": "If a : b = 2 : 3 and b : c = 4 : 5, then what is a : b : c?",
      "options": {
        "A": "8:12:15",
        "B": "2:3:5",
        "C": "8:15:12",
        "D": "6:12:15"
      },
      "answer": "A",
      "explanation": "Make b equal: a : b = 2 : 3 = 8 : 12 and b : c = 4 : 5 = 12 : 15. So a : b : c = 8 : 12 : 15.",
      "hash": "17b19535b49604e0",
      "translations": {
        "hi": {
          "question": "यदि a : b = 2 : 3 और b : c = 4 : 5 है, तो a : b : c क्या होगा?",
          "options": {
            "A": "8:12:15",
            "B": "2:3:5",
            "C": "8:15:12",
            "D": "6:12:15"
          },
          "explanation": "b को बराबर करें: a : b = 2 : 3 = 8 : 12 और b : c = 4 : 5 = 12 : 15। अतः a : b : c = 8 : 12 : 15।"
        }
      }
    },
