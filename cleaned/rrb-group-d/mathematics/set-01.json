    {
      "id": "mathematics-01-005",
      "number": 5,
      "question": "What is the average of the first 10 natural numbers?",
      "options": {
        "A": "5",
        "B": "5.5",
        "C": "6",
        "D": "4.5"
      },
      "answer": "B",
      "explanation": "Sum of 1 to 10 = 10 × 11/2 = 55; average = 55/10 = 5.5. (Average of first n natural numbers = (n + 1)/2.)",
      "hash": "55027a6dfaf9ac3a",
      "translations": {
        "hi": {
          "question": "प्रथम 10 प्राकृतिक संख्याओं का औसत (Average) क्या है?",
          "options": {
            "A": "5",
            "B": "5.5",
            "C": "6",
            "D": "4.5"
          },
          "explanation": "1 से 10 का योग = 10 × 11/2 = 55; औसत = 55/10 = 5.5। (प्रथम n प्राकृतिक संख्याओं का औसत = (n + 1)/2)"
        }
      }
    },
    {
      "id": "mathematics-01-006",
      "number": 6,
      "question": "Convert 72 km/h into m/s.",
      "options": {
        "A": "20 m/s",
        "B": "25 m/s",
        "C": "15 m/s",
        "D": "10 m/s"
      },
      "answer": "A",
      "explanation": "To convert km/h to m/s, multiply by 5/18: 72 × 5/18 = 20 m/s.",
      "hash": "c4d6c2d5d3f11d77",
      "translations": {
        "hi": {
          "question": "72 किमी/घंटा को मीटर/सेकंड में बदलें।",
          "options": {
            "A": "20 m/s",
            "B": "25 m/s",
            "C": "15 m/s",
            "D": "10 m/s"
          },
          "explanation": "किमी/घंटा को मी/से में बदलने के लिए 5/18 से गुणा करें: 72 × 5/18 = 20 मी/से।"
        }
      }
    },
    {
      "id": "mathematics-01-007",
      "number": 7,
      "question": "A can do a work in 10 days and B in 15 days. In how many days will they finish the work together?",
      "options": {
        "A": "5 days",
        "B": "6 days",
        "C": "8 days",
        "D": "12 days"
      },
      "answer": "B",
      "explanation": "Together = (10 × 15)/(10 + 15) = 150/25 = 6 days.",
      "hash": "e04692a46872e7a3",
      "translations": {
        "hi": {
          "question": "A किसी काम को 10 दिन में और B उसी काम को 15 दिन में कर सकता है। दोनों मिलकर उस काम को कितने दिन में करेंगे?",
          "options": {
            "A": "5 दिन",
            "B": "6 दिन",
            "C": "8 दिन",
            "D": "12 दिन"
          },
          "explanation": "दोनों मिलकर = (10 × 15)/(10 + 15) = 150/25 = 6 दिन।"
        }
      }
    },
