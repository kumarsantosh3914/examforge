      "number": 1,
      "question": "What is the electrical resistivity of silver at 20°C?",
      "options": {
        "A": "6.84 × 10⁻⁸ Ωm",
        "B": "10¹² Ωm",
        "C": "49 × 10⁻⁶ Ωm",
        "D": "1.60 × 10⁻⁸ Ωm"
      },
      "answer": "D",
      "explanation": "Silver has very low resistivity.",
      "hash": "98423337119f8cef",
      "translations": {
        "hi": {
          "question": "20°C पर सिल्वर की विद्युत प्रतिरोधकता क्या है?",
          "options": {
            "A": "6.84 × 10⁻⁸ Ωm",
            "B": "10¹² Ωm",
            "C": "49 × 10⁻⁶ Ωm",
            "D": "1.60 × 10⁻⁸ Ωm"
          },
          "explanation": "सिल्वर की प्रतिरोधकता बहुत कम होती है।"
        }
