    {
      "id": "science-11-002",
      "number": 2,
      "question": "What fuse rating is required for a 1 kW device at 220 V?",
      "options": {
        "A": "1 A",
        "B": "3 A",
        "C": "4 A",
        "D": "5 A"
      },
      "answer": "D",
      "explanation": "Current = Power/Voltage ≈ 4.5 A, so 5A fuse.",
      "hash": "1da83902ecd626cc",
      "translations": {
        "hi": {
          "question": "220 V पर 1 kW उपभोग करने वाले उपकरण के लिए कितने एंपियर का फ्यूज चाहिए?",
          "options": {
            "A": "1 A",
            "B": "3 A",
            "C": "4 A",
            "D": "5 A"
          },
          "explanation": "I = P/V = 1000/220 ≈ 4.5 A, अतः 5A फ्यूज।"
        }
      }
    },
