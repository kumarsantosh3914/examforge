            "A": "विद्युत दाब में अंतर नहीं होता",
            "B": "विद्युत दाब में अंतर होता है",
            "C": "दाब समान होता है",
            "D": "दाब का महत्व नहीं"
          },
          "explanation": "धारा प्रवाह के लिए विभवान्तर आवश्यक है।"
        }
