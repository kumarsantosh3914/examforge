      "id": "science-09-001",
      "number": 1,
      "question": "The formula to calculate the resistance of a coil is –",
      "options": {
        "A": "R = V × I",
        "B": "R = V / I",
        "C": "R = I / V",
        "D": "R = V − I"
      },
      "answer": "B",
      "explanation": "According to Ohm’s law, R = V/I.",
      "hash": "96643c700f89b38e",
      "translations": {
        "hi": {
          "question": "किसी कुण्डली का प्रतिरोध ज्ञात करने का सूत्र है –",
          "options": {
            "A": "R = V × I",
            "B": "R = V / I",
            "C": "R = I / V",
            "D": "R = V − I"
          },
          "explanation": "ओम के नियम के अनुसार R = V/I होता है।"
        }
      }
    },
