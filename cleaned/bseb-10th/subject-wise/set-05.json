    {
      "id": "subjet-wise-05-004",
      "number": 4,
      "question": "Value of 1/α + 1/β for x² - 3x + 5?",
      "options": {
        "A": "3/5",
        "B": "5/3",
        "C": "-3/5",
        "D": "-5/3"
      },
      "answer": "A",
      "explanation": "(Sum of zeros) / (Product of zeros) = 3/5.",
      "hash": "a0420b6adf0fd129",
      "translations": {
        "hi": {
          "question": "यदि α, β बहुपद x² - 3x + 5 के शून्यक हैं, तो 1/α + 1/β का मान क्या होगा?",
          "options": {
            "A": "3/5",
            "B": "5/3",
            "C": "-3/5",
            "D": "-5/3"
          },
          "explanation": "1/α + 1/β = (α+β)/αβ = (3)/5 = 3/5।"
        }
      }
    },
