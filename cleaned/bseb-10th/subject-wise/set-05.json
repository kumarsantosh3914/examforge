        "C": "5, 0",
        "D": "√5, √5"
      },
      "answer": "B",
      "explanation": "x = ±√5.",
      "hash": "d434051ccd8361b8",
      "translations": {
        "hi": {
          "question": "द्विघात बहुपद x² - 5 के शून्यक हैं?",
          "options": {
            "A": "+5, -5",
            "B": "+√5, -√5",
            "C": "5, 0",
            "D": "√5, √5"
          },
          "explanation": "x² - 5 = 0 => x² = 5 => x = ±√5।"
        }
      }
