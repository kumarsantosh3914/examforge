    {
      "id": "subjet-wise-05-006",
      "number": 6,
      "question": "Which term of AP: 21, 18, 15... is 0?",
      "options": {
        "A": "6ठा",
        "B": "7वां",
        "C": "8वां",
        "D": "9वां"
      },
      "answer": "C",
      "explanation": "8th term.",
      "hash": "555cf1142066d76c",
      "translations": {
        "hi": {
          "question": "AP: 21, 18, 15... का कौन सा पद 0 है?",
          "options": {
            "A": "6ठा",
            "B": "7वां",
            "C": "8वां",
            "D": "9वां"
          },
          "explanation": "0 = 21 + (n-1)(-3) => -21 = -3(n-1) => 7 = n-1 => n = 8।"
        }
      }
