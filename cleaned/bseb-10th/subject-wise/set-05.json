      "id": "subjet-wise-05-008",
      "number": 8,
      "question": "Distance between (-1, 3) and (-5, 7)?",
      "options": {
        "A": "4√2",
        "B": "2√2",
        "C": "4",
        "D": "8"
      },
      "answer": "A",
      "explanation": "√32 = 4√2.",
      "hash": "101d85e5cf293ac3",
      "translations": {
        "hi": {
          "question": "बिंदुओं (-1, 3) और (-5, 7) के बीच की दूरी?",
          "options": {
            "A": "4√2",
            "B": "2√2",
            "C": "4",
            "D": "8"
          },
          "explanation": "√[(-5+1)² + (7-3)²] = √[16 + 16] = √32 = 4√2।"
        }
      }
    },
