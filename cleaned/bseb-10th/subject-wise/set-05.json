      "id": "subjet-wise-05-001",
      "number": 1,
      "question": "What is the HCF of two consecutive prime numbers?",
      "options": {
        "A": "0",
        "B": "1",
        "C": "2",
        "D": "3"
      },
      "answer": "B",
      "explanation": "Prime numbers only have 1 as a common factor.",
      "hash": "c94d90ef942de44d",
      "translations": {
        "hi": {
          "question": "दो क्रमिक अभाज्य संख्याओं (Consecutive Prime Numbers) का म.स. (HCF) क्या होगा?",
          "options": {
            "A": "0",
            "B": "1",
            "C": "2",
            "D": "3"
          },
          "explanation": "अभाज्य संख्याओं में 1 के अलावा कोई उभयनिष्ठ गुणनखंड नहीं होता, इसलिए HCF हमेशा 1 होता है।"
        }
      }
    },
    {
      "id": "subjet-wise-05-002",
      "number": 2,
      "question": "Product of two numbers is 2166 and HCF is 19. Find LCM.",
      "options": {
        "A": "38",
        "B": "57",
        "C": "114",
        "D": "19"
      },
      "answer": "C",
      "explanation": "LCM = Product / HCF = 114.",
      "hash": "8b33ef22ee7ac7f0",
      "translations": {
        "hi": {
          "question": "यदि दो संख्याओं का गुणनफल 2166 है और उनका म.स. 19 है, तो उनका ल.स. (LCM) क्या होगा?",
          "options": {
            "A": "38",
            "B": "57",
            "C": "114",
            "D": "19"
          },
          "explanation": "LCM = गुणनफल / HCF = 2166 / 19 = 114।"
        }
      }
    },
    {
      "id": "subjet-wise-05-003",
