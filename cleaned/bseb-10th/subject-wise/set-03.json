      "id": "subjet-wise-03-038",
      "number": 38,
      "question": "If 15 cot A = 8, value of sin A?",
      "options": {
        "A": "15/17",
        "B": "8/17",
        "C": "17/15",
        "D": "17/8"
      },
      "answer": "A",
      "explanation": "p=15, b=8, h=17. sin A = 15/17.",
      "hash": "469cbb79b71d7ac1",
      "translations": {
        "hi": {
          "question": "यदि 15 cot A = 8, तो sin A का मान क्या है?",
          "options": {
            "A": "15/17",
            "B": "8/17",
            "C": "17/15",
            "D": "17/8"
          },
          "explanation": "cot A = 8/15 (b/p)। h = √(8²+15²) = 17। sin A = p/h = 15/17।"
        }
      }
    },
