      "id": "subjet-wise-03-001",
      "number": 1,
      "question": "What type of decimal expansion does 6/15 have?",
      "options": {
        "A": "सांत (Terminating)",
        "B": "असांत आवर्ती",
        "C": "असांत अनावर्ती",
        "D": "इनमें से कोई नहीं"
      },
      "answer": "A",
      "explanation": "6/15 simplifies to 2/5. Denominator has 5, so it is Terminating.",
      "hash": "bc91a6fef7204d62",
      "translations": {
        "hi": {
          "question": "6/15 का दशमलव प्रसार (Decimal Expansion) कैसा होगा?",
          "options": {
            "A": "सांत (Terminating)",
            "B": "असांत आवर्ती",
            "C": "असांत अनावर्ती",
            "D": "इनमें से कोई नहीं"
          },
          "explanation": "6/15 = 2/5। हर में केवल 5 है, इसलिए यह सांत होगा।"
        }
      }
    },
    {
      "id": "subjet-wise-03-002",
      "number": 2,
      "question": "Which quadratic equation has no real roots?",
      "options": {
        "A": "x² - 4x + 4 = 0",
        "B": "x² - 5x + 6 = 0",
        "C": "x² + 2x + 4 = 0",
        "D": "x² - 7x + 12 = 0"
      },
      "answer": "C",
      "explanation": "For option C, Discriminant is negative.",
      "hash": "2ca1270236e15646",
      "translations": {
        "hi": {
          "question": "किस द्विघात समीकरण के मूल वास्तविक नहीं हैं?",
          "options": {
            "A": "x² - 4x + 4 = 0",
            "B": "x² - 5x + 6 = 0",
            "C": "x² + 2x + 4 = 0",
            "D": "x² - 7x + 12 = 0"
          },
          "explanation": "विकल्प C के लिए D = 2² - 4(1)(4) = 4 - 16 = -12 (< 0)।"
        }
      }
    },
    {
      "id": "subjet-wise-03-003",
      "number": 3,
      "question": "At which point does the graph of 2x + 3y = 12 intersect the X-axis?",
      "options": {
        "A": "(6, 0)",
        "B": "(0, 4)",
        "C": "(0, 6)",
        "D": "(4, 0)"
      },
      "answer": "A",
      "explanation": "Put y=0, then x=6. Point is (6, 0).",
      "hash": "2fa74df38cbdb4af",
      "translations": {
        "hi": {
          "question": "रैखिक समीकरण 2x + 3y = 12 का आलेख X-अक्ष को किस बिंदु पर काटता है?",
          "options": {
            "A": "(6, 0)",
            "B": "(0, 4)",
            "C": "(0, 6)",
            "D": "(4, 0)"
          },
          "explanation": "X-अक्ष पर y = 0 होता है। 2x = 12 => x = 6। बिंदु (6, 0)।"
        }
      }
    },
