    {
      "id": "subjet-wise-03-006",
      "number": 6,
      "question": "(1 + cot² A) / (1 + tan² A) is equal to?",
      "options": {
        "A": "sec² A",
        "B": "cosec² A",
        "C": "cot² A",
        "D": "tan² A"
      },
      "answer": "C",
      "explanation": "Simplifies to cot² A.",
      "hash": "d31f94937827b25f",
      "translations": {
        "hi": {
          "question": "(1 + cot² A) / (1 + tan² A) किसके बराबर है?",
          "options": {
            "A": "sec² A",
            "B": "cosec² A",
            "C": "cot² A",
            "D": "tan² A"
          },
          "explanation": "cosec² A / sec² A = (1/sin²) / (1/cos²) = cos²/sin² = cot² A।"
        }
      }
    },
    {
      "id": "subjet-wise-03-007",
      "number": 7,
      "question": "Distance between (a, b) and (-a, -b)?",
      "options": {
        "A": "2√(a² + b²)",
        "B": "√(a² + b²)",
        "C": "2a",
        "D": "2b"
      },
      "answer": "A",
      "explanation": "Distance formula gives 2√(a² + b²).",
      "hash": "ce87eb526093b270",
      "translations": {
        "hi": {
          "question": "बिंदुओं (a, b) और (-a, -b) के बीच की दूरी क्या है?",
          "options": {
            "A": "2√(a² + b²)",
            "B": "√(a² + b²)",
            "C": "2a",
            "D": "2b"
          },
          "explanation": "√[(-a-a)² + (-b-b)²] = √[4a² + 4b²] = 2√(a² + b²)।"
        }
      }
    },
    {
      "id": "subjet-wise-03-008",
      "number": 8,
      "question": "Ratio of areas is 4:1, ratio of radii?",
      "options": {
        "A": "4:1",
        "B": "2:1",
        "C": "1:2",
        "D": "1:4"
      },
      "answer": "B",
      "explanation": "Ratio of radii = square root of area ratio.",
