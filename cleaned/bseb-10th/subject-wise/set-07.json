      "number": 1,
      "question": "Which gas is flushed in chips bags to prevent oxidation?",
      "options": {
        "A": "ऑक्सीजन",
        "B": "नाइट्रोजन",
        "C": "हाइड्रोजन",
        "D": "कार्बन डाइऑक्साइड"
      },
      "answer": "B",
      "explanation": "Nitrogen prevents rancidity as it is unreactive.",
      "hash": "ab2445d35868cf20",
      "translations": {
        "hi": {
          "question": "चिप्स की थैली में उपचयन (Oxidation) रोकने के लिए कौन सी गैस भरी जाती है?",
          "options": {
            "A": "ऑक्सीजन",
            "B": "नाइट्रोजन",
            "C": "हाइड्रोजन",
            "D": "कार्बन डाइऑक्साइड"
          },
          "explanation": "नाइट्रोजन एक कम सक्रिय गैस है जो चिप्स को खराब (Rancid) होने से बचाती है।"
        }
      }
    },
