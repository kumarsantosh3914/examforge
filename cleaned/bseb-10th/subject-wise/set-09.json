      "id": "subjet-wise-09-001",
      "number": 1,
      "question": "What is the pH value of Acid Rain?",
      "options": {
        "A": "5.6 से कम",
        "B": "7.0",
        "C": "10",
        "D": "14"
      },
      "answer": "A",
      "explanation": "When pH of rain water is less than 5.6.",
      "hash": "e0c37769ef6509c3",
      "translations": {
        "hi": {
          "question": "अम्लीय वर्षा (Acid Rain) का pH मान कितना होता है?",
          "options": {
            "A": "5.6 से कम",
            "B": "7.0",
            "C": "10",
            "D": "14"
          },
          "explanation": "जब वर्षा के जल का pH 5.6 से कम हो जाता है, तो इसे अम्लीय वर्षा कहते हैं।"
        }
      }
    },
