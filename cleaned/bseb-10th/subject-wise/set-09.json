    {
      "id": "subjet-wise-09-006",
      "number": 6,
      "question": "How many covalent bonds are in Propane (C3H8)?",
      "options": {
        "A": "8",
        "B": "9",
        "C": "10",
        "D": "11"
      },
      "answer": "C",
      "explanation": "Total 10 covalent bonds (2 C-C and 8 C-H).",
      "hash": "17e0ea42d9600d34",
      "translations": {
        "hi": {
          "question": "प्रोपेन (Propane) का आणविक सूत्र C3H8 है। इसमें कितने सहसंयोजक आबंध (Covalent Bonds) हैं?",
          "options": {
            "A": "8",
            "B": "9",
            "C": "10",
            "D": "11"
          },
          "explanation": "संरचना बनाने पर 3 C-C बॉन्ड और 8 C-H बॉन्ड नहीं, बल्कि कुल 10 बॉन्ड (2 C-C + 8 C-H) होते हैं।"
        }
      }
    },
