        "B": "1",
        "C": "2",
        "D": "3"
      },
      "answer": "A",
      "explanation": "3 + 2a = 1 => a = -1.",
      "hash": "69d678b6eeb642e9",
      "translations": {
        "hi": {
          "question": "यदि x = 1, y = 2 समीकरण 3x + ay = 1 के हल हों, तो a का मान?",
          "options": {
            "A": "-1",
            "B": "1",
            "C": "2",
            "D": "3"
          },
          "explanation": "3(1) + a(2) = 1 => 3 + 2a = 1 => 2a = -2 => a = -1।"
        }
      }
