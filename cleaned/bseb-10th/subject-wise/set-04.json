      "id": "subjet-wise-04-004",
      "number": 4,
      "question": "Roots are equal if:",
      "options": {
        "A": "b² = 4ac",
        "B": "b² > 4ac",
        "C": "b² < 4ac",
        "D": "b² + 4ac = 0"
      },
      "answer": "A",
      "explanation": "b² - 4ac = 0 implies b² = 4ac.",
      "hash": "f852fa5437aab1e5",
      "translations": {
        "hi": {
          "question": "द्विघात समीकरण ax² + bx + c = 0 के मूल समान होंगे यदि:",
          "options": {
            "A": "b² = 4ac",
            "B": "b² > 4ac",
            "C": "b² < 4ac",
            "D": "b² + 4ac = 0"
          },
          "explanation": "विविक्तकर शून्य होना चाहिए: b² - 4ac = 0 => b² = 4ac।"
        }
      }
    },
