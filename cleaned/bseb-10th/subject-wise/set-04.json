      "id": "subjet-wise-04-009",
      "number": 9,
      "question": "Which term of AP: 2, 6, 10, 14... is 82?",
      "options": {
        "A": "20वां",
        "B": "21वां",
        "C": "22वां",
        "D": "25वां"
      },
      "answer": "B",
      "explanation": "Solving formula gives n = 21.",
      "hash": "1b8ef6a9946ed0d4",
      "translations": {
        "hi": {
          "question": "AP: 2, 6, 10, 14... का कौन सा पद 82 है?",
          "options": {
            "A": "20वां",
            "B": "21वां",
            "C": "22वां",
            "D": "25वां"
          },
          "explanation": "an = a + (n-1)d => 82 = 2 + (n-1)4 => 80 = 4(n-1) => 20 = n-1 => n = 21।"
        }
      }
    },
