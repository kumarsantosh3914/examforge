      "id": "subjet-wise-08-001",
      "number": 1,
      "question": "Formation of curd from milk is which type of change?",
      "options": {
        "A": "भौतिक परिवर्तन",
        "B": "रासायनिक परिवर्तन",
        "C": "दोनों",
        "D": "कोई नहीं"
      },
      "answer": "B",
      "explanation": "It is a chemical change as a new substance is formed and it is irreversible.",
      "hash": "84603acdacb72122",
      "translations": {
        "hi": {
          "question": "दूध से दही बनना (Milk to Curd) कैसा परिवर्तन है?",
          "options": {
            "A": "भौतिक परिवर्तन",
            "B": "रासायनिक परिवर्तन",
            "C": "दोनों",
            "D": "कोई नहीं"
          },
          "explanation": "यह एक रासायनिक परिवर्तन है क्योंकि इसमें नया पदार्थ (लैक्टिक अम्ल) बनता है और इसे पलटा नहीं जा सकता।"
        }
      }
    },
