      "question": "Mid-point of line segment joining A(4, 5) and B(6, 5)?",
      "options": {
        "A": "(5, 5)",
        "B": "(5, 4)",
        "C": "(4, 5)",
        "D": "(10, 10)"
      },
      "answer": "A",
      "explanation": "Formula (x1+x2)/2, (y1+y2)/2 gives (5, 5).",
      "hash": "6d38b6094cc999fb",
      "translations": {
        "hi": {
          "question": "बिंदुओं A(4, 5) और B(6, 5) को मिलाने वाले रेखाखंड का मध्य बिंदु (Mid-point) क्या है?",
          "options": {
            "A": "(5, 5)",
            "B": "(5, 4)",
            "C": "(4, 5)",
            "D": "(10, 10)"
          },
          "explanation": "((4+6)/2, (5+5)/2) = (10/2, 10/2) = (5, 5)।"
        }
      }
