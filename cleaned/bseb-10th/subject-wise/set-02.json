    {
      "id": "subjet-wise-02-003",
      "number": 3,
      "question": "If -2 is a zero of polynomial p(x), what is one factor of p(x)?",
      "options": {
        "A": "x - 2",
        "B": "x + 2",
        "C": "1/x - 2",
        "D": "x"
      },
      "answer": "B",
      "explanation": "If x = a is a zero, (x - a) is a factor. Here (x - (-2)) = x + 2.",
      "hash": "6ce95eb3db1e7f10",
      "translations": {
        "hi": {
          "question": "यदि बहुपद p(x) का एक शून्यक -2 है, तो p(x) का एक गुणनखंड क्या होगा?",
          "options": {
            "A": "x - 2",
            "B": "x + 2",
            "C": "1/x - 2",
            "D": "x"
          },
          "explanation": "यदि x = a शून्यक है, तो (x - a) गुणनखंड होता है। यहाँ (x - (-2)) = x + 2।"
        }
      }
    },
    {
      "id": "subjet-wise-02-004",
      "number": 4,
      "question": "Nature of roots of 2x² - 4x + 3 = 0?",
      "options": {
        "A": "वास्तविक और समान",
        "B": "वास्तविक और असमान",
        "C": "वास्तविक नहीं (काल्पनिक)",
        "D": "इनमें से कोई नहीं"
      },
      "answer": "C",
      "explanation": "D = -8 < 0, so roots are not real.",
      "hash": "21f6f2ee561d3285",
      "translations": {
        "hi": {
          "question": "द्विघात समीकरण 2x² - 4x + 3 = 0 के मूलों की प्रकृति क्या है?",
          "options": {
            "A": "वास्तविक और समान",
            "B": "वास्तविक और असमान",
            "C": "वास्तविक नहीं (काल्पनिक)",
            "D": "इनमें से कोई नहीं"
          },
          "explanation": "D = b² - 4ac = 16 - 4(2)(3) = 16 - 24 = -8। D < 0, अतः मूल वास्तविक नहीं हैं।"
        }
      }
    },
    {
      "id": "subjet-wise-02-005",
      "number": 5,
      "question": "Value of cos 48° - sin 42°?",
      "options": {
        "A": "0",
        "B": "1",
        "C": "2",
        "D": "-1"
      },
      "answer": "A",
      "explanation": "cos 48° = sin 42°, so difference is 0.",
      "hash": "3d4d7c2111d6f6c9",
      "translations": {
        "hi": {
          "question": "cos 48° - sin 42° का मान क्या है?",
          "options": {
            "A": "0",
            "B": "1",
            "C": "2",
            "D": "-1"
          },
          "explanation": "cos 48° = cos(90°-42°) = sin 42°। अतः sin 42° - sin 42° = 0।"
        }
      }
    },
    {
      "id": "subjet-wise-02-006",
      "number": 6,
      "question": "If nth term of AP is (3n + 5), what is its common difference?",
      "options": {
        "A": "3",
        "B": "5",
        "C": "2",
        "D": "8"
      },
      "answer": "A",
      "explanation": "Coefficient of n is the common difference. d = 3.",
      "hash": "3c2cfa0f50e04445",
      "translations": {
        "hi": {
          "question": "यदि AP का nवां पद (3n + 5) है, तो इसका सार्व अंतर क्या है?",
          "options": {
            "A": "3",
            "B": "5",
            "C": "2",
            "D": "8"
          },
          "explanation": "n का गुणांक सार्व अंतर होता है। a1 = 8, a2 = 11, d = 3।"
        }
      }
    },
    {
      "id": "subjet-wise-02-007",
      "number": 7,
      "question": "Ratio of circumferences is 2:3, what is ratio of radii?",
      "options": {
        "A": "4:9",
        "B": "2:3",
        "C": "3:2",
        "D": "8:27"
      },
      "answer": "B",
      "explanation": "Ratio of circumference is equal to ratio of radius.",
      "hash": "497e9b16cd71bfcd",
      "translations": {
        "hi": {
          "question": "दो वृत्तों की परिधियाँ 2:3 के अनुपात में हैं, उनकी त्रिज्याओं का अनुपात क्या होगा?",
          "options": {
            "A": "4:9",
            "B": "2:3",
            "C": "3:2",
            "D": "8:27"
          },
          "explanation": "परिधि का अनुपात = त्रिज्या का अनुपात। (2πr1 / 2πr2 = r1/r2)।"
        }
      }
    },
