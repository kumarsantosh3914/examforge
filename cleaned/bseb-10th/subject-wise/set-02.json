      "id": "subjet-wise-02-001",
      "number": 1,
      "question": "The product of two numbers 'a' and 'b' is equal to?",
      "options": {
        "A": "HCF + LCM",
        "B": "HCF - LCM",
        "C": "HCF × LCM",
        "D": "HCF ÷ LCM"
      },
      "answer": "C",
      "explanation": "Formula: Product of two numbers = HCF × LCM.",
      "hash": "b019d6665506d107",
      "translations": {
        "hi": {
          "question": "दो संख्याओं 'a' और 'b' का गुणनफल किसके बराबर होता है?",
          "options": {
            "A": "HCF + LCM",
            "B": "HCF - LCM",
            "C": "HCF × LCM",
            "D": "HCF ÷ LCM"
          },
          "explanation": "सूत्र: पहली संख्या × दूसरी संख्या = HCF × LCM।"
        }
      }
    },
    {
