      "question": "What is the 30th term of AP: 10, 7, 4...?",
      "options": {
        "A": "75",
        "B": "-77",
        "C": "55",
        "D": "67"
      },
      "answer": "B",
      "explanation": "a30 = 10 + 29(-3) = -77.",
      "hash": "62c7fac1a9acfd37",
      "translations": {
        "hi": {
          "question": "AP: 10, 7, 4... का 30वां पद क्या है?",
          "options": {
            "A": "75",
            "B": "-77",
            "C": "55",
            "D": "67"
          },
          "explanation": "a=10, d=-3. a30 = a + 29d = 10 + 29(-3) = 10 - 87 = -77।"
        }
      }
