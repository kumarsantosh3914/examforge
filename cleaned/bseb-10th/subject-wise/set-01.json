    {
      "id": "subjet-wise-01-015",
      "number": 15,
      "question": "If sin A = 3/4, what is the value of cos A?",
      "options": {
        "A": "4/3",
        "B": "√7/4",
        "C": "3/√7",
        "D": "4/5"
      },
      "answer": "B",
      "explanation": "cos A = √(1 - 9/16) = √7/4.",
      "hash": "05c521c4694a6946",
      "translations": {
        "hi": {
          "question": "यदि sin A = 3/4 है, तो cos A का मान क्या होगा?",
          "options": {
            "A": "4/3",
            "B": "√7/4",
            "C": "3/√7",
            "D": "4/5"
          },
          "explanation": "cos A = √(1 - sin² A) = √(1 - 9/16) = √(7/16) = √7/4।"
        }
      }
    },
    {
      "id": "subjet-wise-01-016",
      "number": 16,
      "question": "What is the distance between points (2, 3) and (4, 1)?",
      "options": {
        "A": "2√2",
        "B": "2",
        "C": "√8",
        "D": "4"
      },
      "answer": "A",
      "explanation": "Distance = √[4+4] = √8 = 2√2.",
      "hash": "81606514805b2832",
      "translations": {
        "hi": {
          "question": "बिंदुओं (2, 3) और (4, 1) के बीच की दूरी क्या है?",
          "options": {
            "A": "2√2",
            "B": "2",
            "C": "√8",
            "D": "4"
          },
          "explanation": "दूरी = √[(4-2)² + (1-3)²] = √[2² + (-2)²] = √(4+4) = √8 = 2√2।"
        }
      }
    },
