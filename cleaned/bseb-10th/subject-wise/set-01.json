    {
      "id": "subjet-wise-01-009",
      "number": 9,
      "question": "What is the discriminant of equation x² - 4x + 4 = 0?",
      "options": {
        "A": "16",
        "B": "0",
        "C": "4",
        "D": "-8"
      },
      "answer": "B",
      "explanation": "D = b² - 4ac = 16 - 16 = 0.",
      "hash": "4152fb337f6d3a90",
      "translations": {
        "hi": {
          "question": "समीकरण x² - 4x + 4 = 0 का विविक्तकर (Discriminant) क्या है?",
          "options": {
            "A": "16",
            "B": "0",
            "C": "4",
            "D": "-8"
          },
          "explanation": "D = b² - 4ac = (-4)² - 4(1)(4) = 16 - 16 = 0।"
        }
      }
    },
    {
