            "B": "x² - 4x + 4 = 0",
            "C": "x² - 4x - 4 = 0",
            "D": "x² + 4x - 4 = 0"
          },
          "explanation": "x² - (योग)x + (गुणनफल) = 0 => x² - 4x + 4 = 0।"
        }
      }
    },
