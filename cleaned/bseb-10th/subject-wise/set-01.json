      "question": "What is the Common Difference of AP: 2, 7, 12, 17...?",
      "options": {
        "A": "5",
        "B": "-5",
        "C": "2",
        "D": "7"
      },
      "answer": "A",
      "explanation": "d = 7 - 2 = 5.",
      "hash": "8886f2359452c934",
      "translations": {
        "hi": {
          "question": "AP: 2, 7, 12, 17, ... का सार्व अंतर (Common Difference) क्या है?",
          "options": {
            "A": "5",
            "B": "-5",
            "C": "2",
            "D": "7"
          },
          "explanation": "d = a2 - a1 = 7 - 2 = 5।"
        }
      }
