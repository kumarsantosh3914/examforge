      "translations": {
        "hi": {
          "question": "कुस्तुनतुनिया की संधि (Treaty of Constantinople) 1832 ने किस देश को स्वतंत्र राष्ट्र के रूप में मान्यता दी?",
          "options": {
            "A": "जर्मनी",
            "B": "इटली",
