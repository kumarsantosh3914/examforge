    {
      "id": "math-11-009",
      "number": 9,
      "question": "If mean of x, 3, 4, 5 is 4, then x is?",
      "options": {
        "A": "4",
        "B": "3",
        "C": "5",
        "D": "2"
      },
      "answer": "A",
      "explanation": "Sum is 16, so x = 4.",
      "hash": "9a1400f3dfad9a92",
      "translations": {
        "hi": {
          "question": "यदि x, 3, 4, 5 का माध्य 4 है, तो x का मान क्या है?",
          "options": {
            "A": "4",
            "B": "3",
            "C": "5",
            "D": "2"
          },
          "explanation": "(x+3+4+5)/4 = 4 => x+12 = 16 => x = 4।"
        }
      }
    },
