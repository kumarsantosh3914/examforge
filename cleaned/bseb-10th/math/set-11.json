    {
      "id": "math-11-001",
      "number": 1,
      "question": "The value appearing most frequently in data is called?",
      "options": {
        "A": "माध्य",
        "B": "माध्यिका",
        "C": "बहुलक (Mode)",
        "D": "परिसर"
      },
      "answer": "C",
      "explanation": "The observation with the highest frequency is the Mode.",
      "hash": "41da0d870357660f",
      "translations": {
        "hi": {
          "question": "आंकड़ों में सबसे अधिक बार आने वाला मान क्या कहलाता है?",
          "options": {
            "A": "माध्य",
            "B": "माध्यिका",
            "C": "बहुलक (Mode)",
            "D": "परिसर"
          },
          "explanation": "जिस प्रेक्षण की बारंबारता सबसे अधिक होती है, वह बहुलक कहलाता है।"
        }
      }
    },
    {
      "id": "math-11-002",
      "number": 2,
      "question": "What is the mean of the first 5 natural numbers?",
      "options": {
        "A": "2",
        "B": "3",
        "C": "4",
        "D": "5"
      },
      "answer": "B",
      "explanation": "Sum of numbers (15) divided by count (5) is 3.",
      "hash": "263a1fab3c4b57e6",
      "translations": {
        "hi": {
          "question": "प्रथम 5 प्राकृत संख्याओं का माध्य (Mean) क्या है?",
          "options": {
            "A": "2",
            "B": "3",
            "C": "4",
            "D": "5"
          },
          "explanation": "(1+2+3+4+5)/5 = 15/5 = 3।"
        }
      }
    },
    {
      "id": "math-11-003",
      "number": 3,
      "question": "Relationship between Mean, Median, and Mode?",
      "options": {
        "A": "बहुलक = 3(माध्यिका) - 2(माध्य)",
        "B": "बहुलक = 2(माध्यिका) - 3(माध्य)",
        "C": "माध्य = 3(बहुलक) - 2(माध्यिका)",
        "D": "कोई नहीं"
      },
      "answer": "A",
      "explanation": "Empirical formula: Mode = 3(Median) - 2(Mean).",
      "hash": "2aebe3f72b7dc23c",
      "translations": {
        "hi": {
          "question": "माध्य, माध्यिका और बहुलक के बीच क्या संबंध है?",
          "options": {
            "A": "बहुलक = 3(माध्यिका) - 2(माध्य)",
            "B": "बहुलक = 2(माध्यिका) - 3(माध्य)",
            "C": "माध्य = 3(बहुलक) - 2(माध्यिका)",
            "D": "कोई नहीं"
          },
          "explanation": "आनुभविक सूत्र: बहुलक = 3(माध्यिका) - 2(माध्य)।"
        }
      }
    },
    {
      "id": "math-11-004",
      "number": 4,
      "question": "Formula to find Class Mark?",
      "options": {
        "A": "(उच्च सीमा - निम्न सीमा)/2",
        "B": "(उच्च सीमा + निम्न सीमा)/2",
        "C": "उच्च सीमा - निम्न सीमा",
        "D": "उच्च सीमा + निम्न सीमा"
      },
      "answer": "B",
      "explanation": "Class Mark = (Upper Limit + Lower Limit) / 2.",
      "hash": "9ba1fc8a68248703",
      "translations": {
        "hi": {
          "question": "वर्ग चिन्ह (Class Mark) ज्ञात करने का सूत्र क्या है?",
          "options": {
            "A": "(उच्च सीमा - निम्न सीमा)/2",
            "B": "(उच्च सीमा + निम्न सीमा)/2",
            "C": "उच्च सीमा - निम्न सीमा",
            "D": "उच्च सीमा + निम्न सीमा"
          },
          "explanation": "वर्ग चिन्ह = (ऊपरी सीमा + निचली सीमा) / 2।"
        }
      }
    },
