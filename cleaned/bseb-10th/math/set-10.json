      "number": 30,
      "question": "Cone h=4, r=3. Slant height l?",
      "options": {
        "A": "5 सेमी",
        "B": "7 सेमी",
        "C": "25 सेमी",
        "D": "1 सेमी"
      },
      "answer": "A",
      "explanation": "5 cm.",
      "hash": "52c06960d6ef7033",
      "translations": {
        "hi": {
          "question": "एक शंकु की ऊँचाई 4 सेमी और त्रिज्या 3 सेमी है। इसकी तिर्यक ऊँचाई (l) क्या है?",
          "options": {
            "A": "5 सेमी",
            "B": "7 सेमी",
            "C": "25 सेमी",
            "D": "1 सेमी"
          },
          "explanation": "l = √(3² + 4²) = √(9 + 16) = √25 = 5।"
        }
      }
    }
