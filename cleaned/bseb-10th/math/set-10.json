    {
      "id": "math-10-009",
      "number": 9,
      "question": "Surface Area of a cube with side 6 cm?",
      "options": {
        "A": "36",
        "B": "216",
        "C": "144",
        "D": "24"
      },
      "answer": "B",
      "explanation": "6a² = 216.",
      "hash": "f5b4f949a7c3d454",
      "translations": {
        "hi": {
          "question": "6 सेमी भुजा वाले घन का पृष्ठीय क्षेत्रफल क्या होगा?",
          "options": {
            "A": "36",
            "B": "216",
            "C": "144",
            "D": "24"
          },
          "explanation": "6a² = 6 × (6)² = 6 × 36 = 216 सेमी²।"
        }
      }
    },
