    {
      "id": "math-10-001",
      "number": 1,
      "question": "Formula for Volume of a Cube with side 'a'?",
      "options": {
        "A": "a²",
        "B": "a³",
        "C": "6a²",
        "D": "4a²"
      },
      "answer": "B",
      "explanation": "Volume = side³ = a³.",
      "hash": "a13bc8628041cdad",
      "translations": {
        "hi": {
          "question": "एक घन (Cube) का आयतन ज्ञात करने का सूत्र क्या है जिसकी भुजा 'a' है?",
          "options": {
            "A": "a²",
            "B": "a³",
            "C": "6a²",
            "D": "4a²"
          },
          "explanation": "घन का आयतन = भुजा × भुजा × भुजा = a³।"
        }
      }
    },
    {
      "id": "math-10-002",
      "number": 2,
      "question": "Curved Surface Area of a Cylinder with radius r and height h?",
      "options": {
        "A": "2πrh",
        "B": "πr²h",
        "C": "2πr(r+h)",
        "D": "πrh"
      },
      "answer": "A",
      "explanation": "CSA = 2πrh.",
      "hash": "ffff5cf7498f1f01",
      "translations": {
        "hi": {
          "question": "r त्रिज्या और h ऊंचाई वाले बेलन (Cylinder) का वक्र पृष्ठीय क्षेत्रफल क्या होता है?",
          "options": {
            "A": "2πrh",
            "B": "πr²h",
            "C": "2πr(r+h)",
            "D": "πrh"
          },
          "explanation": "बेलन का वक्र पृष्ठ = 2πrh।"
        }
      }
    },
    {
      "id": "math-10-003",
      "number": 3,
      "question": "Volume of a Sphere?",
      "options": {
        "A": "4/3 πr³",
        "B": "2/3 πr³",
        "C": "4πr²",
        "D": "3πr³"
      },
      "answer": "A",
      "explanation": "Volume = 4/3 πr³.",
      "hash": "dc8028a99e89cc79",
      "translations": {
        "hi": {
          "question": "एक गोले (Sphere) का आयतन क्या होता है?",
          "options": {
            "A": "4/3 πr³",
            "B": "2/3 πr³",
            "C": "4πr²",
            "D": "3πr³"
          },
          "explanation": "गोले का आयतन = 4/3 πr³।"
        }
      }
    },
    {
      "id": "math-10-004",
      "number": 4,
      "question": "Formula for Slant Height 'l' of a Cone?",
      "options": {
        "A": "√(h² - r²)",
        "B": "√(r² + h²)",
        "C": "r + h",
        "D": "rh"
      },
      "answer": "B",
      "explanation": "l = √(r² + h²).",
      "hash": "db5d21ed366cfd2a",
      "translations": {
        "hi": {
          "question": "शंकु (Cone) की तिर्यक ऊंचाई (Slant Height) 'l' का सूत्र क्या है?",
          "options": {
            "A": "√(h² - r²)",
            "B": "√(r² + h²)",
            "C": "r + h",
            "D": "rh"
          },
          "explanation": "पाइथागोरस प्रमेय से: l = √(r² + h²)।"
        }
      }
    },
    {
      "id": "math-10-005",
      "number": 5,
      "question": "Ratio of volumes of Cylinder and Cone with same r and h?",
      "options": {
        "A": "1:3",
        "B": "3:1",
        "C": "1:1",
        "D": "1:2"
      },
      "answer": "B",
      "explanation": "Cylinder is 3 times the volume of the cone.",
      "hash": "9442ba0a54d39744",
      "translations": {
        "hi": {
          "question": "एक बेलन और एक शंकु की त्रिज्या और ऊंचाई समान हैं। उनके आयतनों का अनुपात क्या होगा?",
          "options": {
            "A": "1:3",
            "B": "3:1",
            "C": "1:1",
            "D": "1:2"
          },
          "explanation": "बेलन (πr²h) : शंकु (1/3 πr²h) = 3:1।"
        }
      }
    },
    {
      "id": "math-10-006",
