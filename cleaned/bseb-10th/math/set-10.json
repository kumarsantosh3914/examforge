          "options": {
            "A": "2πr²",
            "B": "3πr²",
            "C": "4πr²",
            "D": "πr²"
          },
          "explanation": "वक्र पृष्ठ (2πr²) + आधार का क्षेत्रफल (πr²) = 3πr²।"
        }
      }
    },
