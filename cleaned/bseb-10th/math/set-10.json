    {
      "id": "math-10-023",
      "number": 23,
      "question": "Spheres of radii 6, 8, 10 melted to form a single sphere. Radius?",
      "options": {
        "A": "12 सेमी",
        "B": "24 सेमी",
        "C": "14 सेमी",
        "D": "18 सेमी"
      },
      "answer": "A",
      "explanation": "12 cm.",
      "hash": "862217839fb7e089",
      "translations": {
        "hi": {
          "question": "6 सेमी, 8 सेमी और 10 सेमी त्रिज्या वाले तीन धातु के गोलों को पिघलाकर एक बड़ा गोला बनाया जाता है। बड़े गोले की त्रिज्या?",
          "options": {
            "A": "12 सेमी",
            "B": "24 सेमी",
            "C": "14 सेमी",
            "D": "18 सेमी"
          },
          "explanation": "R³ = 6³ + 8³ + 10³ = 216 + 512 + 1000 = 1728। R = 12।"
        }
      }
    },
