    {
      "id": "math-05-007",
      "number": 7,
      "question": "Which term of AP: 3, 8, 13, 18... is 78?",
      "options": {
        "A": "12वां",
        "B": "15वां",
        "C": "16वां",
        "D": "18वां"
      },
      "answer": "C",
      "explanation": "78 = 3 + (n-1)5 => n = 16.",
      "hash": "c3a5303832651f00",
      "translations": {
        "hi": {
          "question": "AP: 3, 8, 13, 18... का कौन सा पद 78 है?",
          "options": {
            "A": "12वां",
            "B": "15वां",
            "C": "16वां",
            "D": "18वां"
          },
          "explanation": "78 = 3 + (n-1)5 => 75 = 5(n-1) => 15 = n-1 => n = 16।"
        }
      }
    },
