    {
      "id": "math-05-010",
      "number": 10,
      "question": "If common difference is 5, value of a18 - a13?",
      "options": {
        "A": "5",
        "B": "20",
        "C": "25",
        "D": "30"
      },
      "answer": "C",
      "explanation": "Difference is 5d = 25.",
      "hash": "c26d6ecd7b4439d5",
      "translations": {
        "hi": {
          "question": "यदि किसी AP का सार्व अंतर 5 है, तो a18 - a13 का मान क्या है?",
          "options": {
            "A": "5",
            "B": "20",
            "C": "25",
            "D": "30"
          },
          "explanation": "a18 - a13 = (a+17d) - (a+12d) = 5d = 5(5) = 25।"
        }
      }
    },
