    {
      "id": "math-05-001",
      "number": 1,
      "question": "Which of the following is an AP?",
      "options": {
        "A": "2, 4, 8, 16",
        "B": "1, 3, 9, 27",
        "C": "-10, -6, -2, 2",
        "D": "1, 2, 4, 5"
      },
      "answer": "C",
      "explanation": "Common difference is constant (4).",
      "hash": "e89ac02c184daae2",
      "translations": {
        "hi": {
          "question": "निम्नलिखित में से कौन समांतर श्रेणी (AP) है?",
          "options": {
            "A": "2, 4, 8, 16",
            "B": "1, 3, 9, 27",
            "C": "-10, -6, -2, 2",
            "D": "1, 2, 4, 5"
          },
          "explanation": "-10, -6, -2, 2 में सार्व अंतर समान (4) है।"
        }
      }
    },
    {
      "id": "math-05-002",
      "number": 2,
      "question": "What is the 10th term of AP: 2, 7, 12...?",
      "options": {
        "A": "45",
        "B": "47",
        "C": "50",
        "D": "52"
      },
      "answer": "B",
      "explanation": "a10 = 2 + 45 = 47.",
      "hash": "9e91c5abeba48cc1",
      "translations": {
        "hi": {
          "question": "AP: 2, 7, 12... का 10वां पद क्या है?",
          "options": {
            "A": "45",
            "B": "47",
            "C": "50",
            "D": "52"
          },
          "explanation": "a=2, d=5. a10 = a + 9d = 2 + 9(5) = 2 + 45 = 47।"
        }
      }
    },
    {
      "id": "math-05-003",
      "number": 3,
      "question": "What is the formula for the nth term of an AP?",
      "options": {
        "A": "an = a + nd",
        "B": "an = a + (n-1)d",
        "C": "an = a + (n+1)d",
        "D": "an = 2a + (n-1)d"
      },
      "answer": "B",
      "explanation": "General term: an = a + (n-1)d.",
      "hash": "8175da9aaa5f60e5",
      "translations": {
        "hi": {
          "question": "AP के nवें पद का सूत्र क्या है?",
          "options": {
            "A": "an = a + nd",
            "B": "an = a + (n-1)d",
            "C": "an = a + (n+1)d",
            "D": "an = 2a + (n-1)d"
          },
          "explanation": "व्यापक पद: an = a + (n-1)d।"
        }
      }
    },
