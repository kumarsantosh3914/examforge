      "id": "math-05-013",
      "number": 13,
      "question": "How many multiples of 4 lie between 10 and 250?",
      "options": {
        "A": "50",
        "B": "60",
        "C": "59",
        "D": "61"
      },
      "answer": "B",
      "explanation": "n = 60.",
      "hash": "1131d566dfc5b503",
      "translations": {
        "hi": {
          "question": "10 और 250 के बीच 4 के कितने गुणज (Multiples) हैं?",
          "options": {
            "A": "50",
            "B": "60",
            "C": "59",
            "D": "61"
          },
          "explanation": "AP: 12, 16... 248। an = a + (n-1)d => 248 = 12 + (n-1)4 => 236/4 = n-1 => 59 = n-1 => n = 60।"
        }
      }
