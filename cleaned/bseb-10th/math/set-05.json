    {
      "id": "math-05-016",
      "number": 16,
      "question": "If Sn = 3n² + n, what is the second term (a2)?",
      "options": {
        "A": "7",
        "B": "14",
        "C": "10",
        "D": "4"
      },
      "answer": "C",
      "explanation": "a2 = S2 - S1 = 10.",
      "hash": "a08fcbaf01f6513c",
      "translations": {
        "hi": {
          "question": "AP का n पदों का योग Sn = 3n² + n है, तो दूसरा पद (a2) क्या होगा?",
          "options": {
            "A": "7",
            "B": "14",
            "C": "10",
            "D": "4"
          },
          "explanation": "S1 = 3(1)+1 = 4 (a1)। S2 = 3(4)+2 = 14। a2 = S2 - S1 = 14 - 4 = 10।"
        }
      }
    },
    {
      "id": "math-05-017",
      "number": 17,
      "question": "Three numbers in AP sum to 24. Middle number?",
      "options": {
        "A": "6",
        "B": "8",
        "C": "10",
        "D": "12"
      },
      "answer": "B",
      "explanation": "3a = 24 => a = 8.",
      "hash": "ffc72ea2fd1cb6c3",
      "translations": {
        "hi": {
          "question": "तीन संख्याएं AP में हैं और उनका योग 24 है। बीच वाली संख्या क्या है?",
          "options": {
            "A": "6",
            "B": "8",
            "C": "10",
            "D": "12"
          },
          "explanation": "(a-d) + a + (a+d) = 24 => 3a = 24 => a = 8।"
        }
      }
    },
