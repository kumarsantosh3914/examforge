      "question": "If 15 cot A = 8, value of sin A?",
      "options": {
        "A": "15/17",
        "B": "17/15",
        "C": "8/17",
        "D": "17/8"
      },
      "answer": "A",
      "explanation": "P=15, B=8, H=17. sin A = 15/17.",
      "hash": "dce196e3bfff7124",
      "translations": {
        "hi": {
          "question": "यदि 15 cot A = 8 है, तो sin A का मान क्या है?",
          "options": {
            "A": "15/17",
            "B": "17/15",
            "C": "8/17",
            "D": "17/8"
          },
          "explanation": "cot A = 8/15 (B/P)। H = √(8²+15²) = 17। sin A = P/H = 15/17।"
        }
      }
    },
