    {
      "id": "math-06-003",
      "number": 3,
      "question": "What is the value of 1 - sin² θ?",
      "options": {
        "A": "cos² θ",
        "B": "tan² θ",
        "C": "sec² θ",
        "D": "cot² θ"
      },
      "answer": "A",
      "explanation": "From identity sin² θ + cos² θ = 1.",
      "hash": "f12bcd6b6fd8da0c",
      "translations": {
        "hi": {
          "question": "1 - sin² θ का मान किसके बराबर है?",
          "options": {
            "A": "cos² θ",
            "B": "tan² θ",
            "C": "sec² θ",
            "D": "cot² θ"
          },
          "explanation": "sin² θ + cos² θ = 1, इसलिए 1 - sin² θ = cos² θ।"
        }
      }
    },
    {
      "id": "math-06-004",
      "number": 4,
      "question": "If sin A = 3/5, what is cos A?",
      "options": {
        "A": "4/5",
        "B": "5/4",
        "C": "3/4",
        "D": "5/3"
      },
      "answer": "A",
      "explanation": "Using Pythagoras triplet (3, 4, 5), Base=4. cos A = 4/5.",
      "hash": "53917fc3578a58a9",
      "translations": {
        "hi": {
          "question": "यदि sin A = 3/5 है, तो cos A का मान क्या होगा?",
          "options": {
            "A": "4/5",
            "B": "5/4",
            "C": "3/4",
            "D": "5/3"
          },
          "explanation": "पाइथागोरस त्रिक (3, 4, 5) से, यदि लंब=3, कर्ण=5, तो आधार=4। cos A = आधार/कर्ण = 4/5।"
        }
      }
    },
