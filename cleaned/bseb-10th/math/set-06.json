      "id": "math-06-001",
      "number": 1,
      "question": "In a right triangle, what is sin θ equal to?",
      "options": {
        "A": "लंब/कर्ण (P/H)",
        "B": "आधार/कर्ण (B/H)",
        "C": "लंब/आधार (P/B)",
        "D": "कर्ण/लंब (H/P)"
      },
      "answer": "A",
      "explanation": "sin θ = Perpendicular / Hypotenuse.",
      "hash": "e9f3016474e4b819",
      "translations": {
        "hi": {
          "question": "समकोण त्रिभुज में sin θ किसके बराबर होता है?",
          "options": {
            "A": "लंब/कर्ण (P/H)",
            "B": "आधार/कर्ण (B/H)",
            "C": "लंब/आधार (P/B)",
            "D": "कर्ण/लंब (H/P)"
          },
          "explanation": "sin θ = लंब / कर्ण (Perpendicular / Hypotenuse)।"
        }
      }
    },
