      "hash": "81544c56360d9943",
      "translations": {
        "hi": {
          "question": "एक ट्रेन 360 किमी की दूरी एकसमान चाल से तय करती है। यदि चाल 5 किमी/घंटा अधिक होती तो 1 घंटा कम लगता। समीकरण?",
          "options": {
            "A": "360/x - 360/(x+5) = 1",
            "B": "360/(x+5) - 360/x = 1",
            "C": "360/x + 360/(x+5) = 1",
            "D": "x/360 = 1"
          },
          "explanation": "समय का अंतर = 1। (धीमी चाल का समय - तेज चाल का समय = 1)।"
