    {
      "id": "math-04-003",
      "number": 3,
      "question": "Roots of 2x² - 5x + 3 = 0?",
      "options": {
        "A": "1, 3/2",
        "B": "-1, -3/2",
        "C": "1, -3/2",
        "D": "-1, 3/2"
      },
      "answer": "A",
      "explanation": "Factors gives x = 1, 3/2.",
      "hash": "c3504c1df892f2e8",
      "translations": {
        "hi": {
          "question": "द्विघात समीकरण 2x² - 5x + 3 = 0 के मूल क्या हैं?",
          "options": {
            "A": "1, 3/2",
            "B": "-1, -3/2",
            "C": "1, -3/2",
            "D": "-1, 3/2"
          },
          "explanation": "गुणनखंड: 2x² - 2x - 3x + 3 = 0 => 2x(x-1) - 3(x-1) = 0 => x = 1, 3/2।"
        }
      }
    },
