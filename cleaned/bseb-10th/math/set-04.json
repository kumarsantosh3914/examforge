      "id": "math-04-001",
      "number": 1,
      "question": "Value of Discriminant of x² - 4x + 4 = 0?",
      "options": {
        "A": "4",
        "B": "0",
        "C": "16",
        "D": "-4"
      },
      "answer": "B",
      "explanation": "D = 16 - 16 = 0.",
      "hash": "d5be685f09906a1d",
      "translations": {
        "hi": {
          "question": "समीकरण x² - 4x + 4 = 0 के विविक्तकर (Discriminant) का मान क्या है?",
          "options": {
            "A": "4",
            "B": "0",
            "C": "16",
            "D": "-4"
          },
          "explanation": "D = b² - 4ac = (-4)² - 4(1)(4) = 16 - 16 = 0।"
        }
      }
    },
    {
      "id": "math-04-002",
      "number": 2,
      "question": "What is the standard form of a Quadratic Equation?",
      "options": {
        "A": "ax + b = 0",
        "B": "ax² + bx + c = 0",
        "C": "ax³ + bx² + c = 0",
        "D": "ax² + b = 0"
      },
      "answer": "B",
      "explanation": "Standard form is ax² + bx + c = 0, where a ≠ 0.",
      "hash": "11d7c9351f5758d5",
      "translations": {
        "hi": {
          "question": "द्विघात समीकरण का मानक रूप (Standard Form) क्या है?",
          "options": {
            "A": "ax + b = 0",
            "B": "ax² + bx + c = 0",
            "C": "ax³ + bx² + c = 0",
            "D": "ax² + b = 0"
          },
          "explanation": "मानक रूप ax² + bx + c = 0 होता है, जहाँ a ≠ 0।"
        }
      }
