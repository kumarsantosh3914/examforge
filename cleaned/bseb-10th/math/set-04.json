    {
      "id": "math-04-006",
      "number": 6,
      "question": "If roots of x² - kx + 4 = 0 are equal, find k.",
      "options": {
        "A": "±2",
        "B": "±4",
        "C": "±8",
        "D": "16"
      },
      "answer": "B",
      "explanation": "k² - 16 = 0 => k = ±4.",
      "hash": "8eff9e9561e5f289",
      "translations": {
        "hi": {
          "question": "यदि x² - kx + 4 = 0 के मूल समान हों, तो k का मान क्या है?",
          "options": {
            "A": "±2",
            "B": "±4",
            "C": "±8",
            "D": "16"
          },
          "explanation": "b² - 4ac = 0 => (-k)² - 4(1)(4) = 0 => k² = 16 => k = ±4।"
        }
      }
    },
