    {
      "id": "math-04-028",
      "number": 28,
      "question": "For what value of p does px(x-2) + 6 = 0 have equal roots?",
      "options": {
        "A": "0",
        "B": "6",
        "C": "0, 6",
        "D": "-6"
      },
      "answer": "B",
      "explanation": "4p² - 24p = 0 => p=6 (p≠0).",
      "hash": "2448a3733ef08771",
      "translations": {
        "hi": {
          "question": "p के किस मान के लिए समीकरण px(x-2) + 6 = 0 के मूल बराबर हैं?",
          "options": {
            "A": "0",
            "B": "6",
            "C": "0, 6",
            "D": "-6"
          },
          "explanation": "px² - 2px + 6 = 0। D = (-2p)² - 4(p)(6) = 0 => 4p² - 24p = 0 => 4p(p-6)=0। p=0 असंभव (द्विघात नहीं रहेगा), अतः p=6।"
        }
      }
    },
