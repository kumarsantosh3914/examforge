    {
      "id": "math-12-010",
      "number": 10,
      "question": "If P(E) = 0.05, probability of 'not E'?",
      "options": {
        "A": "0.95",
        "B": "0.05",
        "C": "1.05",
        "D": "0.5"
      },
      "answer": "A",
      "explanation": "1 - 0.05 = 0.95.",
      "hash": "7b978c73eb6da436",
      "translations": {
        "hi": {
          "question": "यदि P(E) = 0.05 है, तो 'E नहीं' (not E) की प्रायिकता क्या है?",
          "options": {
            "A": "0.95",
            "B": "0.05",
            "C": "1.05",
            "D": "0.5"
          },
          "explanation": "P(not E) = 1 - P(E) = 1 - 0.05 = 0.95।"
        }
      }
    },
