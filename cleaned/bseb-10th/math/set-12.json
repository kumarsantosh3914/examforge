      "id": "math-12-001",
      "number": 1,
      "question": "Value of P(E) + P(not E)?",
      "options": {
        "A": "0",
        "B": "1",
        "C": "-1",
        "D": "2"
      },
      "answer": "B",
      "explanation": "Sum of probabilities of happening and not happening is 1.",
      "hash": "223b4de34c7b1676",
      "translations": {
        "hi": {
          "question": "किसी घटना E की प्रायिकता P(E) + P(E नहीं) का मान क्या होता है?",
          "options": {
            "A": "0",
            "B": "1",
            "C": "-1",
            "D": "2"
          },
          "explanation": "किसी घटना के घटित होने और न घटित होने की प्रायिकता का योग हमेशा 1 होता है।"
        }
      }
    },
