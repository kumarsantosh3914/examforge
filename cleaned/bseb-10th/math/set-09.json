    {
      "id": "math-09-017",
      "number": 17,
      "question": "Diameter 40cm. Revolutions to cover 176m?",
      "options": {
        "A": "140",
        "B": "150",
        "C": "1400",
        "D": "160"
      },
      "answer": "A",
      "explanation": "Distance / Circumference = 140.",
      "hash": "f87b60e881b6f5ea",
      "translations": {
        "hi": {
          "question": "एक पहिए का व्यास 40 सेमी है। 176 मीटर की दूरी तय करने में इसे कितने चक्कर लगाने होंगे?",
          "options": {
            "A": "140",
            "B": "150",
            "C": "1400",
            "D": "160"
          },
          "explanation": "परिधि = 40π = 880/7 सेमी। दूरी = 17600 सेमी। चक्कर = 17600 / (880/7) = 140।"
        }
      }
    },
