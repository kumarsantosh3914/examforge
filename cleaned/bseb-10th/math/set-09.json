    {
      "id": "math-09-004",
      "number": 4,
      "question": "Area of a circle is 154 cm². Its radius is?",
      "options": {
        "A": "14 सेमी",
        "B": "7 सेमी",
        "C": "21 सेमी",
        "D": "7.5 सेमी"
      },
      "answer": "B",
      "explanation": "Solving πr² = 154 gives r = 7.",
      "hash": "99d95b0c8a9ae133",
      "translations": {
        "hi": {
          "question": "एक वृत्त का क्षेत्रफल 154 सेमी² है। इसकी त्रिज्या क्या होगी?",
          "options": {
            "A": "14 सेमी",
            "B": "7 सेमी",
            "C": "21 सेमी",
            "D": "7.5 सेमी"
          },
          "explanation": "πr² = 154 => (22/7)r² = 154 => r² = 49 => r = 7।"
        }
      }
    },
    {
