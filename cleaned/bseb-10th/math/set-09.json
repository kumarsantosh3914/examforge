      "id": "math-09-001",
      "number": 1,
      "question": "Formula for area of a circle with radius r?",
      "options": {
        "A": "2πr",
        "B": "πr²",
        "C": "2πr²",
        "D": "πr"
      },
      "answer": "B",
      "explanation": "Area = πr².",
      "hash": "4be2b2ae01fedb01",
      "translations": {
        "hi": {
          "question": "r त्रिज्या वाले वृत्त के क्षेत्रफल का सूत्र क्या है?",
          "options": {
            "A": "2πr",
            "B": "πr²",
            "C": "2πr²",
            "D": "πr"
          },
          "explanation": "वृत्त का क्षेत्रफल = πr²।"
        }
      }
    },
    {
      "id": "math-09-002",
      "number": 2,
      "question": "Formula for length of arc of a sector of angle θ?",
      "options": {
        "A": "(θ/360) × πr²",
        "B": "(θ/360) × 2πr",
        "C": "(θ/180) × 2πr",
        "D": "2πr"
      },
      "answer": "B",
      "explanation": "Length of arc = (θ/360) × 2πr.",
      "hash": "8487fcf20f76ed0b",
      "translations": {
        "hi": {
          "question": "कोण θ वाले त्रिज्यखंड के चाप की लंबाई (Length of Arc) का सूत्र क्या है?",
          "options": {
            "A": "(θ/360) × πr²",
            "B": "(θ/360) × 2πr",
            "C": "(θ/180) × 2πr",
            "D": "2πr"
          },
          "explanation": "चाप की लंबाई = (θ/360) × 2πr = (θ/180) × πr।"
        }
      }
    },
    {
