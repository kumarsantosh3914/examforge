    {
      "id": "math-09-013",
      "number": 13,
      "question": "Area of a ring with outer radius R and inner radius r?",
      "options": {
        "A": "π(R² - r²)",
        "B": "π(R - r)²",
        "C": "π(R² + r²)",
        "D": "2π(R - r)"
      },
      "answer": "A",
      "explanation": "π(R² - r²).",
      "hash": "c309006fcca8f32c",
      "translations": {
        "hi": {
          "question": "वलय (Ring) का क्षेत्रफल क्या है यदि बाहरी त्रिज्या R और भीतरी त्रिज्या r है?",
          "options": {
            "A": "π(R² - r²)",
            "B": "π(R - r)²",
            "C": "π(R² + r²)",
            "D": "2π(R - r)"
          },
          "explanation": "बाहरी क्षेत्रफल - भीतरी क्षेत्रफल = πR² - πr² = π(R² - r²)।"
        }
      }
    },
    {
      "id": "math-09-014",
      "number": 14,
      "question": "If perimeter of circle and square are equal, ratio of their areas?",
      "options": {
        "A": "22:7",
        "B": "14:11",
        "C": "7:22",
        "D": "11:14"
      },
      "answer": "B",
      "explanation": "14:11.",
      "hash": "8e04b0fede196ef9",
      "translations": {
        "hi": {
          "question": "यदि एक वृत्त का परिमाप और एक वर्ग का परिमाप बराबर है, तो उनके क्षेत्रफलों का अनुपात क्या है?",
          "options": {
            "A": "22:7",
            "B": "14:11",
            "C": "7:22",
            "D": "11:14"
          },
          "explanation": "2πr = 4a => a = (πr)/2। क्षेत्रफल अनुपात πr² : a² = 14:11।"
        }
      }
    },
    {
      "id": "math-09-015",
      "number": 15,
      "question": "Perimeter of semicircle with r = 7 cm?",
      "options": {
        "A": "22 सेमी",
        "B": "36 सेमी",
        "C": "44 सेमी",
        "D": "58 सेमी"
      },
      "answer": "B",
      "explanation": "22 + 14 = 36 cm.",
      "hash": "6dc8f405e4b11b40",
      "translations": {
        "hi": {
          "question": "7 सेमी त्रिज्या वाले अर्धवृत्त का कुल परिमाप क्या है?",
          "options": {
            "A": "22 सेमी",
            "B": "36 सेमी",
            "C": "44 सेमी",
            "D": "58 सेमी"
          },
          "explanation": "πr + 2r = (22/7 × 7) + 2(7) = 22 + 14 = 36 सेमी।"
        }
      }
    },
