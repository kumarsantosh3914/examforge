      "id": "math-09-026",
      "number": 26,
      "question": "Wheel covers 88km in 1000 revolutions. Diameter?",
      "options": {
        "A": "14 मी",
        "B": "24 मी",
        "C": "28 मी",
        "D": "40 मी"
      },
      "answer": "C",
      "explanation": "28 m.",
      "hash": "8a41afcfe01ccf36",
      "translations": {
        "hi": {
          "question": "एक पहिया 1000 चक्कर में 88 किमी की दूरी तय करता है। पहिए का व्यास है?",
          "options": {
            "A": "14 मी",
            "B": "24 मी",
            "C": "28 मी",
            "D": "40 मी"
          },
          "explanation": "1 चक्कर = 88000/1000 = 88 मी। πd = 88 => 22/7 × d = 88 => d = 28।"
        }
      }
    },
