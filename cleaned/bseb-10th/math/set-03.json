    {
      "id": "math-03-001",
      "number": 1,
      "question": "Pair of linear equations has a unique solution if:",
      "options": {
        "A": "a₁/a₂ = b₁/b₂",
        "B": "a₁/a₂ ≠ b₁/b₂",
        "C": "a₁/a₂ = b₁/b₂ ≠ c₁/c₂",
        "D": "a₁/a₂ = b₁/b₂ = c₁/c₂"
      },
      "answer": "B",
      "explanation": "Condition for unique solution is a₁/a₂ ≠ b₁/b₂.",
      "hash": "46f550a18c82b96a",
      "translations": {
        "hi": {
          "question": "रैखिक समीकरण युग्म a₁x + b₁y + c₁ = 0 और a₂x + b₂y + c₂ = 0 का एक अद्वितीय हल (Unique Solution) होगा, यदि:",
          "options": {
            "A": "a₁/a₂ = b₁/b₂",
            "B": "a₁/a₂ ≠ b₁/b₂",
            "C": "a₁/a₂ = b₁/b₂ ≠ c₁/c₂",
            "D": "a₁/a₂ = b₁/b₂ = c₁/c₂"
          },
          "explanation": "अद्वितीय हल (प्रतिच्छेदी रेखाएं) की शर्त a₁/a₂ ≠ b₁/b₂ है।"
        }
      }
    },
    {
      "id": "math-03-002",
      "number": 2,
      "question": "If lines are parallel, how many solutions does the pair of equations have?",
      "options": {
        "A": "एक",
        "B": "दो",
        "C": "अनंत",
        "D": "कोई हल नहीं"
      },
      "answer": "D",
      "explanation": "Parallel lines never meet, so 'No Solution'.",
      "hash": "70f7b42f66ae56ad",
      "translations": {
        "hi": {
          "question": "यदि रेखाएं समानांतर (Parallel) हों, तो समीकरण युग्म के कितने हल होंगे?",
          "options": {
            "A": "एक",
            "B": "दो",
            "C": "अनंत",
            "D": "कोई हल नहीं"
          },
          "explanation": "समानांतर रेखाएं कभी नहीं मिलतीं, इसलिए उनका 'कोई हल नहीं' होता है।"
        }
      }
    },
    {
      "id": "math-03-003",
      "number": 3,
      "question": "Solution of x + y = 14 and x - y = 4?",
      "options": {
        "A": "x=9, y=5",
        "B": "x=5, y=9",
        "C": "x=10, y=4",
        "D": "x=9, y=9"
      },
      "answer": "A",
      "explanation": "Adding equations gives x=9, then y=5.",
      "hash": "94dda831c8e8da7c",
      "translations": {
        "hi": {
          "question": "समीकरण युग्म x + y = 14 और x - y = 4 का हल क्या है?",
          "options": {
            "A": "x=9, y=5",
            "B": "x=5, y=9",
            "C": "x=10, y=4",
            "D": "x=9, y=9"
          },
          "explanation": "जोड़ने पर: 2x = 18 => x = 9। फिर 9 + y = 14 => y = 5।"
        }
      }
    },
    {
      "id": "math-03-004",
      "number": 4,
      "question": "If a₁/a₂ = b₁/b₂ = c₁/c₂, the lines are?",
      "options": {
        "A": "प्रतिच्छेदी",
        "B": "समानांतर",
        "C": "संपाती (Coincident)",
        "D": "इनमें से कोई नहीं"
      },
      "answer": "C",
      "explanation": "This is the condition for Coincident lines (Infinite solutions).",
      "hash": "e2ef228a6c4d1204",
      "translations": {
        "hi": {
          "question": "यदि a₁/a₂ = b₁/b₂ = c₁/c₂ हो, तो रेखाएं कैसी होंगी?",
          "options": {
            "A": "प्रतिच्छेदी",
            "B": "समानांतर",
            "C": "संपाती (Coincident)",
            "D": "इनमें से कोई नहीं"
          },
          "explanation": "यह स्थिति संपाती रेखाओं (एक के ऊपर एक) की है, जिनके अनंत हल होते हैं।"
        }
      }
    },
    {
      "id": "math-03-005",
      "number": 5,
      "question": "In 2x + 3y = 5, if x = 1, then y = ?",
      "options": {
        "A": "1",
        "B": "2",
        "C": "3",
        "D": "0"
      },
      "answer": "A",
      "explanation": "2 + 3y = 5 => 3y = 3 => y = 1.",
      "hash": "f447d06bb95f94cd",
      "translations": {
        "hi": {
          "question": "रैखिक समीकरण 2x + 3y = 5 में यदि x = 1 हो, तो y का मान क्या होगा?",
          "options": {
            "A": "1",
            "B": "2",
            "C": "3",
            "D": "0"
          },
          "explanation": "2(1) + 3y = 5 => 3y = 3 => y = 1।"
        }
      }
    },
    {
      "id": "math-03-006",
      "number": 6,
      "question": "A pair of equations having no solution is called?",
      "options": {
        "A": "संगत (Consistent)",
        "B": "असंगत (Inconsistent)",
        "C": "आश्रित",
        "D": "इनमें से कोई नहीं"
      },
      "answer": "B",
      "explanation": "No solution implies Inconsistent.",
      "hash": "e086200dc692acb4",
      "translations": {
        "hi": {
          "question": "समीकरण युग्म जिसका कोई हल नहीं होता, क्या कहलाता है?",
          "options": {
            "A": "संगत (Consistent)",
            "B": "असंगत (Inconsistent)",
            "C": "आश्रित",
            "D": "इनमें से कोई नहीं"
          },
          "explanation": "जिसका कोई हल न हो (समानांतर रेखाएं), वह 'असंगत' कहलाता है।"
        }
      }
    },
    {
      "id": "math-03-007",
      "number": 7,
      "question": "For what value of k will x + 2y = 7 and 2x + ky = 14 be coincident?",
      "options": {
        "A": "2",
        "B": "3",
        "C": "4",
        "D": "5"
      },
      "answer": "C",
      "explanation": "1/2 = 2/k => k = 4.",
      "hash": "edbc6c779beabc94",
      "translations": {
        "hi": {
          "question": "k के किस मान के लिए समीकरण x + 2y = 7 और 2x + ky = 14 संपाती होंगे?",
          "options": {
            "A": "2",
            "B": "3",
            "C": "4",
            "D": "5"
          },
          "explanation": "a₁/a₂ = b₁/b₂ => 1/2 = 2/k => k = 4।"
        }
      }
    },
    {
