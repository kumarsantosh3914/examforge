    {
      "id": "math-03-009",
      "number": 9,
      "question": "Formula for x in Cross-Multiplication Method?",
      "options": {
        "A": "(b₁c₂ - b₂c₁) / (a₁b₂ - a₂b₁)",
        "B": "(c₁a₂ - c₂a₁) / (a₁b₂ - a₂b₁)",
        "C": "b₁c₂ - b₂c₁",
        "D": "a₁b₂ - a₂b₁"
      },
      "answer": "A",
      "explanation": "x = (b₁c₂ - b₂c₁) / (a₁b₂ - a₂b₁).",
      "hash": "f616b523e1f585c8",
      "translations": {
        "hi": {
          "question": "वज्र-गुणन विधि (Cross-Multiplication Method) में x का सूत्र क्या है?",
          "options": {
            "A": "(b₁c₂ - b₂c₁) / (a₁b₂ - a₂b₁)",
            "B": "(c₁a₂ - c₂a₁) / (a₁b₂ - a₂b₁)",
            "C": "b₁c₂ - b₂c₁",
            "D": "a₁b₂ - a₂b₁"
          },
          "explanation": "x = (b₁c₂ - b₂c₁) / (a₁b₂ - a₂b₁)।"
        }
      }
    },
