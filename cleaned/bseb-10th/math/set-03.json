          "options": {
            "A": "x + 3",
            "B": "x - 3",
            "C": "3x",
            "D": "x/3"
          },
          "explanation": "3 गुनी का अर्थ 3x है।"
        }
      }
    },
    {
      "id": "math-03-014",
      "number": 14,
      "question": "Value of k for no solution: x + 2y = 3 and 5x + ky = 7?",
      "options": {
        "A": "10",
        "B": "5",
        "C": "2",
        "D": "6"
      },
      "answer": "A",
      "explanation": "1/5 = 2/k => k = 10.",
      "hash": "e88fc840892651e5",
      "translations": {
        "hi": {
          "question": "k के किस मान के लिए समीकरण x + 2y = 3 और 5x + ky = 7 का कोई हल नहीं होगा?",
          "options": {
            "A": "10",
            "B": "5",
            "C": "2",
            "D": "6"
          },
          "explanation": "a₁/a₂ = b₁/b₂ ≠ c₁/c₂ => 1/5 = 2/k => k = 10। (और 3/7 ≠ 1/5)।"
        }
      }
    },
