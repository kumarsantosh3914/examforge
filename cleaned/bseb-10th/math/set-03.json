      "hash": "a564e154f5eb956b",
      "translations": {
        "hi": {
          "question": "दो चरों वाले रैखिक समीकरण का व्यापक रूप क्या है?",
          "options": {
            "A": "ax + b = 0",
            "B": "ax² + bx + c = 0",
            "C": "ax + by + c = 0",
            "D": "ax³ + b = 0"
          },
          "explanation": "ax + by + c = 0।"
        }
      }
