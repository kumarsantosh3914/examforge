    {
      "id": "math-03-012",
      "number": 12,
      "question": "How many solutions for 3x - y = 3 and 9x - 3y = 9?",
      "options": {
        "A": "एक अद्वितीय",
        "B": "दो हल",
        "C": "अनंत हल",
        "D": "कोई हल नहीं"
      },
      "answer": "C",
      "explanation": "Ratios are equal, so infinite solutions.",
      "hash": "78ddf8fb916558e3",
      "translations": {
        "hi": {
          "question": "3x - y = 3 और 9x - 3y = 9 के कितने हल हैं?",
          "options": {
            "A": "एक अद्वितीय",
            "B": "दो हल",
            "C": "अनंत हल",
            "D": "कोई हल नहीं"
          },
          "explanation": "3/9 = -1/-3 = 3/9 (1/3 = 1/3 = 1/3)। अतः अनंत हल।"
        }
      }
    },
    {
      "id": "math-03-013",
