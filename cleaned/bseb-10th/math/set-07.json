    {
      "id": "math-07-007",
      "number": 7,
      "question": "Distance of point (-6, 8) from the origin?",
      "options": {
        "A": "8",
        "B": "2√7",
        "C": "10",
        "D": "6"
      },
      "answer": "C",
      "explanation": "√100 = 10.",
      "hash": "6f4f62068e84a19f",
      "translations": {
        "hi": {
          "question": "बिंदु (-6, 8) की मूल बिंदु से दूरी है?",
          "options": {
            "A": "8",
            "B": "2√7",
            "C": "10",
            "D": "6"
          },
          "explanation": "d = √((-6)² + 8²) = √(36 + 64) = √100 = 10।"
        }
      }
    },
