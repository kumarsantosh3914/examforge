      "number": 22,
      "question": "If vertices of a parallelogram are given, find x and y.",
      "options": {
        "A": "x=6, y=3",
        "B": "x=3, y=6",
        "C": "x=5, y=4",
        "D": "x=4, y=5"
      },
      "answer": "A",
      "explanation": "Diagonals bisect each other. x=6, y=3.",
      "hash": "c3a8aa75375faad5",
      "translations": {
        "hi": {
          "question": "यदि बिंदु (1, 2), (4, y), (x, 6) और (3, 5) एक समांतर चतुर्भुज के शीर्ष हों, तो x और y का मान?",
          "options": {
            "A": "x=6, y=3",
            "B": "x=3, y=6",
            "C": "x=5, y=4",
            "D": "x=4, y=5"
          },
          "explanation": "समांतर चतुर्भुज के विकर्ण परस्पर समद्विभाजित करते हैं। मध्य बिंदु बराबर रखकर हल करें। (1+x)/2 = (4+3)/2 => x=6। (2+6)/2 = (y+5)/2 => y=3।"
        }
      }
    },
