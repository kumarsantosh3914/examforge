      "id": "math-07-024",
      "number": 24,
      "question": "Distance between (-5, 7) and (-1, 3)?",
      "options": {
        "A": "2√2",
        "B": "3√2",
        "C": "4√2",
        "D": "5√2"
      },
      "answer": "C",
      "explanation": "4√2.",
      "hash": "a059515f00803b62",
      "translations": {
        "hi": {
          "question": "बिंदु (-5, 7) और (-1, 3) के बीच की दूरी है?",
          "options": {
            "A": "2√2",
            "B": "3√2",
            "C": "4√2",
            "D": "5√2"
          },
          "explanation": "√((-1+5)² + (3-7)²) = √(16 + 16) = √32 = 4√2।"
        }
      }
    },
