      "id": "math-07-001",
      "number": 1,
      "question": "Formula for distance of point P(x, y) from origin?",
      "options": {
        "A": "√(x² - y²)",
        "B": "x + y",
        "C": "√(x² + y²)",
        "D": "x² + y²"
      },
      "answer": "C",
      "explanation": "Distance formula gives √(x² + y²).",
      "hash": "321de011379afc5c",
      "translations": {
        "hi": {
          "question": "बिंदु P(x, y) की मूल बिंदु से दूरी का सूत्र क्या है?",
          "options": {
            "A": "√(x² - y²)",
            "B": "x + y",
            "C": "√(x² + y²)",
            "D": "x² + y²"
          },
          "explanation": "दूरी = √((x-0)² + (y-0)²) = √(x² + y²)।"
        }
      }
    },
    {
      "id": "math-07-002",
      "number": 2,
      "question": "What are the coordinates of the Origin?",
      "options": {
        "A": "(1, 1)",
        "B": "(0, 1)",
        "C": "(1, 0)",
        "D": "(0, 0)"
      },
      "answer": "D",
