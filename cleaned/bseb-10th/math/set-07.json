      "hash": "e761185f55de2fc4",
      "translations": {
        "hi": {
          "question": "बिंदुओं A(x₁, y₁) और B(x₂, y₂) के बीच की दूरी का सूत्र क्या है?",
          "options": {
            "A": "√[(x₂-x₁)² + (y₂-y₁)²]",
            "B": "√[(x₂+x₁)² + (y₂+y₁)²]",
            "C": "(x₂-x₁) + (y₂-y₁)",
            "D": "√[(x₂-x₁) + (y₂-y₁)]"
          },
          "explanation": "दूरी सूत्र: √[(x₂ - x₁)² + (y₂ - y₁)²]।"
        }
      }
