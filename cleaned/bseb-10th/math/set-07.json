      "id": "math-07-026",
      "number": 26,
      "question": "Point on Y-axis equidistant from (6, 5) and (-4, 3)?",
      "options": {
        "A": "(0, 9)",
        "B": "(0, -9)",
        "C": "(0, 5)",
        "D": "(0, 3)"
      },
      "answer": "A",
      "explanation": "(0, 9).",
      "hash": "1285e4a850151829",
      "translations": {
        "hi": {
          "question": "Y-अक्ष पर वह बिंदु जो (6, 5) और (-4, 3) से समदूरस्थ हो?",
          "options": {
            "A": "(0, 9)",
            "B": "(0, -9)",
            "C": "(0, 5)",
            "D": "(0, 3)"
          },
          "explanation": "(0, y) मानकर हल करें। (0-6)² + (y-5)² = (0+4)² + (y-3)²। हल करने पर y = 9।"
        }
      }
    },
    {
      "id": "math-07-027",
      "number": 27,
      "question": "If A, B, C, D are vertices of a parallelogram, value of p?",
      "options": {
        "A": "6",
        "B": "7",
        "C": "8",
        "D": "9"
      },
      "answer": "B",
      "explanation": "Midpoints of diagonals are same. p = 7.",
      "hash": "ad8f405d450a8b18",
      "translations": {
        "hi": {
          "question": "यदि बिंदु A(6, 1), B(8, 2), C(9, 4) और D(p, 3) एक समांतर चतुर्भुज के शीर्ष हैं, तो p का मान?",
          "options": {
            "A": "6",
            "B": "7",
            "C": "8",
            "D": "9"
          },
          "explanation": "AC का मध्य बिंदु = BD का मध्य बिंदु। (6+9)/2 = (8+p)/2 => 15 = 8+p => p = 7।"
        }
      }
    },
    {
      "id": "math-07-028",
      "number": 28,
      "question": "Distance between (a sin θ, 0) and (0, a cos θ)?",
      "options": {
        "A": "a",
        "B": "2a",
        "C": "a²",
        "D": "0"
      },
      "answer": "A",
      "explanation": "Result is 'a'.",
      "hash": "4efe93fe5b99ae7f",
      "translations": {
        "hi": {
          "question": "बिंदुओं (a sin θ, 0) और (0, a cos θ) के बीच की दूरी क्या है?",
          "options": {
            "A": "a",
            "B": "2a",
            "C": "a²",
            "D": "0"
          },
          "explanation": "√[(0 - a sin θ)² + (a cos θ - 0)²] = √[a²(sin²θ + cos²θ)] = √a² = a।"
        }
      }
    },
