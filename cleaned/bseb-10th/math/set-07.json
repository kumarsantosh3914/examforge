    {
      "id": "math-07-015",
      "number": 15,
      "question": "Area of triangle with vertices (1, -1), (-4, 6) and (-3, -5)?",
      "options": {
        "A": "24",
        "B": "21",
        "C": "28",
        "D": "48"
      },
      "answer": "A",
      "explanation": "Applying formula gives 24 sq units.",
      "hash": "920735809d72e0ae",
      "translations": {
        "hi": {
          "question": "उस त्रिभुज का क्षेत्रफल क्या होगा जिसके शीर्ष (1, -1), (-4, 6) और (-3, -5) हैं?",
          "options": {
            "A": "24",
            "B": "21",
            "C": "28",
            "D": "48"
          },
          "explanation": "सूत्र 1/2 [x₁(y₂-y₃) + x₂(y₃-y₁) + x₃(y₁-y₂)] का प्रयोग करें। 1/2 [1(11) - 4(-4) - 3(-7)] = 1/2 [11 + 16 + 21] = 48/2 = 24।"
        }
      }
    },
