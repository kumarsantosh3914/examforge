    {
      "id": "math-07-005",
      "number": 5,
      "question": "Distance between points (2, 3) and (4, 1)?",
      "options": {
        "A": "2√2",
        "B": "2",
        "C": "4",
        "D": "√8"
      },
      "answer": "A",
      "explanation": "d = √8 = 2√2.",
      "hash": "647e57e9fa1d8435",
      "translations": {
        "hi": {
          "question": "बिंदुओं (2, 3) और (4, 1) के बीच की दूरी क्या है?",
          "options": {
            "A": "2√2",
            "B": "2",
            "C": "4",
            "D": "√8"
          },
          "explanation": "d = √[(4-2)² + (1-3)²] = √[2² + (-2)²] = √[4+4] = √8 = 2√2।"
        }
      }
    },
