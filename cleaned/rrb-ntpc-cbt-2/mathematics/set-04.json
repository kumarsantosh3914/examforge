    {
      "id": "mathematics-04-023",
      "number": 23,
      "question": "If (a+b):(b+c):(c+a) = 6:7:8 and a+b+c=14, find c.",
      "options": {
        "A": "6",
        "B": "7",
        "C": "8",
        "D": "14"
      },
      "answer": "A",
      "explanation": "2(a+b+c) -> 21k. a+b+c=10.5k. k=4/3. a+b=8. c=14-8=6.",
      "hash": "13dfd30a009e0816",
      "translations": {
        "hi": {
          "question": "यदि (a+b) : (b+c) : (c+a) = 6 : 7 : 8 और a+b+c = 14 है, तो c का मान क्या है?",
          "options": {
            "A": "6",
            "B": "7",
            "C": "8",
            "D": "14"
          },
          "explanation": "अनुपात का योग = 2(a+b+c) = 21k. a+b+c = 10.5k. 14 = 10.5k => k = 14/10.5 = 4/3. a+b = 6k = 8. c = (a+b+c) - (a+b) = 14 - 8 = 6."
        }
      }
    },
    {
      "id": "mathematics-04-024",
      "number": 24,
      "question": "If 3 cos θ = 4 sin θ, find tan(45° + θ).",
      "options": {
        "A": "7",
        "B": "1/7",
        "C": "7/25",
        "D": "24/25"
      },
      "answer": "A",
      "explanation": "tan θ = 3/4. Formula (1+tan)/(1-tan) => 7.",
      "hash": "ac7e623e8b48f039",
      "translations": {
        "hi": {
          "question": "यदि 3 cos θ = 4 sin θ है, तो tan(45° + θ) का मान ज्ञात कीजिये।",
          "options": {
            "A": "7",
            "B": "1/7",
            "C": "7/25",
            "D": "24/25"
          },
          "explanation": "tan θ = 3/4. tan(45+θ) = (1 + tan θ)/(1 - tan θ) = (1 + 3/4)/(1 - 3/4) = (7/4)/(1/4) = 7."
        }
      }
    },
