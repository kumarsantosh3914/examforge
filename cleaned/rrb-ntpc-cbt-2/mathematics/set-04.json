    {
      "id": "mathematics-04-001",
      "number": 1,
      "question": "If x² - 4x + 1 = 0, find x⁶ + 1/x⁶.",
      "options": {
        "A": "2702",
        "B": "2596",
        "C": "2704",
        "D": "2600"
      },
      "answer": "A",
      "explanation": "x+1/x=4. x³+1/x³=52. Square it: (52)² = 2704. x⁶+1/x⁶ = 2704-2 = 2702.",
      "hash": "135e0486b4edffb0",
      "translations": {
        "hi": {
          "question": "यदि x² - 4x + 1 = 0 है, तो x⁶ + 1/x⁶ का मान क्या है?",
          "options": {
            "A": "2702",
            "B": "2596",
            "C": "2704",
            "D": "2600"
          },
          "explanation": "x + 1/x = 4. x³ + 1/x³ = 4³ - 3(4) = 52. (x³ + 1/x³)² = x⁶ + 1/x⁶ + 2. 52² = 2704. मान = 2704 - 2 = 2702."
        }
      }
    },
    {
      "id": "mathematics-04-002",
      "number": 2,
      "question": "Perimeter of a right triangle is 60 cm and hypotenuse is 26 cm. Find its area.",
      "options": {
        "A": "120 cm²",
        "B": "130 cm²",
        "C": "100 cm²",
        "D": "240 cm²"
      },
      "answer": "A",
      "explanation": "Sum of legs=34. Sum of squares=676. 2ab = 34²-676=480. Area = 1/2 ab = 120.",
      "hash": "207ae958272389e7",
      "translations": {
        "hi": {
          "question": "एक समकोण त्रिभुज का परिमाप 60 सेमी है और इसका कर्ण 26 सेमी है। त्रिभुज का क्षेत्रफल ज्ञात कीजिये।",
          "options": {
            "A": "120 सेमी²",
            "B": "130 सेमी²",
            "C": "100 सेमी²",
            "D": "240 सेमी²"
          },
          "explanation": "a + b = 60 - 26 = 34. a² + b² = 26² = 676. (a+b)² = a² + b² + 2ab. 34² = 676 + 2ab. 1156 - 676 = 2ab => 2ab = 480 => ab = 240. क्षेत्रफल = 1/2 ab = 120."
        }
      }
    },
    {
      "id": "mathematics-04-003",
      "number": 3,
      "question": "A sum is lent at 20% p.a. compound interest for 2 years. If interest is compounded half-yearly, it would be ₹482 more than if compounded annually. Find the sum.",
      "options": {
        "A": "₹20,000",
        "B": "₹10,000",
        "C": "₹40,000",
        "D": "₹30,000"
      },
      "answer": "A",
      "explanation": "Annual Eff. Rate = 44%. Half-yearly (10% for 4 times) Eff. Rate = 46.41%. Diff = 2.41% = 482. Sum = 20,000.",
      "hash": "1baf79ecf02cb8a2",
      "translations": {
        "hi": {
          "question": "एक राशि 2 वर्षों के लिए 20% प्रति वर्ष चक्रवृद्धि ब्याज पर दी जाती है। यदि ब्याज अर्धवार्षिक रूप से संयोजित किया जाता है, तो यह वार्षिक रूप से संयोजित ब्याज की तुलना में ₹482 अधिक होता। राशि ज्ञात कीजिये।",
          "options": {
            "A": "₹20,000",
            "B": "₹10,000",
            "C": "₹40,000",
            "D": "₹30,000"
          },
          "explanation": "वार्षिक (20%): प्रभावी = 20+20+4 = 44%. अर्धवार्षिक (10%, 4 चक्र): प्रभावी = 46.41%. अंतर = 46.41 - 44 = 2.41%. 2.41% = 482. 1% = 200. 100% = 20,000."
        }
      }
    },
    {
      "id": "mathematics-04-005",
      "number": 5,
      "question": "Two poles of height 10m and 15m stand on ground. Distance between feet is 12m. Distance between tops?",
      "options": {
        "A": "13 m",
        "B": "12 m",
        "C": "14 m",
        "D": "11 m"
      },
      "answer": "A",
      "explanation": "Diff in height = 5. Base = 12. Hypotenuse = √(5² + 12²) = 13.",
      "hash": "f7d83a38c1a1cbf2",
      "translations": {
        "hi": {
          "question": "दो पोल जमीन पर खड़े हैं जिनकी ऊँचाई 10 मीटर और 15 मीटर है। यदि उनके पैरों (feet) के बीच की दूरी 12 मीटर है, तो उनके शीर्षों (tops) के बीच की दूरी क्या है?",
          "options": {
            "A": "13 मीटर",
            "B": "12 मीटर",
            "C": "14 मीटर",
            "D": "11 मीटर"
          },
          "explanation": "ऊँचाई का अंतर = 15 - 10 = 5. क्षैतिज दूरी = 12. शीर्षों की दूरी (कर्ण) = √(5² + 12²) = √(25 + 144) = √169 = 13 मीटर।"
        }
      }
    },
    {
      "id": "mathematics-04-006",
      "number": 6,
      "question": "A container has 80L milk. 8L is removed and replaced with water. Process is repeated 2 more times. How much milk is left?",
      "options": {
        "A": "58.32 L",
        "B": "60 L",
        "C": "55 L",
        "D": "64.8 L"
      },
      "answer": "A",
      "explanation": "Rem = 80 * (9/10)^3 = 80 * 0.729 = 58.32 L.",
      "hash": "4efd8fe7227c2d13",
      "translations": {
        "hi": {
          "question": "एक कंटेनर में 80 लीटर दूध है। इस कंटेनर से 8 लीटर दूध निकाला जाता है और पानी से बदल दिया जाता है। यह प्रक्रिया दो बार और दोहराई जाती है। कंटेनर में अब कितना दूध है?",
          "options": {
            "A": "58.32 लीटर",
            "B": "60 लीटर",
            "C": "55 लीटर",
            "D": "64.8 लीटर"
          },
          "explanation": "सूत्र: शेष मात्रा = प्रारंभिक मात्रा × (1 - निकाला गया/कुल)ⁿ. शेष = 80 × (1 - 8/80)³ = 80 × (9/10)³ = 80 × 0.729 = 58.32 लीटर।"
        }
      }
    },
