    {
      "id": "mathematics-04-013",
      "number": 13,
      "question": "If x = 7 + 4√3, find √x.",
      "options": {
        "A": "2 + √3",
        "B": "2 - √3",
        "C": "√3 + 1",
        "D": "3 + √2"
      },
      "answer": "A",
      "explanation": "x = (2 + √3)². So root is 2 + √3.",
      "hash": "7c7acfa91f3eea54",
      "translations": {
        "hi": {
          "question": "यदि x = 7 + 4√3 है, तो √x ज्ञात कीजिये।",
          "options": {
            "A": "2 + √3",
            "B": "2 - √3",
            "C": "√3 + 1",
            "D": "3 + √2"
          },
          "explanation": "x = 4 + 3 + 2(2)(√3) = 2² + (√3)² + 2(2)(√3) = (2 + √3)². अतः √x = 2 + √3."
        }
      }
    },
