    },
    {
      "id": "mathematics-04-031",
      "number": 31,
      "question": "A sphere is inscribed in a cube. Ratio of volume of sphere to volume of cube?",
      "options": {
        "A": "π : 6",
        "B": "π : 4",
        "C": "π : 3",
        "D": "2π : 3"
      },
      "answer": "A",
      "explanation": "Radius = a/2. Sphere V = πa³/6. Cube V = a³. Ratio π:6.",
      "hash": "24c6c3f5388215c2",
      "translations": {
        "hi": {
          "question": "एक गोले को एक घन के अंदर पूरी तरह से फिट किया गया है। गोले के आयतन और घन के आयतन का अनुपात क्या है?",
          "options": {
            "A": "π : 6",
            "B": "π : 4",
            "C": "π : 3",
            "D": "2π : 3"
          },
          "explanation": "गोले का व्यास = घन की भुजा (a)। त्रिज्या = a/2. गोला V = (4/3)π(a/2)³ = πa³/6. घन V = a³. अनुपात = π/6 : 1 = π : 6."
        }
      }
    },
    {
      "id": "mathematics-04-032",
      "number": 32,
      "question": "Vessels A and B have acid:water 4:3 and 2:3. In what ratio mix them to get 1:1?",
      "options": {
        "A": "7:5",
        "B": "5:7",
        "C": "7:4",
        "D": "4:7"
      },
      "answer": "A",
      "explanation": "Alligation on Acid fraction. 4/7, 2/5, Mean 1/2. Ratio 7:5.",
      "hash": "f67b84b507770d73",
      "translations": {
        "hi": {
          "question": "दो बर्तन A और B में एसिड और पानी का अनुपात 4:3 और 2:3 है। सीसा (Lead) प्रश्न नहीं है, मिश्रण है। दोनों को किस अनुपात में मिलाया जाए ताकि नए मिश्रण में आधा एसिड और आधा पानी हो?",
          "options": {
            "A": "7:5",
            "B": "5:7",
            "C": "7:4",
            "D": "4:7"
          },
          "explanation": "एसिड अंश: A=4/7, B=2/5. लक्ष्य=1/2. मिश्रण नियम: |2/5 - 1/2| = 1/10. |4/7 - 1/2| = 1/14. अनुपात: 1/10 : 1/14 = 14 : 10 = 7 : 5."
        }
      }
    },
