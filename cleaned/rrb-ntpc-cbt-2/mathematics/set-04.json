    {
      "id": "mathematics-04-034",
      "number": 34,
      "question": "Area of Rhombus is 216 cm², one diagonal is 24 cm. Find side length.",
      "options": {
        "A": "15 cm",
        "B": "12 cm",
        "C": "13 cm",
        "D": "10 cm"
      },
      "answer": "A",
      "explanation": "d2=18. Half diags 12, 9. Side = √(144+81) = 15.",
      "hash": "01a6114da100c948",
      "translations": {
        "hi": {
          "question": "एक समचतुर्भुज (Rhombus) का क्षेत्रफल 216 सेमी² है और एक विकर्ण 24 सेमी है। इसकी भुजा की लंबाई ज्ञात कीजिये।",
          "options": {
            "A": "15 सेमी",
            "B": "12 सेमी",
            "C": "13 सेमी",
            "D": "10 सेमी"
          },
          "explanation": "1/2 × d1 × d2 = 216 => 12 × d2 = 216 => d2 = 18. विकर्णों का आधा = 12 और 9. भुजा = √(12² + 9²) = √225 = 15."
        }
      }
    },
    {
      "id": "mathematics-04-035",
      "number": 35,
      "question": "Find value of sin² 1° + sin² 3° + ... + sin² 89°.",
      "options": {
        "A": "22.5",
        "B": "22",
        "C": "23",
        "D": "21.5"
      },
      "answer": "A",
      "explanation": "45 terms. 22 pairs summing to 1 + middle term 0.5. Total 22.5.",
      "hash": "3f83ede9d08ba12a",
      "translations": {
        "hi": {
          "question": "sin² 1° + sin² 3° + ... + sin² 89° का मान ज्ञात कीजिये।",
          "options": {
            "A": "22.5",
            "B": "22",
            "C": "23",
            "D": "21.5"
          },
          "explanation": "कुल पद = (89-1)/2 + 1 = 45 पद। मध्य पद sin² 45° = 1/2. शेष 44 पद 22 जोड़े बनाते हैं (जिनका योग 1 होता है)। कुल योग = 22 + 0.5 = 22.5."
        }
      }
    }
  ]
