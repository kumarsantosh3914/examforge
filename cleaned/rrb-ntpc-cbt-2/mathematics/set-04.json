      "translations": {
        "hi": {
          "question": "एक ट्रेन 400 मीटर लंबे प्लेटफॉर्म को 50 सेकंड में और 600 मीटर लंबे प्लेटफॉर्म को 60 सेकंड में पार करती है। ट्रेन की लंबाई और गति क्या है?",
          "options": {
            "A": "L=600m, S=20m/s",
            "B": "L=500m, S=25m/s",
            "C": "L=600m, S=25m/s",
            "D": "L=400m, S=20m/s"
          },
          "explanation": "दूरी अंतर = 200 मी। समय अंतर = 10 सेकंड। गति = 200/10 = 20 मी/से। लंबाई = (20 × 50) - 400 = 1000 - 400 = 600 मीटर।"
        }
      }
    },
