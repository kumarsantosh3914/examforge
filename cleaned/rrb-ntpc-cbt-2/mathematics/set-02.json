    {
      "id": "mathematics-02-026",
      "number": 26,
      "question": "Base radius and height of a cone are 5cm and 12cm. Find TSA.",
      "options": {
        "A": "90π",
        "B": "85π",
        "C": "60π",
        "D": "80π"
      },
      "answer": "A",
      "explanation": "Slant ht l=13. TSA = πr(l+r) = 5π(18) = 90π.",
      "hash": "7797c0daa114afd1",
      "translations": {
        "hi": {
          "question": "एक शंकु (Cone) की आधार त्रिज्या और ऊँचाई क्रमशः 5 सेमी और 12 सेमी हैं। इसका कुल पृष्ठीय क्षेत्रफल ज्ञात कीजिये।",
          "options": {
            "A": "90π",
            "B": "85π",
            "C": "60π",
            "D": "80π"
          },
          "explanation": "तिर्यक ऊँचाई l = √(5²+12²) = 13. TSA = πr(l+r) = π(5)(13+5) = π(5)(18) = 90π."
        }
      }
    },
