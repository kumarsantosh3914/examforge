      "translations": {
        "hi": {
          "question": "एक क्रिकेट खिलाड़ी का 10 पारियों में औसत 32 था। अगली पारी में उसे कितने रन बनाने चाहिए ताकि उसका औसत 4 रन बढ़ जाए?",
          "options": {
            "A": "76",
            "B": "70",
            "C": "72",
            "D": "66"
          },
          "explanation": "नया औसत = 36। कुल रन = 11 × 36 = 396। पुराने रन = 320। अंतर = 76। (शॉर्टकट: 36 + 10×4 = 76)।"
