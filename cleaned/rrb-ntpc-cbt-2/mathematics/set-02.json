    {
      "id": "mathematics-02-001",
      "number": 1,
      "question": "A shopkeeper offers a discount of 10% on MP and still earns a profit of 20%. If CP is ₹450, find the MP.",
      "options": {
        "A": "₹600",
        "B": "₹540",
        "C": "₹550",
        "D": "₹650"
      },
      "answer": "A",
      "explanation": "MP/CP = (100+P%)/(100-D%). MP/450 = 120/90 = 4/3. MP = ₹600.",
      "hash": "5689ac53daa4c4fd",
      "translations": {
        "hi": {
          "question": "एक दुकानदार अंकित मूल्य पर 10% की छूट देता है और फिर भी 20% का लाभ कमाता है। यदि क्रय मूल्य ₹450 है, तो अंकित मूल्य ज्ञात कीजिये।",
          "options": {
            "A": "₹600",
            "B": "₹540",
            "C": "₹550",
            "D": "₹650"
          },
          "explanation": "MP/CP = (100+Profit%)/(100-Discount%). MP/450 = 120/90 = 4/3. MP = 450 × 4/3 = ₹600."
        }
      }
    },
    {
      "id": "mathematics-02-002",
      "number": 2,
      "question": "The HCF and LCM of two numbers are 12 and 240 respectively. If one number is 48, what is the other number?",
      "options": {
        "A": "60",
        "B": "50",
        "C": "72",
        "D": "80"
      },
      "answer": "A",
      "explanation": "1st × 2nd = HCF × LCM. 48 × x = 12 × 240. x = 60.",
      "hash": "982afe24e7f4be63",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का HCF और LCM क्रमशः 12 और 240 है। यदि एक संख्या 48 है, तो दूसरी संख्या क्या है?",
          "options": {
            "A": "60",
            "B": "50",
            "C": "72",
            "D": "80"
          },
          "explanation": "पहली संख्या × दूसरी संख्या = HCF × LCM. 48 × x = 12 × 240. x = (12 × 240) / 48 = 60."
        }
      }
    },
    {
      "id": "mathematics-02-003",
      "number": 3,
      "question": "Radii of two cylinders are in ratio 2:3 and heights in ratio 5:3. What is the ratio of their volumes?",
      "options": {
        "A": "20:27",
        "B": "27:20",
        "C": "10:9",
        "D": "4:9"
      },
      "answer": "A",
      "explanation": "V1/V2 = (r1/r2)² × (h1/h2) = (2/3)² × (5/3) = 20/27.",
      "hash": "f670b6708c268b24",
      "translations": {
        "hi": {
          "question": "दो बेलनों (Cylinders) की त्रिज्याओं का अनुपात 2:3 है और उनकी ऊंचाइयों का अनुपात 5:3 है। उनके आयतनों का अनुपात क्या है?",
          "options": {
            "A": "20:27",
            "B": "27:20",
            "C": "10:9",
            "D": "4:9"
          },
          "explanation": "V1/V2 = (r1/r2)² × (h1/h2) = (2/3)² × (5/3) = 4/9 × 5/3 = 20/27."
        }
      }
    },
    {
      "id": "mathematics-02-004",
      "number": 4,
      "question": "If x = 3 + 2√2, find the value of √x - 1/√x.",
      "options": {
        "A": "2",
        "B": "1",
        "C": "2√2",
        "D": "√2"
      },
      "answer": "A",
      "explanation": "x = (√2 + 1)². So √x = √2 + 1. 1/√x = √2 - 1. Diff = 2.",
      "hash": "2c10831322596938",
      "translations": {
        "hi": {
          "question": "यदि x = 3 + 2√2 है, तो √x - 1/√x का मान ज्ञात कीजिये।",
          "options": {
            "A": "2",
            "B": "1",
            "C": "2√2",
            "D": "√2"
          },
          "explanation": "x = (√2 + 1)². तो √x = √2 + 1. 1/√x = √2 - 1. अंतर = (√2 + 1) - (√2 - 1) = 2."
        }
      }
    },
    {
      "id": "mathematics-02-005",
      "number": 5,
      "question": "A sum amounts to ₹815 in 3 years and ₹854 in 4 years at SI. What is the sum?",
      "options": {
        "A": "₹698",
        "B": "₹650",
        "C": "₹700",
        "D": "₹690"
      },
      "answer": "A",
      "explanation": "1 yr Interest = 39. 3 yrs Interest = 117. Principal = 815 - 117 = ₹698.",
      "hash": "11f8b48562e66412",
      "translations": {
        "hi": {
          "question": "एक राशि साधारण ब्याज पर 3 वर्षों में ₹815 और 4 वर्षों में ₹854 हो जाती है। वह राशि क्या है?",
          "options": {
            "A": "₹698",
            "B": "₹650",
            "C": "₹700",
            "D": "₹690"
          },
          "explanation": "1 वर्ष का ब्याज = 854 - 815 = ₹39. 3 वर्ष का ब्याज = 39 × 3 = ₹117. मूलधन = 815 - 117 = ₹698."
        }
      }
    },
    {
      "id": "mathematics-02-006",
      "number": 6,
      "question": "What is the value of sin² 5° + sin² 10° + ... + sin² 85° + sin² 90°?",
      "options": {
        "A": "9.5",
        "B": "9",
        "C": "8.5",
        "D": "10"
      },
      "answer": "A",
      "explanation": "17 terms from 5 to 85. 8 pairs sum to 8. Middle sin²45=0.5. sin²90=1. Total 9.5.",
      "hash": "837ab630177f36ec",
      "translations": {
        "hi": {
          "question": "sin² 5° + sin² 10° + ... + sin² 85° + sin² 90° का मान क्या है?",
          "options": {
            "A": "9.5",
            "B": "9",
            "C": "8.5",
            "D": "10"
          },
          "explanation": "5 से 85 तक 17 पद हैं। 8 जोड़े (जैसे 5+85) मिलकर 8 बनाते हैं। बीच में sin² 45° (1/2) बचता है। sin² 90° = 1. कुल = 8 + 0.5 + 1 = 9.5."
        }
      }
    },
    {
      "id": "mathematics-02-007",
      "number": 7,
      "question": "A train at 50 km/hr crosses another train coming from opposite direction at 40 km/hr in 12 sec. If length of first train is 150m, find length of second train.",
      "options": {
        "A": "150 m",
        "B": "200 m",
        "C": "250 m",
        "D": "100 m"
      },
      "answer": "A",
      "explanation": "Rel Speed = 90 km/hr = 25 m/s. Dist = 300m. 2nd Train = 300 - 150 = 150 m.",
      "hash": "4b0e97a001c046e6",
      "translations": {
        "hi": {
          "question": "50 किमी/घंटा की गति से चलने वाली एक ट्रेन, विपरीत दिशा से 40 किमी/घंटा की गति से आ रही दूसरी ट्रेन को पूरी तरह से पार करने में 12 सेकंड का समय लेती है। यदि पहली ट्रेन की लंबाई 150 मीटर है, तो दूसरी ट्रेन की लंबाई क्या है?",
          "options": {
            "A": "150 मीटर",
            "B": "200 मीटर",
            "C": "250 मीटर",
            "D": "100 मीटर"
          },
          "explanation": "सापेक्ष गति = 90 किमी/घंटा = 25 मी/से। कुल दूरी = 25 × 12 = 300 मी। दूसरी ट्रेन = 300 - 150 = 150 मी।"
        }
      }
    },
