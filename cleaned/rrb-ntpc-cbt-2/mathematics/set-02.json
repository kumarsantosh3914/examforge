    {
      "id": "mathematics-02-034",
      "number": 34,
      "question": "If 2^(2x-1) = 8^(3-x), find x.",
      "options": {
        "A": "2",
        "B": "1",
        "C": "3",
        "D": "0"
      },
      "answer": "A",
      "explanation": "2x-1 = 9-3x => 5x=10 => x=2.",
      "hash": "8fce857d2821a080",
      "translations": {
        "hi": {
          "question": "यदि 2^(2x-1) = 8^(3-x), तो x का मान ज्ञात कीजिये।",
          "options": {
            "A": "2",
            "B": "1",
            "C": "3",
            "D": "0"
          },
          "explanation": "2^(2x-1) = 2^[3(3-x)]. 2x-1 = 9-3x. 5x = 10. x = 2."
        }
      }
    },
