      "id": "mathematics-02-029",
      "number": 29,
      "question": "45L mixture of milk and water is 4:1. How much water to add to make it 3:2?",
      "options": {
        "A": "15 L",
        "B": "10 L",
        "C": "12 L",
        "D": "20 L"
      },
      "answer": "A",
      "explanation": "Milk=36, Water=9. 36/(9+x)=3/2 => x=15.",
      "hash": "7a54c1aa4b581dcc",
      "translations": {
        "hi": {
          "question": "45 लीटर मिश्रण में दूध और पानी 4:1 है। मिश्रण को 3:2 बनाने के लिए कितना पानी मिलाना चाहिए?",
          "options": {
            "A": "15 लीटर",
            "B": "10 लीटर",
            "C": "12 लीटर",
            "D": "20 लीटर"
          },
          "explanation": "दूध=36, पानी=9. नया: 36/(9+x) = 3/2. 72 = 27 + 3x. 45 = 3x. x = 15."
        }
      }
    },
