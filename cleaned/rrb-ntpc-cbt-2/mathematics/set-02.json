    {
      "id": "mathematics-02-024",
      "number": 24,
      "question": "Difference between CI and SI on a sum for 3 years at 10% is ₹31. Find the sum.",
      "options": {
        "A": "₹1000",
        "B": "₹1200",
        "C": "₹1500",
        "D": "₹800"
      },
      "answer": "A",
      "explanation": "D = P(R/100)²(3 + R/100). 31 = P(0.01)(3.1). P = 1000.",
      "hash": "043f6cfca2a1a91c",
      "translations": {
        "hi": {
          "question": "10% प्रति वर्ष की दर से 3 वर्षों के लिए किसी राशि पर साधारण ब्याज और चक्रवृद्धि ब्याज का अंतर ₹31 है। वह राशि ज्ञात कीजिये।",
          "options": {
            "A": "₹1000",
            "B": "₹1200",
            "C": "₹1500",
            "D": "₹800"
          },
          "explanation": "सूत्र: D = P(R/100)²(3 + R/100). 31 = P(1/100)(3.1). P = 31 / 0.031 = 1000."
        }
      }
    },
