    {
      "id": "mathematics-02-010",
      "number": 10,
      "question": "If (x + 1/x) = 3, find the value of (x⁵ + 1/x⁵).",
      "options": {
        "A": "123",
        "B": "126",
        "C": "110",
        "D": "115"
      },
      "answer": "A",
      "explanation": "x²+1/x²=7, x³+1/x³=18. Product=126. Subtract (x+1/x)=3. Ans=123.",
      "hash": "e82593ccbbe5329c",
      "translations": {
        "hi": {
          "question": "यदि (x + 1/x) = 3 है, तो (x⁵ + 1/x⁵) का मान क्या है?",
          "options": {
            "A": "123",
            "B": "126",
            "C": "110",
            "D": "115"
          },
          "explanation": "x²+1/x² = 7. x³+1/x³ = 18. गुणा करें: (x²+1/x²)(x³+1/x³) = x⁵+1/x⁵ + (x+1/x). 7×18 = Ans + 3. 126 - 3 = 123."
        }
      }
    },
    {
