    {
      "id": "mathematics-01-001",
      "number": 1,
      "question": "If x + 1/x = 4, then what is the value of x³ + 1/x³?",
      "options": {
        "A": "52",
        "B": "64",
        "C": "76",
        "D": "48"
      },
      "answer": "A",
      "explanation": "Formula: a³ - 3a. Here a = 4. Value = 4³ - 3(4) = 64 - 12 = 52.",
      "hash": "ab96de3cbecf8123",
      "translations": {
        "hi": {
          "question": "यदि x + 1/x = 4 है, तो x³ + 1/x³ का मान क्या है?",
          "options": {
            "A": "52",
            "B": "64",
            "C": "76",
            "D": "48"
          },
          "explanation": "सूत्र: a³ - 3a. यहाँ a = 4. मान = 4³ - 3(4) = 64 - 12 = 52."
        }
      }
    },
    {
      "id": "mathematics-01-002",
      "number": 2,
      "question": "Selling an article for ₹2400 yields a profit of 20%. If it is sold for ₹2600, what will be the profit percentage?",
      "options": {
        "A": "30%",
        "B": "25%",
        "C": "28%",
        "D": "35%"
      },
      "answer": "A",
      "explanation": "CP = 2400 / 1.2 = 2000. New Profit = 2600 - 2000 = 600. Profit % = (600/2000)*100 = 30%.",
      "hash": "f6e3087922d843ce",
      "translations": {
        "hi": {
          "question": "एक वस्तु को ₹2400 में बेचने पर 20% का लाभ होता है। यदि इसे ₹2600 में बेचा जाए, तो लाभ प्रतिशत क्या होगा?",
          "options": {
            "A": "30%",
            "B": "25%",
            "C": "28%",
            "D": "35%"
          },
          "explanation": "CP = 2400 / 1.2 = 2000. नया लाभ = 2600 - 2000 = 600. लाभ % = (600/2000)*100 = 30%."
        }
      }
    },
    {
      "id": "mathematics-01-003",
      "number": 3,
      "question": "The area of an equilateral triangle is 36√3 cm². What is its perimeter?",
      "options": {
        "A": "36 cm",
        "B": "48 cm",
        "C": "24 cm",
        "D": "12 cm"
      },
      "answer": "A",
      "explanation": "(√3/4)a² = 36√3 => a² = 144 => a = 12. Perimeter = 3a = 36 cm.",
      "hash": "4745e02bcadadca2",
      "translations": {
        "hi": {
          "question": "एक समबाहु त्रिभुज का क्षेत्रफल 36√3 सेमी² है। इसका परिमाप क्या है?",
          "options": {
            "A": "36 सेमी",
            "B": "48 सेमी",
            "C": "24 सेमी",
            "D": "12 सेमी"
          },
          "explanation": "(√3/4)a² = 36√3 => a² = 144 => a = 12. परिमाप = 3a = 36 सेमी।"
        }
      }
    },
    {
      "id": "mathematics-01-004",
      "number": 4,
      "question": "Two numbers are in the ratio 5:7 and their HCF is 4. Find their LCM.",
      "options": {
        "A": "140",
        "B": "120",
        "C": "160",
        "D": "280"
      },
      "answer": "A",
      "explanation": "Numbers are 20 and 28. LCM = 140. (Or LCM = HCF × product of ratios = 4 × 5 × 7 = 140).",
      "hash": "7a15cab0381508bb",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का अनुपात 5:7 है और उनका महत्तम समापवर्तक (HCF) 4 है। उनका लघुत्तम समापवर्त्य (LCM) ज्ञात कीजिये।",
          "options": {
            "A": "140",
            "B": "120",
            "C": "160",
            "D": "280"
          },
          "explanation": "संख्याएं 5×4=20 और 7×4=28 होंगी। LCM(20, 28) = 140. (वैकल्पिक: LCM = HCF × उत्पाद अनुपात = 4 × 5 × 7 = 140)."
        }
      }
    },
    {
      "id": "mathematics-01-005",
      "number": 5,
      "question": "What is the value of sin 60° cos 30° + sin 30° cos 60°?",
      "options": {
        "A": "1",
        "B": "0",
        "C": "1/2",
        "D": "√3/2"
      },
      "answer": "A",
      "explanation": "sin(A+B) formula. sin(60+30) = sin 90° = 1.",
      "hash": "a576ed7fb99e3317",
      "translations": {
        "hi": {
          "question": "sin 60° cos 30° + sin 30° cos 60° का मान क्या है?",
          "options": {
            "A": "1",
            "B": "0",
            "C": "1/2",
            "D": "√3/2"
          },
          "explanation": "sin(A+B) = sinA cosB + cosA sinB. यहाँ A=60, B=30. sin(60+30) = sin 90° = 1."
        }
      }
    },
    {
      "id": "mathematics-01-006",
      "number": 6,
      "question": "15 men can do a work in 20 days. In how many days will 10 men complete the same work?",
      "options": {
        "A": "30",
        "B": "40",
        "C": "25",
        "D": "35"
      },
      "answer": "A",
      "explanation": "M1D1 = M2D2 => 15 × 20 = 10 × D2 => 300 = 10 × D2 => D2 = 30.",
      "hash": "b689133bc35856be",
      "translations": {
        "hi": {
          "question": "15 आदमी एक काम को 20 दिनों में कर सकते हैं। 10 आदमी उसी काम को कितने दिनों में पूरा करेंगे?",
          "options": {
            "A": "30",
            "B": "40",
            "C": "25",
            "D": "35"
          },
          "explanation": "M1D1 = M2D2 => 15 × 20 = 10 × D2 => 300 = 10 × D2 => D2 = 30."
        }
      }
    },
