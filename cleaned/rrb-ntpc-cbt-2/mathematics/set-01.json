      "options": {
        "A": "2",
        "B": "2.5",
        "C": "1.41",
        "D": "4"
      },
      "answer": "A",
      "explanation": "Mean = 3. Sum sq diff = 10. Variance = 10/5 = 2.",
      "hash": "6171353a4a812524",
      "translations": {
        "hi": {
          "question": "1, 2, 3, 4, 5 का प्रसरण (Variance) क्या है?",
          "options": {
            "A": "2",
            "B": "2.5",
            "C": "1.41",
            "D": "4"
          },
          "explanation": "माध्य = 3. (1-3)², (2-3)²... 4+1+0+1+4 = 10. प्रसरण = 10/5 = 2."
        }
      }
