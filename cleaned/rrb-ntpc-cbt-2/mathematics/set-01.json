        "hi": {
          "question": "एक समचतुर्भुज (Rhombus) का परिमाप 40 सेमी है और एक विकर्ण 12 सेमी है। दूसरा विकर्ण ज्ञात कीजिये।",
          "options": {
            "A": "16 सेमी",
            "B": "10 सेमी",
            "C": "14 सेमी",
            "D": "18 सेमी"
          },
          "explanation": "भुजा = 10। आधा विकर्ण = 6। दूसरा आधा = √(10² - 6²) = 8। पूरा विकर्ण = 16।"
        }
