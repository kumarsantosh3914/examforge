      "id": "mathematics-01-029",
      "number": 29,
      "question": "A's income is 50% more than B. B's is less than A by?",
      "options": {
        "A": "33.33%",
        "B": "50%",
        "C": "25%",
        "D": "20%"
      },
      "answer": "A",
      "explanation": "50 / 150 * 100 = 33.33%.",
      "hash": "ad086a41ead64cee",
      "translations": {
        "hi": {
          "question": "A की आय B की आय से 50% अधिक है। B की आय A से कितने प्रतिशत कम है?",
          "options": {
            "A": "33.33%",
            "B": "50%",
            "C": "25%",
            "D": "20%"
          },
          "explanation": "50 / (100+50) * 100 = 50/150 * 100 = 1/3 * 100 = 33.33%."
        }
      }
    },
