    {
      "id": "mathematics-05-025",
      "number": 25,
      "question": "Smallest 4-digit number divisible by 15, 18, 42?",
      "options": {
        "A": "1260",
        "B": "1080",
        "C": "1160",
        "D": "1050"
      },
      "answer": "A",
      "explanation": "LCM = 630. Multiples: 630, 1260. Smallest 4-digit is 1260.",
      "hash": "eadc84325f48f0b5",
      "translations": {
        "hi": {
          "question": "15, 18 और 42 से विभाज्य सबसे छोटी 4 अंकों की संख्या क्या है?",
          "options": {
            "A": "1260",
            "B": "1080",
            "C": "1160",
            "D": "1050"
          },
          "explanation": "LCM(15, 18, 42) = LCM(3×5, 2×9, 2×3×7) = 2×9×5×7 = 630. 4 अंकों की सबसे छोटी: 630 × 2 = 1260."
        }
      }
    },
