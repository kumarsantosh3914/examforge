      "id": "mathematics-05-014",
      "number": 14,
      "question": "If x + 1/x = 5, find x⁴ + 1/x⁴.",
      "options": {
        "A": "527",
        "B": "625",
        "C": "529",
        "D": "623"
      },
      "answer": "A",
      "explanation": "x² + 1/x² = 23. Square again: 529 - 2 = 527.",
      "hash": "416d186214d7d089",
      "translations": {
        "hi": {
          "question": "यदि x + 1/x = 5 है, तो x⁴ + 1/x⁴ का मान ज्ञात कीजिये।",
          "options": {
            "A": "527",
            "B": "625",
            "C": "529",
            "D": "623"
          },
          "explanation": "x² + 1/x² = 23. x⁴ + 1/x⁴ = 23² - 2 = 529 - 2 = 527."
        }
      }
    },
