    {
      "id": "mathematics-05-012",
      "number": 12,
      "question": "Ratio of father and son's age 5 years ago was 5:1. After 5 years it will be 3:1. Present age of son?",
      "options": {
        "A": "15 years",
        "B": "10 years",
        "C": "20 years",
        "D": "12 years"
      },
      "answer": "A",
      "explanation": "(5x+10)/(x+10)=3. x=10 (age 5 yrs ago). Present = 15.",
      "hash": "79c78a61048133e2",
      "translations": {
        "hi": {
          "question": "यदि 5 वर्ष पूर्व पिता और पुत्र की आयु का अनुपात 5:1 था और 5 वर्ष बाद 3:1 होगा, तो पुत्र की वर्तमान आयु क्या है?",
          "options": {
            "A": "15 वर्ष",
            "B": "10 वर्ष",
            "C": "20 वर्ष",
            "D": "12 वर्ष"
          },
          "explanation": "अंतर 10 साल। (5x+10)/(x+10) = 3/1. 5x+10 = 3x+30. 2x = 20, x = 10. 5 साल पहले पुत्र 10 का था। वर्तमान = 10 + 5 = 15।"
        }
      }
    },
