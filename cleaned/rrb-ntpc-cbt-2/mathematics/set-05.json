      "question": "If 2^(x+3) = 4^(x-1), find x.",
      "options": {
        "A": "5",
        "B": "4",
        "C": "3",
        "D": "6"
      },
      "answer": "A",
      "explanation": "x+3 = 2x-2 => x=5.",
      "hash": "dd6647460dfead39",
      "translations": {
        "hi": {
          "question": "यदि 2^(x+3) = 4^(x-1), तो x का मान ज्ञात कीजिये।",
          "options": {
            "A": "5",
            "B": "4",
            "C": "3",
            "D": "6"
          },
          "explanation": "2^(x+3) = 2^[2(x-1)]. x+3 = 2x-2. x = 5."
        }
      }
    }
