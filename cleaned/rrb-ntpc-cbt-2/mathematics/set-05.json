    {
      "id": "mathematics-05-027",
      "number": 27,
      "question": "Length of rectangle is 60% more than breadth. Diff is 24m. Find Area.",
      "options": {
        "A": "2560 m²",
        "B": "2400 m²",
        "C": "2000 m²",
        "D": "3000 m²"
      },
      "answer": "A",
      "explanation": "0.6B = 24 => B=40, L=64. Area = 2560.",
      "hash": "41d96f4ea6a3dce2",
      "translations": {
        "hi": {
          "question": "एक आयताकार भूखंड की लंबाई उसकी चौड़ाई से 60% अधिक है। यदि लंबाई और चौड़ाई का अंतर 24 मीटर है, तो भूखंड का क्षेत्रफल ज्ञात कीजिये।",
          "options": {
            "A": "2560 मीटर²",
            "B": "2400 मीटर²",
            "C": "2000 मीटर²",
            "D": "3000 मीटर²"
          },
          "explanation": "L = 1.6B. L - B = 0.6B = 24 => B = 40. L = 64. क्षेत्रफल = 64 × 40 = 2560."
        }
      }
    },
