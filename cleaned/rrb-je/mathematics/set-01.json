    {
      "id": "mathematics-01-023",
      "number": 23,
      "question": "If the area of a circle is 154 cm2, find its circumference.",
      "options": {
        "A": "44 cm",
        "B": "22 cm",
        "C": "66 cm",
        "D": "88 cm"
      },
      "answer": "A",
      "explanation": "pi * r^2 = 154 => r = 7. Circumference = 2 * pi * r = 2 * (22/7) * 7 = 44.",
      "hash": "be2dff31618543fa",
      "translations": {
        "hi": {
          "question": "यदि एक वृत्त का क्षेत्रफल 154 cm2 है, तो उसकी परिधि ज्ञात कीजिए।",
          "options": {
            "A": "44 सेमी",
            "B": "22 सेमी",
            "C": "66 सेमी",
            "D": "88 सेमी"
          },
          "explanation": "pi * r^2 = 154 => r = 7. परिधि = 2 * pi * r = 44 सेमी."
        }
      }
    },
    {
      "id": "mathematics-01-024",
      "number": 24,
      "question": "A boat travels 12 km upstream in 4 hours and 12 km downstream in 3 hours. Find the speed of the stream.",
      "options": {
        "A": "0.5 km/h",
        "B": "1 km/h",
        "C": "1.5 km/h",
        "D": "2 km/h"
      },
      "answer": "A",
      "explanation": "Upstream speed (u) = 12/4 = 3. Downstream (v) = 12/3 = 4. Stream speed = (v-u)/2 = (4-3)/2 = 0.5 km/h.",
      "hash": "3e235d40199d2863",
      "translations": {
        "hi": {
          "question": "एक नाव धारा के प्रतिकूल 12 किमी की यात्रा 4 घंटे में और धारा के अनुकूल 12 किमी की यात्रा 3 घंटे में करती है। धारा की गति ज्ञात कीजिए।",
          "options": {
            "A": "0.5 किमी/घंटा",
            "B": "1 किमी/घंटा",
            "C": "1.5 किमी/घंटा",
            "D": "2 किमी/घंटा"
          },
          "explanation": "धारा की गति = (v-u)/2 = (4-3)/2 = 0.5 किमी/घंटा."
        }
      }
    },
