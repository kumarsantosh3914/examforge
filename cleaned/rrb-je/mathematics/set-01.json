    {
      "id": "mathematics-01-014",
      "number": 14,
      "question": "Find the compound interest on Rs 10000 for 2 years at 10% per annum.",
      "options": {
        "A": "2100",
        "B": "2000",
        "C": "1100",
        "D": "2500"
      },
      "answer": "A",
      "explanation": "Amount = 10000(1 + 10/100)^2 = 12100. CI = 12100 - 10000 = 2100.",
      "hash": "5e18b86bcd34912d",
      "translations": {
        "hi": {
          "question": "10000 रुपये पर 10% वार्षिक दर से 2 वर्ष का चक्रवृद्धि ब्याज ज्ञात कीजिए।",
          "options": {
            "A": "2100",
            "B": "2000",
            "C": "1100",
            "D": "2500"
          },
          "explanation": "मिश्रधन = 10000(1.1)^2 = 12100. CI = 12100 - 10000 = 2100."
        }
      }
    },
    {
      "id": "mathematics-01-015",
      "number": 15,
      "question": "If x + 1/x = 5, find x^2 + 1/x^2.",
      "options": {
        "A": "23",
        "B": "25",
        "C": "27",
        "D": "21"
      },
      "answer": "A",
      "explanation": "x^2 + 1/x^2 = (x + 1/x)^2 - 2 = 5^2 - 2 = 25 - 2 = 23.",
      "hash": "27d5679cf98d4cb2",
      "translations": {
        "hi": {
          "question": "यदि x + 1/x = 5 है, तो x^2 + 1/x^2 ज्ञात कीजिए।",
          "options": {
            "A": "23",
            "B": "25",
            "C": "27",
            "D": "21"
          },
          "explanation": "x^2 + 1/x^2 = (x + 1/x)^2 - 2 = 25 - 2 = 23."
        }
      }
    },
