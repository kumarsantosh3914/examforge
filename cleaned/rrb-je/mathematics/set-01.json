        "hi": {
          "question": "यदि 15 पुरुष एक काम को 20 दिनों में पूरा कर सकते हैं, तो 10 पुरुष उसी काम को कितने दिनों में पूरा करेंगे?",
          "options": {
            "A": "30 दिन",
            "B": "40 दिन",
            "C": "25 दिन",
            "D": "35 दिन"
          },
          "explanation": "M1D1 = M2D2 => 15 * 20 = 10 * D2 => D2 = 30."
        }
      }
    },
