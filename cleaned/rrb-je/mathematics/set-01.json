    {
      "id": "mathematics-01-001",
      "number": 1,
      "question": "A shopkeeper marks his goods 20% above the cost price and allows a discount of 10%. Find his gain percent.",
      "options": {
        "A": "10%",
        "B": "8%",
        "C": "12%",
        "D": "15%"
      },
      "answer": "B",
      "explanation": "Gain = 20 - 10 - (20*10)/100 = 10 - 2 = 8%.",
      "hash": "fd73c5524ddbd75c",
      "translations": {
        "hi": {
          "question": "एक दुकानदार अपनी वस्तुओं पर क्रय मूल्य से 20% अधिक अंकित करता है और 10% की छूट देता है। उसका लाभ प्रतिशत ज्ञात कीजिए।",
          "options": {
            "A": "10%",
            "B": "8%",
            "C": "12%",
            "D": "15%"
          },
          "explanation": "लाभ = 20 - 10 - (20*10)/100 = 10 - 2 = 8%."
        }
      }
    },
    {
      "id": "mathematics-01-002",
      "number": 2,
      "question": "The ratio of two numbers is 3:4 and their LCM is 120. Find the sum of the numbers.",
      "options": {
        "A": "70",
        "B": "35",
        "C": "140",
        "D": "105"
      },
      "answer": "A",
      "explanation": "Let numbers be 3x and 4x. LCM(3x, 4x) = 12x. 12x = 120, so x = 10. Sum = 3x + 4x = 7x = 70.",
      "hash": "3ded190a681ca5e3",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का अनुपात 3:4 है और उनका LCM 120 है। संख्याओं का योग ज्ञात कीजिए।",
          "options": {
            "A": "70",
            "B": "35",
            "C": "140",
            "D": "105"
          },
          "explanation": "माना संख्याएँ 3x और 4x हैं। LCM(3x, 4x) = 12x. 12x = 120, इसलिए x = 10. योग = 7x = 70."
        }
      }
    },
    {
      "id": "mathematics-01-003",
      "number": 3,
      "question": "If a person travels at 40 km/h, he reaches his destination 10 minutes late. At 50 km/h, he reaches 5 minutes early. Find the distance.",
      "options": {
        "A": "50 km",
        "B": "45 km",
        "C": "60 km",
        "D": "55 km"
      },
      "answer": "A",
      "explanation": "Distance = [S1*S2 / (S2-S1)] * Diff in time = [40*50 / 10] * (15/60) = 200 * 0.25 = 50 km.",
      "hash": "4741961b45517de9",
      "translations": {
        "hi": {
          "question": "यदि कोई व्यक्ति 40 किमी/घंटा की गति से यात्रा करता है, तो वह अपने गंतव्य पर 10 मिनट देरी से पहुँचता है। 50 किमी/घंटा पर, वह 5 मिनट पहले पहुँचता है। दूरी ज्ञात कीजिए।",
          "options": {
            "A": "50 किमी",
            "B": "45 किमी",
            "C": "60 किमी",
            "D": "55 किमी"
          },
          "explanation": "दूरी = [S1*S2 / (S2-S1)] * समय में अंतर = [40*50 / 10] * (15/60) = 50 किमी."
        }
      }
    },
    {
      "id": "mathematics-01-004",
      "number": 4,
      "question": "A sum of money doubles itself in 8 years at simple interest. Find the rate of interest.",
      "options": {
        "A": "10%",
        "B": "12.5%",
        "C": "15%",
        "D": "8%"
      },
      "answer": "B",
      "explanation": "R = (n-1)*100 / T = (2-1)*100 / 8 = 12.5%.",
      "hash": "49263b70a9f794a3",
      "translations": {
        "hi": {
          "question": "साधारण ब्याज पर कोई राशि 8 वर्षों में दोगुनी हो जाती है। ब्याज की दर ज्ञात कीजिए।",
          "options": {
            "A": "10%",
            "B": "12.5%",
            "C": "15%",
            "D": "8%"
          },
          "explanation": "R = (n-1)*100 / T = (2-1)*100 / 8 = 12.5%."
        }
      }
    },
    {
      "id": "mathematics-01-005",
      "number": 5,
      "question": "Solve for x: 2^(x+3) = 32.",
      "options": {
        "A": "2",
        "B": "3",
        "C": "5",
        "D": "4"
      },
      "answer": "A",
      "explanation": "2^(x+3) = 2^5. So, x+3 = 5, x = 2.",
      "hash": "e7f9372135c5d8cf",
      "translations": {
        "hi": {
          "question": "x के लिए हल करें: 2^(x+3) = 32.",
          "options": {
            "A": "2",
            "B": "3",
            "C": "5",
            "D": "4"
          },
          "explanation": "2^(x+3) = 2^5. इसलिए, x+3 = 5, x = 2."
        }
      }
    },
    {
      "id": "mathematics-01-006",
      "number": 6,
      "question": "The average of 5 consecutive odd numbers is 25. Find the smallest number.",
      "options": {
        "A": "21",
        "B": "23",
        "C": "19",
        "D": "25"
      },
      "answer": "A",
      "explanation": "In consecutive numbers, average is the middle term. Series: 21, 23, 25, 27, 29. Smallest is 21.",
      "hash": "3f2959fe18f7bb92",
      "translations": {
        "hi": {
          "question": "5 लगातार विषम संख्याओं का औसत 25 है। सबसे छोटी संख्या ज्ञात कीजिए।",
          "options": {
            "A": "21",
            "B": "23",
            "C": "19",
            "D": "25"
          },
          "explanation": "लगातार संख्याओं में, औसत मध्य पद होता है। श्रृंखला: 21, 23, 25, 27, 29. सबसे छोटी 21 है।"
        }
      }
    },
    {
      "id": "mathematics-01-007",
      "number": 7,
      "question": "The volume of a sphere is 38808 cm3. Find its radius.",
      "options": {
        "A": "21 cm",
        "B": "14 cm",
        "C": "28 cm",
        "D": "7 cm"
      },
      "answer": "A",
      "explanation": "V = (4/3) * pi * r^3 = 38808. r^3 = (38808 * 3 * 7) / (4 * 22) = 9261. r = 21 cm.",
      "hash": "218973e03df96447",
      "translations": {
        "hi": {
          "question": "एक गोले का आयतन 38808 cm3 है। इसकी त्रिज्या ज्ञात कीजिए।",
          "options": {
            "A": "21 सेमी",
            "B": "14 सेमी",
            "C": "28 सेमी",
            "D": "7 सेमी"
          },
          "explanation": "आयतन = (4/3) * pi * r^3 = 38808. r = 21 सेमी."
        }
      }
    },
    {
      "id": "mathematics-01-008",
      "number": 8,
      "question": "A train 150m long passes a pole in 15 seconds. Find its speed in km/h.",
      "options": {
        "A": "36 km/h",
        "B": "45 km/h",
        "C": "30 km/h",
        "D": "54 km/h"
      },
      "answer": "A",
      "explanation": "Speed = 150/15 = 10 m/s. In km/h = 10 * 18/5 = 36 km/h.",
      "hash": "94caba6037b543d6",
      "translations": {
        "hi": {
          "question": "150 मीटर लंबी एक ट्रेन 15 सेकंड में एक खंभे को पार करती है। किमी/घंटा में इसकी गति ज्ञात कीजिए।",
          "options": {
            "A": "36 किमी/घंटा",
            "B": "45 किमी/घंटा",
            "C": "30 किमी/घंटा",
            "D": "54 किमी/घंटा"
          },
          "explanation": "गति = 150/15 = 10 मीटर/सेकंड. किमी/घंटा में = 10 * 18/5 = 36 किमी/घंटा."
        }
      }
    },
    {
      "id": "mathematics-01-009",
      "number": 9,
      "question": "If tan A = 3/4, find the value of sin A.",
      "options": {
        "A": "3/5",
        "B": "4/5",
        "C": "5/3",
        "D": "3/7"
      },
      "answer": "A",
      "explanation": "tan A = P/B = 3/4. H = sqrt(3^2 + 4^2) = 5. sin A = P/H = 3/5.",
      "hash": "f09fef41b2168e90",
      "translations": {
        "hi": {
          "question": "यदि tan A = 3/4 है, तो sin A का मान ज्ञात कीजिए।",
          "options": {
            "A": "3/5",
            "B": "4/5",
            "C": "5/3",
            "D": "3/7"
          },
          "explanation": "tan A = लंब/आधार = 3/4. कर्ण = sqrt(3^2 + 4^2) = 5. sin A = लंब/कर्ण = 3/5."
        }
      }
    },
    {
      "id": "mathematics-01-010",
      "number": 10,
      "question": "15% of 40% of a number is 12. Find the number.",
