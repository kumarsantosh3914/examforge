            "B": "36",
            "C": "45",
            "D": "54"
          },
          "explanation": "9/18 = 18/x => x = (18*18)/9 = 36."
        }
      }
    },
    {
      "id": "mathematics-10-009",
      "number": 9,
      "question": "A and B can do a work in 12 and 24 days respectively. How many days will they take together?",
      "options": {
        "A": "6 days",
        "B": "8 days",
        "C": "10 days",
        "D": "9 days"
      },
      "answer": "B",
      "explanation": "(12*24)/(12+24) = 288/36 = 8 days.",
      "hash": "5839fc31ba1f1a51",
      "translations": {
        "hi": {
          "question": "A और B एक काम को क्रमशः 12 और 24 दिनों में कर सकते हैं। वे मिलकर कितने दिन लेंगे?",
          "options": {
            "A": "6 दिन",
            "B": "8 दिन",
            "C": "10 दिन",
            "D": "9 दिन"
          },
          "explanation": "(12*24)/(12+24) = 288/36 = 8 दिन।"
        }
      }
    },
