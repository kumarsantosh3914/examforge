    {
      "id": "mathematics-10-001",
      "number": 1,
      "question": "A person travels 280 km by car at a speed of 70 km/hr. How much time does he take?",
      "options": {
        "A": "3 hours",
        "B": "4 hours",
        "C": "5 hours",
        "D": "6 hours"
      },
      "answer": "B",
      "explanation": "Time = Distance / Speed = 280 / 70 = 4 hours.",
      "hash": "62fab562b1bac9f3",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति कार द्वारा 70 किमी/घंटा की गति से 280 किमी की यात्रा करता है। उसे कितना समय लगता है?",
          "options": {
            "A": "3 घंटे",
            "B": "4 घंटे",
            "C": "5 घंटे",
            "D": "6 घंटे"
          },
          "explanation": "समय = दूरी / गति = 280 / 70 = 4 घंटे।"
        }
      }
    },
    {
      "id": "mathematics-10-002",
      "number": 2,
      "question": "If 15% of 200 + x% of 300 = 60, find the value of x.",
      "options": {
        "A": "5",
        "B": "10",
        "C": "15",
        "D": "20"
      },
      "answer": "B",
      "explanation": "30 + 3x = 60 => 3x = 30 => x = 10.",
      "hash": "672a54858efa195c",
      "translations": {
        "hi": {
          "question": "यदि 200 का 15% + 300 का x% = 60 है, तो x का मान ज्ञात कीजिए।",
          "options": {
            "A": "5",
            "B": "10",
            "C": "15",
            "D": "20"
          },
          "explanation": "30 + 3x = 60 => 3x = 30 => x = 10."
        }
      }
    },
    {
      "id": "mathematics-10-003",
      "number": 3,
      "question": "The sum of two numbers is 22 and their difference is 8. Find the product of the numbers.",
      "options": {
        "A": "105",
        "B": "110",
        "C": "120",
        "D": "130"
      },
      "answer": "A",
      "explanation": "x+y=22, x-y=8. Adding gives 2x=30, x=15. Then y=7. Product = 15*7 = 105.",
      "hash": "ca88874761aa4acb",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का योग 22 है और उनका अंतर 8 है। संख्याओं का गुणनफल ज्ञात कीजिए।",
          "options": {
            "A": "105",
            "B": "110",
            "C": "120",
            "D": "130"
          },
          "explanation": "x+y=22, x-y=8. जोड़ने पर 2x=30, x=15 प्राप्त होता है। फिर y=7. गुणनफल = 15*7 = 105."
        }
      }
    },
    {
      "id": "mathematics-10-004",
      "number": 4,
      "question": "If the length of a rectangle is 15 cm and breadth is 10 cm, find its area.",
      "options": {
        "A": "50 cm²",
        "B": "150 cm²",
        "C": "100 cm²",
        "D": "25 cm²"
      },
      "answer": "B",
      "explanation": "Area = L * B = 15 * 10 = 150.",
      "hash": "8fb0e733bf42ec42",
      "translations": {
        "hi": {
          "question": "यदि एक आयत की लंबाई 15 सेमी और चौड़ाई 10 सेमी है, तो इसका क्षेत्रफल ज्ञात कीजिए।",
          "options": {
            "A": "50 सेमी²",
            "B": "150 सेमी²",
            "C": "100 सेमी²",
            "D": "25 सेमी²"
          },
          "explanation": "क्षेत्रफल = लंबाई * चौड़ाई = 15 * 10 = 150."
        }
      }
    },
    {
      "id": "mathematics-10-005",
