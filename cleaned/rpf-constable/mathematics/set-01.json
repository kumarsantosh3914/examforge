      "id": "mathematics-01-001",
      "number": 1,
      "question": "If 15% of A = 20% of B, then A:B is?",
      "options": {
        "A": "3:4",
        "B": "4:3",
        "C": "17:16",
        "D": "16:17"
      },
      "answer": "B",
      "explanation": "15A = 20B => A/B = 20/15 = 4/3.",
      "hash": "d2fd1c4d952839ff",
      "translations": {
        "hi": {
          "question": "यदि A का 15% = B का 20% है, तो A:B क्या है?",
          "options": {
            "A": "3:4",
            "B": "4:3",
            "C": "17:16",
            "D": "16:17"
          },
          "explanation": "15A = 20B => A/B = 20/15 = 4/3."
        }
      }
    },
    {
      "id": "mathematics-01-002",
      "number": 2,
      "question": "The ratio of two numbers is 3:4 and their HCF is 4. What is their LCM?",
      "options": {
        "A": "12",
        "B": "16",
        "C": "24",
        "D": "48"
      },
      "answer": "D",
      "explanation": "LCM = Ratio Product * HCF = 3 * 4 * 4 = 48.",
      "hash": "28df9f506aa01748",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का अनुपात 3:4 है और उनका HCF 4 है। उनका LCM क्या है?",
          "options": {
            "A": "12",
            "B": "16",
            "C": "24",
            "D": "48"
          },
          "explanation": "LCM = अनुपातों का गुणनफल * HCF = 3 * 4 * 4 = 48."
        }
      }
    },
    {
      "id": "mathematics-01-003",
      "number": 3,
      "question": "A person crosses a 600 m long street in 5 minutes. What is his speed in km/hr?",
      "options": {
        "A": "3.6",
        "B": "7.2",
        "C": "8.4",
        "D": "10"
      },
      "answer": "B",
      "explanation": "Speed = Distance/Time = 600/300 = 2 m/s. In km/hr = 2 * (18/5) = 7.2 km/hr.",
      "hash": "02f4e273e31a2d09",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति 5 मिनट में 600 मीटर लंबी सड़क पार करता है। किमी/घंटा में उसकी गति क्या है?",
          "options": {
            "A": "3.6",
            "B": "7.2",
            "C": "8.4",
            "D": "10"
          },
          "explanation": "गति = दूरी/समय = 600/300 = 2 मीटर/सेकंड। किमी/घंटा में = 2 * (18/5) = 7.2 किमी/घंटा।"
        }
      }
    },
    {
      "id": "mathematics-01-004",
      "number": 4,
      "question": "A sum of money doubles itself at compound interest in 15 years. It will become eight times in?",
      "options": {
        "A": "30 years",
        "B": "40 years",
        "C": "45 years",
        "D": "60 years"
      },
      "answer": "C",
      "explanation": "2 times in 15 yrs. 8 times = 2^3 times. Time = 3 * 15 = 45 years.",
      "hash": "554e1aafefdab580",
      "translations": {
        "hi": {
          "question": "चक्रवृद्धि ब्याज पर कोई राशि 15 वर्षों में दुगुनी हो जाती है। यह आठ गुना कितने समय में होगी?",
          "options": {
            "A": "30 वर्ष",
            "B": "40 वर्ष",
            "C": "45 वर्ष",
            "D": "60 वर्ष"
          },
          "explanation": "15 वर्ष में 2 गुना। 8 गुना = 2^3 गुना। समय = 3 * 15 = 45 वर्ष।"
        }
      }
    },
    {
      "id": "mathematics-01-005",
      "number": 5,
      "question": "Find the value of x: 25% of 400 + x% of 500 = 150.",
