    {
      "id": "mathematics-01-025",
      "number": 25,
      "question": "A boat goes 24 km downstream in 2 hours and 24 km upstream in 6 hours. Find speed of boat in still water.",
      "options": {
        "A": "4 km/hr",
        "B": "8 km/hr",
        "C": "10 km/hr",
        "D": "12 km/hr"
      },
      "answer": "B",
      "explanation": "Down speed = 12, Up speed = 4. Boat speed = (12+4)/2 = 8 km/hr.",
      "hash": "ff93bd56dcc44260",
      "translations": {
        "hi": {
          "question": "एक नाव धारा के अनुकूल 24 किमी 2 घंटे में और धारा के प्रतिकूल 24 किमी 6 घंटे में जाती है। शांत जल में नाव की गति ज्ञात कीजिए।",
          "options": {
            "A": "4 किमी/घंटा",
            "B": "8 किमी/घंटा",
            "C": "10 किमी/घंटा",
            "D": "12 किमी/घंटा"
          },
          "explanation": "अनुकूल गति = 12, प्रतिकूल गति = 4। नाव की गति = (12+4)/2 = 8 किमी/घंटा।"
        }
      }
    },
    {
      "id": "mathematics-01-026",
      "number": 26,
      "question": "The LCM of two prime numbers x and y (x > y) is 161. The value of 3y - x is?",
      "options": {
        "A": "-2",
        "B": "2",
        "C": "1",
        "D": "-1"
      },
      "answer": "A",
      "explanation": "161 = 23 * 7. x=23, y=7. 3(7) - 23 = 21 - 23 = -2.",
      "hash": "3db984e6c4609bed",
      "translations": {
        "hi": {
          "question": "दो अभाज्य संख्याओं x और y (x > y) का LCM 161 है। 3y - x का मान क्या है?",
          "options": {
            "A": "-2",
            "B": "2",
            "C": "1",
            "D": "-1"
          },
          "explanation": "161 = 23 * 7। x=23, y=7। 3(7) - 23 = 21 - 23 = -2।"
        }
      }
    },
