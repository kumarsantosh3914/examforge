          "options": {
            "A": "5 दिन",
            "B": "6 दिन",
            "C": "8 दिन",
            "D": "9 दिन"
          },
          "explanation": "समय = (10*15)/(10+15) = 150/25 = 6 दिन।"
        }
      }
    },
