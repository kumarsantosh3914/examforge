      "hash": "7637f46df2d0a175",
      "translations": {
        "hi": {
          "question": "एक वृत्त की परिधि और व्यास का अनुपात क्या है?",
          "options": {
            "A": "1:pi",
            "B": "pi:1",
            "C": "2*pi:1",
            "D": "1:1"
          },
          "explanation": "परिधि = pi*d। अनुपात = pi*d / d = pi:1।"
        }
      }
