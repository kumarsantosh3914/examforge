        "D": "20"
      },
      "answer": "B",
      "explanation": "100 + 5x = 150 => 5x = 50 => x = 10.",
      "hash": "a744b0defa3c7c84",
      "translations": {
        "hi": {
          "question": "x का मान ज्ञात करें: 400 का 25% + 500 का x% = 150.",
          "options": {
            "A": "5",
            "B": "10",
            "C": "15",
            "D": "20"
          },
          "explanation": "100 + 5x = 150 => 5x = 50 => x = 10."
        }
      }
    },
