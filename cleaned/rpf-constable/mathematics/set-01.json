          "options": {
            "A": "154 सेमी³",
            "B": "1540 सेमी³",
            "C": "770 सेमी³",
            "D": "440 सेमी³"
          },
          "explanation": "आयतन = pi * r^2 * h = (22/7) * 7 * 7 * 10 = 1540।"
        }
