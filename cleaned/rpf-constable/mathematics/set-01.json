    {
      "id": "mathematics-01-007",
      "number": 7,
      "question": "If the area of a square is 625 sq.cm, find its perimeter.",
      "options": {
        "A": "25 cm",
        "B": "50 cm",
        "C": "100 cm",
        "D": "125 cm"
      },
      "answer": "C",
      "explanation": "Side = sqrt(625) = 25. Perimeter = 4 * 25 = 100 cm.",
      "hash": "983bb7ac1f3b6377",
      "translations": {
        "hi": {
          "question": "यदि एक वर्ग का क्षेत्रफल 625 वर्ग सेमी है, तो उसका परिमाप ज्ञात कीजिए।",
          "options": {
            "A": "25 सेमी",
            "B": "50 सेमी",
            "C": "100 सेमी",
            "D": "125 सेमी"
          },
          "explanation": "भुजा = sqrt(625) = 25। परिमाप = 4 * 25 = 100 सेमी।"
        }
      }
    },
    {
      "id": "mathematics-01-008",
      "number": 8,
      "question": "A shopkeeper buys an article for Rs. 450 and sells it for Rs. 540. Find his gain percent.",
      "options": {
        "A": "10%",
        "B": "15%",
        "C": "20%",
        "D": "25%"
      },
      "answer": "C",
      "explanation": "Gain = 540 - 450 = 90. Profit % = (90/450) * 100 = 20%.",
      "hash": "89614b0b05c1d5b2",
      "translations": {
        "hi": {
          "question": "एक दुकानदार एक वस्तु को 450 रुपये में खरीदता है और 540 रुपये में बेचता है। उसका लाभ प्रतिशत ज्ञात कीजिए।",
          "options": {
            "A": "10%",
            "B": "15%",
            "C": "20%",
            "D": "25%"
          },
          "explanation": "लाभ = 540 - 450 = 90। लाभ % = (90/450) * 100 = 20%।"
        }
      }
    },
    {
      "id": "mathematics-01-009",
      "number": 9,
      "question": "A and B can do a work in 10 and 15 days respectively. In how many days they together finish it?",
