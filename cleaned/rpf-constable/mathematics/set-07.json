      "translations": {
        "hi": {
          "question": "उस वृत्त का क्षेत्रफल ज्ञात कीजिए जिसकी परिधि 44 सेमी है।",
          "options": {
            "A": "154 सेमी²",
            "B": "44 सेमी²",
            "C": "308 सेमी²",
            "D": "616 सेमी²"
          },
          "explanation": "2*pi*r = 44 => r = 7। क्षेत्रफल = pi * 7 * 7 = 154."
        }
