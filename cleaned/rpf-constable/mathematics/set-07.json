          "options": {
            "A": "0.2",
            "B": "0.5",
            "C": "0.8",
            "D": "0.3"
          },
          "explanation": "यह (a^3+b^3)/(a^2-ab+b^2) = a+b = 0.5 + 0.3 = 0.8 है।"
        }
      }
    },
