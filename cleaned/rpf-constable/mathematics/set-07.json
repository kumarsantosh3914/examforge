      "hash": "1b9cc48ba66c8015",
      "translations": {
        "hi": {
          "question": "कोई राशि साधारण ब्याज पर 20 वर्षों में तिगुनी हो जाती है। वार्षिक ब्याज दर ज्ञात कीजिए।",
          "options": {
            "A": "5%",
            "B": "10%",
            "C": "15%",
            "D": "20%"
          },
          "explanation": "SI = 2P. R = (2P * 100) / (P * 20) = 10%."
        }
      }
    },
