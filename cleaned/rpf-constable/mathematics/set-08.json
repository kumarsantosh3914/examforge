    {
      "id": "mathematics-08-001",
      "number": 1,
      "question": "The sum of the ages of A and B is 40 years. 5 years ago, the ratio of their ages was 2:1. Find the current age of A.",
      "options": {
        "A": "20 years",
        "B": "25 years",
        "C": "15 years",
        "D": "30 years"
      },
      "answer": "B",
      "explanation": "Sum 5 years ago = 40 - 10 = 30. Ratio 2:1 means A was 20 and B was 10. Current A = 20 + 5 = 25.",
      "hash": "87f759d1ec56f3e1",
      "translations": {
        "hi": {
          "question": "A और B की आयु का योग 40 वर्ष है। 5 वर्ष पहले, उनकी आयु का अनुपात 2:1 था। A की वर्तमान आयु ज्ञात कीजिए।",
          "options": {
            "A": "20 वर्ष",
            "B": "25 वर्ष",
            "C": "15 वर्ष",
            "D": "30 वर्ष"
          },
          "explanation": "5 वर्ष पहले योग = 40 - 10 = 30। अनुपात 2:1 का अर्थ है A 20 वर्ष का था और B 10 वर्ष का। वर्तमान A = 20 + 5 = 25।"
        }
      }
    },
    {
      "id": "mathematics-08-002",
      "number": 2,
      "question": "Find the smallest number of five digits exactly divisible by 16, 24, 60 and 72.",
      "options": {
        "A": "10080",
        "B": "10000",
        "C": "10800",
        "D": "11520"
      },
      "answer": "A",
      "explanation": "LCM of (16, 24, 60, 72) = 720. Smallest 5-digit multiple of 720 is 10080.",
      "hash": "daebbc1d1a91d43a",
      "translations": {
        "hi": {
          "question": "16, 24, 60 और 72 से पूर्णतः विभाज्य पांच अंकों की सबसे छोटी संख्या ज्ञात कीजिए।",
          "options": {
            "A": "10080",
            "B": "10000",
            "C": "10800",
            "D": "11520"
          },
          "explanation": "(16, 24, 60, 72) का LCM = 720 है। 720 का 5 अंकों वाला सबसे छोटा गुणज 10080 है।"
        }
      }
    },
    {
      "id": "mathematics-08-003",
      "number": 3,
      "question": "A shopkeeper marks his goods 40% above the cost price and allows a discount of 25%. Find his profit percentage.",
      "options": {
        "A": "5%",
        "B": "10%",
        "C": "15%",
        "D": "20%"
      },
      "answer": "A",
      "explanation": "Net change = 40 - 25 - (40 * 25 / 100) = 15 - 10 = 5%.",
      "hash": "d0b80e866d8767df",
      "translations": {
        "hi": {
          "question": "एक दुकानदार अपने माल पर क्रय मूल्य से 40% अधिक अंकित करता है और 25% की छूट देता है। उसका लाभ प्रतिशत ज्ञात कीजिए।",
          "options": {
            "A": "5%",
            "B": "10%",
            "C": "15%",
            "D": "20%"
          },
          "explanation": "शुद्ध परिवर्तन = 40 - 25 - (40 * 25 / 100) = 15 - 10 = 5%।"
        }
      }
    },
    {
      "id": "mathematics-08-004",
      "number": 4,
      "question": "A can do a piece of work in 20 days and B in 30 days. They work together for 5 days and then B leaves. In how many more days will A finish the work?",
      "options": {
        "A": "10 days",
        "B": "11.66 days",
        "C": "12 days",
        "D": "15 days"
      },
      "answer": "B",
      "explanation": "Combined 5-day work = 5 * (1/20 + 1/30) = 5 * 5/60 = 5/12. Remaining = 7/12. Time for A = (7/12) * 20 = 140/12 = 11.66.",
      "hash": "a9524052d65cea85",
      "translations": {
        "hi": {
          "question": "A एक काम को 20 दिनों में और B 30 दिनों में कर सकता है। वे 5 दिनों तक साथ काम करते हैं और फिर B चला जाता है। A शेष काम को कितने और दिनों में पूरा करेगा?",
          "options": {
            "A": "10 दिन",
            "B": "11.66 दिन",
            "C": "12 दिन",
            "D": "15 दिन"
          },
          "explanation": "5 दिनों का संयुक्त कार्य = 5/12। शेष = 7/12। A का समय = (7/12) * 20 = 11.66 दिन।"
        }
      }
    },
    {
      "id": "mathematics-08-005",
      "number": 5,
      "question": "The ratio of the volumes of two spheres is 8:27. Find the ratio of their radii.",
      "options": {
        "A": "2:3",
        "B": "4:9",
        "C": "1:3",
        "D": "3:4"
      },
      "answer": "A",
      "explanation": "Volume ratio = r1^3 / r2^3. r1/r2 = cbrt(8/27) = 2/3.",
      "hash": "5395ceda27faa1f8",
      "translations": {
        "hi": {
          "question": "दो गोलों के आयतनों का अनुपात 8:27 है। उनकी त्रिज्याओं का अनुपात ज्ञात कीजिए।",
          "options": {
            "A": "2:3",
            "B": "4:9",
            "C": "1:3",
            "D": "3:4"
          },
          "explanation": "आयतन अनुपात = r1^3 / r2^3। r1/r2 = cbrt(8/27) = 2/3।"
        }
      }
    },
    {
      "id": "mathematics-08-006",
      "number": 6,
      "question": "A train running at 72 km/hr crosses a bridge in 30 seconds. If the train is 200 m long, find the length of the bridge.",
      "options": {
        "A": "300 m",
        "B": "400 m",
        "C": "500 m",
        "D": "600 m"
      },
      "answer": "B",
      "explanation": "Speed = 20 m/s. Total distance = 20 * 30 = 600 m. Bridge = 600 - 200 = 400 m.",
      "hash": "04e34f10bec1c3fc",
      "translations": {
        "hi": {
          "question": "72 किमी/घंटा की गति से चलने वाली एक ट्रेन 30 सेकंड में एक पुल को पार करती है। यदि ट्रेन 200 मीटर लंबी है, तो पुल की लंबाई ज्ञात कीजिए।",
          "options": {
            "A": "300 मीटर",
            "B": "400 मीटर",
            "C": "500 मीटर",
            "D": "600 मीटर"
          },
          "explanation": "गति = 20 मी/से। कुल दूरी = 20 * 30 = 600 मीटर। पुल = 600 - 200 = 400 मीटर।"
        }
      }
    },
    {
