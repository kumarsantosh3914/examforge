      "id": "mathematics-08-028",
      "number": 28,
      "question": "A vendor bought 6 bananas for Rs. 10 and sold 4 bananas for Rs. 10. Find his gain percent.",
      "options": {
        "A": "20%",
        "B": "33.33%",
        "C": "50%",
        "D": "60%"
      },
      "answer": "C",
      "explanation": "CP of 12 = 20. SP of 12 = 30. Gain = 10. Gain % = (10/20) * 100 = 50%.",
      "hash": "d55a9c01372aa124",
      "translations": {
        "hi": {
          "question": "एक विक्रेता ने 10 रुपये में 6 केले खरीदे और 10 रुपये में 4 केले बेचे। उसका लाभ प्रतिशत ज्ञात कीजिए।",
          "options": {
            "A": "20%",
            "B": "33.33%",
            "C": "50%",
            "D": "60%"
          },
          "explanation": "12 का CP = 20. 12 का SP = 30. लाभ = 10. लाभ % = (10/20) * 100 = 50%।"
        }
      }
    },
    {
      "id": "mathematics-08-029",
      "number": 29,
      "question": "Find the LCM of 24, 36 and 40.",
      "options": {
        "A": "120",
        "B": "240",
        "C": "360",
        "D": "480"
      },
      "answer": "C",
      "explanation": "24=2^3*3, 36=2^2*3^2, 40=2^3*5. LCM = 2^3*3^2*5 = 8*9*5 = 360.",
      "hash": "106a9294672465ed",
      "translations": {
        "hi": {
          "question": "24, 36 और 40 का LCM ज्ञात कीजिए।",
          "options": {
            "A": "120",
            "B": "240",
            "C": "360",
            "D": "480"
          },
          "explanation": "24=2^3*3, 36=2^2*3^2, 40=2^3*5. LCM = 360."
        }
      }
    },
    {
      "id": "mathematics-08-030",
      "number": 30,
      "question": "The volume of a cube is 216 cubic cm. Find its diagonal.",
      "options": {
        "A": "6 cm",
        "B": "6*sqrt(2) cm",
        "C": "6*sqrt(3) cm",
        "D": "12 cm"
      },
      "answer": "C",
      "explanation": "Side a = cbrt(216) = 6. Diagonal = a*sqrt(3) = 6*sqrt(3).",
      "hash": "83a7ead29cc7994f",
      "translations": {
        "hi": {
          "question": "एक घन का आयतन 216 घन सेमी है। इसका विकर्ण ज्ञात कीजिए।",
          "options": {
            "A": "6 सेमी",
            "B": "6*sqrt(2) सेमी",
            "C": "6*sqrt(3) सेमी",
            "D": "12 सेमी"
          },
          "explanation": "भुजा a = cbrt(216) = 6। विकर्ण = a*sqrt(3) = 6*sqrt(3)।"
        }
      }
    },
    {
