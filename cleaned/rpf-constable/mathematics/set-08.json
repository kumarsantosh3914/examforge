    },
    {
      "id": "mathematics-08-032",
      "number": 32,
      "question": "In a mixture of 40 liters, the ratio of milk and water is 3:1. How much water should be added so the ratio becomes 2:1?",
      "options": {
        "A": "5 liters",
        "B": "10 liters",
        "C": "15 liters",
        "D": "20 liters"
      },
      "answer": "A",
      "explanation": "Initial Milk=30, Water=10. New Water 'x': 30/(10+x) = 2/1 => 20+2x = 30 => x = 5.",
      "hash": "97cc799edc0578e9",
      "translations": {
        "hi": {
          "question": "40 लीटर के मिश्रण में दूध और पानी का अनुपात 3:1 है। कितना पानी मिलाया जाना चाहिए ताकि अनुपात 2:1 हो जाए?",
          "options": {
            "A": "5 लीटर",
            "B": "10 लीटर",
            "C": "15 लीटर",
            "D": "20 लीटर"
          },
          "explanation": "प्रारंभ में दूध=30, पानी=10। नया पानी 'x': 30/(10+x) = 2/1 => 20+2x = 30 => x = 5."
        }
      }
    },
