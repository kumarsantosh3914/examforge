      "hash": "ace9641f1d2ced87",
      "translations": {
        "hi": {
          "question": "यदि 3x = 5y और 4y = 7z है, तो x:z क्या है?",
          "options": {
            "A": "35:12",
            "B": "12:35",
            "C": "15:28",
            "D": "28:15"
          },
          "explanation": "x/y = 5/3 और y/z = 7/4. x/z = (5/3) * (7/4) = 35/12."
        }
      }
    },
    {
      "id": "mathematics-08-012",
      "number": 12,
      "question": "The mean of 5 numbers is 20. If each number is increased by 2, what will be the new mean?",
