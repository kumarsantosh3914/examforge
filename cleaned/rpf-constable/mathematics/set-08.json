      "hash": "c038d704deaaebc4",
      "translations": {
        "hi": {
          "question": "200 मीटर लंबी एक ट्रेन 300 मीटर लंबे प्लेटफॉर्म को 25 सेकंड में पार करती है। किमी/घंटा में इसकी गति ज्ञात कीजिए।",
          "options": {
            "A": "54",
            "B": "72",
            "C": "90",
            "D": "108"
          },
          "explanation": "दूरी = 500 मीटर। गति = 500/25 = 20 मी/से = 72 किमी/घंटा।"
