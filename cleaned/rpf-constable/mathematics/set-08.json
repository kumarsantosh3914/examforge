      },
      "answer": "B",
      "explanation": "New Mean = Old Mean + 2 = 20 + 2 = 22.",
      "hash": "23a896ce0d3b6b62",
      "translations": {
        "hi": {
          "question": "5 संख्याओं का माध्य 20 है। यदि प्रत्येक संख्या में 2 की वृद्धि की जाती है, तो नया माध्य क्या होगा?",
          "options": {
            "A": "20",
            "B": "22",
            "C": "24",
            "D": "25"
          },
          "explanation": "नया माध्य = पुराना माध्य + 2 = 20 + 2 = 22."
        }
      }
    },
