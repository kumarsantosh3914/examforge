      "translations": {
        "hi": {
          "question": "एक पासा फेंकने पर अभाज्य संख्या आने की प्रायिकता ज्ञात कीजिए।",
          "options": {
            "A": "1/2",
            "B": "1/3",
            "C": "1/6",
            "D": "2/3"
          },
          "explanation": "पासे पर अभाज्य संख्याएँ: 2, 3, 5। कुल = 3। प्रायिकता = 3/6 = 1/2।"
        }
      }
    },
    {
      "id": "mathematics-08-014",
      "number": 14,
      "question": "A cylinder has a radius of 14 cm and its curved surface area is 880 sq.cm. Find its height.",
      "options": {
        "A": "5 cm",
        "B": "10 cm",
        "C": "15 cm",
        "D": "20 cm"
      },
      "answer": "B",
      "explanation": "2 * (22/7) * 14 * h = 880 => 88 * h = 880 => h = 10.",
      "hash": "d4f265ed0bf5e875",
      "translations": {
        "hi": {
          "question": "एक बेलन की त्रिज्या 14 सेमी है और इसका वक्र पृष्ठीय क्षेत्रफल 880 वर्ग सेमी है। इसकी ऊँचाई ज्ञात कीजिए।",
          "options": {
            "A": "5 सेमी",
            "B": "10 सेमी",
            "C": "15 सेमी",
            "D": "20 सेमी"
          },
          "explanation": "2 * (22/7) * 14 * h = 880 => 88 * h = 880 => h = 10."
        }
      }
    },
