    {
      "id": "mathematics-08-026",
      "number": 26,
      "question": "If a circle's radius is doubled, by how many times does its area increase?",
      "options": {
        "A": "2 times",
        "B": "4 times",
        "C": "8 times",
        "D": "16 times"
      },
      "answer": "B",
      "explanation": "Area = pi * r^2. If r becomes 2r, Area = pi * (2r)^2 = 4 * pi * r^2.",
      "hash": "eadbd05d20615289",
      "translations": {
        "hi": {
          "question": "यदि एक वृत्त की त्रिज्या दोगुनी कर दी जाए, तो उसका क्षेत्रफल कितने गुना बढ़ जाएगा?",
          "options": {
            "A": "2 गुना",
            "B": "4 गुना",
            "C": "8 गुना",
            "D": "16 गुना"
          },
          "explanation": "क्षेत्रफल = pi * r^2। यदि r, 2r हो जाता है, तो क्षेत्रफल = 4 * pi * r^2."
        }
      }
    },
