      "translations": {
        "hi": {
          "question": "यदि किसी संख्या का 3/5 भाग उसके 1/2 भाग से 20 अधिक है, तो संख्या ज्ञात कीजिए।",
          "options": {
            "A": "100",
            "B": "200",
            "C": "300",
            "D": "400"
          },
          "explanation": "(3/5 - 1/2)x = 20 => (1/10)x = 20 => x = 200."
        }
      }
    }
