    {
      "id": "mathematics-04-015",
      "number": 15,
      "question": "The sides of a triangle are in the ratio 3:4:5. If its perimeter is 24 cm, what is its area?",
      "options": {
        "A": "12",
        "B": "24",
        "C": "30",
        "D": "48"
      },
      "answer": "B",
      "explanation": "Sides are 6, 8, 10 (3x+4x+5x=24 => 12x=24 => x=2). It's a right triangle. Area = (1/2)×6×8 = 24",
      "hash": "b94514c34c07bc5c",
      "translations": {
        "hi": {
          "question": "एक त्रिभुज की भुजाएं 3:4:5 के अनुपात में हैं। यदि इसका परिमाप 24 सेमी है, तो इसका क्षेत्रफल क्या है?",
          "options": {
            "A": "12",
            "B": "24",
            "C": "30",
            "D": "48"
          },
          "explanation": "भुजाएं 6, 8, 10 हैं (3x+4x+5x=24 => 12x=24 => x=2)। यह समकोण त्रिभुज है। क्षेत्रफल = (1/2)×6×8 = 24"
        }
      }
    },
