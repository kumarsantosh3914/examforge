      "translations": {
        "hi": {
          "question": "एक व्यक्ति 5 किमी/घंटा की गति से चलकर एक पुल को 15 मिनट में पार करता है। पुल की लंबाई (मीटर में) क्या है?",
          "options": {
            "A": "600",
            "B": "750",
            "C": "1000",
            "D": "1250"
          },
          "explanation": "गति = 5 × (5/18) मी/से. समय = 15×60 = 900 सेकंड. दूरी = (25/18) × 900 = 25 × 50 = 1250 मीटर"
        }
