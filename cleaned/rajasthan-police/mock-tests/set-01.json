      "id": "mock-tests-01-001",
      "number": 1,
      "question": "If today is Friday, what day will it be after 31 days?",
      "options": {
        "A": "Saturday",
        "B": "Tuesday",
        "C": "Monday",
        "D": "Wednesday"
      },
      "answer": "C",
      "explanation": "31 mod 7 = 3; Friday + 3 = Monday.",
      "hash": "2a6666f0813abef2"
    },
    {
      "id": "mock-tests-01-002",
      "number": 2,
      "question": "Which letter is 4th to the right of the 11th letter from the left in the English alphabet?",
