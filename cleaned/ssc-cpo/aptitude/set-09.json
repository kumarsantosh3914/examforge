    {
      "id": "aptitude-09-010",
      "number": 10,
      "question": "If the area of a circle is 1386 sq.cm, find its circumference.",
      "options": {
        "A": "132 cm",
        "B": "154 cm",
        "C": "88 cm",
        "D": "44 cm"
      },
      "answer": "A",
      "explanation": "PI*r^2 = 1386 => r^2 = 1386 * 7 / 22 = 441 => r = 21. Circumference = 2 * 22/7 * 21 = 132.",
      "hash": "b366214e07e77f79",
      "translations": {
        "hi": {
          "question": "यदि एक वृत्त का क्षेत्रफल 1386 वर्ग सेमी है, तो इसकी परिधि ज्ञात कीजिए।",
          "options": {
            "A": "132 सेमी",
            "B": "154 सेमी",
            "C": "88 सेमी",
            "D": "44 सेमी"
          },
          "explanation": "r^2 = 441 => r = 21. परिधि = 132."
        }
      }
    },
    {
      "id": "aptitude-09-011",
      "number": 11,
      "question": "A train 300m long is running at a speed of 90 km/h. How many seconds will it take to cross a 200m long bridge?",
      "options": {
