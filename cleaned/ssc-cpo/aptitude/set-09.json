    {
      "id": "aptitude-09-001",
      "number": 1,
      "question": "A can do a work in 15 days and B in 20 days. If they work on it together for 4 days, then the fraction of the work that is left is?",
      "options": {
        "A": "8/15",
        "B": "7/15",
        "C": "1/4",
        "D": "1/10"
      },
      "answer": "A",
      "explanation": "1 day work = 1/15 + 1/20 = 7/60. 4 days work = 28/60 = 7/15. Left = 1 - 7/15 = 8/15.",
      "hash": "1ee508417f3b8ca3",
      "translations": {
        "hi": {
          "question": "A एक कार्य को 15 दिनों में और B 20 दिनों में कर सकता है। यदि वे 4 दिनों तक साथ मिलकर कार्य करते हैं, तो कार्य का बचा हुआ भाग क्या है?",
          "options": {
            "A": "8/15",
            "B": "7/15",
            "C": "1/4",
            "D": "1/10"
          },
          "explanation": "1 दिन का काम = 7/60. 4 दिन का काम = 7/15. शेष = 1 - 7/15 = 8/15."
        }
      }
    },
    {
      "id": "aptitude-09-002",
      "number": 2,
      "question": "The ratio of the surface area of a sphere to the curved surface area of a cylinder circumscribing it is?",
      "options": {
        "A": "1:1",
        "B": "2:1",
        "C": "1:2",
        "D": "2:3"
      },
      "answer": "A",
      "explanation": "Cylinder height h = 2r. Cylinder CSA = 2 * PI * r * (2r) = 4 * PI * r^2. Sphere Area = 4 * PI * r^2. Ratio = 1:1.",
      "hash": "390f8b36b62daac8",
      "translations": {
        "hi": {
          "question": "एक गोले के पृष्ठीय क्षेत्रफल का उसे घेरने वाले बेलन के वक्र पृष्ठीय क्षेत्रफल से अनुपात क्या है?",
          "options": {
            "A": "1:1",
            "B": "2:1",
            "C": "1:2",
            "D": "2:3"
          },
          "explanation": "बेलन की ऊँचाई h = 2r. बेलन का CSA = 4 * PI * r^2. गोले का क्षेत्रफल = 4 * PI * r^2. अनुपात = 1:1."
        }
      }
    },
    {
      "id": "aptitude-09-003",
      "number": 3,
      "question": "Find the compound interest on 10000 at 20% per annum for 9 months, compounded quarterly.",
      "options": {
        "A": "1576.25",
        "B": "1500",
        "C": "1600",
        "D": "1550"
      },
      "answer": "A",
      "explanation": "Rate = 20/4 = 5% per quarter. Time = 3 quarters. Amount = 10000(1.05)^3 = 11576.25. CI = 1576.25.",
      "hash": "1c5bb82a5d0cb9d9",
      "translations": {
        "hi": {
          "question": "20% प्रति वर्ष की दर से 9 महीने के लिए 10000 पर चक्रवृद्धि ब्याज ज्ञात कीजिए, जो त्रैमासिक रूप से संयोजित होता है।",
          "options": {
            "A": "1576.25",
            "B": "1500",
            "C": "1600",
            "D": "1550"
          },
          "explanation": "दर = 5% प्रति तिमाही। समय = 3 तिमाही। राशि = 11576.25. CI = 1576.25."
        }
      }
    },
    {
      "id": "aptitude-09-004",
      "number": 4,
      "question": "If the height of a cone is doubled and the radius remains the same, find the ratio of the volume of the new cone to the old cone.",
      "options": {
        "A": "2:1",
        "B": "1:2",
        "C": "4:1",
        "D": "1:4"
      },
      "answer": "A",
      "explanation": "Vol = (1/3)PI*r^2*h. Since h is doubled, Vol is doubled. Ratio = 2:1.",
      "hash": "a360236a28851f0e",
      "translations": {
        "hi": {
          "question": "यदि एक शंकु की ऊँचाई दोगुनी कर दी जाए और त्रिज्या समान रहे, तो नए शंकु और पुराने शंकु के आयतन का अनुपात ज्ञात कीजिए।",
          "options": {
            "A": "2:1",
            "B": "1:2",
            "C": "4:1",
            "D": "1:4"
          },
          "explanation": "आयतन ऊँचाई के समानुपाती होता है। ऊँचाई दोगुनी होने पर आयतन दोगुना हो जाएगा। अनुपात = 2:1."
        }
      }
    },
    {
      "id": "aptitude-09-005",
      "number": 5,
      "question": "If A:B = 2:3, B:C = 4:5 and C:D = 6:7, find A:D.",
      "options": {
        "A": "16:35",
        "B": "15:35",
        "C": "12:35",
        "D": "18:35"
      },
      "answer": "A",
      "explanation": "A/D = (A/B) * (B/C) * (C/D) = (2/3) * (4/5) * (6/7) = 16/35.",
      "hash": "c8bee3047946b552",
      "translations": {
        "hi": {
          "question": "यदि A:B = 2:3, B:C = 4:5 और C:D = 6:7 है, तो A:D ज्ञात कीजिए।",
          "options": {
            "A": "16:35",
            "B": "15:35",
            "C": "12:35",
            "D": "18:35"
          },
          "explanation": "A/D = (2/3) * (4/5) * (6/7) = 16/35."
        }
      }
    },
    {
      "id": "aptitude-09-006",
      "number": 6,
      "question": "The difference between CI and SI on a certain sum at 10% per annum for 2 years is 631. Find the sum.",
      "options": {
        "A": "63100",
        "B": "6310",
        "C": "60000",
        "D": "65000"
      },
      "answer": "A",
      "explanation": "Diff = P(R/100)^2 => 631 = P(10/100)^2 => P = 631 * 100 = 63100.",
      "hash": "ff917c7dcc1220b3",
      "translations": {
        "hi": {
          "question": "एक निश्चित राशि पर 10% प्रति वर्ष की दर से 2 वर्षों के लिए CI और SI के बीच का अंतर 631 है। राशि ज्ञात कीजिए।",
          "options": {
            "A": "63100",
            "B": "6310",
            "C": "60000",
            "D": "65000"
          },
          "explanation": "अंतर = P(R/100)^2 => 631 = P/100 => P = 63100."
        }
      }
    },
    {
      "id": "aptitude-09-007",
      "number": 7,
      "question": "A reduction of 20% in the price of sugar enables a purchaser to obtain 8 kg more for 160. Find the original price per kg.",
      "options": {
        "A": "5",
        "B": "4",
        "C": "6",
        "D": "4.5"
      },
      "answer": "A",
      "explanation": "Reduced price = (20% of 160) / 8 = 32 / 8 = 4. Original price = 4 / 0.8 = 5.",
      "hash": "c30b196d8debe0eb",
      "translations": {
        "hi": {
          "question": "चीनी की कीमत में 20% की कमी एक खरीदार को 160 में 8 किग्रा अधिक प्राप्त करने में सक्षम बनाती है। प्रति किग्रा मूल मूल्य ज्ञात कीजिए।",
          "options": {
            "A": "5",
            "B": "4",
            "C": "6",
            "D": "4.5"
          },
          "explanation": "घटी हुई कीमत = 32/8 = 4. मूल मूल्य = 4 / 0.8 = 5."
        }
      }
    },
    {
      "id": "aptitude-09-008",
      "number": 8,
      "question": "Find the length of the diagonal of a square whose area is 242 sq.cm.",
      "options": {
        "A": "22 cm",
        "B": "11 cm",
        "C": "20 cm",
        "D": "15 cm"
      },
      "answer": "A",
      "explanation": "Area = d^2 / 2 => 242 = d^2 / 2 => d^2 = 484 => d = 22.",
      "hash": "cb2bb2bd8ad702d9",
      "translations": {
        "hi": {
          "question": "एक वर्ग के विकर्ण की लंबाई ज्ञात कीजिए जिसका क्षेत्रफल 242 वर्ग सेमी है।",
          "options": {
            "A": "22 सेमी",
            "B": "11 सेमी",
            "C": "20 सेमी",
            "D": "15 सेमी"
          },
          "explanation": "क्षेत्रफल = d^2 / 2 => d^2 = 484 => d = 22."
        }
      }
    },
