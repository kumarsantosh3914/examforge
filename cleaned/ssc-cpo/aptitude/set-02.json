    {
      "id": "aptitude-02-001",
      "number": 1,
      "question": "If the height of a triangle is increased by 30% and base is decreased by 20%, find the net change in area.",
      "options": {
        "A": "4% increase",
        "B": "5% increase",
        "C": "4% decrease",
        "D": "10% increase"
      },
      "answer": "A",
      "explanation": "Net change = 30 - 20 - (30*20/100) = 10 - 6 = 4% increase.",
      "hash": "a3fcfe264da55c1e",
      "translations": {
        "hi": {
          "question": "यदि एक त्रिभुज की ऊंचाई 30% बढ़ जाती है और आधार 20% कम हो जाता है, तो क्षेत्रफल में शुद्ध परिवर्तन ज्ञात कीजिए।",
          "options": {
            "A": "4% वृद्धि",
            "B": "5% वृद्धि",
            "C": "4% कमी",
            "D": "10% वृद्धि"
          },
          "explanation": "शुद्ध परिवर्तन = 30 - 20 - (30*20/100) = 10 - 6 = 4% वृद्धि।"
        }
      }
    },
    {
      "id": "aptitude-02-002",
      "number": 2,
      "question": "A and B can complete a task in 12 days, B and C in 15 days, and C and A in 20 days. In how many days can they finish it together?",
      "options": {
        "A": "10",
        "B": "12",
        "C": "8",
        "D": "15"
      },
      "answer": "A",
      "explanation": "2(A+B+C) = 1/12 + 1/15 + 1/20 = 12/60 = 1/5. (A+B+C) = 1/10. Days = 10.",
      "hash": "dad017cef988948e",
      "translations": {
        "hi": {
          "question": "A और B एक कार्य को 12 दिनों में, B और C 15 दिनों में, और C और A 20 दिनों में पूरा कर सकते हैं। वे मिलकर इसे कितने दिनों में समाप्त कर सकते हैं?",
          "options": {
            "A": "10",
            "B": "12",
            "C": "8",
            "D": "15"
          },
          "explanation": "2(A+B+C) = 1/12 + 1/15 + 1/20 = 12/60 = 1/5. (A+B+C) = 1/10. दिन = 10."
        }
      }
    },
    {
      "id": "aptitude-02-003",
      "number": 3,
      "question": "A certain sum of money amounts to 756 in 2 years and 873 in 3.5 years at simple interest. Find the rate of interest.",
      "options": {
        "A": "13%",
        "B": "10%",
        "C": "12%",
        "D": "11%"
      },
      "answer": "A",
      "explanation": "Interest for 1.5 years = 873 - 756 = 117. Interest for 1 year = 78. Principal = 756 - 156 = 600. Rate = (78/600)*100 = 13%.",
      "hash": "ed70f926f332908a",
      "translations": {
        "hi": {
          "question": "एक निश्चित राशि साधारण ब्याज पर 2 वर्षों में 756 और 3.5 वर्षों में 873 हो जाती है। ब्याज की दर ज्ञात कीजिए।",
          "options": {
            "A": "13%",
            "B": "10%",
            "C": "12%",
            "D": "11%"
          },
          "explanation": "1.5 वर्ष का ब्याज = 117. 1 वर्ष का ब्याज = 78. मूलधन = 756 - 156 = 600. दर = (78/600)*100 = 13%."
        }
      }
    },
    {
      "id": "aptitude-02-004",
      "number": 4,
      "question": "The ratio of the volumes of two cubes is 27:64. Find the ratio of their total surface areas.",
      "options": {
        "A": "9:16",
        "B": "3:4",
        "C": "27:64",
        "D": "81:256"
      },
      "answer": "A",
      "explanation": "Side ratio = cbrt(27):cbrt(64) = 3:4. Area ratio = 3^2 : 4^2 = 9:16.",
      "hash": "6913ea2b19eceb6f",
      "translations": {
        "hi": {
          "question": "दो घनों के आयतन का अनुपात 27:64 है। उनके कुल पृष्ठीय क्षेत्रफल का अनुपात ज्ञात कीजिए।",
          "options": {
            "A": "9:16",
            "B": "3:4",
            "C": "27:64",
            "D": "81:256"
          },
          "explanation": "भुजा अनुपात = cbrt(27):cbrt(64) = 3:4. क्षेत्रफल अनुपात = 3^2 : 4^2 = 9:16."
        }
      }
    },
    {
      "id": "aptitude-02-005",
      "number": 5,
      "question": "A man buys rice at 40 per kg and 50 per kg in ratio 3:2. Find the average price per kg.",
      "options": {
        "A": "44",
        "B": "45",
        "C": "46",
        "D": "42"
      },
      "answer": "A",
      "explanation": "Avg = (40*3 + 50*2) / (3+2) = (120 + 100) / 5 = 44.",
      "hash": "9bc6adb028db35da",
      "translations": {
        "hi": {
          "question": "एक आदमी 40 प्रति किग्रा और 50 प्रति किग्रा वाले चावल को 3:2 के अनुपात में खरीदता है। प्रति किग्रा औसत मूल्य ज्ञात कीजिए।",
          "options": {
            "A": "44",
            "B": "45",
            "C": "46",
            "D": "42"
          },
          "explanation": "औसत = (40*3 + 50*2) / (3+2) = (120 + 100) / 5 = 44."
        }
      }
    },
    {
      "id": "aptitude-02-006",
      "number": 6,
      "question": "Find the value of x: (x + 12) / 4 = (x - 2) / 2.",
      "options": {
        "A": "16",
        "B": "14",
        "C": "12",
        "D": "18"
      },
      "answer": "A",
      "explanation": "x + 12 = 2x - 4 => x = 16.",
      "hash": "6a6e14ed30406112",
      "translations": {
        "hi": {
          "question": "x का मान ज्ञात कीजिए: (x + 12) / 4 = (x - 2) / 2.",
          "options": {
            "A": "16",
            "B": "14",
            "C": "12",
            "D": "18"
          },
          "explanation": "x + 12 = 2x - 4 => x = 16."
        }
      }
    },
    {
      "id": "aptitude-02-007",
      "number": 7,
      "question": "A car covers 300 km at 60 km/h and next 400 km at 80 km/h. Find average speed.",
      "options": {
        "A": "70 km/h",
        "B": "65 km/h",
        "C": "75 km/h",
        "D": "68 km/h"
      },
      "answer": "A",
      "explanation": "Total Time = (300/60) + (400/80) = 5+5 = 10 hrs. Avg speed = 700/10 = 70.",
      "hash": "339ee24714f457c1",
      "translations": {
        "hi": {
          "question": "एक कार 60 किमी/घंटा की गति से 300 किमी और अगले 400 किमी 80 किमी/घंटा की गति से तय करती है। औसत गति ज्ञात कीजिए।",
          "options": {
            "A": "70 किमी/घंटा",
            "B": "65 किमी/घंटा",
            "C": "75 किमी/घंटा",
            "D": "68 किमी/घंटा"
          },
          "explanation": "कुल समय = 5 + 5 = 10 घंटे। औसत गति = 700/10 = 70."
        }
      }
    },
    {
