      "translations": {
        "hi": {
          "question": "8000 की राशि चक्रवृद्धि ब्याज पर 3 वर्षों में 9261 देती है। दर ज्ञात कीजिए।",
          "options": {
            "A": "5%",
            "B": "4%",
            "C": "6%",
            "D": "8%"
          },
          "explanation": "(1 + R/100)^3 = (21/20)^3. दर = 5%."
        }
      }
    },
