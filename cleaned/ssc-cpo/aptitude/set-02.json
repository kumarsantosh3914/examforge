      "translations": {
        "hi": {
          "question": "A एक घड़ी B को 20% लाभ पर बेचता है, और B इसे C को 10% हानि पर बेचता है। यदि C 216 का भुगतान करता है, तो A के लिए क्रय मूल्य क्या था?",
          "options": {
            "A": "200",
            "B": "180",
            "C": "210",
            "D": "220"
          },
          "explanation": "CP * 1.2 * 0.9 = 216 => CP * 1.08 = 216 => CP = 200."
        }
      }
    },
