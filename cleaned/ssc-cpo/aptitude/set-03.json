        "hi": {
          "question": "यदि एक समबाहु त्रिभुज का क्षेत्रफल 16√3 वर्ग सेमी है, तो इसका परिमाप ज्ञात कीजिए।",
          "options": {
            "A": "24 सेमी",
            "B": "12 सेमी",
            "C": "18 सेमी",
            "D": "30 सेमी"
          },
          "explanation": "क्षेत्रफल = (√3/4)a^2 = 16√3 => a = 8. परिमाप = 3*8 = 24."
        }
      }
