    {
      "id": "aptitude-03-006",
      "number": 6,
      "question": "The average of 11 results is 50. If the average of first six is 49 and last six is 52, find the sixth result.",
      "options": {
        "A": "56",
        "B": "50",
        "C": "52",
        "D": "48"
      },
      "answer": "A",
      "explanation": "Sixth = (6*49 + 6*52) - (11*50) = 6(101) - 550 = 606 - 550 = 56.",
      "hash": "0e6e6ede9ce8acc2",
      "translations": {
        "hi": {
          "question": "11 परिणामों का औसत 50 है। यदि पहले छह का औसत 49 और अंतिम छह का औसत 52 है, तो छठा परिणाम ज्ञात कीजिए।",
          "options": {
            "A": "56",
            "B": "50",
            "C": "52",
            "D": "48"
          },
          "explanation": "छठा = (6*49 + 6*52) - (11*50) = 606 - 550 = 56."
        }
      }
    },
