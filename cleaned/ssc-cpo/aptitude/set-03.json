          "options": {
            "A": "10 मिनट",
            "B": "8 मिनट",
            "C": "12 मिनट",
            "D": "15 मिनट"
          },
          "explanation": "शुद्ध दर = 1/12 + 1/15 - 1/20 = 1/10. समय = 10 मिनट।"
        }
      }
    },
