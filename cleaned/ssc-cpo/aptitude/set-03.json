    {
      "id": "aptitude-03-001",
      "number": 1,
      "question": "A certain number of men can do a work in 60 days. If there were 8 men more, it could be finished in 10 days less. How many men were there initially?",
      "options": {
        "A": "40",
        "B": "48",
        "C": "45",
        "D": "50"
      },
      "answer": "B",
      "explanation": "M * 60 = (M + 8) * 50 => 6M = 5M + 40 => M = 40. Wait, 60M = 50M + 400 => 10M = 400 => M = 40.",
      "hash": "91a8376760576dea",
      "translations": {
        "hi": {
          "question": "कुछ पुरुष एक कार्य को 60 दिनों में कर सकते हैं। यदि 8 पुरुष और होते, तो कार्य 10 दिन कम में समाप्त हो जाता। प्रारंभ में कितने पुरुष थे?",
          "options": {
            "A": "40",
            "B": "48",
            "C": "45",
            "D": "50"
          },
          "explanation": "M * 60 = (M + 8) * 50 => 6M = 5M + 40 => M = 40."
        }
      }
    },
    {
      "id": "aptitude-03-002",
      "number": 2,
      "question": "If the length of a rectangle is increased by 20% and its breadth is decreased by 10%, find the percentage change in its area.",
      "options": {
        "A": "8% increase",
        "B": "10% increase",
        "C": "5% decrease",
        "D": "12% increase"
      },
      "answer": "A",
      "explanation": "Net change = 20 - 10 - (20*10/100) = 8%.",
      "hash": "eb93f180daf3ff48",
      "translations": {
        "hi": {
          "question": "यदि एक आयत की लंबाई में 20% की वृद्धि की जाती है और उसकी चौड़ाई में 10% की कमी की जाती है, तो उसके क्षेत्रफल में प्रतिशत परिवर्तन ज्ञात कीजिए।",
          "options": {
            "A": "8% वृद्धि",
            "B": "10% वृद्धि",
            "C": "5% कमी",
            "D": "12% वृद्धि"
          },
          "explanation": "शुद्ध परिवर्तन = 20 - 10 - (20*10/100) = 8%."
        }
      }
    },
    {
      "id": "aptitude-03-003",
      "number": 3,
      "question": "A sum of 1600 gives a simple interest of 252 in 2 years and 3 months. Find the rate of interest per annum.",
      "options": {
        "A": "7%",
        "B": "8%",
        "C": "6%",
        "D": "9%"
      },
      "answer": "A",
      "explanation": "Time = 2.25 years. R = (252 * 100) / (1600 * 2.25) = 25200 / 3600 = 7%.",
      "hash": "b50042239cfb6c97",
      "translations": {
        "hi": {
          "question": "1600 की राशि 2 वर्ष और 3 महीने में 252 का साधारण ब्याज देती है। प्रति वर्ष ब्याज की दर ज्ञात कीजिए।",
          "options": {
            "A": "7%",
            "B": "8%",
            "C": "6%",
            "D": "9%"
          },
          "explanation": "समय = 2.25 वर्ष। R = (252 * 100) / (1600 * 2.25) = 7%."
        }
      }
    },
    {
      "id": "aptitude-03-004",
      "number": 4,
      "question": "The ratio of the radii of two circles is 3:4. Find the ratio of their areas.",
      "options": {
        "A": "9:16",
        "B": "3:4",
        "C": "27:64",
        "D": "6:8"
      },
      "answer": "A",
      "explanation": "Area ratio = r1^2 : r2^2 = 3^2 : 4^2 = 9:16.",
      "hash": "0139442bb56d613a",
      "translations": {
        "hi": {
          "question": "दो वृत्तों की त्रिज्याओं का अनुपात 3:4 है। उनके क्षेत्रफलों का अनुपात ज्ञात कीजिए।",
          "options": {
            "A": "9:16",
            "B": "3:4",
            "C": "27:64",
            "D": "6:8"
          },
          "explanation": "क्षेत्रफल अनुपात = r1^2 : r2^2 = 3^2 : 4^2 = 9:16."
        }
      }
    },
