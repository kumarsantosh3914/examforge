        "hi": {
          "question": "एक बेलन की ऊँचाई 10 सेमी और त्रिज्या 7 सेमी है। इसका वक्र पृष्ठीय क्षेत्रफल ज्ञात कीजिए।",
          "options": {
            "A": "440 वर्ग सेमी",
            "B": "220 वर्ग सेमी",
            "C": "616 वर्ग सेमी",
            "D": "1540 वर्ग सेमी"
          },
          "explanation": "CSA = 2 * PI * r * h = 440."
        }
      }
    },
