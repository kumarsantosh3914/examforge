    {
      "id": "aptitude-08-012",
      "number": 12,
      "question": "If 30% of A is added to 40% of B, the result is 80% of B. What percentage of A is B?",
      "options": {
        "A": "75%",
        "B": "60%",
        "C": "80%",
        "D": "50%"
      },
      "answer": "A",
      "explanation": "0.3A + 0.4B = 0.8B => 0.3A = 0.4B => B/A = 0.3/0.4 = 75%.",
      "hash": "c49ca0dcce969702",
      "translations": {
        "hi": {
          "question": "यदि A के 30% को B के 40% में जोड़ा जाता है, तो परिणाम B का 80% होता है। B, A का कितना प्रतिशत है?",
          "options": {
            "A": "75%",
            "B": "60%",
            "C": "80%",
            "D": "50%"
          },
          "explanation": "0.3A + 0.4B = 0.8B => 0.3A = 0.4B => B/A = 0.3/0.4 = 75%."
        }
      }
    },
    {
      "id": "aptitude-08-013",
      "number": 13,
      "question": "The mean of 10 observations is 15. If each observation is multiplied by 3, what is the new mean?",
