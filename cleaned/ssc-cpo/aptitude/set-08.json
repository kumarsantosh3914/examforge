          "question": "प्रथम 10 अभाज्य संख्याओं का औसत ज्ञात कीजिए।",
          "options": {
            "A": "12.9",
            "B": "12.5",
            "C": "13",
            "D": "11.8"
          },
          "explanation": "योग = 129. औसत = 129/10 = 12.9."
        }
      }
