    {
      "id": "aptitude-08-001",
      "number": 1,
      "question": "The ratio of the volumes of two spheres is 8:27. Find the ratio of their surface areas.",
      "options": {
        "A": "4:9",
        "B": "2:3",
        "C": "16:81",
        "D": "4:3"
      },
      "answer": "A",
      "explanation": "Volume ratio = 8:27 => Radius ratio = cbrt(8):cbrt(27) = 2:3. Surface Area ratio = 2^2:3^2 = 4:9.",
      "hash": "77749169072912df",
      "translations": {
        "hi": {
          "question": "दो गोलों के आयतन का अनुपात 8:27 है। उनके पृष्ठीय क्षेत्रफल का अनुपात ज्ञात कीजिए।",
          "options": {
            "A": "4:9",
            "B": "2:3",
            "C": "16:81",
            "D": "4:3"
          },
          "explanation": "आयतन का अनुपात = 8:27 => त्रिज्या अनुपात = 2:3. क्षेत्रफल अनुपात = 4:9."
        }
      }
    },
    {
      "id": "aptitude-08-002",
      "number": 2,
      "question": "A reduction of 21% in the price of an item enables a person to buy 3 kg more for 100. Find the reduced price per kg.",
      "options": {
        "A": "7",
        "B": "6.3",
        "C": "7.5",
        "D": "8"
      },
      "answer": "A",
      "explanation": "21% of 100 = 21. This 21 buys 3 kg extra. So reduced price = 21 / 3 = 7 per kg.",
      "hash": "54c16fddf128f123",
      "translations": {
        "hi": {
          "question": "एक वस्तु की कीमत में 21% की कमी एक व्यक्ति को 100 में 3 किग्रा अधिक खरीदने में सक्षम बनाती है। प्रति किग्रा घटी हुई कीमत ज्ञात कीजिए।",
          "options": {
            "A": "7",
            "B": "6.3",
            "C": "7.5",
            "D": "8"
          },
          "explanation": "100 का 21% = 21. यह 21 में 3 किग्रा अतिरिक्त मिलता है। घटी हुई कीमत = 7 प्रति किग्रा।"
        }
      }
    },
    {
      "id": "aptitude-08-003",
      "number": 3,
      "question": "A and B together can do a piece of work in 12 days, which B alone can do in 30 days. In how many days can A alone do the work?",
      "options": {
        "A": "20",
        "B": "18",
        "C": "25",
        "D": "15"
      },
      "answer": "A",
      "explanation": "1/A = 1/12 - 1/30 = (5-2)/60 = 3/60 = 1/20. So 20 days.",
      "hash": "c443fb0e63a26d4c",
      "translations": {
        "hi": {
          "question": "A और B मिलकर एक कार्य को 12 दिनों में कर सकते हैं, जिसे B अकेला 30 दिनों में कर सकता है। A अकेला उस कार्य को कितने दिनों में कर सकता है?",
          "options": {
            "A": "20",
            "B": "18",
            "C": "25",
            "D": "15"
          },
          "explanation": "1/A = 1/12 - 1/30 = 3/60 = 1/20. अतः 20 दिन।"
        }
      }
    },
    {
      "id": "aptitude-08-004",
      "number": 4,
      "question": "A train 200m long passes a platform 400m long in 30 seconds. Find its speed in km/h.",
      "options": {
        "A": "72",
        "B": "60",
        "C": "80",
        "D": "90"
      },
      "answer": "A",
      "explanation": "Total distance = 600. Speed = 600/30 = 20 m/s. 20 * 18/5 = 72 km/h.",
      "hash": "e5ba09d03e37d00b",
      "translations": {
        "hi": {
          "question": "200 मीटर लंबी एक ट्रेन 400 मीटर लंबे प्लेटफॉर्म को 30 सेकंड में पार करती है। किमी/घंटा में इसकी गति ज्ञात कीजिए।",
          "options": {
            "A": "72",
            "B": "60",
            "C": "80",
            "D": "90"
          },
          "explanation": "कुल दूरी = 600. गति = 20 मीटर/सेकंड। 20 * 18/5 = 72 किमी/घंटा।"
        }
      }
    },
    {
      "id": "aptitude-08-005",
      "number": 5,
      "question": "Find the value of (1/x + 1/y) if x + y = 20 and xy = 80.",
      "options": {
        "A": "0.25",
        "B": "0.5",
        "C": "4",
        "D": "0.2"
      },
      "answer": "A",
      "explanation": "1/x + 1/y = (x+y)/xy = 20/80 = 1/4 = 0.25.",
      "hash": "02c7a3efce019fd6",
      "translations": {
        "hi": {
          "question": "(1/x + 1/y) का मान ज्ञात कीजिए यदि x + y = 20 और xy = 80 है।",
          "options": {
            "A": "0.25",
            "B": "0.5",
            "C": "4",
            "D": "0.2"
          },
          "explanation": "1/x + 1/y = (x+y)/xy = 20/80 = 0.25."
        }
      }
    },
    {
      "id": "aptitude-08-006",
      "number": 6,
      "question": "If the length of a rectangle is increased by 25% and width is decreased by 20%, what is the net effect on area?",
      "options": {
        "A": "No change",
        "B": "5% increase",
        "C": "5% decrease",
        "D": "10% increase"
      },
      "answer": "A",
      "explanation": "Net change = 25 - 20 - (25*20/100) = 5 - 5 = 0.",
      "hash": "16f288d580d90cde",
      "translations": {
        "hi": {
          "question": "यदि एक आयत की लंबाई में 25% की वृद्धि की जाती है और चौड़ाई में 20% की कमी की जाती है, तो क्षेत्रफल पर शुद्ध प्रभाव क्या है?",
          "options": {
            "A": "कोई बदलाव नहीं",
            "B": "5% वृद्धि",
            "C": "5% कमी",
            "D": "10% वृद्धि"
          },
          "explanation": "शुद्ध परिवर्तन = 25 - 20 - 5 = 0."
        }
      }
    },
    {
      "id": "aptitude-08-007",
      "number": 7,
      "question": "A sum of money triples itself in 8 years at simple interest. Find the rate of interest.",
      "options": {
        "A": "25%",
        "B": "12.5%",
        "C": "20%",
        "D": "15%"
      },
      "answer": "A",
      "explanation": "SI = 2P. R = (2P * 100) / (P * 8) = 200/8 = 25%.",
      "hash": "5ee3014ddf84c762",
      "translations": {
        "hi": {
          "question": "साधारण ब्याज पर कोई राशि 8 वर्षों में तिगुनी हो जाती है। ब्याज की दर ज्ञात कीजिए।",
          "options": {
            "A": "25%",
            "B": "12.5%",
            "C": "20%",
            "D": "15%"
          },
          "explanation": "SI = 2P. R = (2P * 100) / (P * 8) = 25%."
        }
      }
    },
    {
      "id": "aptitude-08-008",
      "number": 8,
      "question": "Find the HCF of 2/3, 4/5 and 6/7.",
      "options": {
        "A": "2/105",
        "B": "12/105",
        "C": "2/3",
        "D": "1/105"
      },
      "answer": "A",
      "explanation": "HCF of fractions = HCF(Num) / LCM(Denom) = HCF(2,4,6) / LCM(3,5,7) = 2/105.",
      "hash": "949a57366916ce4b",
      "translations": {
        "hi": {
          "question": "2/3, 4/5 और 6/7 का HCF ज्ञात कीजिए।",
          "options": {
            "A": "2/105",
            "B": "12/105",
            "C": "2/3",
            "D": "1/105"
          },
          "explanation": "भिन्नों का HCF = अंशों का HCF / हरों का LCM = 2/105."
        }
      }
    },
