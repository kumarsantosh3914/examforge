    {
      "id": "aptitude-07-001",
      "number": 1,
      "question": "A certain sum of money invested at compound interest becomes 1440 in 2 years and 1728 in 3 years. Find the rate of interest per annum.",
      "options": {
        "A": "20%",
        "B": "10%",
        "C": "15%",
        "D": "25%"
      },
      "answer": "A",
      "explanation": "Rate = (1728 - 1440) / 1440 * 100 = 288 / 1440 * 100 = 20%.",
      "hash": "dec57b1aa26996c2",
      "translations": {
        "hi": {
          "question": "चक्रवृद्धि ब्याज पर निवेश की गई एक निश्चित राशि 2 वर्षों में 1440 और 3 वर्षों में 1728 हो जाती है। प्रति वर्ष ब्याज की दर ज्ञात कीजिए।",
          "options": {
            "A": "20%",
            "B": "10%",
            "C": "15%",
            "D": "25%"
          },
          "explanation": "दर = (1728 - 1440) / 1440 * 100 = 20%."
        }
      }
    },
    {
      "id": "aptitude-07-002",
      "number": 2,
      "question": "A and B can do a work in 18 and 24 days respectively. They work together for 8 days and then A leaves. In how many days can B finish the remaining work?",
      "options": {
        "A": "5 1/3",
        "B": "6",
        "C": "8",
        "D": "7"
      },
      "answer": "A",
      "explanation": "1 day work = 1/18 + 1/24 = 7/72. 8 days work = 56/72 = 7/9. Remaining = 2/9. B takes = 2/9 * 24 = 16/3 = 5 1/3.",
      "hash": "196c8931da7369e4",
      "translations": {
        "hi": {
          "question": "A और B एक कार्य को क्रमशः 18 और 24 दिनों में कर सकते हैं। वे 8 दिनों तक साथ काम करते हैं और फिर A छोड़ देता है। B शेष कार्य को कितने दिनों में पूरा कर सकता है?",
          "options": {
            "A": "5 1/3",
            "B": "6",
            "C": "8",
            "D": "7"
          },
          "explanation": "8 दिन का काम = 7/9. शेष = 2/9. B लेगा = 2/9 * 24 = 5 1/3 दिन।"
        }
      }
    },
    {
