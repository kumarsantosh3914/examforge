          "question": "240 मीटर लंबी एक ट्रेन 260 मीटर लंबे प्लेटफॉर्म को 25 सेकंड में पार करती है। किमी/घंटा में गति ज्ञात कीजिए।",
          "options": {
            "A": "72",
            "B": "60",
            "C": "80",
            "D": "90"
          },
          "explanation": "गति = 500/25 = 20 मीटर/सेकंड = 72 किमी/घंटा।"
        }
      }
    },
