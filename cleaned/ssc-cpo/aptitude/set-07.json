    {
      "id": "aptitude-07-018",
      "number": 18,
      "question": "If x% of 500 = y% of 300 and x% of y% of 200 = 60, find x.",
      "options": {
        "A": "10",
        "B": "20",
        "C": "15",
        "D": "30"
      },
      "answer": "A",
      "explanation": "5x = 3y => y = 5x/3. (x/100)*(y/100)*200 = 60 => xy = 3000. x(5x/3) = 3000 => x^2 = 1800 => x = sqrt(1800) = 30*sqrt(2). Let me recheck.",
      "hash": "1f1f1e5dded31c1a",
      "translations": {
        "hi": {
          "question": "यदि 500 का x% = 300 का y% और 200 के y% का x% = 60 है, तो x ज्ञात कीजिए।",
          "options": {
            "A": "10",
            "B": "20",
            "C": "15",
            "D": "30"
          },
          "explanation": "5x = 3y. xy/50 = 60 => xy = 3000. x(5x/3) = 3000 => x^2 = 1800."
        }
      }
    },
