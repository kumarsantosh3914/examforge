    {
      "id": "aptitude-07-014",
      "number": 14,
      "question": "A cylinder and a sphere have equal radius r. If their volumes are equal, find the height of the cylinder in terms of r.",
      "options": {
        "A": "4/3 r",
        "B": "2/3 r",
        "C": "2 r",
        "D": "4 r"
      },
      "answer": "A",
      "explanation": "PI * r^2 * h = 4/3 * PI * r^3 => h = 4/3 r.",
      "hash": "3cc38d046ce20463",
      "translations": {
        "hi": {
          "question": "एक बेलन और एक गोले की त्रिज्या r समान है। यदि उनके आयतन समान हैं, तो r के पदों में बेलन की ऊँचाई ज्ञात कीजिए।",
          "options": {
            "A": "4/3 r",
            "B": "2/3 r",
            "C": "2 r",
            "D": "4 r"
          },
          "explanation": "PI * r^2 * h = 4/3 * PI * r^3 => h = 4/3 r."
        }
      }
    },
