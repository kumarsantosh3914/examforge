    {
      "id": "aptitude-07-008",
      "number": 8,
      "question": "A shopkeeper allows a discount of 10% on MP and still gains 8%. If MP is 480, find CP.",
      "options": {
        "A": "400",
        "B": "420",
        "C": "380",
        "D": "410"
      },
      "answer": "A",
      "explanation": "CP = MP * (100 - D) / (100 + P) = 480 * 90 / 108 = 400.",
      "hash": "c772b559478dd709",
      "translations": {
        "hi": {
          "question": "एक दुकानदार अंकित मूल्य पर 10% की छूट देता है और फिर भी 8% का लाभ कमाता है। यदि अंकित मूल्य 480 है, तो क्रय मूल्य ज्ञात कीजिए।",
          "options": {
            "A": "400",
            "B": "420",
            "C": "380",
            "D": "410"
          },
          "explanation": "CP = 480 * 90 / 108 = 400."
        }
      }
    },
    {
