        "hi": {
          "question": "A एक काम 10 दिनों में और B 20 दिनों में कर सकता है। C की मदद से, वे 5 दिनों में समाप्त करते हैं। C अकेला इसे कितने दिनों में कर सकता है?",
          "options": {
            "A": "20",
            "B": "15",
            "C": "10",
            "D": "25"
          },
          "explanation": "1/C = 1/5 - 3/20 = 1/20. C = 20 दिन।"
        }
      }
