        "D": "3"
      },
      "answer": "A",
      "explanation": "4^(x-3) = 4^-3 => x-3 = -3 => x = 0.",
      "hash": "2781d24ae8db1026",
      "translations": {
        "hi": {
          "question": "x का मान ज्ञात कीजिए: 4^(x-3) = 1/64.",
          "options": {
            "A": "0",
            "B": "1",
            "C": "2",
            "D": "3"
          },
          "explanation": "4^(x-3) = 4^-3 => x = 0."
        }
      }
    },
