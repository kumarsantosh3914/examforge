        "hi": {
          "question": "यदि x:y = 2:1 है, तो (x^2 - y^2) : (x^2 + y^2) क्या है?",
          "options": {
            "A": "3:5",
            "B": "5:3",
            "C": "1:3",
            "D": "3:1"
          },
          "explanation": "(4-1)/(4+1) = 3/5."
        }
      }
    },
    {
      "id": "aptitude-06-006",
      "number": 6,
      "question": "A train 150m long is running at 72 km/h. How long will it take to cross a platform 250m long?",
      "options": {
        "A": "20 sec",
        "B": "15 sec",
        "C": "25 sec",
        "D": "18 sec"
      },
      "answer": "A",
      "explanation": "Speed = 20 m/s. Total Dist = 150+250 = 400. Time = 400/20 = 20.",
      "hash": "aa700aca3d5d0932",
      "translations": {
        "hi": {
          "question": "150 मीटर लंबी एक ट्रेन 72 किमी/घंटा की गति से चल रही है। 250 मीटर लंबे प्लेटफॉर्म को पार करने में इसे कितना समय लगेगा?",
          "options": {
            "A": "20 सेकंड",
            "B": "15 सेकंड",
            "C": "25 सेकंड",
            "D": "18 सेकंड"
          },
          "explanation": "गति = 20 मीटर/सेकंड। कुल दूरी = 400. समय = 20."
        }
      }
    },
