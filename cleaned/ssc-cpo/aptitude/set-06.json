    {
      "id": "aptitude-06-010",
      "number": 10,
      "question": "Two numbers are in ratio 3:5. If 9 is subtracted from each, they are in ratio 12:23. Find the smaller number.",
      "options": {
        "A": "33",
        "B": "27",
        "C": "45",
        "D": "55"
      },
      "answer": "A",
      "explanation": "(3x-9)/(5x-9) = 12/23 => 69x - 207 = 60x - 108 => 9x = 99 => x = 11. Smaller = 33.",
      "hash": "b8f4fe85e8f791a7",
      "translations": {
        "hi": {
          "question": "दो संख्याएँ 3:5 के अनुपात में हैं। यदि प्रत्येक से 9 घटाया जाता है, तो वे 12:23 के अनुपात में होती हैं। छोटी संख्या ज्ञात कीजिए।",
          "options": {
            "A": "33",
            "B": "27",
            "C": "45",
            "D": "55"
          },
          "explanation": "(3x-9)/(5x-9) = 12/23 => x = 11. छोटी संख्या = 33."
        }
      }
    },
    {
