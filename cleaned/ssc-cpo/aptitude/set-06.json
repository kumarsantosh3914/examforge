        "hi": {
          "question": "एक टैंक 2/5 भरा हुआ है। पाइप A इसे 10 मिनट में भर सकता है और पाइप B इसे 6 मिनट में खाली कर सकता है। यदि दोनों को खोला जाता है, तो खाली करने में कितना समय लगेगा?",
          "options": {
            "A": "6 मिनट",
            "B": "15 मिनट",
            "C": "10 मिनट",
            "D": "12 मिनट"
          },
          "explanation": "शुद्ध दर = 1/15. 2/5 भाग खाली करने में समय = 6 मिनट।"
        }
