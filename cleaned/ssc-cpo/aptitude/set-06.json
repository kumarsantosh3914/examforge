    {
      "id": "aptitude-06-001",
      "number": 1,
      "question": "The ratio of the area of a square to that of the square drawn on its diagonal is?",
      "options": {
        "A": "1:2",
        "B": "1:4",
        "C": "2:1",
        "D": "1:sqrt(2)"
      },
      "answer": "A",
      "explanation": "Area of square = a^2. Diagonal = a*sqrt(2). Area of diagonal square = (a*sqrt(2))^2 = 2a^2. Ratio = 1:2.",
      "hash": "1c88a92c0ffee38c",
      "translations": {
        "hi": {
          "question": "एक वर्ग के क्षेत्रफल का उसके विकर्ण पर खींचे गए वर्ग के क्षेत्रफल से अनुपात क्या है?",
          "options": {
            "A": "1:2",
            "B": "1:4",
            "C": "2:1",
            "D": "1:sqrt(2)"
          },
          "explanation": "वर्ग का क्षेत्रफल = a^2. विकर्ण = a*sqrt(2). विकर्ण वर्ग का क्षेत्रफल = 2a^2. अनुपात = 1:2."
        }
      }
    },
    {
      "id": "aptitude-06-002",
      "number": 2,
      "question": "A sum of money at simple interest trebles itself in 15 years. In how many years will it become 5 times itself?",
      "options": {
        "A": "30",
        "B": "25",
        "C": "20",
        "D": "40"
      },
      "answer": "A",
      "explanation": "3 times means SI = 2P. 2P in 15 years. 5 times means SI = 4P. 4P in 30 years.",
      "hash": "580b719620b1d252",
      "translations": {
        "hi": {
          "question": "साधारण ब्याज पर कोई राशि 15 वर्षों में तिगुनी हो जाती है। कितने वर्षों में यह स्वयं की 5 गुनी हो जाएगी?",
          "options": {
            "A": "30",
            "B": "25",
            "C": "20",
            "D": "40"
          },
          "explanation": "3 गुना मतलब SI = 2P. 15 वर्ष में 2P. 5 गुना मतलब SI = 4P. 30 वर्ष में 4P."
        }
      }
    },
    {
      "id": "aptitude-06-003",
      "number": 3,
      "question": "Find the volume of the largest right circular cone that can be cut out of a cube of edge 7 cm.",
      "options": {
        "A": "89.83",
        "B": "107.8",
        "C": "75.5",
        "D": "112.4"
      },
      "answer": "A",
      "explanation": "r = 3.5, h = 7. Vol = (1/3)*PI*r^2*h = (1/3)*(22/7)*(3.5)*(3.5)*7 = 89.83.",
      "hash": "6838485eb72e4b5b",
      "translations": {
        "hi": {
          "question": "7 सेमी किनारे वाले घन से काटे जा सकने वाले सबसे बड़े लम्ब वृत्तीय शंकु का आयतन ज्ञात कीजिए।",
          "options": {
            "A": "89.83",
            "B": "107.8",
            "C": "75.5",
            "D": "112.4"
          },
          "explanation": "r = 3.5, h = 7. आयतन = (1/3)*PI*r^2*h = 89.83."
        }
      }
    },
    {
      "id": "aptitude-06-004",
      "number": 4,
      "question": "A shopkeeper gains 20% by selling an article at 25% discount on MP. If the CP is 500, find the MP.",
      "options": {
        "A": "800",
        "B": "750",
        "C": "600",
        "D": "700"
      },
      "answer": "A",
      "explanation": "MP = CP * (100+P)/(100-D) = 500 * (120/75) = 500 * 1.6 = 800.",
      "hash": "9f0036a5f974a6bb",
      "translations": {
        "hi": {
          "question": "एक दुकानदार अंकित मूल्य पर 25% की छूट देकर एक वस्तु को बेचने पर 20% का लाभ प्राप्त करता है। यदि CP 500 है, तो MP ज्ञात कीजिए।",
          "options": {
            "A": "800",
            "B": "750",
            "C": "600",
            "D": "700"
          },
          "explanation": "MP = 500 * (120/75) = 800."
        }
      }
    },
    {
