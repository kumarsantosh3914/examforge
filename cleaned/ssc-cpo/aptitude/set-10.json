      "id": "aptitude-10-007",
      "number": 7,
      "question": "Find the volume of a sphere whose radius is 7 cm.",
      "options": {
        "A": "1437.33",
        "B": "1337.33",
        "C": "1537.33",
        "D": "1237.33"
      },
      "answer": "A",
      "explanation": "Volume = (4/3) * PI * r^3 = (4/3) * (22/7) * 7 * 7 * 7 = 4312/3 = 1437.33.",
      "hash": "a0f340595e263dc3",
      "translations": {
        "hi": {
          "question": "एक गोले का आयतन ज्ञात कीजिए जिसकी त्रिज्या 7 सेमी है।",
          "options": {
            "A": "1437.33",
            "B": "1337.33",
            "C": "1537.33",
            "D": "1237.33"
          },
          "explanation": "आयतन = (4/3) * (22/7) * 7^3 = 1437.33."
        }
      }
    },
