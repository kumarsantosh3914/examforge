    {
      "id": "aptitude-10-001",
      "number": 1,
      "question": "If the length of a rectangle is increased by 20% and the breadth is decreased by 20%, what is the percentage change in area?",
      "options": {
        "A": "4% decrease",
        "B": "4% increase",
        "C": "No change",
        "D": "2% decrease"
      },
      "answer": "A",
      "explanation": "Net change = x + y + xy/100 = 20 - 20 - (400/100) = -4%.",
      "hash": "e195b48463b73339",
      "translations": {
        "hi": {
          "question": "यदि एक आयत की लंबाई में 20% की वृद्धि की जाती है और चौड़ाई में 20% की कमी की जाती है, तो क्षेत्रफल में प्रतिशत परिवर्तन क्या है?",
          "options": {
            "A": "4% की कमी",
            "B": "4% की वृद्धि",
            "C": "कोई बदलाव नहीं",
            "D": "2% की कमी"
          },
          "explanation": "शुद्ध परिवर्तन = 20 - 20 - 4 = -4%."
        }
      }
    },
    {
      "id": "aptitude-10-002",
      "number": 2,
      "question": "A man goes from city A to B at 40 km/h and returns at 60 km/h. Find the average speed for the whole journey.",
      "options": {
        "A": "48 km/h",
        "B": "50 km/h",
        "C": "45 km/h",
        "D": "52 km/h"
      },
      "answer": "A",
      "explanation": "Avg Speed = 2xy/(x+y) = (2 * 40 * 60) / (40 + 60) = 4800 / 100 = 48.",
      "hash": "4676fcb5f3100c4f",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति शहर A से B तक 40 किमी/घंटा की गति से जाता है और 60 किमी/घंटा की गति से वापस आता है। पूरी यात्रा के लिए औसत गति ज्ञात कीजिए।",
          "options": {
            "A": "48 किमी/घंटा",
            "B": "50 किमी/घंटा",
            "C": "45 किमी/घंटा",
            "D": "52 किमी/घंटा"
          },
          "explanation": "औसत गति = 2xy/(x+y) = (2 * 40 * 60) / 100 = 48."
        }
      }
    },
    {
      "id": "aptitude-10-003",
      "number": 3,
      "question": "The ratio of two numbers is 3:4 and their HCF is 15. Find the numbers.",
      "options": {
        "A": "45, 60",
        "B": "30, 40",
        "C": "60, 80",
        "D": "15, 20"
      },
      "answer": "A",
      "explanation": "Numbers = Ratio * HCF. 3*15 = 45 and 4*15 = 60.",
      "hash": "479911dc4cbfc121",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का अनुपात 3:4 है और उनका HCF 15 है। संख्याएँ ज्ञात कीजिए।",
          "options": {
            "A": "45, 60",
            "B": "30, 40",
            "C": "60, 80",
            "D": "15, 20"
          },
          "explanation": "संख्याएँ = अनुपात * HCF. 3*15 = 45 और 4*15 = 60."
        }
      }
    },
    {
      "id": "aptitude-10-004",
      "number": 4,
      "question": "A sum of 12000 amounts to 15000 in 5 years at simple interest. Find the rate of interest per annum.",
      "options": {
        "A": "5%",
        "B": "6%",
        "C": "4%",
        "D": "8%"
      },
      "answer": "A",
      "explanation": "SI = 3000. R = (SI * 100) / (P * T) = (3000 * 100) / (12000 * 5) = 5%.",
      "hash": "7bd73c9b71beaa5b",
      "translations": {
        "hi": {
          "question": "12000 की राशि साधारण ब्याज पर 5 वर्षों में 15000 हो जाती है। प्रति वर्ष ब्याज की दर ज्ञात कीजिए।",
          "options": {
            "A": "5%",
            "B": "6%",
            "C": "4%",
            "D": "8%"
          },
          "explanation": "SI = 3000. R = (3000 * 100) / (12000 * 5) = 5%."
        }
      }
    },
    {
      "id": "aptitude-10-005",
      "number": 5,
      "question": "A and B can do a work in 12 days and 15 days respectively. They started together but A left after 3 days. How many days will B take to finish the remaining work?",
      "options": {
        "A": "8.25",
        "B": "7.5",
        "C": "9",
        "D": "10.25"
      },
      "answer": "A",
      "explanation": "1 day work = 1/12+1/15 = 9/60. 3 days work = 27/60 = 9/20. Rem = 11/20. B takes (11/20)*15 = 8.25.",
      "hash": "03425c5d6359cff3",
      "translations": {
        "hi": {
          "question": "A और B एक कार्य को क्रमशः 12 और 15 दिनों में कर सकते हैं। उन्होंने एक साथ शुरू किया लेकिन A ने 3 दिनों के बाद काम छोड़ दिया। B शेष कार्य को पूरा करने में कितने दिन लेगा?",
          "options": {
            "A": "8.25",
            "B": "7.5",
            "C": "9",
            "D": "10.25"
          },
          "explanation": "3 दिन का काम = 9/20. शेष = 11/20. B द्वारा लिया गया समय = 8.25."
        }
      }
    },
