        "hi": {
          "question": "8 छात्रों का औसत वजन 45 किग्रा है। यदि 63 किग्रा वजन का एक छात्र जोड़ा जाता है, तो नया औसत ज्ञात कीजिए।",
          "options": {
            "A": "47 किग्रा",
            "B": "46 किग्रा",
            "C": "48 किग्रा",
            "D": "49 किग्रा"
          },
          "explanation": "नया औसत = (360 + 63) / 9 = 47."
        }
      }
