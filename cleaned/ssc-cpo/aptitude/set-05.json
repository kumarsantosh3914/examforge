    {
      "id": "aptitude-05-001",
      "number": 1,
      "question": "A man can row 5 km/h in still water. If the speed of the current is 1 km/h and it takes him 1 hour to row to a place and come back, how far is the place?",
      "options": {
        "A": "2.4 km",
        "B": "2.5 km",
        "C": "3 km",
        "D": "3.6 km"
      },
      "answer": "A",
      "explanation": "Speed Down = 6, Speed Up = 4. Distance d: d/6 + d/4 = 1 => 5d/12 = 1 => d = 2.4.",
      "hash": "74ad4bf9627fd9e5",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति शांत जल में 5 किमी/घंटा की गति से नाव चला सकता है। यदि धारा की गति 1 किमी/घंटा है और उसे एक स्थान पर जाने और वापस आने में 1 घंटा लगता है, तो वह स्थान कितनी दूर है?",
          "options": {
            "A": "2.4 किमी",
            "B": "2.5 किमी",
            "C": "3 किमी",
            "D": "3.6 किमी"
          },
          "explanation": "अनुप्रवाह गति = 6, ऊर्ध्वप्रवाह = 4. दूरी d: d/6 + d/4 = 1 => d = 2.4."
        }
      }
    },
    {
      "id": "aptitude-05-002",
      "number": 2,
      "question": "If the area of a square is increased by 44%, find the percentage increase in its side.",
      "options": {
        "A": "20%",
        "B": "22%",
        "C": "12%",
        "D": "15%"
      },
      "answer": "A",
      "explanation": "New Area = 1.44 * Old Area. Side = sqrt(1.44) = 1.2 * Old Side. Increase = 20%.",
      "hash": "b27e802e4c47e59a",
      "translations": {
        "hi": {
          "question": "यदि एक वर्ग के क्षेत्रफल में 44% की वृद्धि की जाती है, तो उसकी भुजा में प्रतिशत वृद्धि ज्ञात कीजिए।",
          "options": {
            "A": "20%",
            "B": "22%",
            "C": "12%",
            "D": "15%"
          },
          "explanation": "नया क्षेत्रफल = 1.44. भुजा = sqrt(1.44) = 1.2. वृद्धि = 20%."
        }
      }
    },
    {
      "id": "aptitude-05-003",
      "number": 3,
      "question": "Find the sum of all natural numbers from 1 to 100.",
      "options": {
        "A": "5050",
        "B": "5000",
        "C": "5100",
        "D": "4950"
      },
      "answer": "A",
      "explanation": "Sum = n(n+1)/2 = 100 * 101 / 2 = 5050.",
      "hash": "49ef9b3a2b4e6c53",
      "translations": {
        "hi": {
          "question": "1 से 100 तक की सभी प्राकृतिक संख्याओं का योग ज्ञात कीजिए।",
          "options": {
            "A": "5050",
            "B": "5000",
            "C": "5100",
            "D": "4950"
          },
          "explanation": "योग = n(n+1)/2 = 50 * 101 = 5050."
        }
      }
    },
    {
      "id": "aptitude-05-004",
      "number": 4,
      "question": "A sum of money amounts to 6655 in 3 years and 6050 in 2 years at compound interest. Find the rate of interest.",
      "options": {
        "A": "10%",
        "B": "5%",
        "C": "12%",
        "D": "8%"
      },
      "answer": "A",
      "explanation": "Rate = (6655 - 6050) / 6050 * 100 = 605 / 6050 * 100 = 10%.",
      "hash": "a9ef79d428e017a6",
      "translations": {
        "hi": {
          "question": "चक्रवृद्धि ब्याज पर कोई राशि 3 वर्षों में 6655 और 2 वर्षों में 6050 हो जाती है। ब्याज की दर ज्ञात कीजिए।",
          "options": {
            "A": "10%",
            "B": "5%",
            "C": "12%",
            "D": "8%"
          },
          "explanation": "दर = (6655 - 6050) / 6050 * 100 = 10%."
        }
      }
    },
    {
      "id": "aptitude-05-005",
      "number": 5,
      "question": "A and B can do a work in 12 days and 18 days respectively. They work together for 4 days, then A leaves. In how many days will B finish the remaining work?",
      "options": {
        "A": "8",
        "B": "6",
        "C": "10",
        "D": "12"
      },
      "answer": "A",
      "explanation": "Work in 4 days = 4(1/12 + 1/18) = 4(5/36) = 5/9. Remaining = 4/9. B takes = (4/9) * 18 = 8 days.",
      "hash": "fbdc8ee779c9f2ea",
      "translations": {
        "hi": {
          "question": "A और B एक कार्य को क्रमशः 12 दिन और 18 दिन में कर सकते हैं। वे 4 दिनों तक साथ काम करते हैं, फिर A छोड़ देता है। B शेष कार्य को कितने दिनों में पूरा करेगा?",
          "options": {
            "A": "8",
            "B": "6",
            "C": "10",
            "D": "12"
          },
          "explanation": "4 दिनों का काम = 5/9. शेष = 4/9. B लेगा = (4/9) * 18 = 8 दिन।"
        }
      }
    },
    {
