      "translations": {
        "hi": {
          "question": "A एक कार्य को 10 दिनों में और B 15 दिनों में कर सकता है। यदि वे A से शुरू करते हुए वैकल्पिक दिनों में कार्य करते हैं, तो कार्य कितने दिनों में समाप्त होगा?",
          "options": {
            "A": "12",
            "B": "13",
            "C": "10",
            "D": "14"
          },
          "explanation": "2 दिन का काम = 1/6. कुल चक्र = 6. दिन = 12."
        }
      }
