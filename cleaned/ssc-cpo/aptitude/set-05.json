        "hi": {
          "question": "तीन संख्याओं का अनुपात 2:3:5 है और उनका गुणनफल 810 है। संख्याएँ ज्ञात कीजिए।",
          "options": {
            "A": "6, 9, 15",
            "B": "4, 6, 10",
            "C": "2, 3, 5",
            "D": "8, 12, 20"
          },
          "explanation": "30x^3 = 810 => x = 3. संख्याएँ: 6, 9, 15."
        }
      }
    },
