          "question": "9 और 16 के बीच मध्यानुपाती ज्ञात कीजिए।",
          "options": {
            "A": "12",
            "B": "12.5",
            "C": "14",
            "D": "10"
          },
          "explanation": "मध्यानुपाती = sqrt(9 * 16) = 12."
        }
      }
    },
    {
      "id": "aptitude-05-007",
      "number": 7,
      "question": "A train crosses a pole in 15 seconds and a 100m platform in 25 seconds. Find the length of the train.",
      "options": {
        "A": "150m",
        "B": "120m",
        "C": "200m",
        "D": "100m"
      },
      "answer": "A",
      "explanation": "Speed = 100 / (25-15) = 10 m/s. Length = 10 * 15 = 150m.",
      "hash": "cdab05743060042d",
      "translations": {
        "hi": {
          "question": "एक ट्रेन एक खंभे को 15 सेकंड में और 100 मीटर लंबे प्लेटफॉर्म को 25 सेकंड में पार करती है। ट्रेन की लंबाई ज्ञात कीजिए।",
          "options": {
            "A": "150 मीटर",
            "B": "120 मीटर",
            "C": "200 मीटर",
            "D": "100 मीटर"
          },
          "explanation": "गति = 100 / 10 = 10 मीटर/सेकंड। लंबाई = 10 * 15 = 150 मीटर।"
        }
      }
    },
    {
      "id": "aptitude-05-008",
      "number": 8,
      "question": "If 20% of (A + B) = 50% of B, then (2A - B) / (2A + B) is?",
      "options": {
        "A": "1/2",
        "B": "2/3",
        "C": "1/3",
        "D": "3/4"
      },
      "answer": "A",
      "explanation": "0.2A + 0.2B = 0.5B => 0.2A = 0.3B => A/B = 3/2. Let A=3, B=2. (6-2)/(6+2) = 4/8 = 1/2.",
      "hash": "c73aa4c5d7e7b9cb",
      "translations": {
        "hi": {
          "question": "यदि (A + B) का 20% = B का 50% है, तो (2A - B) / (2A + B) क्या है?",
          "options": {
            "A": "1/2",
            "B": "2/3",
            "C": "1/3",
            "D": "3/4"
          },
          "explanation": "0.2A = 0.3B => A=3, B=2. (6-2)/(6+2) = 4/8 = 1/2."
        }
      }
    },
