    {
      "id": "aptitude-01-028",
      "number": 28,
      "question": "The ratio of age of father and son is 7:3. The product of their ages is 756. Find the age of the son.",
      "options": {
        "A": "18",
        "B": "24",
        "C": "21",
        "D": "15"
      },
      "answer": "A",
      "explanation": "7x * 3x = 756 => 21x^2 = 756 => x^2 = 36 => x=6. Son = 3 * 6 = 18.",
      "hash": "657c46659bdf3551",
      "translations": {
        "hi": {
          "question": "पिता और पुत्र की आयु का अनुपात 7:3 है। उनकी आयु का गुणनफल 756 है। पुत्र की आयु ज्ञात कीजिए।",
          "options": {
            "A": "18",
            "B": "24",
            "C": "21",
            "D": "15"
          },
          "explanation": "7x * 3x = 756 => 21x^2 = 756 => x^2 = 36 => x=6. पुत्र = 3 * 6 = 18."
        }
      }
    },
