    {
      "id": "aptitude-01-001",
      "number": 1,
      "question": "The ratio of two numbers is 3:5 and their HCF is 12. Find the LCM of these numbers.",
      "options": {
        "A": "180",
        "B": "240",
        "C": "150",
        "D": "210"
      },
      "answer": "A",
      "explanation": "LCM = Ratio Product * HCF = 3 * 5 * 12 = 180.",
      "hash": "9c7aa087f8993904",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का अनुपात 3:5 है और उनका HCF 12 है। इन संख्याओं का LCM ज्ञात कीजिए।",
          "options": {
            "A": "180",
            "B": "240",
            "C": "150",
            "D": "210"
          },
          "explanation": "LCM = अनुपातों का गुणनफल * HCF = 3 * 5 * 12 = 180."
        }
      }
    },
    {
      "id": "aptitude-01-002",
      "number": 2,
      "question": "A shopkeeper allows a 10% discount on the marked price of an item and still makes a profit of 20%. If the marked price is 800, find the cost price.",
      "options": {
        "A": "600",
        "B": "550",
        "C": "500",
        "D": "650"
      },
      "answer": "A",
      "explanation": "CP = (MP * (100 - D)) / (100 + P) = (800 * 90) / 120 = 600.",
      "hash": "97f7bca23b998f40",
      "translations": {
        "hi": {
          "question": "एक दुकानदार एक वस्तु के अंकित मूल्य पर 10% की छूट देता है और फिर भी 20% का लाभ कमाता है। यदि अंकित मूल्य 800 है, तो क्रय मूल्य ज्ञात कीजिए।",
          "options": {
            "A": "600",
            "B": "550",
            "C": "500",
            "D": "650"
          },
          "explanation": "CP = (MP * (100 - D)) / (100 + P) = (800 * 90) / 120 = 600."
        }
      }
    },
    {
      "id": "aptitude-01-003",
      "number": 3,
      "question": "A train 150m long passes a pole in 15 seconds. What is the speed of the train in km/h?",
      "options": {
        "A": "30",
        "B": "36",
        "C": "45",
        "D": "54"
      },
      "answer": "B",
      "explanation": "Speed = 150/15 = 10 m/s. In km/h = 10 * 18/5 = 36.",
      "hash": "29b4f8ad3a01a5f4",
      "translations": {
        "hi": {
          "question": "150 मीटर लंबी एक ट्रेन 15 सेकंड में एक खंभे को पार करती है। किमी/घंटा में ट्रेन की गति क्या है?",
          "options": {
            "A": "30",
            "B": "36",
            "C": "45",
            "D": "54"
          },
          "explanation": "गति = 150/15 = 10 मीटर/सेकंड। किमी/घंटा में = 10 * 18/5 = 36."
        }
      }
    },
    {
      "id": "aptitude-01-004",
      "number": 4,
      "question": "If 15 men can complete a work in 20 days, how many days will 25 men take to complete the same work?",
      "options": {
        "A": "10",
        "B": "12",
        "C": "15",
        "D": "18"
      },
      "answer": "B",
      "explanation": "M1D1 = M2D2 => 15 * 20 = 25 * D2 => D2 = 300 / 25 = 12.",
      "hash": "3c8d61dd7a0bfa93",
      "translations": {
        "hi": {
          "question": "यदि 15 पुरुष एक कार्य को 20 दिनों में पूरा कर सकते हैं, तो 25 पुरुष उसी कार्य को कितने दिनों में पूरा करेंगे?",
          "options": {
            "A": "10",
            "B": "12",
            "C": "15",
            "D": "18"
          },
          "explanation": "M1D1 = M2D2 => 15 * 20 = 25 * D2 => D2 = 300 / 25 = 12."
        }
      }
    },
