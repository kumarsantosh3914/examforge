      "hash": "37f819961c199964",
      "translations": {
        "hi": {
          "question": "एक नाव शांत पानी में 12 किमी/घंटा की गति से चलती है। यदि धारा की गति 3 किमी/घंटा है, तो धारा के अनुकूल गति ज्ञात कीजिए।",
          "options": {
            "A": "15 किमी/घंटा",
            "B": "9 किमी/घंटा",
            "C": "12 किमी/घंटा",
            "D": "18 किमी/घंटा"
          },
          "explanation": "धारा के अनुकूल गति = शांत पानी में गति + धारा की गति = 12 + 3 = 15."
        }
      }
