    {
      "id": "aptitude-01-024",
      "number": 24,
      "question": "If a person walks at 14 km/h instead of 10 km/h, he would have walked 20 km more. Find the actual distance.",
      "options": {
        "A": "50 km",
        "B": "70 km",
        "C": "80 km",
        "D": "60 km"
      },
      "answer": "A",
      "explanation": "Let time be t. 14t - 10t = 20 => 4t = 20 => t = 5. Actual dist = 10 * 5 = 50.",
      "hash": "62267c07b29efefe",
      "translations": {
        "hi": {
          "question": "यदि कोई व्यक्ति 10 किमी/घंटा के बजाय 14 किमी/घंटा की गति से चलता है, तो वह 20 किमी अधिक चला होता। वास्तविक दूरी ज्ञात कीजिए।",
          "options": {
            "A": "50 किमी",
            "B": "70 किमी",
            "C": "80 किमी",
            "D": "60 किमी"
          },
          "explanation": "मान लें समय t है। 14t - 10t = 20 => 4t = 20 => t = 5. वास्तविक दूरी = 10 * 5 = 50."
        }
      }
    },
