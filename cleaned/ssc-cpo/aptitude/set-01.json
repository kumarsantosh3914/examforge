    {
      "id": "aptitude-01-006",
      "number": 6,
      "question": "If the area of a circle is 154 sq.cm, find its circumference.",
      "options": {
        "A": "22 cm",
        "B": "44 cm",
        "C": "66 cm",
        "D": "88 cm"
      },
      "answer": "B",
      "explanation": "PI*r^2 = 154 => r=7. Circumference = 2*PI*r = 2 * 22/7 * 7 = 44.",
      "hash": "9ea0586314d39bde",
      "translations": {
        "hi": {
          "question": "यदि एक वृत्त का क्षेत्रफल 154 वर्ग सेमी है, तो इसकी परिधि ज्ञात कीजिए।",
          "options": {
            "A": "22 सेमी",
            "B": "44 सेमी",
            "C": "66 सेमी",
            "D": "88 सेमी"
          },
          "explanation": "PI*r^2 = 154 => r=7. परिधि = 2*PI*r = 2 * 22/7 * 7 = 44."
        }
      }
    },
    {
      "id": "aptitude-01-007",
      "number": 7,
      "question": "What is the single discount equivalent to two successive discounts of 20% and 10%?",
      "options": {
        "A": "30%",
        "B": "25%",
        "C": "28%",
        "D": "32%"
      },
      "answer": "C",
      "explanation": "Single discount = x + y - (xy/100) = 20 + 10 - 2 = 28%.",
      "hash": "75e3686c95f95d07",
      "translations": {
        "hi": {
          "question": "20% और 10% की दो क्रमिक छूटों के बराबर एकल छूट क्या है?",
          "options": {
            "A": "30%",
            "B": "25%",
            "C": "28%",
            "D": "32%"
          },
          "explanation": "एकल छूट = x + y - (xy/100) = 20 + 10 - 2 = 28%."
        }
      }
    },
    {
      "id": "aptitude-01-008",
      "number": 8,
      "question": "A sum of money doubles itself in 8 years at simple interest. Find the rate of interest.",
      "options": {
        "A": "10%",
        "B": "12.5%",
        "C": "15%",
        "D": "20%"
      },
      "answer": "B",
      "explanation": "R = (n-1)*100 / T = (2-1)*100 / 8 = 12.5%.",
      "hash": "c0a5fcf3ba0a4bee",
      "translations": {
        "hi": {
          "question": "साधारण ब्याज पर कोई राशि 8 वर्षों में दोगुनी हो जाती है। ब्याज की दर ज्ञात कीजिए।",
          "options": {
            "A": "10%",
            "B": "12.5%",
            "C": "15%",
            "D": "20%"
          },
          "explanation": "R = (n-1)*100 / T = (2-1)*100 / 8 = 12.5%."
        }
      }
    },
