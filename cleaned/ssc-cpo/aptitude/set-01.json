    {
      "id": "aptitude-01-021",
      "number": 21,
      "question": "Two numbers are in ratio 2:3. If 4 is added to each, the ratio becomes 5:7. Find the numbers.",
      "options": {
        "A": "16, 24",
        "B": "12, 18",
        "C": "8, 12",
        "D": "20, 30"
      },
      "answer": "A",
      "explanation": "(2x+4)/(3x+4) = 5/7 => 14x+28 = 15x+20 => x=8. Numbers are 16, 24.",
      "hash": "9cb471eb80ae80f6",
      "translations": {
        "hi": {
          "question": "दो संख्याएँ 2:3 के अनुपात में हैं। यदि प्रत्येक में 4 जोड़ा जाता है, तो अनुपात 5:7 हो जाता है। संख्याएँ ज्ञात कीजिए।",
          "options": {
            "A": "16, 24",
            "B": "12, 18",
            "C": "8, 12",
            "D": "20, 30"
          },
          "explanation": "(2x+4)/(3x+4) = 5/7 => 14x+28 = 15x+20 => x=8. संख्याएँ 16, 24 हैं।"
        }
      }
    },
