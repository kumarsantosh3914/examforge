    {
      "id": "mathematics-01-014",
      "number": 14,
      "question": "A cylinder has a radius of 7 cm and height of 10 cm. Find its volume. (Use pi = 22/7)",
      "options": {
        "A": "770 cubic cm",
        "B": "1540 cubic cm",
        "C": "1100 cubic cm",
        "D": "440 cubic cm"
      },
      "answer": "B",
      "explanation": "Volume = pi * r^2 * h = (22/7) * 7 * 7 * 10 = 1540.",
      "hash": "46743747c5b78283",
      "translations": {
        "hi": {
          "question": "एक बेलन की त्रिज्या 7 सेमी और ऊँचाई 10 सेमी है। इसका आयतन ज्ञात कीजिए। (pi = 22/7 का प्रयोग करें)",
          "options": {
            "A": "770 घन सेमी",
            "B": "1540 घन सेमी",
            "C": "1100 घन सेमी",
            "D": "440 घन सेमी"
          },
          "explanation": "आयतन = pi * r^2 * h = (22/7) * 7 * 7 * 10 = 1540।"
        }
      }
    },
