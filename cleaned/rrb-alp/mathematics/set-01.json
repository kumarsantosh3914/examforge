    {
      "id": "mathematics-01-024",
      "number": 24,
      "question": "If a person travels at 40 km/h, he reaches his destination 10 minutes late. At 50 km/h, he reaches 5 minutes early. Find the distance.",
      "options": {
        "A": "50 km",
        "B": "45 km",
        "C": "60 km",
        "D": "55 km"
      },
      "answer": "A",
      "explanation": "Distance = [S1*S2 / (S2-S1)] * Diff in time = [40*50 / 10] * (15/60) = 200 * 0.25 = 50 km.",
      "hash": "4741961b45517de9",
      "translations": {
        "hi": {
          "question": "यदि कोई व्यक्ति 40 किमी/घंटा की गति से यात्रा करता है, तो वह अपने गंतव्य पर 10 मिनट देरी से पहुँचता है। 50 किमी/घंटा पर, वह 5 मिनट पहले पहुँचता है। दूरी ज्ञात कीजिए।",
          "options": {
            "A": "50 किमी",
            "B": "45 किमी",
            "C": "60 किमी",
            "D": "55 किमी"
          },
          "explanation": "दूरी = [S1*S2 / (S2-S1)] * समय में अंतर = [40*50 / 10] * (15/60) = 50 किमी."
        }
      }
    },
