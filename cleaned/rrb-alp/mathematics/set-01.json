    {
      "id": "mathematics-01-008",
      "number": 8,
      "question": "The area of a square is 225 sq cm. Find its perimeter.",
      "options": {
        "A": "45 cm",
        "B": "50 cm",
        "C": "60 cm",
        "D": "75 cm"
      },
      "answer": "C",
      "explanation": "Side = sqrt(225) = 15. Perimeter = 4 * 15 = 60 cm.",
      "hash": "49b9e4549c4f04a7",
      "translations": {
        "hi": {
          "question": "एक वर्ग का क्षेत्रफल 225 वर्ग सेमी है। इसका परिमाप ज्ञात कीजिए।",
          "options": {
            "A": "45 सेमी",
            "B": "50 सेमी",
            "C": "60 सेमी",
            "D": "75 सेमी"
          },
          "explanation": "भुजा = sqrt(225) = 15। परिमाप = 4 * 15 = 60 सेमी।"
        }
      }
    },
