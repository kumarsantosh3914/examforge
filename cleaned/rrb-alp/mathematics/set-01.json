      "question": "The median of 10, 12, 14, 16, 18, 20, 22 is:",
      "options": {
        "A": "16",
        "B": "14",
        "C": "18",
        "D": "20"
      },
      "answer": "A",
      "explanation": "Since data is sorted and n=7 (odd), median is (7+1)/2 = 4th term. 4th term is 16.",
      "hash": "43584a450bbe9d8c",
      "translations": {
        "hi": {
          "question": "10, 12, 14, 16, 18, 20, 22 की माध्यिका है:",
          "options": {
            "A": "16",
            "B": "14",
            "C": "18",
            "D": "20"
          },
          "explanation": "डेटा क्रमबद्ध है और n=7 है, माध्यिका चौथा पद है। 16."
        }
      }
    },
    {
      "id": "mathematics-01-049",
      "number": 49,
      "question": "Find the smallest number which when divided by 6, 9, 12, 15, 18 leaves 2 as remainder in each case.",
      "options": {
        "A": "182",
        "B": "178",
        "C": "180",
        "D": "176"
      },
      "answer": "A",
      "explanation": "LCM of (6, 9, 12, 15, 18) = 180. Required number = 180 + 2 = 182.",
      "hash": "1829c6f0e54a6a7f",
      "translations": {
        "hi": {
          "question": "वह छोटी से छोटी संख्या ज्ञात कीजिए जिसे 6, 9, 12, 15, 18 से विभाजित करने पर प्रत्येक स्थिति में शेषफल 2 बचता है।",
          "options": {
            "A": "182",
            "B": "178",
            "C": "180",
            "D": "176"
          },
          "explanation": "LCM(6, 9, 12, 15, 18) = 180. अभीष्ट संख्या = 180 + 2 = 182."
        }
      }
    },
