    {
      "id": "mathematics-01-001",
      "number": 1,
      "question": "If a train covers 450 km in 5 hours, what is its speed in m/s?",
      "options": {
        "A": "20 m/s",
        "B": "25 m/s",
        "C": "30 m/s",
        "D": "90 m/s"
      },
      "answer": "B",
      "explanation": "Speed = 450/5 = 90 km/h. To convert to m/s, multiply by 5/18. 90 * 5/18 = 25 m/s.",
      "hash": "aa23b0b4f1a7edd3",
      "translations": {
        "hi": {
          "question": "यदि एक ट्रेन 5 घंटे में 450 किमी की दूरी तय करती है, तो उसकी गति मीटर/सेकंड में क्या है?",
          "options": {
            "A": "20 मीटर/सेकंड",
            "B": "25 मीटर/सेकंड",
            "C": "30 मीटर/सेकंड",
            "D": "90 मीटर/सेकंड"
          },
          "explanation": "गति = 450/5 = 90 किमी/घंटा। मीटर/सेकंड में बदलने के लिए 5/18 से गुणा करें। 90 * 5/18 = 25 मीटर/सेकंड।"
        }
      }
    },
    {
      "id": "mathematics-01-002",
      "number": 2,
      "question": "Find the value of x if 25% of x is 120.",
      "options": {
        "A": "400",
        "B": "480",
        "C": "520",
        "D": "600"
      },
      "answer": "B",
      "explanation": "0.25 * x = 120, so x = 120 / 0.25 = 480.",
      "hash": "6b2b8e7881059e36",
      "translations": {
        "hi": {
          "question": "यदि x का 25% 120 है, तो x का मान ज्ञात कीजिए।",
          "options": {
            "A": "400",
            "B": "480",
            "C": "520",
            "D": "600"
          },
          "explanation": "0.25 * x = 120, इसलिए x = 120 / 0.25 = 480."
        }
      }
    },
    {
      "id": "mathematics-01-003",
      "number": 3,
      "question": "Two numbers are in the ratio 3:5. If their sum is 64, find the smaller number.",
      "options": {
        "A": "24",
        "B": "30",
        "C": "40",
        "D": "18"
      },
      "answer": "A",
      "explanation": "3x + 5x = 64; 8x = 64; x = 8. Smaller number = 3 * 8 = 24.",
      "hash": "374370d6ca6f6df3",
      "translations": {
        "hi": {
          "question": "दो संख्याएँ 3:5 के अनुपात में हैं। यदि उनका योग 64 है, तो छोटी संख्या ज्ञात कीजिए।",
          "options": {
            "A": "24",
            "B": "30",
            "C": "40",
            "D": "18"
          },
          "explanation": "3x + 5x = 64; 8x = 64; x = 8। छोटी संख्या = 3 * 8 = 24।"
        }
      }
    },
    {
