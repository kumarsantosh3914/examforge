    {
      "id": "mathematics-01-005",
      "number": 5,
      "question": "A shopkeeper buys an article for 800 and sells it for 1000. Find the profit percentage.",
      "options": {
        "A": "20%",
        "B": "25%",
        "C": "30%",
        "D": "15%"
      },
      "answer": "B",
      "explanation": "Profit = 200. Profit % = (200/800) * 100 = 25%.",
      "hash": "f2a7d1a20e0cb1b8",
      "translations": {
        "hi": {
          "question": "एक दुकानदार एक वस्तु को 800 में खरीदता है और उसे 1000 में बेचता है। लाभ प्रतिशत ज्ञात कीजिए।",
          "options": {
            "A": "20%",
            "B": "25%",
            "C": "30%",
            "D": "15%"
          },
          "explanation": "लाभ = 200। लाभ % = (200/800) * 100 = 25%।"
        }
      }
    },
    {
      "id": "mathematics-01-006",
      "number": 6,
      "question": "A work can be completed by 10 men in 12 days. How many days will 15 men take to complete the same work?",
      "options": {
        "A": "6 days",
        "B": "8 days",
        "C": "10 days",
        "D": "9 days"
      },
      "answer": "B",
      "explanation": "M1D1 = M2D2; 10 * 12 = 15 * D2; D2 = 120 / 15 = 8.",
      "hash": "8ddfc74ce41311c6",
      "translations": {
        "hi": {
          "question": "एक कार्य को 10 व्यक्ति 12 दिनों में पूरा कर सकते हैं। उसी कार्य को पूरा करने में 15 व्यक्ति कितने दिन लेंगे?",
          "options": {
            "A": "6 दिन",
            "B": "8 दिन",
            "C": "10 दिन",
            "D": "9 दिन"
          },
          "explanation": "M1D1 = M2D2; 10 * 12 = 15 * D2; D2 = 120 / 15 = 8।"
        }
      }
    },
    {
