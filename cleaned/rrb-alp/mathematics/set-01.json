    {
      "id": "mathematics-01-010",
      "number": 10,
      "question": "If a sum of money doubles itself in 5 years at simple interest, what is the rate of interest?",
      "options": {
        "A": "10%",
        "B": "15%",
        "C": "20%",
        "D": "25%"
      },
      "answer": "C",
      "explanation": "SI = P, so P = (P * R * 5)/100. R = 100/5 = 20%.",
      "hash": "b7b6d5454b030c35",
      "translations": {
        "hi": {
          "question": "यदि कोई राशि साधारण ब्याज पर 5 वर्षों में दोगुनी हो जाती है, तो ब्याज की दर क्या है?",
          "options": {
            "A": "10%",
            "B": "15%",
            "C": "20%",
            "D": "25%"
          },
          "explanation": "SI = P, इसलिए P = (P * R * 5)/100. R = 100/5 = 20%।"
        }
      }
    },
    {
