      "translations": {
        "hi": {
          "question": "एक टैंक में 500 लीटर पानी है। यदि 12500 मिली पानी निकाल दिया जाए, तो टैंक में कितना पानी बचेगा?",
          "options": {
            "A": "487.5 लीटर",
            "B": "488.5 लीटर",
            "C": "475.5 लीटर",
            "D": "480.5 लीटर"
          },
          "explanation": "12500 मिली = 12.5 लीटर। शेष = 500 - 12.5 = 487.5 लीटर।"
        }
      }
    },
