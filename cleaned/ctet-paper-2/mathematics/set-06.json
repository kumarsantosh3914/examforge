    {
      "id": "mathematics-06-005",
      "number": 5,
      "question": "A rectangular garden is 25 m long and 15 m wide. If a fence is to be put around it, what is the total length of the wire required for one round?",
      "options": {
        "A": "80 m",
        "B": "40 m",
        "C": "70 m",
        "D": "100 m"
      },
      "answer": "A",
      "explanation": "Perimeter = 2(L + B) = 2(25 + 15) = 2(40) = 80 m.",
      "hash": "6724fe388113fc02",
      "translations": {
        "hi": {
          "question": "एक आयताकार बगीचा 25 मीटर लंबा और 15 मीटर चौड़ा है। यदि इसके चारों ओर बाड़ लगानी हो, तो एक चक्कर के लिए आवश्यक तार की कुल लंबाई क्या है?",
          "options": {
            "A": "80 मीटर",
            "B": "40 मीटर",
            "C": "70 मीटर",
            "D": "100 मीटर"
          },
          "explanation": "परिमाप = 2(लंबाई + चौड़ाई) = 2(25 + 15) = 80 मीटर।"
        }
      }
    },
    {
      "id": "mathematics-06-006",
      "number": 6,
      "question": "A train starts from city A at 21:30 and reaches city B at 06:45 the next morning. What is the travel time?",
      "options": {
        "A": "9 hours 15 mins",
        "B": "8 hours 15 mins",
        "C": "9 hours 45 mins",
        "D": "10 hours 15 mins"
      },
      "answer": "A",
      "explanation": "21:30 to 00:00 is 2h 30m. 00:00 to 06:45 is 6h 45m. Total = 9h 15m.",
      "hash": "fbe3699d3e6f68a3",
      "translations": {
        "hi": {
          "question": "एक ट्रेन शहर A से 21:30 बजे चलती है और अगली सुबह 06:45 बजे शहर B पहुँचती है। यात्रा का समय क्या है?",
          "options": {
            "A": "9 घंटे 15 मिनट",
            "B": "8 घंटे 15 मिनट",
            "C": "9 घंटे 45 मिनट",
            "D": "10 घंटे 15 मिनट"
          },
          "explanation": "21:30 से 00:00 तक 2घंटे 30मिनट। 00:00 से 06:45 तक 6घंटे 45मिनट। कुल = 9घंटे 15मिनट।"
        }
      }
    },
