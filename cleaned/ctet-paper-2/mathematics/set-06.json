    {
      "id": "mathematics-06-001",
      "number": 1,
      "question": "In a five-digit number, the digit at the hundreds place is 0, the digit at units place is 4, the digit at tens place is half the units place digit, and the digit at thousands place is three times the tens place digit. The ten-thousands digit is the sum of tens and units digits. What is the number?",
      "options": {
        "A": "66024",
        "B": "63024",
        "C": "46024",
        "D": "66204"
      },
      "answer": "A",
      "explanation": "Units=4, Tens=2, Hundreds=0, Thousands=2*3=6, Ten-thousands=2+4=6. Result is 66024.",
      "hash": "aa0b5480722abe72",
      "translations": {
        "hi": {
          "question": "एक पांच अंकीय संख्या में, सैकड़े के स्थान का अंक 0 है, इकाई के स्थान का अंक 4 है, दहाई के स्थान का अंक इकाई के स्थान के अंक का आधा है, और हजार के स्थान का अंक दहाई के स्थान के अंक का तीन गुना है। दस-हजार का अंक दहाई और इकाई के अंकों का योग है। संख्या क्या है?",
          "options": {
            "A": "66024",
            "B": "63024",
            "C": "46024",
            "D": "66204"
          },
          "explanation": "इकाई=4, दहाई=2, सैकड़ा=0, हजार=6, दस-हजार=6। परिणाम 66024 है।"
        }
      }
    },
    {
      "id": "mathematics-06-002",
      "number": 2,
      "question": "Which of the following is a pair of twin primes between 1 and 20?",
      "options": {
        "A": "(13, 17)",
        "B": "(17, 19)",
        "C": "(11, 15)",
        "D": "(3, 7)"
      },
      "answer": "B",
      "explanation": "Twin primes are primes with a difference of 2. 17 and 19 are both prime and their difference is 2.",
      "hash": "049435a3f1a40c0e",
      "translations": {
        "hi": {
          "question": "निम्नलिखित में से कौन सा 1 से 20 के बीच जुड़वां अभाज्य संख्याओं का एक युग्म है?",
          "options": {
            "A": "(13, 17)",
            "B": "(17, 19)",
            "C": "(11, 15)",
            "D": "(3, 7)"
          },
          "explanation": "जुड़वां अभाज्य संख्याएं वे अभाज्य संख्याएं हैं जिनमें 2 का अंतर होता है। 17 और 19 दोनों अभाज्य हैं।"
        }
      }
    },
