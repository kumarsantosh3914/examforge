      "question": "A circle has a diameter of 14 cm. What is its circumference? (pi = 22/7)",
      "options": {
        "A": "44 cm",
        "B": "22 cm",
        "C": "88 cm",
        "D": "154 cm"
      },
      "answer": "A",
      "explanation": "Circumference = pi * d = (22 / 7) * 14 = 44 cm.",
      "hash": "3f8a1b58945f0c86",
      "translations": {
        "hi": {
          "question": "एक वृत्त का व्यास 14 सेमी है। इसकी परिधि क्या है? (pi = 22/7)",
          "options": {
            "A": "44 सेमी",
            "B": "22 सेमी",
            "C": "88 सेमी",
            "D": "154 सेमी"
          },
          "explanation": "परिधि = pi * व्यास = (22 / 7) * 14 = 44 सेमी।"
        }
      }
    },
