    {
      "id": "mathematical-ability-03-011",
      "number": 11,
      "question": "Find the difference between CI and SI on ₹1000 at 10% per annum for 2 years.",
      "options": {
        "A": "₹10",
        "B": "₹20",
        "C": "₹100",
        "D": "₹5"
      },
      "answer": "A",
      "explanation": "Formula (for 2 years): P(R/100)² ⇒ 1000(10/100)² = 1000(1/100) = ₹10.",
      "hash": "741b2856fe4b132d",
      "translations": {
        "hi": {
          "question": "₹1000 पर 10% वार्षिक दर से 2 वर्ष के लिए चक्रवृद्धि ब्याज (CI) और साधारण ब्याज (SI) के बीच का अंतर ज्ञात करें।",
          "options": {
            "A": "₹10",
            "B": "₹20",
            "C": "₹100",
            "D": "₹5"
          },
          "explanation": "सूत्र (2 वर्ष के लिए): P(R/100)² ⇒ 1000(10/100)² = 1000(1/100) = ₹10।"
        }
      }
