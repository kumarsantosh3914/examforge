          "options": {
            "A": "2 घंटे",
            "B": "3 घंटे",
            "C": "4 घंटे",
            "D": "2.5 घंटे"
          },
          "explanation": "समय = दूरी / गति = 180 / 60 = 3 घंटे।"
        }
      }
