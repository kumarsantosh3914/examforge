          "options": {
            "A": "60 किमी/घंटा",
            "B": "72 किमी/घंटा",
            "C": "80 किमी/घंटा",
            "D": "90 किमी/घंटा"
          },
          "explanation": "20 × (18/5) = 4 × 18 = 72 किमी/घंटा।"
        }
      }
