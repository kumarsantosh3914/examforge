    {
      "id": "mathematical-ability-03-007",
      "number": 7,
      "question": "What will be the Simple Interest on ₹5000 at 4% per annum for 3 years?",
      "options": {
        "A": "₹500",
        "B": "₹600",
        "C": "₹700",
        "D": "₹800"
      },
      "answer": "B",
      "explanation": "SI = (5000 × 4 × 3) / 100 = 50 × 12 = ₹600.",
      "hash": "7ca477785a7a7dda",
      "translations": {
        "hi": {
          "question": "₹5000 पर 4% वार्षिक दर से 3 वर्ष का साधारण ब्याज क्या होगा?",
          "options": {
            "A": "₹500",
            "B": "₹600",
            "C": "₹700",
            "D": "₹800"
          },
          "explanation": "SI = (5000 × 4 × 3) / 100 = 50 × 12 = ₹600।"
        }
      }
