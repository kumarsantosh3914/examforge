    {
      "id": "mathematical-ability-03-014",
      "number": 14,
      "question": "If A:B = 3:4 and B:C = 8:9, find A:C.",
      "options": {
        "A": "1:2",
        "B": "2:3",
        "C": "3:2",
        "D": "1:3"
      },
      "answer": "B",
      "explanation": "A/C = (A/B) × (B/C) = (3/4) × (8/9) = 24/36 = 2/3.",
      "hash": "e2a98c96d9969c26",
      "translations": {
        "hi": {
          "question": "यदि A:B = 3:4 और B:C = 8:9 है, तो A:C ज्ञात करें।",
          "options": {
            "A": "1:2",
            "B": "2:3",
            "C": "3:2",
            "D": "1:3"
          },
          "explanation": "A/C = (A/B) × (B/C) = (3/4) × (8/9) = 24/36 = 2/3।"
        }
      }
    },
