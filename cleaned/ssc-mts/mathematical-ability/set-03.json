        "hi": {
          "question": "एक आयत की लंबाई 15 सेमी और चौड़ाई 10 सेमी है। इसका क्षेत्रफल क्या होगा?",
          "options": {
            "A": "150 सेमी²",
            "B": "100 सेमी²",
            "C": "50 सेमी²",
            "D": "250 सेमी²"
          },
          "explanation": "क्षेत्रफल = लंबाई × चौड़ाई = 15 × 10 = 150 सेमी²।"
        }
      }
