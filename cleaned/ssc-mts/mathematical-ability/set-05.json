    {
      "id": "mathematical-ability-05-003",
      "number": 3,
      "question": "15 men can do a work in 10 days. In how many days will 10 men do the same work?",
      "options": {
        "A": "15 days",
        "B": "20 days",
        "C": "12 days",
        "D": "25 days"
      },
      "answer": "A",
      "explanation": "M1D1 = M2D2 ⇒ 15 × 10 = 10 × D2 ⇒ D2 = 15.",
      "hash": "9ebdc4442a041aff",
      "translations": {
        "hi": {
          "question": "15 आदमी एक काम को 10 दिनों में कर सकते हैं। उसी काम को 10 आदमी कितने दिनों में करेंगे?",
          "options": {
            "A": "15 दिन",
            "B": "20 दिन",
            "C": "12 दिन",
            "D": "25 दिन"
          },
          "explanation": "M1D1 = M2D2 ⇒ 15 × 10 = 10 × D2 ⇒ D2 = 15।"
        }
      }
    },
