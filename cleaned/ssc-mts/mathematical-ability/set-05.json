      "id": "mathematical-ability-05-001",
      "number": 1,
      "question": "If 7 : x :: 35 : 45, find the value of x.",
      "options": {
        "A": "7",
        "B": "9",
        "C": "5",
        "D": "8"
      },
      "answer": "B",
      "explanation": "7/x = 35/45 ⇒ 7/x = 7/9 ⇒ x = 9.",
      "hash": "3ce5255c7283c885",
      "translations": {
        "hi": {
          "question": "यदि 7 : x :: 35 : 45 है, तो x का मान ज्ञात करें।",
          "options": {
            "A": "7",
            "B": "9",
            "C": "5",
            "D": "8"
          },
          "explanation": "7/x = 35/45 ⇒ 7/x = 7/9 ⇒ x = 9।"
        }
      }
    },
