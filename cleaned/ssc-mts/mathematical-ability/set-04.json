    {
      "id": "mathematical-ability-04-005",
      "number": 5,
      "question": "The perimeter of a rectangular field is 480 m and the ratio of length to breadth is 5:3. What is the area of the field?",
      "options": {
        "A": "13500 m²",
        "B": "15000 m²",
        "C": "12000 m²",
        "D": "14500 m²"
      },
      "answer": "A",
      "explanation": "2(5x+3x)=480 ⇒ 16x=480 ⇒ x=30. L=150, B=90. Area=150×90=13500.",
      "hash": "84d40f51f71fc875",
      "translations": {
        "hi": {
          "question": "एक आयताकार मैदान का परिमाप 480 मीटर है और लंबाई तथा चौड़ाई का अनुपात 5:3 है। मैदान का क्षेत्रफल क्या है?",
          "options": {
            "A": "13500 मी²",
            "B": "15000 मी²",
            "C": "12000 मी²",
            "D": "14500 मी²"
          },
          "explanation": "2(5x+3x)=480 ⇒ 16x=480 ⇒ x=30. L=150, B=90. क्षेत्रफल=150×90=13500।"
        }
      }
    },
    {
      "id": "mathematical-ability-04-006",
      "number": 6,
      "question": "A train crosses a pole in 30 seconds at a speed of 45 km/h. Find the length of the train.",
      "options": {
        "A": "300 meters",
        "B": "375 meters",
        "C": "400 meters",
        "D": "450 meters"
      },
      "answer": "B",
      "explanation": "Speed = 45×(5/18) = 12.5 m/s. Distance = 12.5 × 30 = 375 meters.",
      "hash": "5e78ab2afd3d185e",
      "translations": {
        "hi": {
          "question": "एक ट्रेन 45 किमी/घंटा की गति से एक खंभे को 30 सेकंड में पार करती है। ट्रेन की लंबाई ज्ञात करें।",
          "options": {
            "A": "300 मीटर",
            "B": "375 मीटर",
            "C": "400 मीटर",
            "D": "450 मीटर"
          },
          "explanation": "गति = 45×(5/18) = 12.5 मी/से। दूरी = 12.5 × 30 = 375 मीटर।"
        }
      }
    },
