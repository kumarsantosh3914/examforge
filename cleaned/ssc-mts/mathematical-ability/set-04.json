    {
      "id": "mathematical-ability-04-001",
      "number": 1,
      "question": "Simplify: 25 - [12 - {5 + 18 ÷ (4 - 2)}]",
      "options": {
        "A": "27",
        "B": "29",
        "C": "25",
        "D": "20"
      },
      "answer": "A",
      "explanation": "25 - [12 - {5 + 18 ÷ 2}] ⇒ 25 - [12 - {5 + 9}] ⇒ 25 - [12 - 14] ⇒ 25 - [-2] ⇒ 25 + 2 = 27.",
      "hash": "1fb5a636f3e18c21",
      "translations": {
        "hi": {
          "question": "सरल करें: 25 - [12 - {5 + 18 ÷ (4 - 2)}]",
          "options": {
            "A": "27",
            "B": "29",
            "C": "25",
            "D": "20"
          },
          "explanation": "25 - [12 - {5 + 18 ÷ 2}] ⇒ 25 - [12 - {5 + 9}] ⇒ 25 - [12 - 14] ⇒ 25 - [-2] ⇒ 25 + 2 = 27."
        }
      }
    },
    {
      "id": "mathematical-ability-04-002",
      "number": 2,
      "question": "The average age of A, B, and C is 25 years. If the average age of A and B is 20 years, what is C's age?",
      "options": {
        "A": "30 years",
        "B": "35 years",
        "C": "40 years",
        "D": "25 years"
      },
      "answer": "B",
      "explanation": "A+B+C = 25×3 = 75. A+B = 20×2 = 40. C = 75-40 = 35.",
      "hash": "885bd2b6a6329f2c",
      "translations": {
        "hi": {
          "question": "A, B और C की औसत आयु 25 वर्ष है। यदि A और B की औसत आयु 20 वर्ष है, तो C की आयु क्या है?",
          "options": {
            "A": "30 वर्ष",
            "B": "35 वर्ष",
            "C": "40 वर्ष",
            "D": "25 वर्ष"
          },
          "explanation": "A+B+C = 25×3 = 75. A+B = 20×2 = 40. C = 75-40 = 35।"
        }
      }
    },
