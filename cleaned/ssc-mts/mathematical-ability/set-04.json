      "hash": "83581dbc1e623116",
      "translations": {
        "hi": {
          "question": "16 मजदूर एक दीवार को 12 दिनों में बना सकते हैं। उसी दीवार को 8 दिनों में बनाने के लिए कितने मजदूरों की आवश्यकता होगी?",
          "options": {
            "A": "20",
            "B": "24",
            "C": "30",
            "D": "32"
          },
          "explanation": "M1D1 = M2D2 ⇒ 16×12 = M2×8 ⇒ M2 = 24।"
        }
      }
