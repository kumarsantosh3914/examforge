      "id": "mathematical-ability-01-001",
      "number": 1,
      "question": "Simplify: 24 ÷ 4 × (3 + 2) - 10",
      "options": {
        "A": "20",
        "B": "22",
        "C": "18",
        "D": "15"
      },
      "answer": "A",
      "explanation": "Follow BODMAS rule: 24 ÷ 4 × 5 - 10 ⇒ 6 × 5 - 10 ⇒ 30 - 10 = 20",
      "hash": "d5d90582e5db58c0",
      "translations": {
        "hi": {
          "question": "सरल करें: 24 ÷ 4 × (3 + 2) - 10",
          "options": {
            "A": "20",
            "B": "22",
            "C": "18",
            "D": "15"
          },
          "explanation": "BODMAS नियम का पालन करें: 24 ÷ 4 × 5 - 10 ⇒ 6 × 5 - 10 ⇒ 30 - 10 = 20"
        }
      }
    },
    {
      "id": "mathematical-ability-01-002",
      "number": 2,
      "question": "A can do a work in 10 days and B in 15 days. In how many days will they finish the work together?",
      "options": {
        "A": "5 days",
        "B": "6 days",
        "C": "8 days",
        "D": "9 days"
      },
      "answer": "B",
      "explanation": "Formula: (xy)/(x+y) ⇒ (10×15)/(10+15) = 150/25 = 6 days.",
      "hash": "2da34f4dcb9a01d6",
      "translations": {
        "hi": {
          "question": "A किसी काम को 10 दिन में और B उसी काम को 15 दिन में कर सकता है। दोनों मिलकर उस काम को कितने दिन में पूरा करेंगे?",
          "options": {
            "A": "5 दिन",
            "B": "6 दिन",
            "C": "8 दिन",
            "D": "9 दिन"
          },
          "explanation": "सूत्र: (xy)/(x+y) ⇒ (10×15)/(10+15) = 150/25 = 6 दिन।"
        }
      }
    },
    {
      "id": "mathematical-ability-01-003",
      "number": 3,
      "question": "What is the third proportional to 18 and 24?",
      "options": {
        "A": "30",
        "B": "32",
        "C": "36",
        "D": "40"
      },
      "answer": "B",
      "explanation": "Formula: b² / a. Here, (24 × 24) / 18 = 576 / 18 = 32",
      "hash": "bc23c396d92e6811",
      "translations": {
        "hi": {
          "question": "18 और 24 का तृतीय आनुपातिक (Third Proportional) क्या है?",
          "options": {
            "A": "30",
            "B": "32",
            "C": "36",
            "D": "40"
          },
          "explanation": "सूत्र: b² / a. यहाँ, (24 × 24) / 18 = 576 / 18 = 32"
        }
      }
    },
    {
      "id": "mathematical-ability-01-004",
      "number": 4,
      "question": "The cost price of an article is ₹500 and it is sold for ₹600. What is the profit percentage?",
      "options": {
        "A": "10%",
        "B": "15%",
        "C": "20%",
        "D": "25%"
      },
      "answer": "C",
      "explanation": "Profit = 600 - 500 = 100. Profit % = (100 / 500) × 100 = 20%",
      "hash": "42b3e59b9b8fd42f",
      "translations": {
        "hi": {
          "question": "एक वस्तु का क्रय मूल्य ₹500 है और इसे ₹600 में बेचा जाता है। लाभ प्रतिशत क्या है?",
          "options": {
            "A": "10%",
            "B": "15%",
            "C": "20%",
            "D": "25%"
          },
          "explanation": "लाभ = 600 - 500 = 100। लाभ % = (100 / 500) × 100 = 20%"
        }
      }
    },
