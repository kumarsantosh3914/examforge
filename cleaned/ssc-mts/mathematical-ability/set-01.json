          "options": {
            "A": "₹200",
            "B": "₹300",
            "C": "₹400",
            "D": "₹500"
          },
          "explanation": "SI = (P × R × T) / 100 ⇒ (2000 × 5 × 3) / 100 = ₹300"
        }
      }
