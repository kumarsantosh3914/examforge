    {
      "id": "mathematical-ability-01-011",
      "number": 11,
      "question": "If P : Q = 2 : 3 and Q : R = 4 : 5, then what is P : R?",
      "options": {
        "A": "8 : 15",
        "B": "10 : 12",
        "C": "6 : 15",
        "D": "8 : 12"
      },
      "answer": "A",
      "explanation": "P/R = (P/Q) × (Q/R) = (2/3) × (4/5) = 8/15. So P:R = 8:15.",
      "hash": "fd695bbdbec1ec0c",
      "translations": {
        "hi": {
          "question": "यदि P : Q = 2 : 3 और Q : R = 4 : 5 है, तो P : R क्या है?",
          "options": {
            "A": "8 : 15",
            "B": "10 : 12",
            "C": "6 : 15",
            "D": "8 : 12"
          },
          "explanation": "P/R = (P/Q) × (Q/R) = (2/3) × (4/5) = 8/15. अतः P:R = 8:15."
        }
      }
    },
    {
      "id": "mathematical-ability-01-012",
      "number": 12,
      "question": "A train is 200 m long and running at 36 km/h. In how much time will it cross a pole?",
      "options": {
