    {
      "id": "mathematical-ability-01-016",
      "number": 16,
      "question": "30 men can do a work in 20 days. In how many days will 20 men do the same work?",
      "options": {
        "A": "25 days",
        "B": "30 days",
        "C": "40 days",
        "D": "15 days"
      },
      "answer": "B",
      "explanation": "M1 × D1 = M2 × D2 ⇒ 30 × 20 = 20 × D2 ⇒ D2 = 30 days.",
      "hash": "0f8e1d67c3a8e152",
      "translations": {
        "hi": {
          "question": "30 आदमी एक काम को 20 दिनों में कर सकते हैं। उसी काम को 20 आदमी कितने दिनों में करेंगे?",
          "options": {
            "A": "25 दिन",
            "B": "30 दिन",
            "C": "40 दिन",
            "D": "15 दिन"
          },
          "explanation": "M1 × D1 = M2 × D2 ⇒ 30 × 20 = 20 × D2 ⇒ D2 = 30 दिन।"
        }
      }
    },
    {
