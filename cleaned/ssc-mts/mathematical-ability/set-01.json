      "question": "Find the LCM of 12, 15 and 20.",
      "options": {
        "A": "40",
        "B": "50",
        "C": "60",
        "D": "80"
      },
      "answer": "C",
      "explanation": "The smallest multiple divisible by 12, 15, and 20 is 60.",
      "hash": "0abd7a4e8515004b",
      "translations": {
        "hi": {
          "question": "12, 15 और 20 का लघुत्तम समापवर्त्य (LCM) ज्ञात करें।",
          "options": {
            "A": "40",
            "B": "50",
            "C": "60",
            "D": "80"
          },
          "explanation": "12, 15, 20 का सबसे छोटा गुणज जो तीनों से विभाज्य हो, वह 60 है।"
        }
      }
    },
    {
      "id": "mathematical-ability-01-007",
      "number": 7,
      "question": "The length of a rectangle is 12 cm and breadth is 8 cm. What is its perimeter?",
      "options": {
        "A": "20 cm",
        "B": "40 cm",
        "C": "96 cm",
        "D": "48 cm"
      },
      "answer": "B",
      "explanation": "Perimeter = 2(Length + Breadth) = 2(12 + 8) = 2 × 20 = 40 cm.",
      "hash": "953d6351c3b1dcdd",
      "translations": {
        "hi": {
          "question": "एक आयत की लंबाई 12 सेमी और चौड़ाई 8 सेमी है। इसका परिमाप क्या है?",
          "options": {
            "A": "20 सेमी",
            "B": "40 सेमी",
            "C": "96 सेमी",
            "D": "48 सेमी"
          },
          "explanation": "परिमाप = 2(लंबाई + चौड़ाई) = 2(12 + 8) = 2 × 20 = 40 सेमी।"
        }
      }
    },
