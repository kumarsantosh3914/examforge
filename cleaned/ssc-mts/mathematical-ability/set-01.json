    {
      "id": "mathematical-ability-01-018",
      "number": 18,
      "question": "If x/5 = y/8, then what is the value of (x+5) : (y+8)?",
      "options": {
        "A": "3 : 5",
        "B": "5 : 8",
        "C": "8 : 5",
        "D": "13 : 8"
      },
      "answer": "B",
      "explanation": "Let x=5k, y=8k. Ratio = (5k+5)/(8k+8) = 5(k+1)/8(k+1) = 5:8.",
      "hash": "22221352e6a9f580",
      "translations": {
        "hi": {
          "question": "यदि x/5 = y/8 है, तो (x+5) : (y+8) का मान क्या होगा?",
          "options": {
            "A": "3 : 5",
            "B": "5 : 8",
            "C": "8 : 5",
            "D": "13 : 8"
          },
          "explanation": "माना x=5k, y=8k. अनुपात = (5k+5)/(8k+8) = 5(k+1)/8(k+1) = 5:8."
        }
      }
