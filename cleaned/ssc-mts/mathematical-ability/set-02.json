    {
      "id": "mathematical-ability-02-002",
      "number": 2,
      "question": "Divide ₹750 between A and B in the ratio 2:3. What is B's share?",
      "options": {
        "A": "₹300",
        "B": "₹450",
        "C": "₹500",
        "D": "₹250"
      },
      "answer": "B",
      "explanation": "Total parts = 2+3=5. B's share = (3/5) × 750 = 3 × 150 = ₹450.",
      "hash": "8979c8c7b7cf3048",
      "translations": {
        "hi": {
          "question": "₹750 को A और B के बीच 2:3 के अनुपात में विभाजित करें। B का हिस्सा क्या है?",
          "options": {
            "A": "₹300",
            "B": "₹450",
            "C": "₹500",
            "D": "₹250"
          },
          "explanation": "कुल भाग = 2+3=5. B का हिस्सा = (3/5) × 750 = 3 × 150 = ₹450."
        }
      }
    },
    {
      "id": "mathematical-ability-02-003",
      "number": 3,
      "question": "The cost price of an item is ₹200. If a profit of 25% is desired, what should be the selling price?",
      "options": {
        "A": "₹240",
        "B": "₹250",
        "C": "₹225",
        "D": "₹300"
      },
      "answer": "B",
      "explanation": "Selling Price = 200 × (125/100) = 200 × 1.25 = ₹250.",
      "hash": "52836d1dc37926f1",
      "translations": {
        "hi": {
          "question": "एक वस्तु का क्रय मूल्य ₹200 है। यदि 25% का लाभ वांछित है, तो विक्रय मूल्य क्या होना चाहिए?",
          "options": {
            "A": "₹240",
            "B": "₹250",
            "C": "₹225",
            "D": "₹300"
          },
          "explanation": "विक्रय मूल्य = 200 × (125/100) = 200 × 1.25 = ₹250."
        }
      }
    },
    {
      "id": "mathematical-ability-02-004",
      "number": 4,
      "question": "A can complete a work in 12 days and B in 24 days. In how many days will they complete it together?",
      "options": {
        "A": "6 days",
        "B": "8 days",
        "C": "10 days",
        "D": "12 days"
      },
      "answer": "B",
      "explanation": "Days = (12×24)/(12+24) = 288/36 = 8 days.",
      "hash": "2d1e6d84f1c2913e",
      "translations": {
        "hi": {
          "question": "A एक कार्य को 12 दिनों में और B उसे 24 दिनों में पूरा कर सकता है। वे एक साथ मिलकर इसे कितने दिनों में पूरा करेंगे?",
          "options": {
            "A": "6 दिन",
            "B": "8 दिन",
            "C": "10 दिन",
            "D": "12 दिन"
          },
          "explanation": "दिन = (12×24)/(12+24) = 288/36 = 8 दिन।"
        }
      }
    },
