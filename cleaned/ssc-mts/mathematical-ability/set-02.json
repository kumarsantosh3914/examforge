      },
      "answer": "B",
      "explanation": "BODMAS: 12 ÷ 2 × 3 + 5 ⇒ 6 × 3 + 5 ⇒ 18 + 5 = 23.",
      "hash": "6681b4ba9d4f9a6e",
      "translations": {
        "hi": {
          "question": "सरल करें: (18 - 6) ÷ 2 × 3 + 5",
          "options": {
            "A": "20",
            "B": "23",
            "C": "25",
            "D": "18"
          },
          "explanation": "BODMAS: 12 ÷ 2 × 3 + 5 ⇒ 6 × 3 + 5 ⇒ 18 + 5 = 23."
