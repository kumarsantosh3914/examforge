    {
      "id": "mathematical-ability-02-018",
      "number": 18,
      "question": "The average of 5 numbers is 20. If one number is removed, the average becomes 18. What is the removed number?",
      "options": {
        "A": "26",
        "B": "28",
        "C": "22",
        "D": "24"
      },
      "answer": "B",
      "explanation": "Total sum = 5×20=100. New sum = 4×18=72. Removed number = 100-72 = 28.",
      "hash": "b472688f8dae95d7",
      "translations": {
        "hi": {
          "question": "5 संख्याओं का औसत 20 है। यदि एक संख्या हटा दी जाए, तो औसत 18 हो जाता है। हटाई गई संख्या क्या है?",
          "options": {
            "A": "26",
            "B": "28",
            "C": "22",
            "D": "24"
          },
          "explanation": "कुल योग = 5×20=100. नया योग = 4×18=72. हटाई गई संख्या = 100-72 = 28."
        }
      }
