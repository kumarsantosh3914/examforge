    {
      "id": "mathematical-ability-02-009",
      "number": 9,
      "question": "The radius of a circle is 7 cm. Find its area.",
      "options": {
        "A": "144 cm²",
        "B": "154 cm²",
        "C": "132 cm²",
        "D": "160 cm²"
      },
      "answer": "B",
      "explanation": "Area = πr² = (22/7) × 7 × 7 = 22 × 7 = 154 cm².",
      "hash": "187d7f7d29b5dbd5",
      "translations": {
        "hi": {
          "question": "एक वृत्त की त्रिज्या 7 सेमी है। इसका क्षेत्रफल ज्ञात करें। (π = 22/7)",
          "options": {
            "A": "144 सेमी²",
            "B": "154 सेमी²",
            "C": "132 सेमी²",
            "D": "160 सेमी²"
          },
          "explanation": "क्षेत्रफल = πr² = (22/7) × 7 × 7 = 22 × 7 = 154 सेमी²।"
        }
      }
    },
