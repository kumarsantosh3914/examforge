      "id": "mathematical-ability-02-017",
      "number": 17,
      "question": "A 150m long train crosses a 250m long bridge at a speed of 72 km/h. Find the time taken.",
      "options": {
        "A": "15 seconds",
        "B": "20 seconds",
        "C": "25 seconds",
        "D": "30 seconds"
      },
      "answer": "B",
      "explanation": "Total dist = 150+250=400 m. Speed = 72×(5/18)=20 m/s. Time = 400/20 = 20 sec.",
      "hash": "a8f4ac5f6a0b952d",
      "translations": {
        "hi": {
          "question": "150 मीटर लंबी एक ट्रेन 250 मीटर लंबे पुल को 72 किमी/घंटा की गति से पार करती है। लिया गया समय ज्ञात करें।",
          "options": {
            "A": "15 सेकंड",
            "B": "20 सेकंड",
            "C": "25 सेकंड",
            "D": "30 सेकंड"
          },
          "explanation": "कुल दूरी = 150+250=400 मी। गति = 72×(5/18)=20 मी/से। समय = 400/20 = 20 सेकंड।"
        }
      }
