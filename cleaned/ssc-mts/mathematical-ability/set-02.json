    {
      "id": "mathematical-ability-02-008",
      "number": 8,
      "question": "Find the principal on which simple interest for 2 years at 10% per annum is ₹400.",
      "options": {
        "A": "₹1000",
        "B": "₹1500",
        "C": "₹2000",
        "D": "₹2500"
      },
      "answer": "C",
      "explanation": "P = (SI × 100) / (R × T) = (400 × 100) / (10 × 2) = 40000 / 20 = ₹2000.",
      "hash": "124ce4d59c8e6d8c",
      "translations": {
        "hi": {
          "question": "वह मूलधन ज्ञात करें जिस पर 10% वार्षिक दर से 2 वर्ष का साधारण ब्याज ₹400 हो।",
          "options": {
            "A": "₹1000",
            "B": "₹1500",
            "C": "₹2000",
            "D": "₹2500"
          },
          "explanation": "P = (SI × 100) / (R × T) = (400 × 100) / (10 × 2) = 40000 / 20 = ₹2000."
        }
      }
