          "question": "एक वस्तु को ₹990 में बेचने पर 10% का लाभ होता है। क्रय मूल्य ज्ञात करें।",
          "options": {
            "A": "₹800",
            "B": "₹850",
            "C": "₹900",
            "D": "₹890"
          },
          "explanation": "CP = (SP × 100) / (100 + लाभ%) = (990 × 100) / 110 = 9 × 100 = ₹900."
        }
      }
