  "questions": [
    {
      "id": "mock-test-session-i-03-001",
      "number": 1,
      "question": "Find the compound interest on 5000 at 10% per annum for 2 years, compounded annually.",
      "options": {
        "A": "1000",
        "B": "1050",
        "C": "1100",
        "D": "1200"
      },
      "answer": "B",
      "explanation": "Amount = 5000 * (1.1)^2 = 5000 * 1.21 = 6050. CI = 6050 - 5000 = 1050.",
      "hash": "749a79e280789cc3",
      "translations": {
        "hi": {
          "question": "5000 पर 10% वार्षिक दर से 2 वर्ष का चक्रवृद्धि ब्याज ज्ञात कीजिए, जो वार्षिक रूप से संयोजित होता है।",
          "options": {
            "A": "1000",
            "B": "1050",
            "C": "1100",
            "D": "1200"
          },
          "explanation": "मिश्रधन = 5000 * (1.1)^2 = 5000 * 1.21 = 6050. चक्रवृद्धि ब्याज = 6050 - 5000 = 1050."
        }
      }
    },
    {
      "id": "mock-test-session-i-03-002",
      "number": 2,
      "question": "If the length of a rectangle is increased by 20% and its breadth is decreased by 20%, what is the net change in area?",
      "options": {
        "A": "No change",
        "B": "4% increase",
        "C": "4% decrease",
        "D": "2% decrease"
      },
      "answer": "C",
      "explanation": "Net change = x + y + xy/100. Here, 20 - 20 - (20*20)/100 = -4%.",
      "hash": "29bd22319ea5856c",
      "translations": {
        "hi": {
          "question": "यदि एक आयत की लंबाई में 20% की वृद्धि की जाती है और उसकी चौड़ाई में 20% की कमी की जाती है, तो क्षेत्रफल में शुद्ध परिवर्तन क्या है?",
          "options": {
            "A": "कोई परिवर्तन नहीं",
            "B": "4% वृद्धि",
            "C": "4% कमी",
            "D": "2% कमी"
          },
          "explanation": "शुद्ध परिवर्तन = x + y + xy/100. यहाँ, 20 - 20 - (20*20)/100 = -4%."
        }
      }
    },
    {
      "id": "mock-test-session-i-03-003",
      "number": 3,
      "question": "A shopkeeper buys a fan for 1200 and sells it at a loss of 10%. What is the selling price?",
      "options": {
        "A": "1000",
        "B": "1080",
        "C": "1100",
        "D": "1120"
      },
      "answer": "B",
      "explanation": "Loss = 10% of 1200 = 120. Selling Price = 1200 - 120 = 1080.",
      "hash": "ba0c6f797fdc80ad",
      "translations": {
        "hi": {
          "question": "एक दुकानदार एक पंखे को 1200 में खरीदता है और उसे 10% की हानि पर बेचता है। विक्रय मूल्य क्या है?",
          "options": {
            "A": "1000",
            "B": "1080",
            "C": "1100",
            "D": "1120"
          },
          "explanation": "हानि = 1200 का 10% = 120. विक्रय मूल्य = 1200 - 120 = 1080."
        }
      }
    },
    {
      "id": "mock-test-session-i-03-004",
      "number": 4,
      "question": "If 12 men can complete a work in 20 days, how many days will 15 men take to complete the same work?",
      "options": {
        "A": "15 days",
        "B": "16 days",
        "C": "18 days",
        "D": "20 days"
      },
      "answer": "B",
      "explanation": "M1D1 = M2D2. 12 * 20 = 15 * D2 => D2 = 240 / 15 = 16 days.",
      "hash": "486f122d41ccbffc",
      "translations": {
        "hi": {
          "question": "यदि 12 पुरुष एक कार्य को 20 दिनों में पूरा कर सकते हैं, तो 15 पुरुष उसी कार्य को पूरा करने में कितने दिन लेंगे?",
          "options": {
            "A": "15 दिन",
            "B": "16 दिन",
            "C": "18 दिन",
            "D": "20 दिन"
          },
          "explanation": "M1D1 = M2D2. 12 * 20 = 15 * D2 => D2 = 240 / 15 = 16 दिन।"
        }
      }
    },
    {
      "id": "mock-test-session-i-03-005",
      "number": 5,
      "question": "A man crosses a 600 m long street in 5 minutes. What is his speed in km/hr?",
      "options": {
        "A": "3.6",
        "B": "7.2",
        "C": "8.4",
        "D": "10"
      },
      "answer": "B",
      "explanation": "Speed = 600m / 300s = 2 m/s. In km/hr = 2 * 18/5 = 7.2 km/hr.",
      "hash": "5a56a858ef4a37c6",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति 600 मीटर लंबी सड़क को 5 मिनट में पार करता है। उसकी गति किमी/घंटा में क्या है?",
          "options": {
            "A": "3.6",
            "B": "7.2",
            "C": "8.4",
            "D": "10"
          },
          "explanation": "गति = 600 मीटर / 300 सेकंड = 2 मीटर/सेकंड। किमी/घंटा में = 2 * 18/5 = 7.2 किमी/घंटा।"
        }
      }
    },
    {
      "id": "mock-test-session-i-03-006",
      "number": 6,
      "question": "Three numbers are in the ratio 2:3:5. If their LCM is 600, find the numbers.",
      "options": {
        "A": "20, 30, 50",
        "B": "40, 60, 100",
        "C": "10, 15, 25",
        "D": "60, 90, 150"
      },
      "answer": "B",
      "explanation": "Let numbers be 2x, 3x, 5x. LCM = 30x. 30x = 600 => x = 20. Numbers are 40, 60, 100.",
      "hash": "6c479029071103f6",
      "translations": {
        "hi": {
          "question": "तीन संख्याएँ 2:3:5 के अनुपात में हैं। यदि उनका लघुत्तम समापवर्त्य (LCM) 600 है, तो संख्याएँ ज्ञात कीजिए।",
          "options": {
            "A": "20, 30, 50",
            "B": "40, 60, 100",
            "C": "10, 15, 25",
            "D": "60, 90, 150"
          },
          "explanation": "माना संख्याएँ 2x, 3x, 5x हैं। LCM = 30x. 30x = 600 => x = 20. संख्याएँ 40, 60, 100 हैं।"
        }
      }
    },
    {
