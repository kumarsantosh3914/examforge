    },
    {
      "id": "mock-test-session-i-03-008",
      "number": 8,
      "question": "Solve: (0.5 * 0.5 * 0.5 + 0.6 * 0.6 * 0.6) / (0.5 * 0.5 - 0.5 * 0.6 + 0.6 * 0.6)",
      "options": {
        "A": "0.1",
        "B": "1.1",
        "C": "0.3",
        "D": "0.61"
      },
      "answer": "B",
      "explanation": "Formula: (a^3 + b^3) / (a^2 - ab + b^2) = a + b. So, 0.5 + 0.6 = 1.1.",
      "hash": "8702f8f872b32777",
      "translations": {
        "hi": {
          "question": "हल करें: (0.5 * 0.5 * 0.5 + 0.6 * 0.6 * 0.6) / (0.5 * 0.5 - 0.5 * 0.6 + 0.6 * 0.6)",
          "options": {
            "A": "0.1",
            "B": "1.1",
            "C": "0.3",
            "D": "0.61"
          },
          "explanation": "सूत्र: (a^3 + b^3) / (a^2 - ab + b^2) = a + b. इसलिए, 0.5 + 0.6 = 1.1."
        }
      }
    },
    {
      "id": "mock-test-session-i-03-009",
      "number": 9,
      "question": "The area of an equilateral triangle is 16*sqrt(3) sq cm. Find its side.",
      "options": {
        "A": "4 cm",
        "B": "8 cm",
        "C": "12 cm",
        "D": "16 cm"
      },
      "answer": "B",
      "explanation": "Area = (sqrt(3)/4) * side^2. 16*sqrt(3) = (sqrt(3)/4) * a^2 => a^2 = 64 => a = 8.",
      "hash": "d874309a3eb2eeff",
      "translations": {
        "hi": {
          "question": "एक समबाहु त्रिभुज का क्षेत्रफल 16*sqrt(3) वर्ग सेमी है। इसकी भुजा ज्ञात कीजिए।",
          "options": {
            "A": "4 सेमी",
            "B": "8 सेमी",
            "C": "12 सेमी",
            "D": "16 सेमी"
          },
          "explanation": "क्षेत्रफल = (sqrt(3)/4) * भुजा^2. 16*sqrt(3) = (sqrt(3)/4) * a^2 => a^2 = 64 => a = 8."
        }
      }
    },
    {
      "id": "mock-test-session-i-03-010",
      "number": 10,
      "question": "The ratio of the ages of Father and Son is 7:2. After 10 years, the ratio will be 9:4. Find Father's current age.",
      "options": {
        "A": "30",
        "B": "35",
        "C": "40",
        "D": "45"
      },
      "answer": "B",
      "explanation": "(7x+10)/(2x+10) = 9/4 => 28x+40 = 18x+90 => 10x=50 => x=5. Father = 7*5 = 35.",
      "hash": "9a02a5a7546e5c69",
      "translations": {
        "hi": {
          "question": "पिता और पुत्र की आयु का अनुपात 7:2 है। 10 वर्ष बाद अनुपात 9:4 हो जाएगा। पिता की वर्तमान आयु ज्ञात कीजिए।",
          "options": {
            "A": "30",
            "B": "35",
            "C": "40",
            "D": "45"
          },
          "explanation": "(7x+10)/(2x+10) = 9/4 => 28x+40 = 18x+90 => 10x=50 => x=5. पिता = 7*5 = 35."
        }
      }
    },
    {
      "id": "mock-test-session-i-03-011",
      "number": 11,
      "question": "If 40% of (A + B) = 60% of (A - B), then (2A - 3B) / (A + B) is:",
      "options": {
        "A": "7/6",
        "B": "6/7",
        "C": "5/6",
        "D": "1/6"
      },
      "answer": "A",
      "explanation": "A = 5B. Substitute A=5B: (10B-3B)/(5B+B) = 7B/6B.",
      "hash": "0beec5d8b934c845",
      "translations": {
        "hi": {
          "question": "यदि (A + B) का 40% = (A - B) का 60% है, तो (2A - 3B) / (A + B) क्या है?",
          "options": {
            "A": "7/6",
            "B": "6/7",
            "C": "5/6",
            "D": "1/6"
          },
          "explanation": "2(A+B) = 3(A-B) => 2A+2B = 3A-3B => A = 5B. A=5B रखने पर: (10B-3B)/(5B+B) = 7/6."
        }
      }
    },
    {
      "id": "mock-test-session-i-03-012",
      "number": 12,
      "question": "A sum of money becomes 3 times in 20 years at simple interest. Find the rate of interest.",
      "options": {
        "A": "5%",
        "B": "10%",
        "C": "15%",
        "D": "20%"
      },
      "answer": "B",
      "explanation": "Interest = 3P - P = 2P. Rate = (2P * 100) / (P * 20) = 10%.",
      "hash": "92ad1a9327cdc7f7",
      "translations": {
        "hi": {
          "question": "कोई धनराशि साधारण ब्याज पर 20 वर्षों में 3 गुनी हो जाती है। ब्याज की दर ज्ञात कीजिए।",
          "options": {
            "A": "5%",
            "B": "10%",
            "C": "15%",
            "D": "20%"
          },
          "explanation": "ब्याज = 3P - P = 2P. दर = (2P * 100) / (P * 20) = 10%."
        }
      }
    },
    {
