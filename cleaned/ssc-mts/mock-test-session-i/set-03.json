    },
    {
      "id": "mock-test-session-i-03-014",
      "number": 14,
      "question": "A cistern is normally filled in 8 hours but takes 2 hours longer to fill because of a leak in its bottom. If the cistern is full, in how many hours will the leak empty it?",
      "options": {
        "A": "20 hours",
        "B": "30 hours",
        "C": "40 hours",
        "D": "50 hours"
      },
      "answer": "C",
      "explanation": "Filling rate = 1/8. With leak = 1/10. Leak rate = 1/8 - 1/10 = 2/80 = 1/40. So, 40 hours.",
      "hash": "d6a7bedd5b144627",
      "translations": {
        "hi": {
          "question": "एक हौज सामान्य रूप से 8 घंटे में भर जाता है लेकिन इसके तल में रिसाव के कारण भरने में 2 घंटे अधिक समय लगता है। यदि हौज भरा हुआ है, तो रिसाव इसे कितने घंटों में खाली कर देगा?",
          "options": {
            "A": "20 घंटे",
            "B": "30 घंटे",
            "C": "40 घंटे",
            "D": "50 घंटे"
          },
          "explanation": "भरने की दर = 1/8. रिसाव के साथ = 1/10. रिसाव की दर = 1/8 - 1/10 = 2/80 = 1/40. इसलिए, 40 घंटे।"
        }
      }
    },
    {
