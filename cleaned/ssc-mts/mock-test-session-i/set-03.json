    {
      "id": "mock-test-session-i-03-020",
      "number": 20,
      "question": "If a number is increased by 20% and then decreased by 10%, find the net percentage increase.",
      "options": {
        "A": "8%",
        "B": "10%",
        "C": "12%",
        "D": "15%"
      },
      "answer": "A",
      "explanation": "Net change = 20 - 10 - (20*10)/100 = 10 - 2 = 8%.",
      "hash": "048b6bcf69fc9212",
