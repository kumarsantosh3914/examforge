  "questions": [
    {
      "id": "mock-test-session-i-01-001",
      "number": 1,
      "question": "A person buys an article for 500 and sells it for 600. What is the profit percentage?",
      "options": {
        "A": "10%",
        "B": "20%",
        "C": "25%",
        "D": "15%"
      },
      "answer": "B",
      "explanation": "Profit = 600 - 500 = 100. Profit percentage = (100/500) * 100 = 20%.",
      "hash": "bde874715f699c76",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति एक वस्तु को 500 में खरीदता है और उसे 600 में बेच देता है। लाभ प्रतिशत क्या है?",
          "options": {
            "A": "10%",
            "B": "20%",
            "C": "25%",
            "D": "15%"
          },
          "explanation": "लाभ = 600 - 500 = 100. लाभ प्रतिशत = (100/500) * 100 = 20%."
        }
      }
    },
    {
      "id": "mock-test-session-i-01-002",
      "number": 2,
      "question": "If 15% of a number is 45, what is the number?",
      "options": {
        "A": "200",
        "B": "250",
        "C": "300",
        "D": "350"
      },
      "answer": "C",
      "explanation": "Let the number be x. 0.15x = 45, so x = 45 / 0.15 = 300.",
      "hash": "0a22058ae3d66374",
      "translations": {
        "hi": {
          "question": "यदि किसी संख्या का 15% 45 है, तो वह संख्या क्या है?",
          "options": {
            "A": "200",
            "B": "250",
            "C": "300",
            "D": "350"
          },
          "explanation": "मान लीजिए संख्या x है। 0.15x = 45, इसलिए x = 45 / 0.15 = 300."
        }
      }
    },
    {
      "id": "mock-test-session-i-01-003",
      "number": 3,
      "question": "The ratio of two numbers is 3:4. If their sum is 70, find the larger number.",
      "options": {
        "A": "30",
        "B": "40",
        "C": "50",
        "D": "60"
      },
      "answer": "B",
      "explanation": "Let numbers be 3x and 4x. 3x + 4x = 70 => 7x = 70 => x = 10. Larger number = 4x = 40.",
      "hash": "e2c5d8a5eefcfc53",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का अनुपात 3:4 है। यदि उनका योग 70 है, तो बड़ी संख्या ज्ञात कीजिए।",
          "options": {
            "A": "30",
            "B": "40",
            "C": "50",
            "D": "60"
          },
          "explanation": "मान लीजिए संख्याएं 3x और 4x हैं। 3x + 4x = 70 => 7x = 70 => x = 10. बड़ी संख्या = 4x = 40."
        }
      }
    },
    {
      "id": "mock-test-session-i-01-004",
      "number": 4,
      "question": "A can do a piece of work in 10 days and B can do it in 15 days. In how many days can they complete it together?",
      "options": {
        "A": "5 days",
        "B": "6 days",
        "C": "7 days",
        "D": "8 days"
      },
      "answer": "B",
      "explanation": "Combined rate = 1/10 + 1/15 = 5/30 = 1/6. So, 6 days.",
      "hash": "82c57b17cf3ce1d0",
      "translations": {
        "hi": {
          "question": "A किसी कार्य को 10 दिनों में कर सकता है और B उसे 15 दिनों में कर सकता है। वे दोनों मिलकर उसे कितने दिनों में पूरा कर सकते हैं?",
          "options": {
            "A": "5 दिन",
            "B": "6 दिन",
            "C": "7 दिन",
            "D": "8 दिन"
          },
          "explanation": "संयुक्त दर = 1/10 + 1/15 = 5/30 = 1/6. इसलिए, 6 दिन।"
        }
      }
    },
    {
      "id": "mock-test-session-i-01-005",
      "number": 5,
      "question": "Find the average of first five prime numbers.",
      "options": {
        "A": "5.2",
        "B": "5.4",
        "C": "5.6",
        "D": "5.8"
      },
      "answer": "C",
      "explanation": "First five prime numbers are 2, 3, 5, 7, 11. Average = (2+3+5+7+11)/5 = 28/5 = 5.6.",
      "hash": "3ad72f6866e4e13f",
      "translations": {
        "hi": {
          "question": "प्रथम पांच अभाज्य संख्याओं का औसत ज्ञात कीजिए।",
          "options": {
            "A": "5.2",
            "B": "5.4",
            "C": "5.6",
            "D": "5.8"
          },
          "explanation": "प्रथम पांच अभाज्य संख्याएं 2, 3, 5, 7, 11 हैं। औसत = (2+3+5+7+11)/5 = 28/5 = 5.6."
        }
      }
    },
    {
      "id": "mock-test-session-i-01-006",
      "number": 6,
      "question": "The length and breadth of a rectangle are 12 cm and 8 cm. Find its area.",
      "options": {
        "A": "80 sq cm",
        "B": "96 sq cm",
        "C": "100 sq cm",
        "D": "120 sq cm"
      },
      "answer": "B",
      "explanation": "Area = length * breadth = 12 * 8 = 96 sq cm.",
      "hash": "f939e7f3f49419b7",
      "translations": {
        "hi": {
          "question": "एक आयत की लंबाई और चौड़ाई 12 सेमी और 8 सेमी है। इसका क्षेत्रफल ज्ञात कीजिए।",
          "options": {
            "A": "80 वर्ग सेमी",
            "B": "96 वर्ग सेमी",
            "C": "100 वर्ग सेमी",
            "D": "120 वर्ग सेमी"
          },
          "explanation": "क्षेत्रफल = लंबाई * चौड़ाई = 12 * 8 = 96 वर्ग सेमी।"
        }
      }
    },
    {
      "id": "mock-test-session-i-01-007",
      "number": 7,
      "question": "A train 150m long is running at a speed of 54 km/h. How much time will it take to cross a pole?",
      "options": {
        "A": "10 seconds",
        "B": "12 seconds",
        "C": "15 seconds",
        "D": "20 seconds"
      },
      "answer": "A",
      "explanation": "Speed in m/s = 54 * 5/18 = 15 m/s. Time = Distance/Speed = 150/15 = 10 seconds.",
      "hash": "c15171c6ac1ed4d3",
      "translations": {
        "hi": {
          "question": "150 मीटर लंबी एक ट्रेन 54 किमी/घंटा की गति से चल रही है। एक खंभे को पार करने में इसे कितना समय लगेगा?",
          "options": {
            "A": "10 सेकंड",
            "B": "12 सेकंड",
            "C": "15 सेकंड",
            "D": "20 सेकंड"
          },
          "explanation": "मीटर/सेकंड में गति = 54 * 5/18 = 15 मीटर/सेकंड। समय = दूरी/गति = 150/15 = 10 सेकंड।"
        }
      }
    },
    {
      "id": "mock-test-session-i-01-008",
      "number": 8,
      "question": "Find the simple interest on 2000 at 5% per annum for 3 years.",
      "options": {
        "A": "200",
        "B": "300",
        "C": "400",
        "D": "500"
      },
      "answer": "B",
      "explanation": "SI = (P*R*T)/100 = (2000*5*3)/100 = 300.",
      "hash": "5b69a7ee5a8f905d",
      "translations": {
        "hi": {
          "question": "2000 पर 5% वार्षिक दर से 3 वर्ष का साधारण ब्याज ज्ञात कीजिए।",
          "options": {
            "A": "200",
            "B": "300",
            "C": "400",
            "D": "500"
          },
          "explanation": "साधारण ब्याज = (P*R*T)/100 = (2000*5*3)/100 = 300."
        }
      }
    },
    {
      "id": "mock-test-session-i-01-009",
      "number": 9,
      "question": "If the side of a square is doubled, its area becomes how many times?",
      "options": {
        "A": "2 times",
        "B": "3 times",
        "C": "4 times",
        "D": "8 times"
      },
      "answer": "C",
      "explanation": "Area = side^2. If side is 2s, Area = (2s)^2 = 4s^2.",
      "hash": "404fc21934908f5a",
      "translations": {
        "hi": {
          "question": "यदि किसी वर्ग की भुजा दोगुनी कर दी जाए, तो उसका क्षेत्रफल कितने गुना हो जाता है?",
          "options": {
            "A": "2 गुना",
            "B": "3 गुना",
            "C": "4 गुना",
            "D": "8 गुना"
          },
          "explanation": "क्षेत्रफल = भुजा^2। यदि भुजा 2s है, तो क्षेत्रफल = (2s)^2 = 4s^2."
        }
      }
    },
    {
      "id": "mock-test-session-i-01-010",
      "number": 10,
      "question": "What is the HCF of 12, 18 and 24?",
      "options": {
        "A": "4",
        "B": "6",
        "C": "8",
        "D": "12"
      },
      "answer": "B",
      "explanation": "12 = 2*2*3, 18 = 2*3*3, 24 = 2*2*2*3. Common factors are 2 and 3. HCF = 2*3 = 6.",
      "hash": "62789139a14983b1",
      "translations": {
        "hi": {
          "question": "12, 18 और 24 का महत्तम समापवर्तक (HCF) क्या है?",
          "options": {
            "A": "4",
            "B": "6",
            "C": "8",
            "D": "12"
          },
          "explanation": "12 = 2*2*3, 18 = 2*3*3, 24 = 2*2*2*3. सामान्य गुणनखंड 2 और 3 हैं। HCF = 2*3 = 6."
        }
      }
    },
