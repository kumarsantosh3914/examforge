    {
      "id": "mock-test-session-i-01-014",
      "number": 14,
      "question": "If the diameter of a circle is 14 cm, find its circumference. (Use pi = 22/7)",
      "options": {
        "A": "22 cm",
        "B": "44 cm",
        "C": "66 cm",
        "D": "88 cm"
      },
      "answer": "B",
      "explanation": "Circumference = pi * diameter = (22/7) * 14 = 44 cm.",
      "hash": "e0cce89ba79df3fc",
      "translations": {
        "hi": {
          "question": "यदि एक वृत्त का व्यास 14 सेमी है, तो उसकी परिधि ज्ञात कीजिए। (pi = 22/7 का प्रयोग करें)",
          "options": {
            "A": "22 सेमी",
            "B": "44 सेमी",
            "C": "66 सेमी",
            "D": "88 सेमी"
          },
          "explanation": "परिधि = pi * व्यास = (22/7) * 14 = 44 सेमी।"
        }
      }
    },
    {
      "id": "mock-test-session-i-01-015",
      "number": 15,
      "question": "The average weight of 5 students is 40 kg. If a student of 50 kg leaves, what is the new average?",
      "options": {
        "A": "35 kg",
        "B": "37.5 kg",
        "C": "38 kg",
        "D": "39 kg"
      },
      "answer": "B",
      "explanation": "Total weight = 5 * 40 = 200. New total = 200 - 50 = 150. New average = 150 / 4 = 37.5.",
      "hash": "7b047c1cb77e3cee",
      "translations": {
        "hi": {
          "question": "5 छात्रों का औसत वजन 40 किग्रा है। यदि 50 किग्रा का एक छात्र चला जाता है, तो नया औसत क्या है?",
          "options": {
            "A": "35 किग्रा",
            "B": "37.5 किग्रा",
            "C": "38 किग्रा",
            "D": "39 किग्रा"
          },
          "explanation": "कुल वजन = 5 * 40 = 200. नया कुल वजन = 200 - 50 = 150. नया औसत = 150 / 4 = 37.5."
        }
      }
    },
