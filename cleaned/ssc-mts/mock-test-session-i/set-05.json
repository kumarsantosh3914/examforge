    {
      "id": "mock-test-session-i-05-025",
      "number": 25,
      "question": "A person walks 4 km North, then turns right and walks 3 km. How far is he from the starting point?",
      "options": {
        "A": "5 km",
        "B": "7 km",
        "C": "1 km",
        "D": "10 km"
      },
      "answer": "A",
      "explanation": "Use Pythagoras theorem: sqrt(4^2 + 3^2) = sqrt(16 + 9) = 5 km.",
      "hash": "886bf694f9c60dde",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति उत्तर की ओर 4 किमी चलता है, फिर दाएं मुड़ता है और 3 किमी चलता है। वह शुरुआती बिंदु से कितनी दूर है?",
          "options": {
            "A": "5 किमी",
            "B": "7 किमी",
            "C": "1 किमी",
            "D": "10 किमी"
          },
          "explanation": "पाइथागोरस प्रमेय का प्रयोग करें: sqrt(4^2 + 3^2) = sqrt(16 + 9) = 5 किमी।"
        }
      }
    },
