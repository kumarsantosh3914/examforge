  "questions": [
    {
      "id": "mock-test-session-i-05-001",
      "number": 1,
      "question": "A sum of money triples itself in 10 years at simple interest. What is the rate of interest per annum?",
      "options": {
        "A": "10%",
        "B": "20%",
        "C": "25%",
        "D": "30%"
      },
      "answer": "B",
      "explanation": "Triple means Interest = 2P. R = (2P * 100) / (P * 10) = 20%.",
      "hash": "036a012ba7d256bb",
      "translations": {
        "hi": {
          "question": "कोई धनराशि साधारण ब्याज पर 10 वर्षों में स्वयं की तीन गुनी हो जाती है। वार्षिक ब्याज दर क्या है?",
          "options": {
            "A": "10%",
            "B": "20%",
            "C": "25%",
            "D": "30%"
          },
          "explanation": "तीन गुना का अर्थ है ब्याज = 2P। दर = (2P * 100) / (P * 10) = 20%."
        }
      }
    },
    {
      "id": "mock-test-session-i-05-002",
      "number": 2,
      "question": "If the cost price of 15 articles is equal to the selling price of 12 articles, find the profit percentage.",
      "options": {
        "A": "20%",
        "B": "25%",
        "C": "30%",
        "D": "15%"
      },
      "answer": "B",
      "explanation": "Profit % = [(15-12)/12] * 100 = (3/12) * 100 = 25%.",
      "hash": "907fd9c583676fcd",
      "translations": {
        "hi": {
          "question": "यदि 15 वस्तुओं का क्रय मूल्य 12 वस्तुओं के विक्रय मूल्य के बराबर है, तो लाभ प्रतिशत ज्ञात कीजिए।",
          "options": {
            "A": "20%",
            "B": "25%",
            "C": "30%",
            "D": "15%"
          },
          "explanation": "लाभ % = [(15-12)/12] * 100 = (3/12) * 100 = 25%."
        }
      }
    },
    {
      "id": "mock-test-session-i-05-003",
      "number": 3,
      "question": "Find the value of 25% of 120 + 30% of 200.",
      "options": {
        "A": "80",
        "B": "90",
        "C": "100",
        "D": "110"
      },
      "answer": "B",
      "explanation": "(0.25 * 120) + (0.30 * 200) = 30 + 60 = 90.",
      "hash": "57419fc995e5b5a1",
      "translations": {
        "hi": {
          "question": "120 के 25% + 200 के 30% का मान ज्ञात कीजिए।",
          "options": {
            "A": "80",
            "B": "90",
            "C": "100",
            "D": "110"
          },
          "explanation": "(0.25 * 120) + (0.30 * 200) = 30 + 60 = 90."
        }
      }
    },
    {
      "id": "mock-test-session-i-05-004",
      "number": 4,
      "question": "A can do a piece of work in 20 days and B can do it in 30 days. In how many days can they complete it together?",
      "options": {
        "A": "10 days",
        "B": "12 days",
        "C": "15 days",
        "D": "18 days"
      },
      "answer": "B",
      "explanation": "Combined work = (20 * 30) / (20 + 30) = 600 / 50 = 12 days.",
      "hash": "195e9304663d02d6",
      "translations": {
        "hi": {
          "question": "A किसी कार्य को 20 दिनों में और B उसे 30 दिनों में कर सकता है। वे दोनों मिलकर उसे कितने दिनों में पूरा कर सकते हैं?",
          "options": {
            "A": "10 दिन",
            "B": "12 दिन",
            "C": "15 दिन",
            "D": "18 दिन"
          },
          "explanation": "संयुक्त कार्य = (20 * 30) / (20 + 30) = 600 / 50 = 12 दिन।"
        }
      }
    },
    {
      "id": "mock-test-session-i-05-005",
      "number": 5,
      "question": "A train 300 m long is running at a speed of 90 km/h. How much time will it take to cross a pole?",
      "options": {
        "A": "10 seconds",
        "B": "12 seconds",
        "C": "15 seconds",
        "D": "20 seconds"
      },
      "answer": "B",
      "explanation": "Speed = 90 * 5/18 = 25 m/s. Time = 300 / 25 = 12 seconds.",
      "hash": "bde6ca2368a2946e",
      "translations": {
        "hi": {
          "question": "300 मीटर लंबी एक ट्रेन 90 किमी/घंटा की गति से चल रही है। एक खंभे को पार करने में इसे कितना समय लगेगा?",
          "options": {
            "A": "10 सेकंड",
            "B": "12 सेकंड",
            "C": "15 सेकंड",
            "D": "20 सेकंड"
          },
          "explanation": "गति = 90 * 5/18 = 25 मीटर/सेकंड। समय = 300 / 25 = 12 सेकंड।"
        }
      }
    },
    {
      "id": "mock-test-session-i-05-006",
      "number": 6,
      "question": "Find the volume of a sphere with radius 3 cm. (Use pi = 22/7 approx)",
      "options": {
        "A": "113.14 cubic cm",
        "B": "150.25 cubic cm",
        "C": "100.50 cubic cm",
        "D": "120.40 cubic cm"
      },
      "answer": "A",
      "explanation": "Volume = (4/3) * pi * r^3 = (4/3) * (22/7) * 27 = 113.14 approx.",
      "hash": "f8827558295b609b",
      "translations": {
        "hi": {
          "question": "3 सेमी त्रिज्या वाले एक गोले का आयतन ज्ञात कीजिए। (pi = 22/7 का प्रयोग करें)",
          "options": {
            "A": "113.14 घन सेमी",
            "B": "150.25 घन सेमी",
            "C": "100.50 घन सेमी",
            "D": "120.40 घन सेमी"
          },
          "explanation": "आयतन = (4/3) * pi * r^3 = (4/3) * (22/7) * 27 = 113.14 लगभग।"
        }
      }
    },
    {
      "id": "mock-test-session-i-05-007",
      "number": 7,
      "question": "Three numbers are in the ratio 2:3:4. If their sum is 180, find the largest number.",
      "options": {
        "A": "40",
        "B": "60",
        "C": "80",
        "D": "100"
      },
      "answer": "C",
      "explanation": "2x + 3x + 4x = 180 => 9x = 180 => x = 20. Largest = 4x = 80.",
      "hash": "1dbfd3c2ef158ec5",
      "translations": {
        "hi": {
          "question": "तीन संख्याएँ 2:3:4 के अनुपात में हैं। यदि उनका योग 180 है, तो सबसे बड़ी संख्या ज्ञात कीजिए।",
          "options": {
            "A": "40",
            "B": "60",
            "C": "80",
            "D": "100"
          },
          "explanation": "2x + 3x + 4x = 180 => 9x = 180 => x = 20. सबसे बड़ी संख्या = 4x = 80."
        }
      }
    },
    {
      "id": "mock-test-session-i-05-008",
      "number": 8,
      "question": "The average of 10 numbers is 50. If a new number 105 is added, what is the new average?",
      "options": {
        "A": "55",
        "B": "60",
        "C": "52.5",
        "D": "65"
      },
      "answer": "A",
      "explanation": "Total sum = 10 * 50 = 500. New sum = 500 + 105 = 605. New average = 605 / 11 = 55.",
      "hash": "e236c33802d1c09b",
      "translations": {
        "hi": {
          "question": "10 संख्याओं का औसत 50 है। यदि एक नई संख्या 105 जोड़ी जाती है, तो नया औसत क्या है?",
          "options": {
            "A": "55",
            "B": "60",
            "C": "52.5",
            "D": "65"
          },
          "explanation": "कुल योग = 10 * 50 = 500. नया योग = 500 + 105 = 605. नया औसत = 605 / 11 = 55."
        }
      }
    },
    {
      "id": "mock-test-session-i-05-009",
      "number": 9,
      "question": "Find the difference between CI and SI on 2000 for 2 years at 5% per annum.",
      "options": {
        "A": "5",
        "B": "10",
        "C": "15",
        "D": "20"
      },
      "answer": "A",
      "explanation": "Difference = P(r/100)^2 = 2000(5/100)^2 = 2000 * 0.0025 = 5.",
      "hash": "495095b821a2b32c",
      "translations": {
        "hi": {
          "question": "2000 पर 2 वर्ष के लिए 5% वार्षिक दर से चक्रवृद्धि ब्याज (CI) और साधारण ब्याज (SI) के बीच का अंतर ज्ञात कीजिए।",
          "options": {
            "A": "5",
            "B": "10",
            "C": "15",
            "D": "20"
          },
          "explanation": "अंतर = P(r/100)^2 = 2000(5/100)^2 = 2000 * 0.0025 = 5."
        }
      }
    },
