    {
      "id": "mock-test-session-i-07-001",
      "number": 1,
      "question": "The LCM of two numbers is 120 and their HCF is 10. If one of the numbers is 30, what is the other number?",
      "options": {
        "A": "40",
        "B": "50",
        "C": "60",
        "D": "70"
      },
      "answer": "A",
      "explanation": "LCM * HCF = Product of two numbers. 120 * 10 = 30 * x => 1200 = 30x => x = 40.",
      "hash": "0f06f2f074ac3cd1",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का LCM 120 है और उनका HCF 10 है। यदि उनमें से एक संख्या 30 है, तो दूसरी संख्या क्या है?",
          "options": {
            "A": "40",
            "B": "50",
            "C": "60",
            "D": "70"
          },
          "explanation": "LCM * HCF = दो संख्याओं का गुणनफल। 120 * 10 = 30 * x => 1200 = 30x => x = 40."
        }
      }
    },
    {
      "id": "mock-test-session-i-07-002",
      "number": 2,
      "question": "If the area of a circle is 154 sq cm, find its circumference. (Use pi = 22/7)",
      "options": {
        "A": "22 cm",
        "B": "44 cm",
        "C": "66 cm",
        "D": "88 cm"
      },
      "answer": "B",
      "explanation": "Area = pi * r^2 = 154 => r^2 = 49 => r = 7. Circumference = 2 * pi * r = 2 * 22/7 * 7 = 44.",
      "hash": "4dbea618b780ac06",
      "translations": {
        "hi": {
          "question": "यदि एक वृत्त का क्षेत्रफल 154 वर्ग सेमी है, तो उसकी परिधि ज्ञात कीजिए। (pi = 22/7 का प्रयोग करें)",
          "options": {
            "A": "22 सेमी",
            "B": "44 सेमी",
            "C": "66 सेमी",
            "D": "88 सेमी"
          },
          "explanation": "क्षेत्रफल = pi * r^2 = 154 => r^2 = 49 => r = 7. परिधि = 2 * pi * r = 2 * 22/7 * 7 = 44."
        }
      }
    },
    {
      "id": "mock-test-session-i-07-003",
      "number": 3,
      "question": "A shopkeeper allows a 20% discount on the marked price of 1500 and still makes a 20% profit. Find the cost price.",
      "options": {
        "A": "1000",
        "B": "1200",
        "C": "800",
        "D": "900"
      },
      "answer": "A",
      "explanation": "SP = 1500 * 0.8 = 1200. Profit = 20%, so CP = 1200 / 1.2 = 1000.",
      "hash": "851d5999c5bde2b3",
      "translations": {
        "hi": {
          "question": "एक दुकानदार 1500 के अंकित मूल्य पर 20% की छूट देता है और फिर भी 20% का लाभ कमाता है। क्रय मूल्य ज्ञात कीजिए।",
          "options": {
            "A": "1000",
            "B": "1200",
            "C": "800",
            "D": "900"
          },
          "explanation": "SP = 1500 * 0.8 = 1200. लाभ = 20%, इसलिए CP = 1200 / 1.2 = 1000."
        }
      }
    },
    {
      "id": "mock-test-session-i-07-004",
      "number": 4,
      "question": "The average of 5 results is 46 and that of the first 4 is 45. Find the fifth result.",
      "options": {
        "A": "48",
        "B": "50",
        "C": "52",
        "D": "60"
      },
      "answer": "B",
      "explanation": "Total of 5 = 5 * 46 = 230. Total of 4 = 4 * 45 = 180. Fifth result = 230 - 180 = 50.",
      "hash": "a7309c2aa5ff1560",
      "translations": {
        "hi": {
          "question": "5 परिणामों का औसत 46 है और पहले 4 का औसत 45 है। पांचवां परिणाम ज्ञात कीजिए।",
          "options": {
            "A": "48",
            "B": "50",
            "C": "52",
            "D": "60"
          },
          "explanation": "5 का कुल योग = 5 * 46 = 230. 4 का कुल योग = 4 * 45 = 180. पांचवां परिणाम = 230 - 180 = 50."
        }
      }
    },
    {
      "id": "mock-test-session-i-07-005",
      "number": 5,
      "question": "The ratio of the length and breadth of a rectangle is 3 : 2. If its area is 150 sq cm, find its perimeter.",
      "options": {
        "A": "30 cm",
        "B": "40 cm",
        "C": "50 cm",
        "D": "60 cm"
      },
      "answer": "C",
      "explanation": "3x * 2x = 150 => 6x^2 = 150 => x^2 = 25 => x = 5. L=15, B=10. Perimeter = 2(15+10) = 50.",
      "hash": "10a6e99e032213af",
      "translations": {
        "hi": {
          "question": "एक आयत की लंबाई और चौड़ाई का अनुपात 3 : 2 है। यदि इसका क्षेत्रफल 150 वर्ग सेमी है, तो इसका परिमाप ज्ञात कीजिए।",
          "options": {
            "A": "30 सेमी",
            "B": "40 सेमी",
            "C": "50 सेमी",
            "D": "60 सेमी"
          },
          "explanation": "3x * 2x = 150 => 6x^2 = 150 => x^2 = 25 => x = 5. L=15, B=10. परिमाप = 2(15+10) = 50."
        }
      }
    },
    {
      "id": "mock-test-session-i-07-006",
      "number": 6,
      "question": "If x : y = 5 : 2, find the value of (8x + 9y) : (8x + 2y).",
      "options": {
        "A": "22:29",
        "B": "26:61",
        "C": "29:22",
        "D": "61:26"
      },
      "answer": "C",
      "explanation": "Substitute x=5, y=2: (40+18) : (40+4) = 58 : 44 = 29 : 22.",
      "hash": "f3d5b9e8be7f8c68",
      "translations": {
        "hi": {
          "question": "यदि x : y = 5 : 2 है, तो (8x + 9y) : (8x + 2y) का मान ज्ञात कीजिए।",
          "options": {
            "A": "22:29",
            "B": "26:61",
            "C": "29:22",
            "D": "61:26"
          },
          "explanation": "x=5, y=2 रखने पर: (40+18) : (40+4) = 58 : 44 = 29 : 22."
        }
      }
    },
    {
      "id": "mock-test-session-i-07-007",
      "number": 7,
      "question": "A sum of 4000 amounts to 5000 in 5 years at simple interest. Find the rate of interest per annum.",
      "options": {
        "A": "4%",
        "B": "5%",
        "C": "6%",
        "D": "8%"
      },
      "answer": "B",
      "explanation": "Interest = 1000. R = (1000 * 100) / (4000 * 5) = 5%.",
      "hash": "d6b4ebad2102ed7a",
      "translations": {
        "hi": {
          "question": "4000 की राशि साधारण ब्याज पर 5 वर्षों में 5000 हो जाती है। वार्षिक ब्याज दर ज्ञात कीजिए।",
          "options": {
            "A": "4%",
            "B": "5%",
            "C": "6%",
            "D": "8%"
          },
          "explanation": "ब्याज = 1000. दर = (1000 * 100) / (4000 * 5) = 5%."
        }
      }
    },
    {
      "id": "mock-test-session-i-07-008",
      "number": 8,
      "question": "A car travels 90 km in 1.5 hours. What is its speed in m/s?",
      "options": {
        "A": "15.66",
        "B": "16.66",
        "C": "17.66",
        "D": "18.66"
      },
      "answer": "B",
      "explanation": "Speed = 90 / 1.5 = 60 km/h. 60 * 5/18 = 16.66 m/s.",
      "hash": "4664f4132b822230",
      "translations": {
        "hi": {
          "question": "एक कार 1.5 घंटे में 90 किमी की यात्रा करती है। इसकी गति मीटर/सेकंड में क्या है?",
          "options": {
            "A": "15.66",
            "B": "16.66",
            "C": "17.66",
            "D": "18.66"
          },
          "explanation": "गति = 90 / 1.5 = 60 किमी/घंटा। 60 * 5/18 = 16.66 मीटर/सेकंड।"
        }
      }
    },
    {
      "id": "mock-test-session-i-07-009",
      "number": 9,
      "question": "A can complete a work in 10 days and B can do it in 12 days. In how many days can they complete it together?",
      "options": {
        "A": "5(5/11) days",
        "B": "6(5/11) days",
        "C": "4(5/11) days",
        "D": "7(5/11) days"
      },
      "answer": "A",
      "explanation": "Together = (10 * 12) / (10 + 12) = 120 / 22 = 60 / 11 = 5(5/11) days.",
      "hash": "f2a3e92b676208ee",
      "translations": {
        "hi": {
          "question": "A एक कार्य को 10 दिनों में पूरा कर सकता है और B उसे 12 दिनों में कर सकता है। वे दोनों मिलकर उसे कितने दिनों में पूरा कर सकते हैं?",
          "options": {
            "A": "5(5/11) दिन",
            "B": "6(5/11) दिन",
            "C": "4(5/11) दिन",
            "D": "7(5/11) दिन"
          },
          "explanation": "एक साथ = (10 * 12) / (10 + 12) = 120 / 22 = 60 / 11 = 5(5/11) दिन।"
        }
      }
    },
