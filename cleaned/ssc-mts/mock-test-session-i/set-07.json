      "hash": "bfc91146d44a0f8d",
      "translations": {
        "hi": {
          "question": "150 मीटर लंबी एक ट्रेन 54 किमी/घंटा की गति से चल रही है। 250 मीटर लंबे प्लेटफॉर्म को पार करने में इसे कितना समय लगेगा?",
          "options": {
            "A": "20.66 सेकंड",
            "B": "26.66 सेकंड",
            "C": "30 सेकंड",
            "D": "40 सेकंड"
          },
          "explanation": "गति = 15 मीटर/सेकंड। दूरी = 150 + 250 = 400. समय = 400 / 15 = 26.66."
        }
