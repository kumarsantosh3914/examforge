    {
      "id": "mock-test-session-i-06-001",
      "number": 1,
      "question": "A shopkeeper sells an item for 960 at a gain of 20%. Find the cost price.",
      "options": {
        "A": "700",
        "B": "800",
        "C": "850",
        "D": "900"
      },
      "answer": "B",
      "explanation": "120% = 960. 100% = (960/120) * 100 = 800.",
      "hash": "44f71908ea0585ea",
      "translations": {
        "hi": {
          "question": "एक दुकानदार एक वस्तु को 20% के लाभ पर 960 में बेचता है। क्रय मूल्य ज्ञात कीजिए।",
          "options": {
            "A": "700",
            "B": "800",
            "C": "850",
            "D": "900"
          },
          "explanation": "120% = 960. 100% = (960/120) * 100 = 800."
        }
      }
    },
    {
      "id": "mock-test-session-i-06-002",
      "number": 2,
      "question": "The sum of two numbers is 25 and their difference is 13. Find the product of the numbers.",
      "options": {
        "A": "114",
        "B": "104",
        "C": "124",
        "D": "134"
      },
      "answer": "A",
      "explanation": "x+y=25, x-y=13. Adding gives 2x=38, x=19. Then y=6. Product = 19*6 = 114.",
      "hash": "5e0d2113748c488e",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का योग 25 है और उनका अंतर 13 है। संख्याओं का गुणनफल ज्ञात कीजिए।",
          "options": {
            "A": "114",
            "B": "104",
            "C": "124",
            "D": "134"
          },
          "explanation": "x+y=25, x-y=13. जोड़ने पर 2x=38, x=19. फिर y=6. गुणनफल = 19*6 = 114."
        }
      }
    },
    {
