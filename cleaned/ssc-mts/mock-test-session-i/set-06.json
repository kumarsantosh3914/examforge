      "translations": {
        "hi": {
          "question": "2/3, 4/5 और 6/7 का महत्तम समापवर्तक (HCF) ज्ञात कीजिए।",
          "options": {
            "A": "2/105",
            "B": "12/105",
            "C": "2/15",
            "D": "1/105"
          },
          "explanation": "भिन्नों का HCF = HCF(अंश) / LCM(हर) = HCF(2,4,6) / LCM(3,5,7) = 2 / 105."
        }
      }
    },
