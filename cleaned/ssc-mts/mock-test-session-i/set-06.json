    {
      "id": "mock-test-session-i-06-005",
      "number": 5,
      "question": "A train 120 m long passes a pole in 6 seconds. What is its speed in km/h?",
      "options": {
        "A": "60",
        "B": "72",
        "C": "80",
        "D": "90"
      },
      "answer": "B",
      "explanation": "Speed = 120/6 = 20 m/s. In km/h = 20 * 18/5 = 72 km/h.",
      "hash": "5d990e58ab4f87fd",
      "translations": {
        "hi": {
          "question": "120 मीटर लंबी एक ट्रेन एक खंभे को 6 सेकंड में पार करती है। इसकी गति किमी/घंटा में क्या है?",
          "options": {
            "A": "60",
            "B": "72",
            "C": "80",
            "D": "90"
          },
          "explanation": "गति = 120/6 = 20 मीटर/सेकंड। किमी/घंटा में = 20 * 18/5 = 72 किमी/घंटा।"
        }
      }
    },
    {
      "id": "mock-test-session-i-06-006",
      "number": 6,
      "question": "A can complete a work in 10 days and B in 15 days. They worked together for 2 days and then A left. In how many days will B finish the remaining work?",
      "options": {
        "A": "8 days",
        "B": "10 days",
        "C": "12 days",
        "D": "15 days"
      },
      "answer": "B",
      "explanation": "1 day work together = 1/10+1/15 = 1/6. 2 days = 1/3. Remaining = 2/3. B takes (2/3)/(1/15) = 10 days.",
      "hash": "ce1865e933847b5a",
      "translations": {
        "hi": {
          "question": "A एक कार्य को 10 दिनों में और B 15 दिनों में पूरा कर सकता है। उन्होंने 2 दिनों तक साथ काम किया और फिर A चला गया। B शेष कार्य को कितने दिनों में पूरा करेगा?",
          "options": {
            "A": "8 दिन",
            "B": "10 दिन",
            "C": "12 दिन",
            "D": "15 दिन"
          },
          "explanation": "1 दिन का साथ कार्य = 1/10+1/15 = 1/6. 2 दिन = 1/3. शेष = 2/3. B को (2/3)/(1/15) = 10 दिन लगेंगे।"
        }
      }
    },
    {
      "id": "mock-test-session-i-06-007",
      "number": 7,
      "question": "The radius of a cylinder is 3.5 cm and its height is 10 cm. Find its volume.",
      "options": {
        "A": "385 cubic cm",
        "B": "770 cubic cm",
        "C": "154 cubic cm",
        "D": "110 cubic cm"
      },
      "answer": "A",
      "explanation": "Volume = pi * r^2 * h = (22/7) * 3.5 * 3.5 * 10 = 385.",
      "hash": "9cf8397cb686450a",
      "translations": {
        "hi": {
          "question": "एक बेलन की त्रिज्या 3.5 सेमी और ऊंचाई 10 सेमी है। इसका आयतन ज्ञात कीजिए।",
          "options": {
            "A": "385 घन सेमी",
            "B": "770 घन सेमी",
            "C": "154 घन सेमी",
            "D": "110 घन सेमी"
          },
          "explanation": "आयतन = pi * r^2 * h = (22/7) * 3.5 * 3.5 * 10 = 385."
        }
      }
    },
    {
