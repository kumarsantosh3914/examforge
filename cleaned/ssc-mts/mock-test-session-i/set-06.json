    {
      "id": "mock-test-session-i-06-032",
      "number": 32,
      "question": "A cube is cut into 64 small cubes. How many small cubes have two faces painted if original cube was painted on all sides?",
      "options": {
        "A": "12",
        "B": "24",
        "C": "32",
        "D": "48"
      },
      "answer": "B",
      "explanation": "n^3=64 => n=4. 2-face painted = 12(n-2) = 12(2) = 24.",
      "hash": "295368bbc3ae0a53",
      "translations": {
        "hi": {
          "question": "एक घन को 64 छोटे घनों में काटा जाता है। यदि मूल घन को सभी तरफ से रंगा गया था, तो कितने छोटे घनों के दो फलक रंगे हुए होंगे?",
          "options": {
            "A": "12",
            "B": "24",
            "C": "32",
            "D": "48"
          },
          "explanation": "n^3=64 => n=4. 2-फलक रंगे = 12(n-2) = 12(2) = 24."
        }
      }
    },
