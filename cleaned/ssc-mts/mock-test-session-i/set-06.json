    {
      "id": "mock-test-session-i-06-017",
      "number": 17,
      "question": "The average of 10 results is 15. If the average of first 5 is 12 and the average of last 4 is 16, find the 6th result.",
      "options": {
        "A": "20",
        "B": "25",
        "C": "26",
        "D": "30"
      },
      "answer": "C",
      "explanation": "Total = 150. Sum of 5 = 60. Sum of 4 = 64. 6th result = 150 - (60+64) = 26.",
      "hash": "93c48457c93bc5f2",
      "translations": {
        "hi": {
          "question": "10 परिणामों का औसत 15 है। यदि पहले 5 का औसत 12 है और अंतिम 4 का औसत 16 है, तो छठा परिणाम ज्ञात कीजिए।",
          "options": {
            "A": "20",
            "B": "25",
            "C": "26",
            "D": "30"
          },
          "explanation": "कुल = 150. 5 का योग = 60. 4 का योग = 64. छठा परिणाम = 150 - (60+64) = 26."
        }
      }
    },
    {
      "id": "mock-test-session-i-06-018",
      "number": 18,
      "question": "If 4 men or 6 women can do a work in 12 days, how many days will 2 men and 9 women take?",
      "options": {
        "A": "4 days",
        "B": "6 days",
        "C": "8 days",
        "D": "10 days"
      },
      "answer": "B",
      "explanation": "4M = 6W => 2M = 3W. Total efficiency needed = 3W + 9W = 12W. 6W take 12 days, so 12W take 6 days.",
      "hash": "403356507f2da9c4",
      "translations": {
        "hi": {
          "question": "यदि 4 पुरुष या 6 महिलाएं एक कार्य को 12 दिनों में कर सकते हैं, तो 2 पुरुष और 9 महिलाएं कितने दिन लेंगे?",
          "options": {
            "A": "4 दिन",
            "B": "6 दिन",
            "C": "8 दिन",
            "D": "10 दिन"
          },
          "explanation": "4M = 6W => 2M = 3W. आवश्यक कुल दक्षता = 3W + 9W = 12W. 6W 12 दिन लेते हैं, तो 12W 6 दिन लेंगे।"
        }
      }
    },
