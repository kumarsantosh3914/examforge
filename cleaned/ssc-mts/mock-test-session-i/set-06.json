    {
      "id": "mock-test-session-i-06-009",
      "number": 9,
      "question": "A sum of 5000 amounts to 6000 in 2 years at simple interest. Find the rate of interest per annum.",
      "options": {
        "A": "5%",
        "B": "10%",
        "C": "12%",
        "D": "15%"
      },
      "answer": "B",
      "explanation": "Interest = 1000. Rate = (1000 * 100) / (5000 * 2) = 10%.",
      "hash": "7eba2402ba710609",
      "translations": {
        "hi": {
          "question": "5000 की राशि साधारण ब्याज पर 2 वर्षों में 6000 हो जाती है। वार्षिक ब्याज दर ज्ञात कीजिए।",
          "options": {
            "A": "5%",
            "B": "10%",
            "C": "12%",
            "D": "15%"
          },
          "explanation": "ब्याज = 1000. दर = (1000 * 100) / (5000 * 2) = 10%."
        }
      }
    },
    {
