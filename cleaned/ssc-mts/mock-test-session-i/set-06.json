        "hi": {
          "question": "एक व्यक्ति P से Q तक 20 किमी/घंटा की गति से जाता है और 30 किमी/घंटा की गति से वापस आता है। औसत गति ज्ञात कीजिए।",
          "options": {
            "A": "24 किमी/घंटा",
            "B": "25 किमी/घंटा",
            "C": "26 किमी/घंटा",
            "D": "27 किमी/घंटा"
          },
          "explanation": "औसत गति = (2 * 20 * 30) / (20 + 30) = 1200 / 50 = 24."
        }
      }
