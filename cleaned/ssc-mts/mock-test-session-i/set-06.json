    {
      "id": "mock-test-session-i-06-014",
      "number": 14,
      "question": "If the area of a circle is 616 sq cm, find its radius.",
      "options": {
        "A": "7 cm",
        "B": "14 cm",
        "C": "21 cm",
        "D": "28 cm"
      },
      "answer": "B",
      "explanation": "(22/7) * r^2 = 616 => r^2 = 616 * 7 / 22 = 196 => r = 14.",
      "hash": "f568eb46d154df13",
      "translations": {
        "hi": {
          "question": "यदि एक वृत्त का क्षेत्रफल 616 वर्ग सेमी है, तो इसकी त्रिज्या ज्ञात कीजिए।",
          "options": {
            "A": "7 सेमी",
            "B": "14 सेमी",
            "C": "21 सेमी",
            "D": "28 सेमी"
          },
          "explanation": "(22/7) * r^2 = 616 => r^2 = 616 * 7 / 22 = 196 => r = 14."
        }
      }
    },
