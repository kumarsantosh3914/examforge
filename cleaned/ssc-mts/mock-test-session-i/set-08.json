      "translations": {
        "hi": {
          "question": "एक कार पहले 100 किमी 50 किमी/घंटा की गति से और अगले 100 किमी 40 किमी/घंटा की गति से तय करती है। औसत गति ज्ञात कीजिए।",
          "options": {
            "A": "44.44 किमी/घंटा",
            "B": "45 किमी/घंटा",
            "C": "46.66 किमी/घंटा",
            "D": "48 किमी/घंटा"
          },
          "explanation": "कुल दूरी = 200 किमी। कुल समय = 100/50 + 100/40 = 2 + 2.5 = 4.5 घंटा। औसत गति = 200 / 4.5 = 44.44."
        }
      }
    },
    {
      "id": "mock-test-session-i-08-020",
      "number": 20,
      "question": "The ratio of present ages of P and Q is 5:7. 4 years ago, the ratio was 3:5. Find Q's present age.",
      "options": {
        "A": "10",
        "B": "14",
        "C": "18",
        "D": "12"
      },
      "answer": "B",
      "explanation": "(5x - 4)/(7x - 4) = 3/5 => 25x - 20 = 21x - 12 => 4x = 8 => x = 2. Q = 7 * 2 = 14.",
      "hash": "847932ba6c601de5",
      "translations": {
        "hi": {
          "question": "P और Q की वर्तमान आयु का अनुपात 5:7 है। 4 वर्ष पहले, अनुपात 3:5 था। Q की वर्तमान आयु ज्ञात कीजिए।",
          "options": {
            "A": "10",
            "B": "14",
            "C": "18",
            "D": "12"
          },
          "explanation": "(5x - 4)/(7x - 4) = 3/5 => 25x - 20 = 21x - 12 => 4x = 8 => x = 2. Q = 7 * 2 = 14."
        }
      }
    },
