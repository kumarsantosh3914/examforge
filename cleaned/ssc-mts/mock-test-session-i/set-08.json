          "question": "15% और 20% की दो क्रमिक छूटों के बराबर एकल छूट क्या है?",
          "options": {
            "A": "32%",
            "B": "35%",
            "C": "40%",
            "D": "31%"
          },
          "explanation": "x + y - xy/100 = 15 + 20 - (15*20)/100 = 35 - 3 = 32%."
        }
      }
    },
    {
      "id": "mock-test-session-i-08-010",
      "number": 10,
      "question": "Two trains are running in opposite directions at 40 km/h and 50 km/h. Their lengths are 150m and 100m. How long will they take to cross each other?",
      "options": {
        "A": "8 sec",
        "B": "10 sec",
        "C": "12 sec",
        "D": "15 sec"
      },
      "answer": "B",
      "explanation": "Relative speed = 90 km/h = 25 m/s. Total distance = 250m. Time = 250 / 25 = 10 sec.",
      "hash": "1fd9c0699d65aac6",
      "translations": {
        "hi": {
          "question": "दो ट्रेनें 40 किमी/घंटा और 50 किमी/घंटा की गति से विपरीत दिशाओं में चल रही हैं। उनकी लंबाई 150 मीटर और 100 मीटर है। वे एक-दूसरे को पार करने में कितना समय लेंगी?",
          "options": {
            "A": "8 सेकंड",
            "B": "10 सेकंड",
            "C": "12 सेकंड",
            "D": "15 सेकंड"
          },
          "explanation": "सापेक्ष गति = 90 किमी/घंटा = 25 मीटर/सेकंड। कुल दूरी = 250 मीटर। समय = 250 / 25 = 10 सेकंड।"
        }
      }
    },
    {
