  "questions": [
    {
      "id": "mock-test-session-i-08-001",
      "number": 1,
      "question": "The ratio of salaries of A and B is 4:3. If each saves 600 and their expenditure ratio is 3:2, find A's salary.",
      "options": {
        "A": "1800",
        "B": "2400",
        "C": "3000",
        "D": "3600"
      },
      "answer": "B",
      "explanation": "(4x - 600)/(3x - 600) = 3/2 => 8x - 1200 = 9x - 1800 => x = 600. A = 4 * 600 = 2400.",
      "hash": "9f14489b18204286",
      "translations": {
        "hi": {
          "question": "A और B के वेतन का अनुपात 4:3 है। यदि प्रत्येक 600 बचाता है और उनके व्यय का अनुपात 3:2 है, तो A का वेतन ज्ञात कीजिए।",
          "options": {
            "A": "1800",
            "B": "2400",
            "C": "3000",
            "D": "3600"
          },
          "explanation": "(4x - 600)/(3x - 600) = 3/2 => 8x - 1200 = 9x - 1800 => x = 600. A = 4 * 600 = 2400."
        }
      }
    },
    {
      "id": "mock-test-session-i-08-002",
      "number": 2,
      "question": "The population of a city is 50,000. It increases by 10% in the first year and 20% in the second year. Find the population after 2 years.",
      "options": {
        "A": "60,000",
        "B": "65,000",
        "C": "66,000",
        "D": "70,000"
      },
      "answer": "C",
      "explanation": "50000 * 1.1 * 1.2 = 55000 * 1.2 = 66000.",
      "hash": "4fa5419966a05177",
      "translations": {
        "hi": {
          "question": "एक शहर की जनसंख्या 50,000 है। पहले वर्ष में इसमें 10% और दूसरे वर्ष में 20% की वृद्धि होती है। 2 वर्ष बाद जनसंख्या ज्ञात कीजिए।",
          "options": {
            "A": "60,000",
            "B": "65,000",
            "C": "66,000",
            "D": "70,000"
          },
          "explanation": "50000 * 1.1 * 1.2 = 55000 * 1.2 = 66000."
        }
      }
    },
    {
      "id": "mock-test-session-i-08-003",
      "number": 3,
      "question": "Find the total surface area of a cylinder with radius 7 cm and height 10 cm. (pi = 22/7)",
      "options": {
        "A": "748 sq cm",
        "B": "616 sq cm",
        "C": "440 sq cm",
        "D": "800 sq cm"
      },
      "answer": "A",
      "explanation": "TSA = 2*pi*r(h+r) = 2 * 22/7 * 7 * (10+7) = 44 * 17 = 748.",
      "hash": "e5df660758a0429d",
      "translations": {
        "hi": {
          "question": "7 सेमी त्रिज्या और 10 सेमी ऊंचाई वाले बेलन का कुल पृष्ठीय क्षेत्रफल ज्ञात कीजिए। (pi = 22/7)",
          "options": {
            "A": "748 वर्ग सेमी",
            "B": "616 वर्ग सेमी",
            "C": "440 वर्ग सेमी",
            "D": "800 वर्ग सेमी"
          },
          "explanation": "कुल पृष्ठीय क्षेत्रफल = 2*pi*r(h+r) = 2 * 22/7 * 7 * (10+7) = 44 * 17 = 748."
        }
      }
    },
    {
      "id": "mock-test-session-i-08-004",
      "number": 4,
      "question": "A sum of money doubles itself in 5 years at compound interest. In how many years will it become 8 times?",
      "options": {
        "A": "10 years",
        "B": "15 years",
        "C": "20 years",
        "D": "25 years"
      },
      "answer": "B",
      "explanation": "2^1 times in 5 years. 8 times is 2^3. Time = 3 * 5 = 15 years.",
      "hash": "62dd0a71813a8aa6",
      "translations": {
        "hi": {
          "question": "चक्रवृद्धि ब्याज पर कोई राशि 5 वर्षों में दोगुनी हो जाती है। कितने वर्षों में यह 8 गुनी हो जाएगी?",
          "options": {
            "A": "10 वर्ष",
            "B": "15 वर्ष",
            "C": "20 वर्ष",
            "D": "25 वर्ष"
          },
          "explanation": "5 वर्ष में 2^1 गुना। 8 गुना यानी 2^3 है। समय = 3 * 5 = 15 वर्ष।"
        }
      }
    },
    {
      "id": "mock-test-session-i-08-005",
      "number": 5,
      "question": "Pipe A can fill a tank in 4 hours and Pipe B can fill it in 6 hours. If both are opened together, how long will they take?",
      "options": {
        "A": "2 hours",
        "B": "2.4 hours",
        "C": "3 hours",
        "D": "3.5 hours"
      },
      "answer": "B",
      "explanation": "Time = (4 * 6) / (4 + 6) = 24 / 10 = 2.4 hours.",
      "hash": "3e4b2f7e191a257f",
      "translations": {
        "hi": {
          "question": "पाइप A एक टैंक को 4 घंटे में भर सकता है और पाइप B उसे 6 घंटे में भर सकता है। यदि दोनों को एक साथ खोल दिया जाए, तो उन्हें कितना समय लगेगा?",
          "options": {
            "A": "2 घंटे",
            "B": "2.4 घंटे",
            "C": "3 घंटे",
            "D": "3.5 घंटे"
          },
          "explanation": "समय = (4 * 6) / (4 + 6) = 24 / 10 = 2.4 घंटे।"
        }
      }
    },
    {
      "id": "mock-test-session-i-08-006",
      "number": 6,
      "question": "A person travels at 12 km/h instead of 10 km/h and covers 20 km more. Find the actual distance.",
      "options": {
        "A": "100 km",
        "B": "120 km",
        "C": "150 km",
        "D": "80 km"
      },
      "answer": "A",
      "explanation": "Difference in speed = 2 km/h. Time = 20/2 = 10 hours. Actual distance = 10 * 10 = 100 km.",
      "hash": "6301d97823e0a5fd",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति 10 किमी/घंटा के बजाय 12 किमी/घंटा की गति से यात्रा करता है और 20 किमी अधिक दूरी तय करता है। वास्तविक दूरी ज्ञात कीजिए।",
          "options": {
            "A": "100 किमी",
            "B": "120 किमी",
            "C": "150 किमी",
            "D": "80 किमी"
          },
          "explanation": "गति में अंतर = 2 किमी/घंटा। समय = 20/2 = 10 घंटे। वास्तविक दूरी = 10 * 10 = 100 किमी।"
        }
      }
    },
    {
      "id": "mock-test-session-i-08-007",
      "number": 7,
      "question": "The average weight of 8 persons increases by 2.5 kg when a new person comes in place of one weighing 65 kg. Find the weight of the new person.",
      "options": {
        "A": "75 kg",
        "B": "80 kg",
        "C": "85 kg",
        "D": "90 kg"
      },
      "answer": "C",
      "explanation": "Total increase = 8 * 2.5 = 20 kg. New weight = 65 + 20 = 85 kg.",
      "hash": "85db7c660cc21469",
      "translations": {
        "hi": {
          "question": "8 व्यक्तियों का औसत वजन 2.5 किग्रा बढ़ जाता है जब 65 किग्रा वजन वाले व्यक्ति के स्थान पर एक नया व्यक्ति आता है। नए व्यक्ति का वजन ज्ञात कीजिए।",
          "options": {
            "A": "75 किग्रा",
            "B": "80 किग्रा",
            "C": "85 किग्रा",
            "D": "90 किग्रा"
          },
          "explanation": "कुल वृद्धि = 8 * 2.5 = 20 किग्रा। नया वजन = 65 + 20 = 85 किग्रा।"
        }
      }
    },
    {
      "id": "mock-test-session-i-08-008",
      "number": 8,
      "question": "Find the unit digit of (2153)^167.",
      "options": {
        "A": "1",
        "B": "3",
        "C": "7",
        "D": "9"
      },
      "answer": "C",
      "explanation": "Cyclicity of 3 is 4. 167 % 4 = 3. Unit digit is 3^3 = 27, so 7.",
      "hash": "21f7fe692b880a4a",
      "translations": {
        "hi": {
          "question": "(2153)^167 का इकाई अंक ज्ञात कीजिए।",
          "options": {
            "A": "1",
            "B": "3",
            "C": "7",
            "D": "9"
          },
          "explanation": "3 की चक्रीयता 4 है। 167 % 4 = 3. इकाई अंक 3^3 = 27 है, यानी 7."
        }
      }
    },
    {
      "id": "mock-test-session-i-08-009",
      "number": 9,
      "question": "What is the single discount equivalent to two successive discounts of 15% and 20%?",
