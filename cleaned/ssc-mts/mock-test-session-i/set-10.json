    {
      "id": "mock-test-session-i-10-001",
      "number": 1,
      "question": "A shopkeeper sells an article for 400 with a profit of 25%. Find the cost price.",
      "options": {
        "A": "300",
        "B": "320",
        "C": "350",
        "D": "360"
      },
      "answer": "B",
      "explanation": "125% = 400. So CP = (400/125) * 100 = 320.",
      "hash": "10dc21b4530b4c88",
      "translations": {
        "hi": {
          "question": "एक दुकानदार एक वस्तु को 25% के लाभ पर 400 में बेचता है। क्रय मूल्य ज्ञात कीजिए।",
          "options": {
            "A": "300",
            "B": "320",
            "C": "350",
            "D": "360"
          },
          "explanation": "125% = 400. इसलिए CP = (400/125) * 100 = 320."
        }
      }
    },
    {
      "id": "mock-test-session-i-10-002",
      "number": 2,
      "question": "The ratio of two numbers is 3:5. If their sum is 80, find the larger number.",
      "options": {
        "A": "30",
        "B": "40",
        "C": "50",
        "D": "60"
      },
      "answer": "C",
      "explanation": "3x + 5x = 80 => 8x = 80 => x = 10. Larger number = 5x = 50.",
      "hash": "e1c91cc25cda220e",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का अनुपात 3:5 है। यदि उनका योग 80 है, तो बड़ी संख्या ज्ञात कीजिए।",
          "options": {
            "A": "30",
            "B": "40",
            "C": "50",
            "D": "60"
          },
          "explanation": "3x + 5x = 80 => 8x = 80 => x = 10. बड़ी संख्या = 5x = 50."
        }
      }
    },
    {
      "id": "mock-test-session-i-10-003",
      "number": 3,
      "question": "A can do a work in 10 days and B can do it in 15 days. In how many days can they finish it together?",
      "options": {
        "A": "5 days",
        "B": "6 days",
        "C": "7 days",
        "D": "8 days"
      },
      "answer": "B",
      "explanation": "Time taken = (10 * 15) / (10 + 15) = 150 / 25 = 6 days.",
      "hash": "9f83f55dd4f1f7aa",
      "translations": {
        "hi": {
          "question": "A एक कार्य को 10 दिनों में कर सकता है और B उसे 15 दिनों में कर सकता है। वे दोनों मिलकर इसे कितने दिनों में समाप्त कर सकते हैं?",
          "options": {
            "A": "5 दिन",
            "B": "6 दिन",
            "C": "7 दिन",
            "D": "8 दिन"
          },
          "explanation": "लिया गया समय = (10 * 15) / (10 + 15) = 150 / 25 = 6 दिन।"
        }
      }
    },
    {
      "id": "mock-test-session-i-10-005",
      "number": 5,
      "question": "Find the average of first 5 natural numbers.",
      "options": {
        "A": "2",
