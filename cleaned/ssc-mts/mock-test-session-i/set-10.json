    {
      "id": "mock-test-session-i-10-011",
      "number": 11,
      "question": "The diameter of a circle is 14 cm. Find its circumference. (pi = 22/7)",
      "options": {
        "A": "22 cm",
        "B": "44 cm",
        "C": "66 cm",
        "D": "88 cm"
      },
      "answer": "B",
      "explanation": "Circumference = pi * diameter = (22/7) * 14 = 44 cm.",
      "hash": "a0b3664b15d3baa3",
      "translations": {
        "hi": {
          "question": "एक वृत्त का व्यास 14 सेमी है। इसकी परिधि ज्ञात कीजिए। (pi = 22/7)",
          "options": {
            "A": "22 सेमी",
            "B": "44 सेमी",
            "C": "66 सेमी",
            "D": "88 सेमी"
          },
          "explanation": "परिधि = pi * व्यास = (22/7) * 14 = 44 सेमी।"
        }
      }
    },
