    {
      "id": "arithmetic-06-033",
      "number": 33,
      "question": "A man travels 100 km at 50 km/hr and another 100 km at 25 km/hr. Find his average speed.",
      "options": {
        "A": "33.33 km/hr",
        "B": "37.5 km/hr",
        "C": "40 km/hr",
        "D": "45 km/hr"
      },
      "answer": "A",
      "explanation": "Total time = 100/50 + 100/25 = 2 + 4 = 6 hours. Avg Speed = 200/6 = 33.33 km/hr.",
      "hash": "e3e67ed4647827e2",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति 50 किमी/घंटा की गति से 100 किमी और 25 किमी/घंटा की गति से अन्य 100 किमी की यात्रा करता है। उसकी औसत गति ज्ञात कीजिए।",
          "options": {
            "A": "33.33 किमी/घंटा",
            "B": "37.5 किमी/घंटा",
            "C": "40 किमी/घंटा",
            "D": "45 किमी/घंटा"
          },
          "explanation": "कुल समय = 2 + 4 = 6 घंटे। औसत गति = 200/6 = 33.33 किमी/घंटा।"
        }
      }
    },
