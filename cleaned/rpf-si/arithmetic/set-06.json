    {
      "id": "arithmetic-06-030",
      "number": 30,
      "question": "A cylinder has a radius of 7 cm and total surface area of 968 sq.cm. Find its height.",
      "options": {
        "A": "10 cm",
        "B": "15 cm",
        "C": "20 cm",
        "D": "25 cm"
      },
      "answer": "B",
      "explanation": "2*pi*r(r+h) = 968 => 2*(22/7)*7(7+h) = 968 => 44(7+h) = 968 => 7+h = 22 => h = 15.",
      "hash": "97a830fd485014a3",
      "translations": {
        "hi": {
          "question": "एक बेलन की त्रिज्या 7 सेमी और कुल पृष्ठीय क्षेत्रफल 968 वर्ग सेमी है। इसकी ऊँचाई ज्ञात कीजिए।",
          "options": {
            "A": "10 सेमी",
            "B": "15 सेमी",
            "C": "20 सेमी",
            "D": "25 सेमी"
          },
          "explanation": "2*pi*r(r+h) = 968 => 44(7+h) = 968 => 7+h = 22 => h = 15."
        }
      }
    },
