      "translations": {
        "hi": {
          "question": "यदि x:y = 5:8 और y:z = 4:7 है, तो x:z ज्ञात कीजिए।",
          "options": {
            "A": "5:14",
            "B": "5:7",
            "C": "10:7",
            "D": "20:56"
          },
          "explanation": "x/z = (x/y) * (y/z) = (5/8) * (4/7) = 20/56 = 5/14."
        }
      }
    },
