    {
      "id": "arithmetic-06-014",
      "number": 14,
      "question": "The perimeter of a semi-circle is 36 cm. Find its radius.",
      "options": {
        "A": "7 cm",
        "B": "14 cm",
        "C": "21 cm",
        "D": "28 cm"
      },
      "answer": "A",
      "explanation": "Perimeter = pi*r + 2r = r(pi + 2) = r(22/7 + 2) = r(36/7) = 36. r = 7.",
      "hash": "1e2b49f226e5ab6e",
      "translations": {
        "hi": {
          "question": "एक अर्धवृत्त का परिमाप 36 सेमी है। इसकी त्रिज्या ज्ञात कीजिए।",
          "options": {
            "A": "7 सेमी",
            "B": "14 सेमी",
            "C": "21 सेमी",
            "D": "28 सेमी"
          },
          "explanation": "परिमाप = pi*r + 2r = r(36/7) = 36। r = 7."
        }
      }
    },
    {
