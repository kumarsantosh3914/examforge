    {
      "id": "arithmetic-06-006",
      "number": 6,
      "question": "If 3/4 of a number is 12 more than 1/2 of the same number, find the number.",
      "options": {
        "A": "24",
        "B": "36",
        "C": "48",
        "D": "60"
      },
      "answer": "C",
      "explanation": "3/4x - 1/2x = 12 => 1/4x = 12 => x = 48.",
      "hash": "daef631446601bd6",
      "translations": {
        "hi": {
          "question": "यदि किसी संख्या का 3/4 उसी संख्या के 1/2 से 12 अधिक है, तो संख्या ज्ञात कीजिए।",
          "options": {
            "A": "24",
            "B": "36",
            "C": "48",
            "D": "60"
          },
          "explanation": "3/4x - 1/2x = 12 => 1/4x = 12 => x = 48."
        }
      }
    },
