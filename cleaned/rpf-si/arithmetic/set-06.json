    {
      "id": "arithmetic-06-008",
      "number": 8,
      "question": "A train 240 m long passes a platform 160 m long in 20 seconds. Find its speed in km/hr.",
      "options": {
        "A": "36",
        "B": "54",
        "C": "72",
        "D": "90"
      },
      "answer": "C",
      "explanation": "Total distance = 400. Speed = 400/20 = 20 m/s. 20 * (18/5) = 72 km/hr.",
      "hash": "9981bdfb237b36c6",
      "translations": {
        "hi": {
          "question": "240 मीटर लंबी एक ट्रेन 160 मीटर लंबे प्लेटफॉर्म को 20 सेकंड में पार करती है। किमी/घंटा में इसकी गति ज्ञात कीजिए।",
          "options": {
            "A": "36",
            "B": "54",
            "C": "72",
            "D": "90"
          },
          "explanation": "कुल दूरी = 400। गति = 400/20 = 20 मी/से। 20 * (18/5) = 72 किमी/घंटा।"
        }
      }
    },
    {
      "id": "arithmetic-06-009",
      "number": 9,
      "question": "A and B together can do a work in 12 days. A alone can do it in 20 days. In how many days can B alone do it?",
      "options": {
        "A": "25 days",
        "B": "30 days",
        "C": "35 days",
        "D": "40 days"
      },
      "answer": "B",
      "explanation": "B's work = 1/12 - 1/20 = 2/60 = 1/30. Days = 30.",
      "hash": "78f207a6cf2324b0",
      "translations": {
        "hi": {
          "question": "A और B मिलकर एक काम को 12 दिनों में कर सकते हैं। A अकेला इसे 20 दिनों में कर सकता है। B अकेला इसे कितने दिनों में कर सकता है?",
          "options": {
            "A": "25 दिन",
            "B": "30 दिन",
            "C": "35 दिन",
            "D": "40 दिन"
          },
          "explanation": "B का कार्य = 1/12 - 1/20 = 2/60 = 1/30। दिन = 30."
        }
      }
    },
    {
      "id": "arithmetic-06-010",
      "number": 10,
      "question": "If the circumference of a circle is 88 cm, find its area.",
      "options": {
        "A": "154 cm²",
        "B": "308 cm²",
        "C": "462 cm²",
        "D": "616 cm²"
      },
      "answer": "D",
      "explanation": "2*pi*r = 88 => r = 14. Area = pi * 14 * 14 = 616.",
      "hash": "8d1ec39198a80771",
      "translations": {
        "hi": {
          "question": "यदि एक वृत्त की परिधि 88 सेमी है, तो इसका क्षेत्रफल ज्ञात कीजिए।",
          "options": {
            "A": "154 सेमी²",
            "B": "308 सेमी²",
            "C": "462 सेमी²",
            "D": "616 सेमी²"
          },
          "explanation": "2*pi*r = 88 => r = 14. क्षेत्रफल = pi * 14 * 14 = 616."
        }
      }
    },
