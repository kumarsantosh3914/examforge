    {
      "id": "arithmetic-06-020",
      "number": 20,
      "question": "A boat travels 12 km/hr in still water. If the speed of the stream is 4 km/hr, how much time will it take to go 48 km upstream?",
      "options": {
        "A": "3 hours",
        "B": "4 hours",
        "C": "6 hours",
        "D": "8 hours"
      },
      "answer": "C",
      "explanation": "Upstream speed = 12 - 4 = 8 km/hr. Time = 48 / 8 = 6 hours.",
      "hash": "f1c975c8fb1624b6",
      "translations": {
        "hi": {
          "question": "एक नाव शांत जल में 12 किमी/घंटा की गति से चलती है। यदि धारा की गति 4 किमी/घंटा है, तो धारा के प्रतिकूल 48 किमी जाने में कितना समय लगेगा?",
          "options": {
            "A": "3 घंटे",
            "B": "4 घंटे",
            "C": "6 घंटे",
            "D": "8 घंटे"
          },
          "explanation": "धारा के प्रतिकूल गति = 12 - 4 = 8 किमी/घंटा। समय = 48 / 8 = 6 घंटे."
        }
      }
    },
