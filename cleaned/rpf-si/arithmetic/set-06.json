      "id": "arithmetic-06-001",
      "number": 1,
      "question": "A man buys a watch for Rs. 1600. At what price should he sell it to gain 25%?",
      "options": {
        "A": "1800",
        "B": "1900",
        "C": "2000",
        "D": "2100"
      },
      "answer": "C",
      "explanation": "SP = 1600 * 1.25 = 2000.",
      "hash": "820f553c5025df85",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति 1600 रुपये में एक घड़ी खरीदता है। 25% लाभ प्राप्त करने के लिए उसे इसे किस मूल्य पर बेचना चाहिए?",
          "options": {
            "A": "1800",
            "B": "1900",
            "C": "2000",
            "D": "2100"
          },
          "explanation": "SP = 1600 * 1.25 = 2000."
        }
      }
    },
    {
      "id": "arithmetic-06-002",
      "number": 2,
      "question": "The ratio of the volumes of two cubes is 27:64. Find the ratio of their total surface areas.",
      "options": {
        "A": "3:4",
        "B": "9:16",
        "C": "27:64",
        "D": "81:256"
      },
      "answer": "B",
      "explanation": "Ratio of sides = cbrt(27):cbrt(64) = 3:4. Ratio of areas = 3^2:4^2 = 9:16.",
      "hash": "f91ae224c8b347bb",
      "translations": {
        "hi": {
          "question": "दो घनों के आयतनों का अनुपात 27:64 है। उनके कुल पृष्ठीय क्षेत्रफलों का अनुपात ज्ञात कीजिए।",
          "options": {
            "A": "3:4",
            "B": "9:16",
            "C": "27:64",
            "D": "81:256"
          },
          "explanation": "भुजाओं का अनुपात = cbrt(27):cbrt(64) = 3:4। क्षेत्रफलों का अनुपात = 3^2:4^2 = 9:16."
        }
      }
    },
    {
      "id": "arithmetic-06-003",
      "number": 3,
      "question": "If the length of a rectangle is increased by 10% and breadth is increased by 20%, find the net percentage increase in area.",
      "options": {
        "A": "30%",
        "B": "32%",
        "C": "35%",
        "D": "40%"
      },
      "answer": "B",
      "explanation": "Increase = 10 + 20 + (10*20)/100 = 32%.",
      "hash": "c5c9663bd79644c7",
      "translations": {
        "hi": {
          "question": "यदि एक आयत की लंबाई में 10% की वृद्धि की जाती है और चौड़ाई में 20% की वृद्धि की जाती है, तो क्षेत्रफल में शुद्ध प्रतिशत वृद्धि ज्ञात कीजिए।",
          "options": {
            "A": "30%",
            "B": "32%",
            "C": "35%",
            "D": "40%"
          },
          "explanation": "वृद्धि = 10 + 20 + (10*20)/100 = 32%."
        }
      }
    },
    {
      "id": "arithmetic-06-004",
      "number": 4,
      "question": "The average of 10 numbers is 7. If each number is multiplied by 12, then the average of new set of numbers is?",
      "options": {
        "A": "7",
        "B": "19",
        "C": "82",
        "D": "84"
      },
      "answer": "D",
      "explanation": "New Average = Old Average * 12 = 7 * 12 = 84.",
      "hash": "d4e669a37b59893b",
      "translations": {
        "hi": {
          "question": "10 संख्याओं का औसत 7 है। यदि प्रत्येक संख्या को 12 से गुणा किया जाता है, तो संख्याओं के नए सेट का औसत क्या होगा?",
          "options": {
            "A": "7",
            "B": "19",
            "C": "82",
            "D": "84"
          },
          "explanation": "नया औसत = पुराना औसत * 12 = 7 * 12 = 84."
        }
      }
    },
