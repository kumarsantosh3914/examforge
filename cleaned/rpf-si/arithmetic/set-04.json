    {
      "id": "arithmetic-04-022",
      "number": 22,
      "question": "The average of 7 numbers is 30. If the average of first three is 25 and that of last three is 35, find the fourth number.",
      "options": {
        "A": "20",
        "B": "25",
        "C": "30",
        "D": "40"
      },
      "answer": "C",
      "explanation": "Total = 210. Fourth = 210 - (3*25 + 3*35) = 210 - (75+105) = 210-180 = 30.",
      "hash": "3eab19c4d7e9d1d9",
      "translations": {
        "hi": {
          "question": "7 संख्याओं का औसत 30 है। यदि पहली तीन का औसत 25 है और अंतिम तीन का 35 है, तो चौथी संख्या ज्ञात कीजिए।",
          "options": {
            "A": "20",
            "B": "25",
            "C": "30",
            "D": "40"
          },
          "explanation": "कुल = 210। चौथी = 210 - (3*25 + 3*35) = 210 - (75+105) = 210-180 = 30."
        }
      }
    },
    {
      "id": "arithmetic-04-023",
      "number": 23,
      "question": "Find the largest number that divides 62, 132 and 237 to leave the same remainder in each case.",
      "options": {
        "A": "15",
        "B": "35",
        "C": "45",
        "D": "55"
      },
      "answer": "B",
      "explanation": "HCF of (132-62), (237-132) and (237-62) = HCF of 70, 105, 175 = 35.",
      "hash": "e7c8052077f22f9e",
      "translations": {
        "hi": {
          "question": "वह सबसे बड़ी संख्या ज्ञात कीजिए जो 62, 132 और 237 को विभाजित करने पर प्रत्येक स्थिति में समान शेषफल छोड़े।",
          "options": {
            "A": "15",
            "B": "35",
            "C": "45",
            "D": "55"
          },
          "explanation": "(132-62), (237-132) और (237-62) का HCF = 70, 105, 175 का HCF = 35."
        }
      }
    },
    {
      "id": "arithmetic-04-024",
      "number": 24,
      "question": "A sphere has a radius of 3 cm. Find its volume.",
      "options": {
        "A": "12pi",
        "B": "36pi",
        "C": "18pi",
        "D": "27pi"
      },
      "answer": "B",
      "explanation": "Volume = (4/3) * pi * r^3 = (4/3) * pi * 27 = 36pi.",
      "hash": "4ce54ebf495365bd",
      "translations": {
        "hi": {
          "question": "एक गोले की त्रिज्या 3 सेमी है। इसका आयतन ज्ञात कीजिए।",
          "options": {
            "A": "12pi",
            "B": "36pi",
            "C": "18pi",
            "D": "27pi"
          },
          "explanation": "आयतन = (4/3) * pi * r^3 = (4/3) * pi * 27 = 36pi."
        }
      }
    },
