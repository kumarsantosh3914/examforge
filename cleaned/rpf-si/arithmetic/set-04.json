    {
      "id": "arithmetic-04-020",
      "number": 20,
      "question": "In what time will a train 100 m long cross a bridge 150 m long if it is moving at 50 km/hr?",
      "options": {
        "A": "15 sec",
        "B": "18 sec",
        "C": "20 sec",
        "D": "25 sec"
      },
      "answer": "B",
      "explanation": "Total distance = 250 m. Speed = 50 * (5/18) = 125/9 m/s. Time = 250 / (125/9) = 18 sec.",
      "hash": "767ed85a5033a797",
      "translations": {
        "hi": {
          "question": "100 मीटर लंबी एक ट्रेन 150 मीटर लंबे पुल को कितने समय में पार करेगी यदि वह 50 किमी/घंटा की गति से चल रही है?",
          "options": {
            "A": "15 सेकंड",
            "B": "18 सेकंड",
            "C": "20 सेकंड",
            "D": "25 सेकंड"
          },
          "explanation": "कुल दूरी = 250 मीटर। गति = 50 * (5/18) = 125/9 मीटर/सेकंड। समय = 250 / (125/9) = 18 सेकंड।"
        }
      }
    },
    {
