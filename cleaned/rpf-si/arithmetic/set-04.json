    {
      "id": "arithmetic-04-027",
      "number": 27,
      "question": "A rectangular field has a length of 15 m and width of 10 m. If a path 1 m wide is made inside it, find the area of the path.",
      "options": {
        "A": "25 m²",
        "B": "46 m²",
        "C": "50 m²",
        "D": "44 m²"
      },
      "answer": "B",
      "explanation": "Outer Area = 150. Inner dimensions = (15-2) and (10-2) = 13 and 8. Inner Area = 104. Path = 150 - 104 = 46.",
      "hash": "891e5966b7226d2f",
      "translations": {
        "hi": {
          "question": "एक आयताकार मैदान की लंबाई 15 मीटर और चौड़ाई 10 मीटर है। यदि इसके अंदर 1 मीटर चौड़ा रास्ता बनाया जाता है, तो रास्ते का क्षेत्रफल ज्ञात कीजिए।",
          "options": {
            "A": "25 मीटर²",
            "B": "46 मीटर²",
            "C": "50 मीटर²",
            "D": "44 मीटर²"
          },
          "explanation": "बाहरी क्षेत्रफल = 150. आंतरिक विमाएं = 13 और 8. आंतरिक क्षेत्रफल = 104. रास्ता = 150 - 104 = 46."
        }
      }
    },
