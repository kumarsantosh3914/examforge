          "options": {
            "A": "4 महीने",
            "B": "6 महीने",
            "C": "8 महीने",
            "D": "9 महीने"
          },
          "explanation": "3500 * 12 = 7000 * x => x = 6 महीने। B शुरुआत के 6 महीने बाद शामिल हुआ।"
        }
      }
    },
