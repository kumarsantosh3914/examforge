      "id": "arithmetic-09-009",
      "number": 9,
      "question": "What is the third proportional to 4 and 6?",
      "options": {
        "A": "8",
        "B": "9",
        "C": "10",
        "D": "12"
      },
      "answer": "B",
      "explanation": "4/6 = 6/x => 4x = 36 => x = 9.",
      "hash": "4c7c35b7629df9c1",
      "translations": {
        "hi": {
          "question": "4 और 6 का तृतीयानुपाती क्या है?",
          "options": {
            "A": "8",
            "B": "9",
            "C": "10",
            "D": "12"
          },
          "explanation": "4/6 = 6/x => 4x = 36 => x = 9."
        }
      }
    },
