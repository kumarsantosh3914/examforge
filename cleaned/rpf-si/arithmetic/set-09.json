    {
      "id": "arithmetic-09-016",
      "number": 16,
      "question": "The product of two numbers is 120 and the sum of their squares is 289. Find the sum of the numbers.",
      "options": {
        "A": "20",
        "B": "23",
        "C": "25",
        "D": "27"
      },
      "answer": "B",
      "explanation": "(x+y)^2 = x^2 + y^2 + 2xy = 289 + 2(120) = 529. x+y = sqrt(529) = 23.",
      "hash": "1f8779722ee44a7a",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का गुणनफल 120 है और उनके वर्गों का योग 289 है। संख्याओं का योग ज्ञात कीजिए।",
          "options": {
            "A": "20",
            "B": "23",
            "C": "25",
            "D": "27"
          },
          "explanation": "(x+y)^2 = x^2 + y^2 + 2xy = 289 + 2(120) = 529. x+y = 23."
        }
      }
    },
