      "id": "arithmetic-09-001",
      "number": 1,
      "question": "The sum of two numbers is 30 and their LCM is 36. Find the numbers.",
      "options": {
        "A": "12, 18",
        "B": "10, 20",
        "C": "15, 15",
        "D": "14, 16"
      },
      "answer": "A",
      "explanation": "12 + 18 = 30 and LCM of 12, 18 is 36.",
      "hash": "bf9a2aeaaa3ffb06",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का योग 30 है और उनका LCM 36 है। संख्याएँ ज्ञात कीजिए।",
          "options": {
            "A": "12, 18",
            "B": "10, 20",
            "C": "15, 15",
            "D": "14, 16"
          },
          "explanation": "12 + 18 = 30 और 12, 18 का LCM 36 है।"
        }
      }
    },
    {
      "id": "arithmetic-09-002",
      "number": 2,
      "question": "A man buys an item for Rs. 800 and sells it for Rs. 1000. Find his gain percent.",
      "options": {
        "A": "20%",
        "B": "25%",
        "C": "15%",
        "D": "30%"
      },
      "answer": "B",
      "explanation": "Profit = 200. Profit % = (200/800) * 100 = 25%.",
      "hash": "8f027da35bd318e1",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति 800 रुपये में एक वस्तु खरीदता है और उसे 1000 रुपये में बेचता है। उसका लाभ प्रतिशत ज्ञात कीजिए।",
          "options": {
            "A": "20%",
            "B": "25%",
            "C": "15%",
            "D": "30%"
          },
          "explanation": "लाभ = 200. लाभ % = (200/800) * 100 = 25%."
        }
      }
    },
    {
      "id": "arithmetic-09-003",
      "number": 3,
      "question": "If 40% of a number is 200, find 10% of that number.",
      "options": {
        "A": "40",
        "B": "50",
        "C": "60",
        "D": "80"
      },
      "answer": "B",
      "explanation": "40% = 200. So 10% = 200 / 4 = 50.",
      "hash": "469cd571b5ffe772",
      "translations": {
        "hi": {
          "question": "यदि किसी संख्या का 40% 200 है, तो उस संख्या का 10% ज्ञात कीजिए।",
          "options": {
            "A": "40",
            "B": "50",
            "C": "60",
            "D": "80"
          },
          "explanation": "40% = 200. तो 10% = 200 / 4 = 50."
        }
      }
    },
    {
      "id": "arithmetic-09-004",
      "number": 4,
      "question": "If the area of a square is 144 sq.cm, find its perimeter.",
      "options": {
        "A": "12 cm",
        "B": "24 cm",
        "C": "36 cm",
        "D": "48 cm"
      },
      "answer": "D",
      "explanation": "Side = sqrt(144) = 12. Perimeter = 4 * 12 = 48.",
      "hash": "ee83f51490c0914a",
      "translations": {
        "hi": {
          "question": "यदि एक वर्ग का क्षेत्रफल 144 वर्ग सेमी है, तो उसका परिमाप ज्ञात कीजिए।",
          "options": {
            "A": "12 सेमी",
            "B": "24 सेमी",
            "C": "36 सेमी",
            "D": "48 सेमी"
          },
          "explanation": "भुजा = sqrt(144) = 12. परिमाप = 4 * 12 = 48."
        }
      }
    },
    {
      "id": "arithmetic-09-005",
      "number": 5,
      "question": "A train 150m long is running at a speed of 54 km/hr. How much time will it take to pass a pole?",
      "options": {
        "A": "8 sec",
        "B": "10 sec",
        "C": "12 sec",
        "D": "15 sec"
      },
      "answer": "B",
      "explanation": "Speed = 54 * (5/18) = 15 m/s. Time = 150 / 15 = 10 sec.",
      "hash": "41b9ef4e7814f045",
      "translations": {
        "hi": {
          "question": "150 मीटर लंबी एक ट्रेन 54 किमी/घंटा की गति से चल रही है। एक खंभे को पार करने में इसे कितना समय लगेगा?",
          "options": {
            "A": "8 सेकंड",
            "B": "10 सेकंड",
            "C": "12 सेकंड",
            "D": "15 सेकंड"
          },
          "explanation": "गति = 54 * (5/18) = 15 मी/से। समय = 150 / 15 = 10 सेकंड।"
        }
      }
    },
    {
      "id": "arithmetic-09-006",
      "number": 6,
      "question": "Find the average of the first 20 natural numbers.",
      "options": {
        "A": "10",
        "B": "10.5",
        "C": "11",
        "D": "20.5"
      },
      "answer": "B",
      "explanation": "Average = (n+1)/2 = 21/2 = 10.5.",
      "hash": "7821ed08431aa35f",
      "translations": {
        "hi": {
          "question": "प्रथम 20 प्राकृतिक संख्याओं का औसत ज्ञात कीजिए।",
          "options": {
            "A": "10",
            "B": "10.5",
            "C": "11",
            "D": "20.5"
          },
          "explanation": "औसत = (n+1)/2 = 21/2 = 10.5."
        }
      }
    },
    {
      "id": "arithmetic-09-007",
      "number": 7,
      "question": "The ratio of boys and girls in a class is 5:3. If there are 24 girls, find the number of boys.",
      "options": {
        "A": "30",
        "B": "35",
        "C": "40",
        "D": "45"
      },
      "answer": "C",
      "explanation": "3 units = 24. 1 unit = 8. 5 units = 40.",
      "hash": "9d2f79d683091ab0",
      "translations": {
        "hi": {
          "question": "एक कक्षा में लड़कों और लड़कियों का अनुपात 5:3 है। यदि 24 लड़कियाँ हैं, तो लड़कों की संख्या ज्ञात कीजिए।",
          "options": {
            "A": "30",
            "B": "35",
            "C": "40",
            "D": "45"
          },
          "explanation": "3 इकाई = 24. 1 इकाई = 8. 5 इकाई = 40."
        }
      }
    },
    {
      "id": "arithmetic-09-008",
      "number": 8,
      "question": "A and B can do a work in 10 and 15 days respectively. Together they can finish it in?",
      "options": {
        "A": "5 days",
        "B": "6 days",
        "C": "8 days",
        "D": "9 days"
      },
      "answer": "B",
      "explanation": "(10 * 15) / (10 + 15) = 150 / 25 = 6.",
      "hash": "15cef1fe352734e5",
      "translations": {
        "hi": {
          "question": "A और B एक काम को क्रमशः 10 और 15 दिनों में कर सकते हैं। वे मिलकर इसे कितने समय में पूरा करेंगे?",
          "options": {
            "A": "5 दिन",
            "B": "6 दिन",
            "C": "8 दिन",
            "D": "9 दिन"
          },
          "explanation": "(10 * 15) / (10 + 15) = 150 / 25 = 6."
        }
      }
    },
