    {
      "id": "arithmetic-05-001",
      "number": 1,
      "question": "A man crosses a 600 m long bridge in 5 minutes. What is his speed in km/hr?",
      "options": {
        "A": "3.6",
        "B": "7.2",
        "C": "8.4",
        "D": "10"
      },
      "answer": "B",
      "explanation": "Speed = 600m / 300s = 2 m/s. In km/hr = 2 * (18/5) = 7.2.",
      "hash": "68ad0e70c2dd9d73",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति 5 मिनट में 600 मीटर लंबा पुल पार करता है। किमी/घंटा में उसकी गति क्या है?",
          "options": {
            "A": "3.6",
            "B": "7.2",
            "C": "8.4",
            "D": "10"
          },
          "explanation": "गति = 600मी / 300से = 2 मी/से। किमी/घंटा में = 2 * (18/5) = 7.2."
        }
      }
    },
    {
      "id": "arithmetic-05-002",
      "number": 2,
      "question": "The sum of two numbers is 15 and the sum of their squares is 113. Find the numbers.",
      "options": {
        "A": "7, 8",
        "B": "6, 9",
        "C": "5, 10",
        "D": "4, 11"
      },
      "answer": "A",
      "explanation": "7+8=15 and 49+64=113.",
      "hash": "5db0bb94f431ca3b",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का योग 15 है और उनके वर्गों का योग 113 है। संख्याएँ ज्ञात कीजिए।",
          "options": {
            "A": "7, 8",
            "B": "6, 9",
            "C": "5, 10",
            "D": "4, 11"
          },
          "explanation": "7+8=15 और 49+64=113."
        }
      }
    },
    {
      "id": "arithmetic-05-003",
      "number": 3,
      "question": "The average of first five prime numbers is?",
      "options": {
        "A": "3.6",
        "B": "5.6",
        "C": "5.4",
        "D": "5"
      },
      "answer": "B",
      "explanation": "Prime numbers: 2, 3, 5, 7, 11. Sum = 28. Average = 28/5 = 5.6.",
      "hash": "db37bb57ccbc0cf0",
      "translations": {
        "hi": {
          "question": "प्रथम पांच अभाज्य संख्याओं का औसत क्या है?",
          "options": {
            "A": "3.6",
            "B": "5.6",
            "C": "5.4",
            "D": "5"
          },
          "explanation": "अभाज्य संख्याएँ: 2, 3, 5, 7, 11। योग = 28। औसत = 28/5 = 5.6."
        }
      }
    },
    {
      "id": "arithmetic-05-004",
      "number": 4,
      "question": "A person buys an article for Rs. 450 and sells it for Rs. 540. Find his gain percent.",
      "options": {
        "A": "10%",
        "B": "15%",
        "C": "20%",
        "D": "25%"
      },
      "answer": "C",
      "explanation": "Gain = 90. Profit % = (90/450) * 100 = 20%.",
      "hash": "672dc3a2c282a11f",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति 450 रुपये में एक वस्तु खरीदता है और उसे 540 रुपये में बेचता है। उसका लाभ प्रतिशत ज्ञात कीजिए।",
          "options": {
            "A": "10%",
            "B": "15%",
            "C": "20%",
            "D": "25%"
          },
          "explanation": "लाभ = 90. लाभ % = (90/450) * 100 = 20%."
        }
      }
    },
    {
      "id": "arithmetic-05-005",
      "number": 5,
      "question": "If 20% of a number is 120, then 120% of that number will be?",
      "options": {
        "A": "20",
        "B": "120",
        "C": "480",
        "D": "720"
      },
      "answer": "D",
      "explanation": "20% = 120. 120% = 120 * 6 = 720.",
      "hash": "94626f393422dbb9",
      "translations": {
        "hi": {
          "question": "यदि किसी संख्या का 20% 120 है, तो उस संख्या का 120% क्या होगा?",
          "options": {
            "A": "20",
            "B": "120",
            "C": "480",
            "D": "720"
          },
          "explanation": "20% = 120. 120% = 120 * 6 = 720."
        }
      }
    },
    {
      "id": "arithmetic-05-006",
      "number": 6,
      "question": "If the side of a square is increased by 25%, find the percent increase in its area.",
      "options": {
        "A": "25%",
        "B": "50%",
        "C": "55.25%",
        "D": "56.25%"
      },
      "answer": "D",
      "explanation": "Increase = 25 + 25 + (25*25)/100 = 56.25%.",
      "hash": "2b39ad0584eaeb9c",
      "translations": {
        "hi": {
          "question": "यदि किसी वर्ग की भुजा में 25% की वृद्धि की जाती है, तो उसके क्षेत्रफल में प्रतिशत वृद्धि ज्ञात कीजिए।",
          "options": {
            "A": "25%",
            "B": "50%",
            "C": "55.25%",
            "D": "56.25%"
          },
          "explanation": "वृद्धि = 25 + 25 + (25*25)/100 = 56.25%."
        }
      }
    },
    {
      "id": "arithmetic-05-007",
      "number": 7,
      "question": "A and B together can complete a work in 15 days. If B alone can do it in 20 days, in how many days can A alone do it?",
      "options": {
        "A": "30 days",
        "B": "40 days",
        "C": "45 days",
        "D": "60 days"
      },
      "answer": "D",
      "explanation": "A's work = 1/15 - 1/20 = 1/60. Days = 60.",
      "hash": "c7d87bcc81e096dc",
      "translations": {
        "hi": {
          "question": "A और B मिलकर एक काम को 15 दिनों में पूरा कर सकते हैं। यदि B अकेला इसे 20 दिनों में कर सकता है, तो A अकेला इसे कितने दिनों में कर सकता है?",
          "options": {
            "A": "30 दिन",
            "B": "40 दिन",
            "C": "45 दिन",
            "D": "60 दिन"
          },
          "explanation": "A का कार्य = 1/15 - 1/20 = 1/60। दिन = 60."
        }
      }
    },
    {
      "id": "arithmetic-05-008",
      "number": 8,
      "question": "Find the simple interest on Rs. 2500 at 6% per annum for 4 years.",
      "options": {
        "A": "500",
        "B": "600",
        "C": "700",
        "D": "800"
      },
      "answer": "B",
      "explanation": "SI = (2500 * 6 * 4) / 100 = 600.",
