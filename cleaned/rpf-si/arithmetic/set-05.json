    {
      "id": "arithmetic-05-020",
      "number": 20,
      "question": "The length of a rectangle is thrice its breadth. If the area is 192 sq.cm, find the perimeter.",
      "options": {
        "A": "32 cm",
        "B": "48 cm",
        "C": "64 cm",
        "D": "72 cm"
      },
      "answer": "C",
      "explanation": "3x * x = 192 => x^2 = 64 => x = 8. Length = 24, Breadth = 8. Perimeter = 2(24+8) = 64.",
      "hash": "95fb2875098e72b9",
      "translations": {
        "hi": {
          "question": "एक आयत की लंबाई उसकी चौड़ाई की तीन गुनी है। यदि क्षेत्रफल 192 वर्ग सेमी है, तो परिमाप ज्ञात कीजिए।",
          "options": {
            "A": "32 सेमी",
            "B": "48 सेमी",
            "C": "64 सेमी",
            "D": "72 सेमी"
          },
          "explanation": "3x * x = 192 => x^2 = 64 => x = 8। लंबाई = 24, चौड़ाई = 8। परिमाप = 2(24+8) = 64."
        }
      }
    },
