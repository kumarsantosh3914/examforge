      "translations": {
        "hi": {
          "question": "एक डीलर 1200 रुपये में एक वस्तु खरीदता है और उस पर क्रय मूल्य से 20% अधिक अंकित करता है। फिर वह 10% की छूट देता है। उसका लाभ प्रतिशत ज्ञात कीजिए।",
          "options": {
            "A": "8%",
            "B": "10%",
            "C": "12%",
            "D": "15%"
          },
          "explanation": "शुद्ध परिवर्तन = 20 - 10 - (20*10)/100 = 8%."
        }
      }
    },
    {
