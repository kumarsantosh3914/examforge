      "translations": {
        "hi": {
          "question": "2500 रुपये पर 6% वार्षिक दर से 4 वर्ष का साधारण ब्याज ज्ञात कीजिए।",
          "options": {
            "A": "500",
            "B": "600",
            "C": "700",
            "D": "800"
          },
          "explanation": "SI = (2500 * 6 * 4) / 100 = 600."
        }
      }
    },
