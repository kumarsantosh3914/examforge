      "hash": "a3c3fe729ad1179c",
      "translations": {
        "hi": {
          "question": "150 मीटर लंबी एक ट्रेन 9 सेकंड में एक खंभे को पार करती है। किमी/घंटा में ट्रेन की गति ज्ञात कीजिए।",
          "options": {
            "A": "40",
            "B": "50",
            "C": "60",
            "D": "70"
          },
          "explanation": "गति = 150/9 मी/से। किमी/घंटा में = (150/9) * (18/5) = 60."
        }
      }
    },
    {
      "id": "arithmetic-05-012",
      "number": 12,
      "question": "The difference between CI and SI on Rs. 2500 for 2 years at 4% per annum is?",
      "options": {
        "A": "2",
        "B": "4",
        "C": "6",
        "D": "8"
      },
      "answer": "B",
      "explanation": "Difference = P(R/100)^2 = 2500(4/100)^2 = 2500 * (1/625) = 4.",
      "hash": "4096e00393f073fd",
      "translations": {
        "hi": {
          "question": "2500 रुपये पर 4% वार्षिक दर से 2 वर्ष के चक्रवृद्धि ब्याज और साधारण ब्याज के बीच का अंतर क्या है?",
          "options": {
            "A": "2",
            "B": "4",
            "C": "6",
            "D": "8"
          },
          "explanation": "अंतर = P(R/100)^2 = 2500(4/100)^2 = 2500 * (1/625) = 4."
        }
      }
    },
