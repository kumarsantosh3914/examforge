    {
      "id": "arithmetic-05-011",
      "number": 11,
      "question": "A train 150 m long passes a pole in 9 seconds. Find the speed of the train in km/hr.",
      "options": {
        "A": "40",
        "B": "50",
        "C": "60",
        "D": "70"
      },
      "answer": "C",
