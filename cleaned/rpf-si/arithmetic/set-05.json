    {
      "id": "arithmetic-05-014",
      "number": 14,
      "question": "A cube has a total surface area of 486 sq.cm. Find its volume.",
      "options": {
        "A": "512 cm³",
        "B": "729 cm³",
        "C": "1000 cm³",
        "D": "343 cm³"
      },
      "answer": "B",
      "explanation": "6a^2 = 486 => a^2 = 81 => a = 9. Volume = 9^3 = 729.",
      "hash": "19a4cc6171d98213",
      "translations": {
        "hi": {
          "question": "एक घन का कुल पृष्ठीय क्षेत्रफल 486 वर्ग सेमी है। इसका आयतन ज्ञात कीजिए।",
          "options": {
            "A": "512 सेमी³",
            "B": "729 सेमी³",
            "C": "1000 सेमी³",
            "D": "343 सेमी³"
          },
          "explanation": "6a^2 = 486 => a^2 = 81 => a = 9। आयतन = 9^3 = 729."
        }
      }
    },
    {
      "id": "arithmetic-05-015",
      "number": 15,
      "question": "A dealer buys an item for Rs. 1200 and marks it 20% above the cost price. He then allows a 10% discount. Find his profit percent.",
