    {
      "id": "arithmetic-05-027",
      "number": 27,
      "question": "A can do a work in 10 days and B in 20 days. Together they work for 5 days and then A leaves. How many more days will B take to finish?",
      "options": {
        "A": "5 days",
        "B": "10 days",
        "C": "15 days",
        "D": "20 days"
      },
      "answer": "A",
      "explanation": "5 days work = 5(1/10+1/20) = 3/4. Remaining = 1/4. B takes (1/4)*20 = 5 days.",
      "hash": "58e633eee1b708b8",
      "translations": {
        "hi": {
          "question": "A एक काम को 10 दिनों में और B 20 दिनों में कर सकता है। वे 5 दिनों तक साथ काम करते हैं और फिर A चला जाता है। B शेष काम को पूरा करने में कितने और दिन लेगा?",
          "options": {
            "A": "5 दिन",
            "B": "10 दिन",
            "C": "15 दिन",
            "D": "20 दिन"
          },
          "explanation": "5 दिनों का कार्य = 5(1/10+1/20) = 3/4। शेष = 1/4। B को (1/4)*20 = 5 दिन लगेंगे।"
        }
      }
    },
