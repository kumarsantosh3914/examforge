    {
      "id": "arithmetic-02-020",
      "number": 20,
      "question": "If the height of a triangle is decreased by 40% and its base is increased by 40%, what is the effect on its area?",
      "options": {
        "A": "No change",
        "B": "16% increase",
        "C": "16% decrease",
        "D": "8% decrease"
      },
      "answer": "C",
      "explanation": "Effect = -40 + 40 + (-40*40/100) = -16%.",
      "hash": "3f4364a96a08897b",
      "translations": {
        "hi": {
          "question": "यदि एक त्रिभुज की ऊँचाई 40% कम कर दी जाती है और इसका आधार 40% बढ़ा दिया जाता है, तो इसके क्षेत्रफल पर क्या प्रभाव पड़ेगा?",
          "options": {
            "A": "कोई बदलाव नहीं",
            "B": "16% वृद्धि",
            "C": "16% कमी",
            "D": "8% कमी"
          },
          "explanation": "प्रभाव = -40 + 40 + (-40*40/100) = -16%."
        }
      }
    },
    {
      "id": "arithmetic-02-021",
      "number": 21,
      "question": "A can do a work in 10 days and B in 15 days. They work together for 2 days and then A leaves. In how many days will B finish the remaining work?",
      "options": {
        "A": "8 days",
        "B": "10 days",
        "C": "12 days",
        "D": "15 days"
      },
      "answer": "B",
      "explanation": "Together in 2 days = 2 * (1/10 + 1/15) = 2 * 5/30 = 1/3. Remaining = 2/3. B takes (2/3) * 15 = 10 days.",
      "hash": "3390f6f985520420",
      "translations": {
        "hi": {
          "question": "A एक काम को 10 दिनों में और B 15 दिनों में कर सकता है। वे 2 दिनों तक साथ काम करते हैं और फिर A चला जाता है। B शेष काम को कितने दिनों में पूरा करेगा?",
          "options": {
            "A": "8 दिन",
            "B": "10 दिन",
            "C": "12 दिन",
            "D": "15 दिन"
          },
          "explanation": "2 दिनों में साथ = 2 * (1/10 + 1/15) = 2 * 5/30 = 1/3. शेष = 2/3. B को (2/3) * 15 = 10 दिन लगेंगे।"
        }
      }
    },
    {
      "id": "arithmetic-02-022",
      "number": 22,
      "question": "A man walks at 5 km/h and reaches his office 6 minutes late. If he walks at 6 km/h, he reaches 2 minutes early. Find the distance to his office.",
      "options": {
        "A": "3 km",
        "B": "4 km",
        "C": "5 km",
        "D": "6 km"
      },
      "answer": "B",
      "explanation": "Distance = (S1*S2 / (S2-S1)) * (Total time diff / 60) = (30/1) * (8/60) = 4 km.",
      "hash": "f7a45d02905d2ff0",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति 5 किमी/घंटा की गति से चलता है और अपने कार्यालय 6 मिनट देरी से पहुँचता है। यदि वह 6 किमी/घंटा की गति से चलता है, तो वह 2 मिनट जल्दी पहुँचता है। उसके कार्यालय की दूरी ज्ञात कीजिए।",
          "options": {
            "A": "3 किमी",
            "B": "4 किमी",
            "C": "5 किमी",
            "D": "6 किमी"
          },
          "explanation": "दूरी = (S1*S2 / (S2-S1)) * (कुल समय अंतर / 60) = (30/1) * (8/60) = 4 किमी।"
        }
      }
    },
