    {
      "id": "arithmetic-02-017",
      "number": 17,
      "question": "The ratio of two numbers is 5:6. If 8 is subtracted from each, the ratio becomes 4:5. Find the numbers.",
      "options": {
        "A": "40, 48",
        "B": "30, 36",
        "C": "20, 24",
        "D": "50, 60"
      },
      "answer": "A",
      "explanation": "(5x-8)/(6x-8) = 4/5 => 25x - 40 = 24x - 32 => x = 8. Numbers are 40 and 48.",
      "hash": "0460b301b84ff296",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का अनुपात 5:6 है। यदि प्रत्येक में से 8 घटाया जाता है, तो अनुपात 4:5 हो जाता है। संख्याएँ ज्ञात कीजिए।",
          "options": {
            "A": "40, 48",
            "B": "30, 36",
            "C": "20, 24",
            "D": "50, 60"
          },
          "explanation": "(5x-8)/(6x-8) = 4/5 => 25x - 40 = 24x - 32 => x = 8। संख्याएँ 40 और 48 हैं।"
        }
      }
    },
