      "question": "What is the unit digit in (7^105)?",
      "options": {
        "A": "1",
        "B": "3",
        "C": "7",
        "D": "9"
      },
      "answer": "C",
      "explanation": "Cycle of 7 is 7, 9, 3, 1. 105 mod 4 = 1. So, unit digit is 7^1 = 7.",
      "hash": "6308bddd22e14051",
      "translations": {
        "hi": {
          "question": "(7^105) में इकाई अंक क्या है?",
          "options": {
            "A": "1",
            "B": "3",
            "C": "7",
            "D": "9"
          },
          "explanation": "7 का चक्र 7, 9, 3, 1 है। 105 mod 4 = 1. अतः इकाई अंक 7^1 = 7 है।"
        }
      }
    },
