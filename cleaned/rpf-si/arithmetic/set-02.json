    {
      "id": "arithmetic-02-001",
      "number": 1,
      "question": "A sum of Rs. 1200 becomes Rs. 1320 in 2 years at simple interest. What is the rate of interest per annum?",
      "options": {
        "A": "4%",
        "B": "5%",
        "C": "6%",
        "D": "8%"
      },
      "answer": "B",
      "explanation": "SI = 1320 - 1200 = 120. R = (120 * 100) / (1200 * 2) = 5%.",
      "hash": "bd6242818c335649",
      "translations": {
        "hi": {
          "question": "1200 रुपये की राशि साधारण ब्याज पर 2 वर्षों में 1320 रुपये हो जाती है। वार्षिक ब्याज दर क्या है?",
          "options": {
            "A": "4%",
            "B": "5%",
            "C": "6%",
            "D": "8%"
          },
          "explanation": "SI = 1320 - 1200 = 120. R = (120 * 100) / (1200 * 2) = 5%."
        }
      }
    },
    {
      "id": "arithmetic-02-002",
      "number": 2,
      "question": "The price of sugar is increased by 25%. By how much percent must a housewife reduce her consumption so as not to increase the expenditure?",
      "options": {
        "A": "15%",
        "B": "20%",
        "C": "25%",
        "D": "30%"
      },
      "answer": "B",
      "explanation": "Reduction = [r / (100 + r)] * 100 = [25 / 125] * 100 = 20%.",
      "hash": "49d245597a3f0ddc",
      "translations": {
        "hi": {
          "question": "चीनी की कीमत में 25% की वृद्धि हुई है। एक गृहिणी को अपनी खपत में कितने प्रतिशत की कमी करनी चाहिए ताकि खर्च न बढ़े?",
          "options": {
            "A": "15%",
            "B": "20%",
            "C": "25%",
            "D": "30%"
          },
          "explanation": "कमी = [r / (100 + r)] * 100 = [25 / 125] * 100 = 20%."
        }
      }
    },
    {
      "id": "arithmetic-02-003",
      "number": 3,
      "question": "The LCM of two numbers is 480 and their HCF is 160. If one number is 480, find the other number.",
      "options": {
        "A": "160",
        "B": "320",
        "C": "480",
        "D": "640"
      },
      "answer": "A",
      "explanation": "Product of numbers = HCF * LCM. 480 * x = 160 * 480 => x = 160.",
      "hash": "e24e775792380c9d",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का LCM 480 है और उनका HCF 160 है। यदि एक संख्या 480 है, तो दूसरी संख्या ज्ञात कीजिए।",
          "options": {
            "A": "160",
            "B": "320",
            "C": "480",
            "D": "640"
          },
          "explanation": "संख्याओं का गुणनफल = HCF * LCM. 480 * x = 160 * 480 => x = 160."
        }
      }
    },
    {
      "id": "arithmetic-02-004",
      "number": 4,
      "question": "If A:B = 2:3 and B:C = 4:5, then A:B:C is?",
      "options": {
        "A": "8:12:15",
        "B": "2:3:5",
        "C": "8:10:15",
        "D": "4:6:15"
      },
      "answer": "A",
      "explanation": "Multiply A:B by 4 and B:C by 3 to equate B. 8:12 and 12:15.",
      "hash": "dde0655c396cbbf2",
      "translations": {
        "hi": {
          "question": "यदि A:B = 2:3 और B:C = 4:5 है, तो A:B:C क्या है?",
          "options": {
            "A": "8:12:15",
            "B": "2:3:5",
            "C": "8:10:15",
            "D": "4:6:15"
          },
          "explanation": "B को बराबर करने के लिए A:B को 4 से और B:C को 3 से गुणा करें। 8:12 और 12:15।"
        }
      }
    },
    {
      "id": "arithmetic-02-005",
      "number": 5,
      "question": "The mean of 5 observations is 60. If one observation is excluded, the mean becomes 55. What is the excluded observation?",
      "options": {
        "A": "70",
        "B": "80",
        "C": "90",
        "D": "100"
      },
      "answer": "B",
      "explanation": "Total = 5 * 60 = 300. New Total = 4 * 55 = 220. Excluded = 300 - 220 = 80.",
      "hash": "6251343b87c290a8",
      "translations": {
        "hi": {
          "question": "5 प्रेक्षणों का माध्य 60 है। यदि एक प्रेक्षण को हटा दिया जाए, तो माध्य 55 हो जाता है। हटाया गया प्रेक्षण क्या है?",
          "options": {
            "A": "70",
            "B": "80",
            "C": "90",
            "D": "100"
          },
          "explanation": "कुल = 5 * 60 = 300। नया कुल = 4 * 55 = 220। हटाया गया = 300 - 220 = 80।"
        }
      }
    },
    {
      "id": "arithmetic-02-006",
      "number": 6,
      "question": "A train covers 180 km in 3 hours. What is its speed in m/s?",
      "options": {
        "A": "15.6",
        "B": "16.66",
        "C": "20.22",
        "D": "25.5"
      },
      "answer": "B",
      "explanation": "Speed = 180/3 = 60 km/h. In m/s = 60 * (5/18) = 16.66 m/s.",
      "hash": "095dfb4f9a31d761",
      "translations": {
        "hi": {
          "question": "एक ट्रेन 3 घंटे में 180 किमी की दूरी तय करती है। मीटर/सेकंड में इसकी गति क्या है?",
          "options": {
            "A": "15.6",
            "B": "16.66",
            "C": "20.22",
            "D": "25.5"
          },
          "explanation": "गति = 180/3 = 60 किमी/घंटा। मीटर/सेकंड में = 60 * (5/18) = 16.66 मीटर/सेकंड।"
        }
      }
    },
    {
      "id": "arithmetic-02-007",
      "number": 7,
      "question": "A cycle is sold for Rs. 880 at a profit of 10%. Find its cost price.",
      "options": {
        "A": "700",
        "B": "750",
        "C": "800",
        "D": "820"
      },
      "answer": "C",
      "explanation": "CP = (SP * 100) / (100 + P%) = (880 * 100) / 110 = 800.",
      "hash": "1f22998091f787f4",
      "translations": {
        "hi": {
          "question": "एक साइकिल 10% के लाभ पर 880 रुपये में बेची जाती है। इसका क्रय मूल्य ज्ञात कीजिए।",
          "options": {
            "A": "700",
            "B": "750",
            "C": "800",
            "D": "820"
          },
          "explanation": "CP = (SP * 100) / (100 + P%) = (880 * 100) / 110 = 800."
        }
      }
    },
    {
      "id": "arithmetic-02-008",
      "number": 8,
      "question": "The perimeter of a rectangle is 60 cm and its length is 18 cm. Find its breadth.",
      "options": {
        "A": "10 cm",
        "B": "12 cm",
        "C": "15 cm",
        "D": "18 cm"
      },
      "answer": "B",
      "explanation": "2(l + b) = 60 => 18 + b = 30 => b = 12.",
      "hash": "c9161659cbfb5591",
      "translations": {
        "hi": {
          "question": "एक आयत का परिमाप 60 सेमी है और इसकी लंबाई 18 सेमी है। इसकी चौड़ाई ज्ञात कीजिए।",
          "options": {
            "A": "10 सेमी",
            "B": "12 सेमी",
            "C": "15 सेमी",
            "D": "18 सेमी"
          },
          "explanation": "2(l + b) = 60 => 18 + b = 30 => b = 12."
        }
      }
    },
    {
      "id": "arithmetic-02-009",
      "number": 9,
      "question": "A can do a piece of work in 12 days and B in 24 days. How many days will they take together?",
      "options": {
        "A": "6 days",
        "B": "8 days",
        "C": "10 days",
        "D": "12 days"
      },
      "answer": "B",
      "explanation": "(12 * 24) / (12 + 24) = 288 / 36 = 8 days.",
      "hash": "bb2b19890c2dd549",
      "translations": {
        "hi": {
          "question": "A एक काम को 12 दिनों में और B 24 दिनों में कर सकता है। वे दोनों मिलकर कितने दिन लेंगे?",
          "options": {
            "A": "6 दिन",
            "B": "8 दिन",
            "C": "10 दिन",
            "D": "12 दिन"
          },
          "explanation": "(12 * 24) / (12 + 24) = 288 / 36 = 8 दिन।"
        }
      }
    },
    {
      "id": "arithmetic-02-010",
      "number": 10,
      "question": "A bag contains 25p, 10p and 5p coins in the ratio 1:2:3. If their total value is Rs. 30, find the number of 5p coins.",
      "options": {
        "A": "50",
        "B": "100",
        "C": "150",
        "D": "200"
      },
      "answer": "C",
      "explanation": "25x + 20x + 15x = 3000 paise => 60x = 3000 => x = 50. 5p coins = 3 * 50 = 150.",
      "hash": "2dbd0655b1dad371",
      "translations": {
        "hi": {
          "question": "एक बैग में 25 पैसे, 10 पैसे और 5 पैसे के सिक्के 1:2:3 के अनुपात में हैं। यदि उनका कुल मूल्य 30 रुपये है, तो 5 पैसे के सिक्कों की संख्या ज्ञात कीजिए।",
          "options": {
            "A": "50",
            "B": "100",
            "C": "150",
            "D": "200"
          },
          "explanation": "25x + 20x + 15x = 3000 पैसे => 60x = 3000 => x = 50. 5p सिक्के = 3 * 50 = 150."
        }
      }
    },
    {
      "id": "arithmetic-02-011",
      "number": 11,
      "question": "If 3/5 of a number is 60, what is the number?",
      "options": {
        "A": "80",
        "B": "100",
        "C": "120",
        "D": "150"
      },
      "answer": "B",
      "explanation": "(3/5)x = 60 => x = 60 * 5 / 3 = 100.",
      "hash": "6fdfc57e0f0deee1",
      "translations": {
        "hi": {
          "question": "यदि किसी संख्या का 3/5 हिस्सा 60 है, तो वह संख्या क्या है?",
          "options": {
            "A": "80",
            "B": "100",
            "C": "120",
            "D": "150"
          },
          "explanation": "(3/5)x = 60 => x = 60 * 5 / 3 = 100."
        }
      }
    },
