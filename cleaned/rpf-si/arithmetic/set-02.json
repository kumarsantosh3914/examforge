    {
      "id": "arithmetic-02-015",
      "number": 15,
      "question": "A sum was put at simple interest at a certain rate for 2 years. Had it been put at 3% higher rate, it would have fetched Rs. 300 more. Find the sum.",
      "options": {
        "A": "4000",
        "B": "5000",
        "C": "6000",
        "D": "7500"
      },
      "answer": "B",
      "explanation": "Extra % = 2 * 3 = 6%. 6% of P = 300 => P = (300 * 100) / 6 = 5000.",
      "hash": "0539326249a2a7ca",
      "translations": {
        "hi": {
          "question": "एक राशि 2 वर्षों के लिए एक निश्चित दर पर साधारण ब्याज पर रखी गई थी। यदि इसे 3% अधिक दर पर रखा जाता, तो 300 रुपये अधिक प्राप्त होते। राशि ज्ञात कीजिए।",
          "options": {
            "A": "4000",
            "B": "5000",
            "C": "6000",
            "D": "7500"
          },
          "explanation": "अतिरिक्त % = 2 * 3 = 6%। P का 6% = 300 => P = (300 * 100) / 6 = 5000."
        }
      }
    },
