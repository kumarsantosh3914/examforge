        "hi": {
          "question": "यदि एक वृत्त का क्षेत्रफल 154 वर्ग सेमी है, तो इसकी परिधि ज्ञात कीजिए।",
          "options": {
            "A": "22 सेमी",
            "B": "44 सेमी",
            "C": "66 सेमी",
            "D": "88 सेमी"
          },
          "explanation": "pi*r^2 = 154 => r = 7. परिधि = 2*pi*r = 44 सेमी."
        }
      }
    },
