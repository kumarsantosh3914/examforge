    {
      "id": "arithmetic-02-026",
      "number": 26,
      "question": "If 10 workers can build a wall in 12 days, how many days will 8 workers take?",
      "options": {
        "A": "15 days",
        "B": "16 days",
        "C": "18 days",
        "D": "20 days"
      },
      "answer": "A",
      "explanation": "M1D1 = M2D2 => 10 * 12 = 8 * x => x = 120 / 8 = 15.",
      "hash": "c494a71892ae4a2e",
      "translations": {
        "hi": {
          "question": "यदि 10 मजदूर 12 दिनों में एक दीवार बना सकते हैं, तो 8 मजदूर कितने दिन लेंगे?",
          "options": {
            "A": "15 दिन",
            "B": "16 दिन",
            "C": "18 दिन",
            "D": "20 दिन"
          },
          "explanation": "M1D1 = M2D2 => 10 * 12 = 8 * x => x = 120 / 8 = 15."
        }
      }
    },
