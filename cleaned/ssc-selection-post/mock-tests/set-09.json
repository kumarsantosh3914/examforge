      "answer": "A",
      "explanation": "10 mod 7 = 3; Wednesday + 3 = Saturday.",
      "hash": "d643097a5cf18c3f"
    },
    {
      "id": "mock-tests-09-002",
      "number": 2,
      "question": "Which letter is 8th to the right of the 13th letter from the left in the English alphabet?",
