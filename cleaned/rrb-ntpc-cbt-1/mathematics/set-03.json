          "options": {
            "A": "3",
            "B": "4",
            "C": "5",
            "D": "2"
          },
          "explanation": "CP/टॉफी = 1/6। SP = (1/6) * 1.20 = 1/5। अतः 5 टॉफियां।"
        }
      }
    },
