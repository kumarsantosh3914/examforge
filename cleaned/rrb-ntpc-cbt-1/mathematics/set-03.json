        "hi": {
          "question": "A, B और C की कार्य क्षमता का अनुपात 2:3:5 है। यदि वे एक साथ कार्य करते हुए किसी कार्य को 6 दिनों में पूरा करते हैं, तो A अकेले उस कार्य का 20% कितने दिनों में पूरा करेगा?",
          "options": {
            "A": "8",
            "B": "6",
            "C": "5",
            "D": "4"
          },
          "explanation": "कुल कार्य = (2+3+5) * 6 = 60 इकाई। कार्य का 20% = 12 इकाई। A का समय = 12 / 2 = 6 दिन।"
        }
      }
    },
