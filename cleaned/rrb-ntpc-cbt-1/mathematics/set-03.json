    {
      "id": "mathematics-03-029",
      "number": 29,
      "question": "How many numbers between 400 and 800 are divisible by 4, 5, and 6?",
      "options": {
        "A": "7",
        "B": "6",
        "C": "8",
        "D": "9"
      },
      "answer": "A",
      "explanation": "LCM(4, 5, 6) = 60. Multiples: 420, 480, 540, 600, 660, 720, 780. Total 7.",
      "hash": "7107aacecfda7b11",
      "translations": {
        "hi": {
          "question": "400 और 800 के बीच कितनी संख्याएँ 4, 5 और 6 से विभाज्य हैं?",
          "options": {
            "A": "7",
            "B": "6",
            "C": "8",
            "D": "9"
          },
          "explanation": "LCM(4, 5, 6) = 60. 400 के बाद पहला = 420. अंतिम = 780. AP: 420...780. n = (780-420)/60 + 1 = 6+1 = 7."
        }
      }
    },
    {
      "id": "mathematics-03-030",
      "number": 30,
      "question": "If 2^x = 3^y = 6^-z, then what is the value of (1/x + 1/y + 1/z)?",
      "options": {
        "A": "0",
        "B": "1",
        "C": "3",
        "D": "-1"
      },
      "answer": "A",
      "explanation": "Let k. 2=k^(1/x), 3=k^(1/y), 6=k^(-1/z). 2*3=6 => k^(1/x)*k^(1/y) = k^(-1/z). 1/x + 1/y = -1/z => 1/x + 1/y + 1/z = 0.",
      "hash": "6aa78c77272c2fc4",
      "translations": {
        "hi": {
          "question": "यदि 2^x = 3^y = 6^-z है, तो (1/x + 1/y + 1/z) का मान क्या है?",
          "options": {
            "A": "0",
            "B": "1",
            "C": "3",
            "D": "-1"
          },
          "explanation": "माना k. 2=k^(1/x), 3=k^(1/y), 6=k^(-1/z). 2*3=6 => k^(1/x)*k^(1/y) = k^(-1/z). 1/x + 1/y = -1/z => 1/x + 1/y + 1/z = 0."
        }
      }
    }
  ]
