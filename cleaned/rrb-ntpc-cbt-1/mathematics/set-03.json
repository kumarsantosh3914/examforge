      "translations": {
        "hi": {
          "question": "A और B किसी व्यवसाय में 3:2 के अनुपात में निवेश करते हैं। कुल लाभ का 5% दान में जाता है और A का हिस्सा ₹855 है। कुल लाभ क्या है?",
          "options": {
            "A": "₹1425",
            "B": "₹1500",
            "C": "₹1600",
            "D": "₹1575"
          },
          "explanation": "शेष लाभ का A का हिस्सा = 3/5। कुल लाभ का (95/100) * (3/5) = 855. लाभ = 855 * 100 * 5 / (95 * 3) = ₹1500."
        }
      }
    },
    {
      "id": "mathematics-03-018",
      "number": 18,
      "question": "Fresh fruit contains 68% water and dry fruit contains 20% water. How much dry fruit can be obtained from 100 kg of fresh fruits?",
      "options": {
        "A": "32 kg",
        "B": "40 kg",
        "C": "50 kg",
        "D": "60 kg"
      },
      "answer": "B",
      "explanation": "Pulp remains constant. Pulp in fresh = 32%. 32% of 100 = 32 kg. Pulp in dry = 80%. 80% of x = 32 => x = 40 kg.",
      "hash": "7c3331dd35f051ec",
      "translations": {
        "hi": {
          "question": "ताजे फल में 68% पानी होता है और सूखे मेवे में 20% पानी होता है। 100 किलो ताजे फलों से कितने सूखे मेवे प्राप्त किए जा सकते हैं?",
          "options": {
            "A": "32 किलो",
            "B": "40 किलो",
            "C": "50 किलो",
            "D": "60 किलो"
          },
          "explanation": "गूदा (Pulp) समान रहता है। ताजे में गूदा = 32%। 100 का 32% = 32 किलो। सूखे में गूदा = 80%। x का 80% = 32 => x = 40 किलो।"
        }
      }
    },
