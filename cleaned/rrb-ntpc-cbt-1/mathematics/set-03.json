      "translations": {
        "hi": {
          "question": "यदि a² + b² + c² = ab + bc + ca है, तो (a+c)/b का मान क्या है?",
          "options": {
            "A": "1",
            "B": "2",
            "C": "0",
            "D": "3"
          },
          "explanation": "यह स्थिति तब संभव है जब a = b = c हो। अतः (a+a)/a = 2a/a = 2."
