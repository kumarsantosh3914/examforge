    {
      "id": "mathematics-02-001",
      "number": 1,
      "question": "The HCF of two numbers is 11 and their LCM is 7700. If one of the numbers is 275, then the other number is?",
      "options": {
        "A": "279",
        "B": "283",
        "C": "308",
        "D": "318"
      },
      "answer": "C",
      "explanation": "1st Number × 2nd Number = HCF × LCM. 275 × 2nd = 11 × 7700. 2nd = (11 × 7700) / 275 = 308.",
      "hash": "c148426e8b87a410",
      "translations": {
        "hi": {
          "question": "दो संख्याओं का महत्तम समापवर्तक (HCF) 11 है और उनका लघुत्तम समापवर्त्य (LCM) 7700 है। यदि एक संख्या 275 है, तो दूसरी संख्या क्या है?",
          "options": {
            "A": "279",
            "B": "283",
            "C": "308",
            "D": "318"
          },
          "explanation": "पहली संख्या × दूसरी संख्या = HCF × LCM. 275 × दूसरी = 11 × 7700. दूसरी = (11 × 7700) / 275 = 308."
        }
      }
    },
    {
      "id": "mathematics-02-002",
      "number": 2,
      "question": "If the Cost Price (CP) of 15 articles is equal to the Selling Price (SP) of 10 articles, what is the profit percentage?",
      "options": {
        "A": "30%",
        "B": "40%",
        "C": "50%",
        "D": "45%"
      },
      "answer": "C",
      "explanation": "15 CP = 10 SP => CP/SP = 10/15 = 2/3. Profit = 1. Profit % = (1/2) * 100 = 50%.",
      "hash": "2c83e9374fac289c",
      "translations": {
        "hi": {
          "question": "यदि 15 लेखों का क्रय मूल्य (CP) 10 लेखों के विक्रय मूल्य (SP) के बराबर है, तो लाभ प्रतिशत क्या है?",
          "options": {
            "A": "30%",
            "B": "40%",
            "C": "50%",
            "D": "45%"
          },
          "explanation": "15 CP = 10 SP => CP/SP = 10/15 = 2/3. लाभ = 1. लाभ % = (1/2) * 100 = 50%."
        }
      }
    },
    {
      "id": "mathematics-02-003",
      "number": 3,
      "question": "The diagonals of a rhombus are 16 cm and 12 cm. Find its area.",
      "options": {
        "A": "96 cm²",
        "B": "192 cm²",
        "C": "48 cm²",
        "D": "64 cm²"
      },
      "answer": "A",
      "explanation": "Area = (1/2) × d1 × d2 = (1/2) × 16 × 12 = 96 cm².",
      "hash": "77ebb5cd36eb6131",
      "translations": {
        "hi": {
          "question": "एक समचतुर्भुज (Rhombus) के विकर्ण 16 सेमी और 12 सेमी हैं। उसका क्षेत्रफल ज्ञात कीजिये।",
          "options": {
            "A": "96 सेमी²",
            "B": "192 सेमी²",
            "C": "48 सेमी²",
            "D": "64 सेमी²"
          },
          "explanation": "क्षेत्रफल = (1/2) × d1 × d2 = (1/2) × 16 × 12 = 96 सेमी²."
        }
      }
    },
    {
      "id": "mathematics-02-004",
      "number": 4,
      "question": "A speed of 45 km/hr is equal to what in meters/second?",
      "options": {
        "A": "10 m/s",
        "B": "12 m/s",
        "C": "12.5 m/s",
        "D": "15 m/s"
      },
      "answer": "C",
      "explanation": "Multiply by 5/18 to convert to m/s. 45 × (5/18) = 2.5 × 5 = 12.5 m/s.",
      "hash": "8bf709564ac01bc2",
      "translations": {
        "hi": {
          "question": "45 किमी/घंटा की गति, मीटर/सेकंड में किसके बराबर है?",
          "options": {
            "A": "10 मी/से",
            "B": "12 मी/से",
            "C": "12.5 मी/से",
            "D": "15 मी/से"
          },
          "explanation": "मी/से में बदलने के लिए 5/18 से गुणा करें। 45 × (5/18) = 2.5 × 5 = 12.5 मी/से।"
        }
      }
    },
    {
