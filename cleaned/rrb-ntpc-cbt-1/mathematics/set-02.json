    {
      "id": "mathematics-02-022",
      "number": 22,
      "question": "A bag contains coins of ₹1, 50p, and 25p in the ratio 5:6:8. If the total amount is ₹240, find the number of 25p coins.",
      "options": {
        "A": "96",
        "B": "120",
        "C": "160",
        "D": "192"
      },
      "answer": "D",
      "explanation": "Value ratio = 5(1) : 6(0.5) : 8(0.25) = 5 : 3 : 2. Total units = 10. 10 units = 240, 1 unit = 24. Value of 25p = 2×24 = 48 Rs. Coins = 48 × 4 = 192.",
      "hash": "925065c09195f08d",
      "translations": {
        "hi": {
          "question": "एक बैग में ₹1, 50 पैसे और 25 पैसे के सिक्के 5:6:8 के अनुपात में हैं। यदि कुल राशि ₹240 है, तो 25 पैसे के सिक्कों की संख्या ज्ञात कीजिये।",
          "options": {
            "A": "96",
            "B": "120",
            "C": "160",
            "D": "192"
          },
          "explanation": "मूल्य अनुपात = 5(1) : 6(0.5) : 8(0.25) = 5 : 3 : 2। कुल अनुपात = 10। 10 इकाई = 240, 1 इकाई = 24। 25p का मूल्य = 2×24 = 48 रुपये। सिक्के = 48 × 4 = 192।"
        }
      }
    },
    {
      "id": "mathematics-02-023",
      "number": 23,
      "question": "Find the distance between points (2, 3) and (4, 1).",
      "options": {
        "A": "2",
        "B": "2√2",
        "C": "4",
        "D": "√8"
      },
      "answer": "B",
      "explanation": "Distance = √[(x2-x1)² + (y2-y1)²] = √[(4-2)² + (1-3)²] = √(4+4) = √8 = 2√2.",
      "hash": "5ff54a12e29f7df9",
      "translations": {
        "hi": {
          "question": "बिंदुओं (2, 3) और (4, 1) के बीच की दूरी ज्ञात कीजिये।",
          "options": {
            "A": "2",
            "B": "2√2",
            "C": "4",
            "D": "√8"
          },
          "explanation": "दूरी = √[(x2-x1)² + (y2-y1)²] = √[(4-2)² + (1-3)²] = √(4+4) = √8 = 2√2."
        }
      }
    },
