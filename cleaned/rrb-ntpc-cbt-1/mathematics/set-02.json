          "options": {
            "A": "10%",
            "B": "5%",
            "C": "15%",
            "D": "20%"
          },
          "explanation": "ब्याज = 2P (क्योंकि मिश्रधन 3P है)। SI = (P×R×T)/100. 2P = (P×R×20)/100 => R = 10%."
        }
      }
