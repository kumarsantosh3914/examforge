      "hash": "66aef57ea6356070",
      "translations": {
        "hi": {
          "question": "एक बॉक्स में 3 नीली, 2 सफेद और 4 लाल गेंदें हैं। यदि एक गेंद यादृच्छिक रूप से (randomly) निकाली जाती है, तो उसके सफेद होने की प्रायिकता क्या है?",
          "options": {
            "A": "2/9",
            "B": "1/3",
            "C": "4/9",
            "D": "2/7"
          },
          "explanation": "कुल गेंदें = 3 + 2 + 4 = 9। सफेद गेंदें = 2। प्रायिकता = 2/9।"
        }
      }
    }
