      "hash": "16f9a22b3f12f4a9",
      "translations": {
        "hi": {
          "question": "यदि A:B = 3:4 और B:C = 8:9 है, तो A:C ज्ञात कीजिये।",
          "options": {
            "A": "1:2",
            "B": "3:2",
            "C": "1:3",
            "D": "2:3"
          },
          "explanation": "A/C = (A/B) × (B/C) = (3/4) × (8/9) = 24/36 = 2/3. अनुपात 2:3 है।"
        }
      }
    },
    {
      "id": "mathematics-02-006",
      "number": 6,
      "question": "In what time will ₹800 become ₹926.10 at 10% p.a. compound interest, compounded semi-annually?",
      "options": {
        "A": "1.5 years",
        "B": "2 years",
        "C": "2.5 years",
        "D": "3 years"
      },
      "answer": "A",
      "explanation": "Semi-annual rate = 5%. A = P(1 + R/100)^n. 926.1/800 = (21/20)^n => (21/20)^3 = (21/20)^n. n = 3 half-years = 1.5 years.",
      "hash": "e26a8ee1f7bb462c",
      "translations": {
        "hi": {
          "question": "कितने समय में ₹800 की राशि 10% प्रति वर्ष चक्रवृद्धि ब्याज की दर से ₹926.10 हो जाएगी, यदि ब्याज अर्धवार्षिक रूप से संयोजित होता है?",
          "options": {
            "A": "1.5 वर्ष",
            "B": "2 वर्ष",
            "C": "2.5 वर्ष",
            "D": "3 वर्ष"
          },
          "explanation": "अर्धवार्षिक दर = 5%. A = P(1 + R/100)^n. 926.1/800 = (21/20)^n => (21/20)^3 = (21/20)^n. n = 3 छमाही = 1.5 वर्ष।"
        }
      }
    },
