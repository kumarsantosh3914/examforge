      "id": "mathematics-02-027",
      "number": 27,
      "question": "What is the smallest number which when divided by 8, 9, 12, 15 leaves a remainder 1 every time?",
      "options": {
        "A": "179",
        "B": "181",
        "C": "359",
        "D": "361"
      },
      "answer": "D",
      "explanation": "LCM (8, 9, 12, 15) = 360. Required Number = 360 + 1 = 361.",
      "hash": "a57a06436a3f97c3",
      "translations": {
        "hi": {
          "question": "वह सबसे छोटी संख्या कौन सी है जिसे 8, 9, 12, 15 से विभाजित करने पर हर बार 1 शेष बचे?",
          "options": {
            "A": "179",
            "B": "181",
            "C": "359",
            "D": "361"
          },
          "explanation": "LCM (8, 9, 12, 15) = 360. अभीष्ट संख्या = 360 + 1 = 361."
        }
      }
    },
    {
      "id": "mathematics-02-028",
      "number": 28,
      "question": "A cricket player has a certain average for 10 innings. In the 11th inning, he scored 108 runs, thereby increasing his average by 6 runs. What is his new average?",
      "options": {
        "A": "48",
        "B": "60",
        "C": "52",
        "D": "42"
      },
      "answer": "A",
      "explanation": "New Average = Runs - (Old Innings × Increase) = 108 - (10 × 6) = 108 - 60 = 48.",
      "hash": "eba0bc900ec7f5f4",
      "translations": {
        "hi": {
          "question": "एक क्रिकेट खिलाड़ी का 10 पारियों का एक निश्चित औसत है। 11वीं पारी में उसने 108 रन बनाए, जिससे उसका औसत 6 रन बढ़ गया। उसका नया औसत क्या है?",
          "options": {
            "A": "48",
            "B": "60",
            "C": "52",
            "D": "42"
          },
          "explanation": "नया औसत = रन - (पुरानी पारी × वृद्धि) = 108 - (10 × 6) = 108 - 60 = 48।"
        }
      }
    },
    {
      "id": "mathematics-02-029",
      "number": 29,
      "question": "The radius of a semicircle is 14 cm. Find its perimeter.",
      "options": {
        "A": "36 cm",
        "B": "44 cm",
        "C": "72 cm",
        "D": "88 cm"
      },
      "answer": "C",
      "explanation": "Perimeter of semicircle = πr + 2r = (22/7)×14 + 28 = 44 + 28 = 72 cm.",
      "hash": "455debc5ed9a2be9",
      "translations": {
        "hi": {
          "question": "एक अर्धवृत्त (Semicircle) की त्रिज्या 14 सेमी है। इसका परिमाप ज्ञात कीजिये।",
          "options": {
            "A": "36 सेमी",
            "B": "44 सेमी",
            "C": "72 सेमी",
            "D": "88 सेमी"
          },
          "explanation": "अर्धवृत्त का परिमाप = πr + 2r = (22/7)×14 + 28 = 44 + 28 = 72 सेमी।"
        }
      }
    },
