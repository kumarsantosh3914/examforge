      "hash": "459a6d1d4704d9a6",
      "translations": {
        "hi": {
          "question": "यदि x + 1/x = 2 है, तो x¹⁰⁰ + 1/x¹⁰⁰ का मान क्या है?",
          "options": {
            "A": "0",
            "B": "1",
            "C": "2",
            "D": "100"
          },
          "explanation": "यदि x + 1/x = 2, तो x = 1 होता है। अतः 1 + 1 = 2."
        }
      }
    },
    {
      "id": "mathematics-02-025",
      "number": 25,
      "question": "A car covers a certain distance at 20 km/hr and returns at 30 km/hr. What is the average speed for the whole journey?",
      "options": {
        "A": "25 km/hr",
        "B": "24 km/hr",
        "C": "26 km/hr",
        "D": "22 km/hr"
      },
      "answer": "B",
      "explanation": "Average Speed = (2xy)/(x+y) = (2 × 20 × 30) / (20 + 30) = 1200 / 50 = 24 km/hr.",
      "hash": "2610ac487158cfb4",
      "translations": {
        "hi": {
          "question": "एक कार 20 किमी/घंटा की गति से एक निश्चित दूरी तय करती है और 30 किमी/घंटा की गति से वापस आती है। पूरी यात्रा के लिए औसत गति क्या है?",
          "options": {
            "A": "25 किमी/घंटा",
            "B": "24 किमी/घंटा",
            "C": "26 किमी/घंटा",
            "D": "22 किमी/घंटा"
          },
          "explanation": "औसत गति = (2xy)/(x+y) = (2 × 20 × 30) / (20 + 30) = 1200 / 50 = 24 किमी/घंटा।"
        }
      }
    },
