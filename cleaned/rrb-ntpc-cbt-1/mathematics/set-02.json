      "translations": {
        "hi": {
          "question": "एक कक्षा में 24 छात्रों का औसत वजन 35 किलो है। यदि शिक्षक का वजन भी शामिल कर लिया जाए, तो औसत 400 ग्राम बढ़ जाता है। शिक्षक का वजन क्या है?",
          "options": {
            "A": "45 किलो",
            "B": "50 किलो",
            "C": "55 किलो",
            "D": "60 किलो"
          },
          "explanation": "कुल वृद्धि = 25 लोग × 0.4 किलो = 10 किलो। शिक्षक का वजन = 35 + 10 = 45 किलो।"
        }
      }
    },
