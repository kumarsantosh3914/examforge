    {
      "id": "mathematics-05-019",
      "number": 19,
      "question": "Average of 3 numbers is 15. If average of first two is 14, what is the 3rd number?",
      "options": {
        "A": "17",
        "B": "16",
        "C": "15",
        "D": "18"
      },
      "answer": "A",
      "explanation": "Sum = 3×15 = 45. Sum of two = 2×14 = 28. Third = 45 - 28 = 17.",
      "hash": "78483878eda1c42c",
      "translations": {
        "hi": {
          "question": "3 संख्याओं का औसत 15 है। यदि पहली दो संख्याओं का औसत 14 है, तो तीसरी संख्या क्या है?",
          "options": {
            "A": "17",
            "B": "16",
            "C": "15",
            "D": "18"
          },
          "explanation": "योग = 3×15 = 45। दो का योग = 2×14 = 28। तीसरी = 45 - 28 = 17।"
        }
      }
    },
