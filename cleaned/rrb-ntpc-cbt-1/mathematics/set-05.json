      "translations": {
        "hi": {
          "question": "दो संख्याओं का अनुपात 3:5 है। यदि प्रत्येक में 9 घटाया जाए, तो अनुपात 12:23 हो जाता है। छोटी संख्या क्या है?",
          "options": {
            "A": "33",
            "B": "27",
            "C": "45",
            "D": "55"
          },
          "explanation": "(3x-9)/(5x-9) = 12/23. 69x - 207 = 60x - 108. 9x = 99 => x = 11. छोटी संख्या = 33।"
        }
      }
