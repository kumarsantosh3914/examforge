    {
      "id": "mathematics-05-016",
      "number": 16,
      "question": "A bag contains 4 red, 5 green, 6 blue balls. If 3 balls are drawn randomly, what is the probability they are of different colors?",
      "options": {
        "A": "24/91",
        "B": "12/91",
        "C": "4/13",
        "D": "8/91"
      },
      "answer": "A",
      "explanation": "Total = 15C3 = 455. Favorable = 4C1 × 5C1 × 6C1 = 4×5×6 = 120. Prob = 120/455 = 24/91.",
      "hash": "b7555156b68d3d5b",
      "translations": {
        "hi": {
          "question": "एक थैले में 4 लाल, 5 हरी और 6 नीली गेंदें हैं। यदि 3 गेंदें यादृच्छिक रूप से निकाली जाती हैं, तो उनके अलग-अलग रंगों के होने की प्रायिकता क्या है?",
          "options": {
            "A": "24/91",
            "B": "12/91",
            "C": "4/13",
            "D": "8/91"
          },
          "explanation": "कुल = 15C3 = 455। अनुकूल = 4C1 × 5C1 × 6C1 = 4×5×6 = 120। प्रायिकता = 120/455 = 24/91।"
        }
      }
    },
