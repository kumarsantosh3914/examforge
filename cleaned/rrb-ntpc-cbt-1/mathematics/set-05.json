      "id": "mathematics-05-030",
      "number": 30,
      "question": "A 150m long train crosses a telegraph post in 12 seconds. Speed of train (in km/hr)?",
      "options": {
        "A": "45",
        "B": "50",
        "C": "54",
        "D": "60"
      },
      "answer": "A",
      "explanation": "Speed = 150/12 m/s = 12.5 m/s. km/hr = 12.5 × 18/5 = 2.5 × 18 = 45.",
      "hash": "b9830c86e3dc8219",
      "translations": {
        "hi": {
          "question": "एक 150 मीटर लंबी ट्रेन एक टेलीग्राफ पोस्ट को 12 सेकंड में पार करती है। ट्रेन की गति (किमी/घंटा में) क्या है?",
          "options": {
            "A": "45",
            "B": "50",
            "C": "54",
            "D": "60"
          },
          "explanation": "गति = 150/12 मी/से = 12.5 मी/से। किमी/घंटा = 12.5 × 18/5 = 2.5 × 18 = 45।"
        }
      }
    }
  ]
