{
  "name": "examforge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --env-file-if-exists=.env.local --test tests/integration/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env.local tests/e2e/flow.mjs",
    "seed": "node --import tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "validate": "npm run validate:data && npm run lint && npm run typecheck && npm test",
    "expire": "node --import tsx --env-file-if-exists=.env.local scripts/expire.ts",
    "db:inspect": "node --import tsx --env-file-if-exists=.env.local scripts/inspect-db.ts"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "mongodb": "7.5.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "typescript-eslint": "8.70.1",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "bson": "7.3.2"
  },
  "type": "module"
}
