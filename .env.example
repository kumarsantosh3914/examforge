# Server only. Use a dedicated development/test database with this supplied cluster.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
MONGODB_DB=examforge_dev
APP_ORIGIN=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
QUESTION_BANK_DIR=cleaned
# Only enable behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Optional: integration tests use this URI and an isolated disposable database.
TEST_MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
# Optional: Google Search Console HTML-tag verification code (content="..." value only).
# Not needed when verifying the domain with a DNS TXT record.
GOOGLE_SITE_VERIFICATION=
