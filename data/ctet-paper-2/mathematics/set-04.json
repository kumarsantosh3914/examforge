      "id": "mathematics-04-001",
      "number": 1,
      "question": "Which of the following is a prime number?",
      "options": {
        "A": "1",
        "B": "23",
        "C": "33",
        "D": "51"
      },
      "answer": "B",
      "explanation": "23 has only two factors: 1 and 23.",
      "hash": "0c9a29e75a41a695",
      "translations": {
        "hi": {
          "question": "निम्नलिखित में से कौन सी एक अभाज्य संख्या है?",
          "options": {
            "A": "1",
            "B": "23",
            "C": "33",
            "D": "51"
          },
          "explanation": "23 के केवल दो गुणनखंड हैं: 1 और 23।"
        }
      }
    },
    {
      "id": "mathematics-04-002",
      "number": 2,
      "question": "In a five-digit number, the digit at the tens place is 4, the digit at units place is half of the tens place digit, the digit at thousands place is 0, the digit at hundreds place is twice the tens place digit, and the ten-thousands digit is the sum of units and tens place digits. What is the number?",
      "options": {
        "A": "60842",
        "B": "40842",
        "C": "60442",
        "D": "60824"
      },
      "answer": "A",
      "explanation": "Units=2, Tens=4, Hundreds=8, Thousands=0, Ten-thousands=6.",
      "hash": "15202208d20f69f2",
      "translations": {
        "hi": {
          "question": "एक पांच अंकीय संख्या में, दहाई के स्थान का अंक 4 है, इकाई के स्थान का अंक दहाई के स्थान के अंक का आधा है, हजार के स्थान का अंक 0 है, सैकड़े के स्थान का अंक दहाई के स्थान के अंक का दोगुना है, और दस-हजार का अंक इकाई और दहाई के अंकों का योग है। संख्या क्या है?",
          "options": {
            "A": "60842",
            "B": "40842",
            "C": "60442",
            "D": "60824"
          },
          "explanation": "इकाई=2, दहाई=4, सैकड़ा=8, हजार=0, दस-हजार=6।"
        }
      }
    },
    {
      "id": "mathematics-04-003",
      "number": 3,
      "question": "A square has a perimeter of 48 cm. A rectangle has the same perimeter. If the length of the rectangle is 14 cm, what is its area?",
      "options": {
        "A": "140 sq cm",
        "B": "144 sq cm",
        "C": "120 sq cm",
        "D": "130 sq cm"
      },
      "answer": "A",
      "explanation": "Perimeter=48, 2(14+B)=48 -> 14+B=24 -> B=10. Area=14*10=140.",
      "hash": "d7cef2f1b6d0b730",
      "translations": {
        "hi": {
          "question": "एक वर्ग का परिमाप 48 सेमी है। एक आयत का परिमाप भी समान है। यदि आयत की लंबाई 14 सेमी है, तो इसका क्षेत्रफल क्या है?",
          "options": {
            "A": "140 वर्ग सेमी",
            "B": "144 वर्ग सेमी",
            "C": "120 वर्ग सेमी",
            "D": "130 वर्ग सेमी"
          },
          "explanation": "परिमाप=48, 2(14+B)=48 -> B=10। क्षेत्रफल=14*10=140।"
        }
      }
    },
