    {
      "id": "mathematics-04-005",
      "number": 5,
      "question": "A wire of length 88 cm is bent to form a circle. What is the diameter of the circle? (pi = 22/7)",
      "options": {
        "A": "14 cm",
        "B": "28 cm",
        "C": "7 cm",
        "D": "44 cm"
      },
      "answer": "B",
      "explanation": "Circumference = 88. pi*d = 88 -> (22/7)*d = 88 -> d = 28.",
      "hash": "e58123a9c44212a3",
      "translations": {
        "hi": {
          "question": "88 सेमी लंबे एक तार को मोड़कर एक वृत्त बनाया जाता है। वृत्त का व्यास क्या है? (pi = 22/7)",
          "options": {
            "A": "14 सेमी",
            "B": "28 सेमी",
            "C": "7 सेमी",
            "D": "44 सेमी"
          },
          "explanation": "परिधि = 88। pi*d = 88 -> (22/7)*d = 88 -> d = 28।"
        }
      }
    },
