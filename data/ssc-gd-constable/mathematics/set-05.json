    {
      "id": "mathematics-05-019",
      "number": 19,
      "question": "What will be the Compound Interest (CI) on Rs 6400 at 12.5% per annum for 2 years?",
      "options": {
        "A": "1600",
        "B": "1700",
        "C": "1500",
        "D": "1800"
      },
      "answer": "B",
      "explanation": "12.5% = 1/8. Amount = 6400 × (9/8) × (9/8) = 8100. CI = 8100 - 6400 = 1700",
      "hash": "a27cff1bef288e9a",
      "translations": {
        "hi": {
          "question": "6400 रुपये पर 12.5% वार्षिक दर से 2 वर्ष का चक्रवृद्धि ब्याज (CI) क्या होगा?",
          "options": {
            "A": "1600",
            "B": "1700",
            "C": "1500",
            "D": "1800"
          },
          "explanation": "12.5% = 1/8। मिश्रधन = 6400 × (9/8) × (9/8) = 8100। CI = 8100 - 6400 = 1700"
        }
      }
    },
