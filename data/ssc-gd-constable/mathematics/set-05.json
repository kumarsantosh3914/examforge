    {
      "id": "mathematics-05-015",
      "number": 15,
      "question": "If 5 men can build a wall in 14 days, in how many days will 7 men build the same wall?",
      "options": {
        "A": "8 days",
        "B": "10 days",
        "C": "12 days",
        "D": "7 days"
      },
      "answer": "B",
      "explanation": "M1D1 = M2D2 => 5 × 14 = 7 × D2 => 70 = 7D2 => D2 = 10",
      "hash": "084e3889329cde91",
      "translations": {
        "hi": {
          "question": "यदि 5 आदमी एक दीवार को 14 दिनों में बना सकते हैं, तो 7 आदमी उसी दीवार को कितने दिनों में बनाएंगे?",
          "options": {
            "A": "8 दिन",
            "B": "10 दिन",
            "C": "12 दिन",
            "D": "7 दिन"
          },
          "explanation": "M1D1 = M2D2 => 5 × 14 = 7 × D2 => 70 = 7D2 => D2 = 10"
        }
      }
    },
    {
      "id": "mathematics-05-016",
      "number": 16,
      "question": "The hypotenuse of a right angled triangle is 10 cm and one side is 8 cm. Find the length of the other side.",
      "options": {
        "A": "4 cm",
        "B": "6 cm",
        "C": "5 cm",
        "D": "7 cm"
      },
      "answer": "B",
      "explanation": "Pythagoras theorem: √(10² - 8²) = √(100 - 64) = √36 = 6",
      "hash": "7f61e1868b406263",
      "translations": {
        "hi": {
          "question": "एक समकोण त्रिभुज (Right angled triangle) का कर्ण 10 सेमी और एक भुजा 8 सेमी है। दूसरी भुजा की लंबाई ज्ञात करें।",
          "options": {
            "A": "4 सेमी",
            "B": "6 सेमी",
            "C": "5 सेमी",
            "D": "7 सेमी"
          },
          "explanation": "पाइथागोरस प्रमेय: √(10² - 8²) = √(100 - 64) = √36 = 6"
        }
      }
    },
