      "question": "Simplify: (256)^0.16 × (256)^0.09",
      "options": {
        "A": "4",
        "B": "16",
        "C": "64",
        "D": "256.25"
      },
      "answer": "A",
      "explanation": "Exponents add up: 256^(0.25) = 256^(1/4) = 4",
      "hash": "a0503f256e926f96",
      "translations": {
        "hi": {
          "question": "सरल करें: (256)^0.16 × (256)^0.09",
          "options": {
            "A": "4",
            "B": "16",
            "C": "64",
            "D": "256.25"
          },
          "explanation": "घातांक जुड़ जाएंगे: 256^(0.25) = 256^(1/4) = 4"
        }
      }
    },
    {
      "id": "mathematics-05-005",
      "number": 5,
      "question": "A man saves 15% of his monthly income. If his expenditure is Rs 1700, what is his monthly income?",
      "options": {
        "A": "2000",
        "B": "2500",
        "C": "3000",
        "D": "3400"
      },
      "answer": "A",
      "explanation": "Expenditure = 100 - 15 = 85%. 85% = 1700. 100% = (1700/85) × 100 = 20 × 100 = 2000",
      "hash": "d745c565ed5eea6e",
      "translations": {
        "hi": {
          "question": "एक व्यक्ति अपनी मासिक आय का 15% बचाता है। यदि उसका खर्च 1700 रुपये है, तो उसकी मासिक आय क्या है?",
          "options": {
            "A": "2000",
            "B": "2500",
            "C": "3000",
            "D": "3400"
          },
          "explanation": "खर्च = 100 - 15 = 85%। 85% = 1700। 100% = (1700/85) × 100 = 20 × 100 = 2000"
        }
      }
    },
    {
      "id": "mathematics-05-006",
      "number": 6,
      "question": "A car covers a certain distance at 60 km/hr and returns at 40 km/hr. What is the average speed of the whole journey?",
      "options": {
        "A": "50 km/hr",
        "B": "48 km/hr",
        "C": "52 km/hr",
        "D": "45 km/hr"
      },
      "answer": "B",
      "explanation": "Average Speed = (2xy)/(x+y) = (2×60×40)/(60+40) = 4800/100 = 48 km/hr",
      "hash": "30e7a2fea7b372fb",
      "translations": {
        "hi": {
          "question": "एक कार 60 किमी/घंटा की गति से एक निश्चित दूरी तय करती है और 40 किमी/घंटा की गति से वापस आती है। पूरी यात्रा की औसत गति क्या है?",
          "options": {
            "A": "50 किमी/घंटा",
            "B": "48 किमी/घंटा",
            "C": "52 किमी/घंटा",
            "D": "45 किमी/घंटा"
          },
          "explanation": "औसत गति = (2xy)/(x+y) = (2×60×40)/(60+40) = 4800/100 = 48 किमी/घंटा"
        }
      }
    },
    {
      "id": "mathematics-05-007",
      "number": 7,
      "question": "If the Simple Interest on Rs 600 for 4 years is Rs 120, what is the rate of interest?",
      "options": {
        "A": "4%",
        "B": "5%",
        "C": "6%",
        "D": "3%"
      },
      "answer": "B",
      "explanation": "Rate = (100 × SI) / (P × T) = (100 × 120) / (600 × 4) = 12000 / 2400 = 5%",
      "hash": "d0f74181ecb7477b",
      "translations": {
        "hi": {
          "question": "यदि 600 रुपये का 4 साल का साधारण ब्याज 120 रुपये है, तो ब्याज की दर क्या है?",
          "options": {
            "A": "4%",
            "B": "5%",
            "C": "6%",
            "D": "3%"
          },
          "explanation": "दर = (100 × SI) / (P × T) = (100 × 120) / (600 × 4) = 12000 / 2400 = 5%"
        }
      }
    },
