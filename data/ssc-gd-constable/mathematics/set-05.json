        "hi": {
          "question": "52 ताश के पत्तों की गड्डी से एक पत्ता निकाला जाता है। इसके इक्का (Ace) होने की प्रायिकता (probability) क्या है?",
          "options": {
            "A": "1/13",
            "B": "1/4",
            "C": "1/52",
            "D": "4/13"
