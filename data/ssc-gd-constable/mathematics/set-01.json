      "translations": {
        "hi": {
          "question": "A : B = 3 : 4 और B : C = 8 : 9 है, तो A : C ज्ञात करें।",
          "options": {
            "A": "1:2",
            "B": "3:8",
            "C": "2:3",
            "D": "1:3"
          },
          "explanation": "A/C = (A/B) * (B/C) = (3/4) * (8/9) = 24/36 = 2/3. अनुपात 2:3 है।"
        }
      }
    },
