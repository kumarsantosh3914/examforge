    {
      "id": "mathematics-01-010",
      "number": 10,
      "question": "What will be the Simple Interest on Rs 5000 at 10% per annum for 2 years?",
      "options": {
        "A": "500",
        "B": "1000",
        "C": "1500",
        "D": "2000"
      },
      "answer": "B",
      "explanation": "SI = (P*R*T)/100 = (5000*10*2)/100 = 1000",
      "hash": "6f1345e33bc321c0",
      "translations": {
        "hi": {
          "question": "5000 रुपये पर 10% प्रति वर्ष की दर से 2 वर्षों का साधारण ब्याज क्या होगा?",
          "options": {
            "A": "500",
            "B": "1000",
            "C": "1500",
            "D": "2000"
          },
          "explanation": "SI = (P*R*T)/100 = (5000*10*2)/100 = 1000"
        }
      }
    },
    {
      "id": "mathematics-01-011",
      "number": 11,
      "question": "A 200m long train is running at a speed of 36 km/hr. How much time will it take to cross a pole?",
      "options": {
        "A": "10 sec",
        "B": "20 sec",
        "C": "15 sec",
        "D": "25 sec"
      },
      "answer": "B",
      "explanation": "Speed = 36 * (5/18) = 10 m/s. Time = Distance/Speed = 200/10 = 20 seconds.",
      "hash": "877f3b227ad6c92c",
      "translations": {
        "hi": {
          "question": "एक 200 मीटर लंबी ट्रेन 36 किमी/घंटा की गति से चल रही है। एक खंभे को पार करने में उसे कितना समय लगेगा?",
          "options": {
            "A": "10 सेकंड",
            "B": "20 सेकंड",
            "C": "15 सेकंड",
            "D": "25 सेकंड"
          },
          "explanation": "गति = 36 * (5/18) = 10 मी/से। समय = दूरी/गति = 200/10 = 20 सेकंड।"
        }
      }
    },
