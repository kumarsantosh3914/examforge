        "hi": {
          "question": "10% और 20% की दो क्रमिक छूट (successive discounts) किस एकल छूट के बराबर हैं?",
          "options": {
            "A": "30%",
            "B": "28%",
            "C": "25%",
            "D": "32%"
          },
          "explanation": "सूत्र: x + y - (xy/100) = 10 + 20 - (200/100) = 30 - 2 = 28%"
        }
      }
