    {
      "id": "mathematics-01-018",
      "number": 18,
      "question": "If 12 men can do a work in 10 days, then in how many days will 8 men do the same work?",
      "options": {
        "A": "12 days",
        "B": "15 days",
        "C": "18 days",
        "D": "20 days"
      },
      "answer": "B",
      "explanation": "M1 × D1 = M2 × D2 => 12 × 10 = 8 × D2 => 120 = 8 × D2 => D2 = 15",
      "hash": "fc8750485aca611c",
      "translations": {
        "hi": {
          "question": "यदि 12 आदमी एक काम को 10 दिनों में कर सकते हैं, तो उसी काम को 8 आदमी कितने दिनों में करेंगे?",
          "options": {
            "A": "12 दिन",
            "B": "15 दिन",
            "C": "18 दिन",
            "D": "20 दिन"
          },
          "explanation": "M1 × D1 = M2 × D2 => 12 × 10 = 8 × D2 => 120 = 8 × D2 => D2 = 15"
        }
      }
    },
    {
      "id": "mathematics-01-019",
      "number": 19,
      "question": "What will be the Compound Interest (CI) on Rs 3000 at 10% per annum for 2 years?",
      "options": {
        "A": "300",
        "B": "600",
        "C": "630",
        "D": "660"
      },
      "answer": "C",
      "explanation": "Amount = 3000 * (1.1)^2 = 3000 * 1.21 = 3630. CI = 3630 - 3000 = 630",
      "hash": "65b4f1920b493e7c",
      "translations": {
        "hi": {
          "question": "3000 रुपये पर 10% वार्षिक दर से 2 वर्ष का चक्रवृद्धि ब्याज (CI) क्या होगा?",
          "options": {
            "A": "300",
            "B": "600",
            "C": "630",
            "D": "660"
          },
          "explanation": "मिश्रधन = 3000 * (1.1)^2 = 3000 * 1.21 = 3630. CI = 3630 - 3000 = 630"
        }
      }
    },
    {
      "id": "mathematics-01-020",
      "number": 20,
      "question": "The radius of a circle is 7 cm. What is its circumference? (Take π = 22/7)",
      "options": {
        "A": "22 cm",
        "B": "44 cm",
        "C": "66 cm",
        "D": "88 cm"
      },
      "answer": "B",
      "explanation": "Circumference = 2πr = 2 * (22/7) * 7 = 44 cm",
      "hash": "50f6ed7c91daf728",
      "translations": {
        "hi": {
          "question": "एक वृत्त (circle) की त्रिज्या 7 सेमी है। इसकी परिधि (circumference) क्या है? (π = 22/7)",
          "options": {
            "A": "22 सेमी",
            "B": "44 सेमी",
            "C": "66 सेमी",
            "D": "88 सेमी"
          },
          "explanation": "परिधि = 2πr = 2 * (22/7) * 7 = 44 सेमी"
        }
      }
    }
  ]
