      "hash": "d117e80f694c95ce",
      "translations": {
        "hi": {
          "question": "4, 8 और 12 का चौथा समानुपाती (fourth proportional) ज्ञात करें।",
          "options": {
            "A": "16",
            "B": "20",
            "C": "24",
            "D": "32"
          },
          "explanation": "4:8 :: 12:x => 4x = 8 × 12 => x = 96 / 4 = 24"
        }
      }
    },
