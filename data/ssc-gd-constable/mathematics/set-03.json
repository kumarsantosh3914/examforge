      "question": "What is the sum of the first 10 whole numbers?",
      "options": {
        "A": "45",
        "B": "50",
        "C": "55",
        "D": "40"
      },
      "answer": "A",
      "explanation": "First 10 whole numbers are 0 to 9. Sum = (9 × 10) / 2 = 45",
      "hash": "802cbcf161563a65",
      "translations": {
        "hi": {
          "question": "प्रथम 10 पूर्ण संख्याओं (whole numbers) का योग क्या है?",
          "options": {
            "A": "45",
            "B": "50",
            "C": "55",
            "D": "40"
          },
          "explanation": "प्रथम 10 पूर्ण संख्याएं 0 से 9 तक हैं। योग = (9 × 10) / 2 = 45"
        }
      }
    },
    {
      "id": "mathematics-03-008",
      "number": 8,
      "question": "A shopkeeper allows a discount of 10% on his goods. If the Marked Price of an article is Rs 500, what is the Selling Price?",
      "options": {
        "A": "400",
        "B": "450",
        "C": "480",
        "D": "490"
      },
      "answer": "B",
      "explanation": "Discount = 10% of 500 = 50. Selling Price = 500 - 50 = 450",
      "hash": "4e28c94bf67659dc",
      "translations": {
        "hi": {
          "question": "एक दुकानदार अपनी वस्तुओं पर 10% की छूट देता है। यदि किसी वस्तु का अंकित मूल्य 500 रुपये है, तो विक्रय मूल्य क्या है?",
          "options": {
            "A": "400",
            "B": "450",
            "C": "480",
            "D": "490"
          },
          "explanation": "छूट = 500 का 10% = 50। विक्रय मूल्य = 500 - 50 = 450"
        }
      }
    },
    {
      "id": "mathematics-03-009",
      "number": 9,
      "question": "If a person runs at a speed of 10 km/hr, how much distance will he cover in 15 minutes?",
      "options": {
        "A": "1.5 km",
        "B": "2.5 km",
        "C": "3.5 km",
        "D": "2 km"
      },
      "answer": "B",
      "explanation": "Distance = Speed × Time = 10 × (15/60) = 10 × (1/4) = 2.5 km",
      "hash": "26813e3f01e14aac",
      "translations": {
        "hi": {
          "question": "यदि कोई व्यक्ति 10 किमी/घंटा की गति से दौड़ता है, तो वह 15 मिनट में कितनी दूरी तय करेगा?",
          "options": {
            "A": "1.5 किमी",
            "B": "2.5 किमी",
            "C": "3.5 किमी",
            "D": "2 किमी"
          },
          "explanation": "दूरी = गति × समय = 10 × (15/60) = 10 × (1/4) = 2.5 किमी"
        }
      }
    },
    {
