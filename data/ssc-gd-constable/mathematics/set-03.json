    {
      "id": "mathematics-03-004",
      "number": 4,
      "question": "There are 40 students in a class. If the number of students increases by 20%, how many students are there now?",
      "options": {
        "A": "45",
        "B": "48",
        "C": "50",
        "D": "60"
      },
      "answer": "B",
      "explanation": "Increase = 20% of 40 = 8. Total = 40 + 8 = 48",
      "hash": "2b692f8d02c85e38",
      "translations": {
        "hi": {
          "question": "एक कक्षा में 40 छात्र हैं। यदि छात्रों की संख्या 20% बढ़ जाती है, तो अब कक्षा में कितने छात्र हैं?",
          "options": {
            "A": "45",
            "B": "48",
            "C": "50",
            "D": "60"
          },
          "explanation": "वृद्धि = 40 का 20% = 8। कुल = 40 + 8 = 48"
        }
      }
    },
    {
      "id": "mathematics-03-005",
      "number": 5,
      "question": "The perimeter of a rectangle is 50 cm. If its length is 15 cm, what is its breadth?",
      "options": {
        "A": "10 cm",
        "B": "15 cm",
        "C": "20 cm",
        "D": "25 cm"
      },
      "answer": "A",
      "explanation": "2(L + B) = 50 => 15 + B = 25 => B = 10",
      "hash": "13241efa0870cd06",
      "translations": {
        "hi": {
          "question": "एक आयत की परिधि 50 सेमी है। यदि इसकी लंबाई 15 सेमी है, तो इसकी चौड़ाई क्या है?",
          "options": {
            "A": "10 सेमी",
            "B": "15 सेमी",
            "C": "20 सेमी",
            "D": "25 सेमी"
          },
          "explanation": "2(L + B) = 50 => 15 + B = 25 => B = 10"
        }
      }
    },
    {
      "id": "mathematics-03-006",
      "number": 6,
      "question": "Ram works twice as fast as Shyam. If Shyam can do a work alone in 12 days, in how many days will Ram do it?",
      "options": {
        "A": "6 days",
        "B": "12 days",
        "C": "24 days",
        "D": "3 days"
      },
      "answer": "A",
      "explanation": "Ram's efficiency is double, so he takes half the time. 12 / 2 = 6 days.",
      "hash": "f335d30cd2f3c5c1",
      "translations": {
        "hi": {
          "question": "राम श्याम से दोगुना तेज काम करता है। यदि श्याम अकेले किसी काम को 12 दिनों में कर सकता है, तो राम उसे कितने दिनों में करेगा?",
          "options": {
            "A": "6 दिन",
            "B": "12 दिन",
            "C": "24 दिन",
            "D": "3 दिन"
          },
          "explanation": "राम की दक्षता दोगुनी है, इसलिए उसे आधा समय लगेगा। 12 / 2 = 6 दिन।"
        }
      }
    },
    {
