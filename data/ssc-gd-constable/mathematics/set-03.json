    {
      "id": "mathematics-03-020",
      "number": 20,
      "question": "The radius of the base of a cylinder is 7 cm and height is 10 cm. What is its Curved Surface Area?",
      "options": {
        "A": "220",
        "B": "440",
        "C": "660",
        "D": "880"
      },
      "answer": "B",
      "explanation": "CSA = 2πrh = 2 × (22/7) × 7 × 10 = 440 sq cm",
      "hash": "ebf910f3e0cd3217",
      "translations": {
        "hi": {
          "question": "एक बेलन (cylinder) के आधार की त्रिज्या 7 सेमी और ऊंचाई 10 सेमी है। इसका वक्र पृष्ठीय क्षेत्रफल (Curved Surface Area) क्या है?",
          "options": {
            "A": "220",
            "B": "440",
            "C": "660",
            "D": "880"
          },
          "explanation": "CSA = 2πrh = 2 × (22/7) × 7 × 10 = 440 वर्ग सेमी"
        }
      }
    }
