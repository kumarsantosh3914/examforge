        "hi": {
          "question": "यदि x का 30%, 72 है, तो x का मान क्या है?",
          "options": {
            "A": "200",
            "B": "216",
            "C": "240",
            "D": "300"
          },
          "explanation": "x * (30/100) = 72 => x = (72 * 100) / 30 = 240"
        }
      }
