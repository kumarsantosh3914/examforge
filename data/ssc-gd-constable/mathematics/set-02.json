    {
      "id": "mathematics-02-015",
      "number": 15,
      "question": "The side of an equilateral triangle is 6 cm. What will be its area?",
      "options": {
        "A": "15.57",
        "B": "9√3",
        "C": "36",
        "D": "18"
      },
      "answer": "B",
      "explanation": "Area = (√3/4) * (Side)^2 = (√3/4) * 36 = 9√3",
      "hash": "d1f0c13e31e65195",
      "translations": {
        "hi": {
          "question": "एक समबाहु त्रिभुज (equilateral triangle) की भुजा 6 सेमी है। इसका क्षेत्रफल क्या होगा? (√3 = 1.73)",
          "options": {
            "A": "15.57",
            "B": "9√3",
            "C": "36",
            "D": "18"
          },
          "explanation": "क्षेत्रफल = (√3/4) * (भुजा)^2 = (√3/4) * 36 = 9√3"
        }
      }
    },
    {
      "id": "mathematics-02-016",
      "number": 16,
      "question": "Divide Rs 1200 among A, B, and C in the ratio 2:3:5. What will be B's share?",
      "options": {
        "A": "240",
        "B": "360",
        "C": "600",
        "D": "400"
      },
      "answer": "B",
      "explanation": "Total ratio = 2+3+5 = 10. B's share = (3/10) * 1200 = Rs 360.",
      "hash": "4461481c97d1da80",
      "translations": {
        "hi": {
          "question": "1200 रुपये को A, B और C के बीच 2:3:5 के अनुपात में विभाजित करें। B का हिस्सा क्या होगा?",
          "options": {
            "A": "240",
            "B": "360",
            "C": "600",
            "D": "400"
          },
          "explanation": "कुल अनुपात = 2+3+5 = 10. B का हिस्सा = (3/10) * 1200 = 360 रुपये।"
        }
      }
    },
