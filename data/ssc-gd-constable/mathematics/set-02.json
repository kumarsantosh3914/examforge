    {
      "id": "mathematics-02-001",
      "number": 1,
      "question": "Which digit should come in the blank space of number 583_4 so that the number is divisible by 9?",
      "options": {
        "A": "6",
        "B": "7",
        "C": "8",
        "D": "9"
      },
      "answer": "B",
      "explanation": "Divisibility by 9: Sum of digits must be divisible by 9. 5+8+3+x+4 = 20+x. If x=7, sum is 27, divisible by 9.",
      "hash": "462f7d76d21ce4d2",
      "translations": {
        "hi": {
          "question": "संख्या 583_4 में रिक्त स्थान पर कौन सा अंक आएगा ताकि संख्या 9 से पूर्णतः विभाजित हो सके?",
          "options": {
            "A": "6",
            "B": "7",
            "C": "8",
            "D": "9"
          },
          "explanation": "9 से विभाज्यता का नियम: अंकों का योग 9 से विभाजित होना चाहिए। 5+8+3+x+4 = 20+x। यदि x=7, तो 27, जो 9 से विभाजित है।"
        }
      }
    },
    {
      "id": "mathematics-02-002",
      "number": 2,
      "question": "A shirt is sold for Rs 640 after a discount of 20%. What was its Marked Price?",
      "options": {
        "A": "700",
        "B": "750",
        "C": "800",
        "D": "850"
      },
      "answer": "C",
      "explanation": "80% = 640. 100% = (640/80) * 100 = Rs 800.",
      "hash": "b9352a88d98fce32",
      "translations": {
        "hi": {
          "question": "20% की छूट के बाद एक शर्ट 640 रुपये में बेची जाती है। उसका अंकित मूल्य क्या था?",
          "options": {
            "A": "700",
            "B": "750",
            "C": "800",
            "D": "850"
          },
          "explanation": "80% = 640. 100% = (640/80) * 100 = 800 रुपये।"
        }
      }
    },
    {
      "id": "mathematics-02-003",
      "number": 3,
      "question": "If A:B = 2:3 and B:C = 4:5, what is A:B:C?",
      "options": {
        "A": "8:12:15",
        "B": "6:9:15",
        "C": "8:10:15",
        "D": "2:3:5"
      },
      "answer": "A",
      "explanation": "A:B = 8:12 and B:C = 12:15 (Making B equal). So, 8:12:15",
      "hash": "6bf417f757465ea1",
      "translations": {
        "hi": {
          "question": "यदि A:B = 2:3 और B:C = 4:5 है, तो A:B:C क्या होगा?",
          "options": {
            "A": "8:12:15",
            "B": "6:9:15",
            "C": "8:10:15",
            "D": "2:3:5"
          },
          "explanation": "A:B = 8:12 और B:C = 12:15 (B को समान करने पर)। अतः 8:12:15"
        }
      }
    },
    {
      "id": "mathematics-02-004",
      "number": 4,
      "question": "The perimeter of a square is 40 m. Find its area.",
      "options": {
        "A": "100 sq m",
        "B": "80 sq m",
        "C": "160 sq m",
        "D": "40 sq m"
      },
      "answer": "A",
      "explanation": "Side = Perimeter/4 = 40/4 = 10. Area = 10 * 10 = 100 sq m.",
      "hash": "f8f193ff1a02cae1",
      "translations": {
        "hi": {
          "question": "एक वर्ग (square) का परिमाप 40 मीटर है। उसका क्षेत्रफल ज्ञात कीजिए।",
          "options": {
            "A": "100 वर्ग मीटर",
            "B": "80 वर्ग मीटर",
            "C": "160 वर्ग मीटर",
            "D": "40 वर्ग मीटर"
          },
          "explanation": "भुजा = परिमाप/4 = 40/4 = 10। क्षेत्रफल = 10 * 10 = 100 वर्ग मीटर।"
        }
      }
    },
    {
      "id": "mathematics-02-005",
      "number": 5,
      "question": "What is the average of the first 5 odd numbers?",
      "options": {
        "A": "3",
        "B": "5",
        "C": "7",
        "D": "9"
      },
      "answer": "B",
      "explanation": "Average of first n odd numbers is n. So answer is 5. (1+3+5+7+9)/5 = 25/5 = 5",
      "hash": "d6b2fcc1c50282c5",
      "translations": {
        "hi": {
          "question": "प्रथम 5 विषम संख्याओं (odd numbers) का औसत क्या है?",
          "options": {
            "A": "3",
            "B": "5",
            "C": "7",
            "D": "9"
          },
          "explanation": "प्रथम n विषम संख्याओं का औसत n होता है। अतः उत्तर 5 है। (1+3+5+7+9)/5 = 25/5 = 5"
        }
      }
    },
    {
      "id": "mathematics-02-006",
      "number": 6,
      "question": "If the Cost Price of 15 pens is equal to the Selling Price of 20 pens, what is the loss percentage?",
      "options": {
        "A": "20%",
        "B": "25%",
        "C": "30%",
        "D": "15%"
      },
      "answer": "B",
      "explanation": "Loss = (20-15)/20 * 100 = 5/20 * 100 = 25%",
      "hash": "213609fe0cc95775",
      "translations": {
        "hi": {
          "question": "यदि 15 कलमों का क्रय मूल्य 20 कलमों के विक्रय मूल्य के बराबर है, तो हानि प्रतिशत क्या है?",
          "options": {
            "A": "20%",
            "B": "25%",
            "C": "30%",
            "D": "15%"
          },
          "explanation": "हानि = (20-15)/20 * 100 = 5/20 * 100 = 25%"
        }
      }
    },
    {
      "id": "mathematics-02-007",
      "number": 7,
      "question": "A sum of money doubles itself in 10 years at Simple Interest. What is the rate of interest?",
      "options": {
        "A": "5%",
        "B": "8%",
        "C": "10%",
        "D": "12%"
      },
      "answer": "C",
      "explanation": "Rate = (100 * (n-1)) / T = (100 * (2-1)) / 10 = 100/10 = 10%",
      "hash": "39211dde4578e3ba",
      "translations": {
        "hi": {
          "question": "एक धनराशि साधारण ब्याज पर 10 वर्षों में दोगुनी हो जाती है। ब्याज की दर क्या है?",
          "options": {
            "A": "5%",
            "B": "8%",
            "C": "10%",
            "D": "12%"
          },
          "explanation": "दर = (100 * (n-1)) / T = (100 * (2-1)) / 10 = 100/10 = 10%"
        }
      }
    },
